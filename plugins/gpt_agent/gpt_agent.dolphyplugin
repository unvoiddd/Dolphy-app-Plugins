1. МЕТАДАННЫЕ — самые первые строки файла, ДО любых import/class/def, верхний уровень, строки в кавычках:
__id__ = "my_plugin"          # a-z0-9_- , до 64 символов, стабильный
__name__ = "My Plugin"
__version__ = "1.0.0"
__author__ = "Name"
__description__ = "Короткое описание"
