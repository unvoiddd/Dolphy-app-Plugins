DICT_LOW = {}
for _k, _v in DICT.items():
    DICT_LOW.setdefault(_k.lower(), _v)

TEXT_KEYS = ("text", "title", "subtitle", "description", "label", "message", "confirmText",
             "dismissText", "primaryText", "placeholder", "hint", "summary")
SKIP_TYPES = ("logPanel", "webView", "image", "icon")
SKIP_RE = re.compile(r"(?:[0-9A-Fa-f]{2}[:-]){3,}|\b\d{1,3}(?:\.\d{1,3}){3}\b|https?://|www\.|"
                     r"\S+@\S+\.\S+|^[/~]\S|0x[0-9A-Fa-f]{4,}|\b[0-9A-Fa-f]{12,}\b")
TAIL_RE = re.compile(r"^(.*?)([\s:.…!?]*)$", re.S)


def gtx(text):
    import urllib.parse
    import urllib.request
    url = ("https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=es&dt=t&q="
           + urllib.parse.quote(text))
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=8) as r:
        data = json.loads(r.read().decode("utf-8"))
    return "".join(seg[0] for seg in data[0] if seg and seg[0])


class Translator:
    def __init__(self, cache_path=None, fetch=gtx, on_ready=None):
        self.enabled = True
        self.online = True
        self.cache_path = cache_path
        self.fetch = fetch
        self.on_ready = on_ready          # fn(lista_de_sesiones) -> refresca pantallas
        self.cache = collections.OrderedDict()
        self.queue = collections.deque()
        self.queued = set()
        self.waiters = set()
        self.lock = threading.Lock()
        self.worker = None
        self.fails = 0
        self.pause_until = 0.0
        self.dirty = False
        self._load()

    # ---- caché en disco
    def _load(self):
        try:
            if self.cache_path and os.path.exists(self.cache_path):
                with open(self.cache_path, encoding="utf-8") as f:
                    for k, v in json.load(f).items():
                        self.cache[k] = v
        except Exception:
            self.cache.clear()

    def _save(self):
        try:
            if self.cache_path and self.dirty:
                tmp = self.cache_path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(dict(self.cache), f, ensure_ascii=False)
                os.replace(tmp, self.cache_path)
                self.dirty = False
        except Exception:
            pass

    # ---- reglas
    @staticmethod
    def worth(s):
        if len(s) < 2 or len(s) > 400:
            return False
        letters = sum(c.isalpha() for c in s)
        if letters < 2 or letters * 10 < len(s) * 4:
            return False
        return not SKIP_RE.search(s)

    def _dict(self, core):
        hit = DICT.get(core)
        if hit is None:
            hit = DICT_LOW.get(core.lower())
        if hit is not None and len(core) > 2 and core.isupper():
            hit = hit.upper()
        return hit

    def tr(self, s, session=None):
        """Devuelve la traducción si ya se conoce; si no, la pide en segundo plano."""
        if not isinstance(s, str) or not self.worth(s):
            return s
        pre = s[:len(s) - len(s.lstrip())]
        body = s.strip()
        m = TAIL_RE.match(body)
        core, tail = (m.group(1), m.group(2)) if m else (body, "")
        if not core:
            return s
        hit = self._dict(core)
        if hit is not None:
            return pre + hit + tail
        hit = self.cache.get(body)
        if hit is not None:
            return pre + hit + s[len(s.rstrip()):]
        if self.online and sum(c.isdigit() for c in s) < 4:
            self._enqueue(body, session)
        return s

    # ---- cola en segundo plano
    def _enqueue(self, body, session):
        with self.lock:
            if session is not None:
                self.waiters.add(session)
            if body in self.queued or len(self.queue) > 200:
                return
            self.queued.add(body)
            self.queue.append(body)
            if self.worker is None or not self.worker.is_alive():
                self.worker = threading.Thread(target=self._run, daemon=True)
                self.worker.start()

    def _run(self):
        while True:
            with self.lock:
                if not self.queue:
                    waiters = list(self.waiters)
                    self.waiters.clear()
                    self.worker = None
                    break
                body = self.queue.popleft()
            if time.time() < self.pause_until:
                with self.lock:
                    self.queued.discard(body)
                continue
            try:
                out = self.fetch(body)
                if not out or not str(out).strip():
                    out = body
                self.cache[body] = str(out).strip()
                while len(self.cache) > 5000:
                    self.cache.popitem(last=False)
                self.dirty = True
                self.fails = 0
            except Exception:
                self.fails += 1
                if self.fails >= 4:
                    self.pause_until = time.time() + 120.0
                    self.fails = 0
            with self.lock:
                self.queued.discard(body)
            time.sleep(0.15)
        self._save()
        if waiters and self.on_ready is not None:
            try:
                self.on_ready(waiters)
            except Exception:
                pass

    # ---- recorrido de estructuras de UI / ajustes
    def walk(self, node, session=None):
        if isinstance(node, dict):
            if node.get("type") in SKIP_TYPES:
                return node
            for k, v in list(node.items()):
                if k in TEXT_KEYS and isinstance(v, str):
                    node[k] = self.tr(v, session)
                elif k == "options" and isinstance(v, list):
                    for opt in v:
                        if isinstance(opt, list) and len(opt) > 1 and isinstance(opt[1], str):
                            opt[1] = self.tr(opt[1], session)
                        elif isinstance(opt, dict):
                            self.walk(opt, session)
                elif k == "tabs" and isinstance(v, list):
                    node[k] = [self.tr(t, session) if isinstance(t, str) else t for t in v]
                elif isinstance(v, (dict, list)):
                    self.walk(v, session)
        elif isinstance(node, list):
            for item in node:
                if isinstance(item, (dict, list)):
                    self.walk(item, session)
        return node

    def json_text(self, raw, session=None):
        return json.dumps(self.walk(json.loads(raw), session), ensure_ascii=False)


class Bridge:
    """Envoltorio del puente de un plugin: traduce lo que registra (ajustes, módulos...)."""

    def __init__(self, inner, tr):
        object.__setattr__(self, "_b", inner)
        object.__setattr__(self, "_t", tr)

    def __getattr__(self, name):
        return getattr(object.__getattribute__(self, "_b"), name)

    def _t_(self, s):
        t = object.__getattribute__(self, "_t")
        return t.tr(s) if t.enabled else s

    def registerSettings(self, title, spec, *rest):
        t = object.__getattribute__(self, "_t")
        try:
            if t.enabled:
                title = t.tr(str(title))
                spec = t.json_text(spec)
        except Exception:
            pass
        return object.__getattribute__(self, "_b").registerSettings(title, spec, *rest)

    def registerModule(self, section, title, description, *rest):
        try:
            title, description = self._t_(str(title)), self._t_(str(description))
        except Exception:
            pass
        return object.__getattribute__(self, "_b").registerModule(section, title, description, *rest)

    def registerBleMode(self, mode_id, title, description, *rest):
        try:
            title, description = self._t_(str(title)), self._t_(str(description))
        except Exception:
            pass
        return object.__getattribute__(self, "_b").registerBleMode(mode_id, title, description, *rest)


def runtime_module():
    mod = sys.modules.get("dolphy_runtime")
    if mod is None:
        import dolphy_runtime as mod
    return mod


def install_patches(rt, tr):
    S = rt.PluginRuntimeSession
    B = rt.BasePlugin
    S._es_tr = tr
    if getattr(S, "_es_installed", False):
        return
    S._es_installed = True
    orig_render = S.render
    orig_init = S.__init__
    orig_toast = B.toast

    def render(self, screen_id, state_json):
        out = orig_render(self, screen_id, state_json)
        t = getattr(S, "_es_tr", None)
        if t is None or not t.enabled:
            return out
        try:
            return t.json_text(out, self)
        except Exception:
            return out

    def init(self, source, bridge, manifest_json):
        t = getattr(S, "_es_tr", None)
        try:
            if t is not None and t.enabled and json.loads(manifest_json).get("id") != "dolphy_es":
                bridge = Bridge(bridge, t)
        except Exception:
            pass
        orig_init(self, source, bridge, manifest_json)

    def toast(self, text):
        t = getattr(S, "_es_tr", None)
        if t is not None and t.enabled:
            try:
                text = t.tr(str(text))
            except Exception:
                pass
        return orig_toast(self, text)

    S.render = render
    S.__init__ = init
    B.toast = toast


def uninstall_patches(rt):
    try:
        rt.PluginRuntimeSession._es_tr = None
    except Exception:
        pass


def make_run():
    from java import dynamic_proxy, jclass
    Runnable = jclass("java.lang.Runnable")

    class Run(dynamic_proxy(Runnable)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def run(self):
            self.fn()

    return Run


class DolphyEs(BasePlugin):
    def on_plugin_load(self):
        self.enabled = bool(self.get_setting("es_enabled", True))
        self.tr = None
        self.loader = None
        self.targets = []
        self.handler = None
        self.Run = None
        self.err = ""
        self.tries = 0
        self.alive = True
        self.api.registerSettings("Español", json.dumps([
            {"type": "header", "title": "Dolphy en Español"},
            {"type": "switch", "key": "es_enabled", "title": "Traducir la app al español",
             "subtitle": "Apágalo para volver al idioma original. Si algo no cambia al instante, cierra y abre Dolphy.",
             "default": True},
            {"type": "switch", "key": "es_plugins", "title": "Traducir también los otros plugins",
             "subtitle": "Pantallas, botones, avisos y ajustes de los demás plugins. Los plugins que se cargan después de este se traducen por completo; los anteriores, sus pantallas y avisos.",
             "default": True},
            {"type": "switch", "key": "es_online", "title": "Traductor en línea para textos desconocidos",
             "subtitle": "Envía a Google Translate los textos de plugins que no estén en el diccionario (no se envían direcciones, números largos ni lo que escribes). Las traducciones se guardan en el teléfono.",
             "default": True},
        ]), 40)
        self._setup_translator()
        try:
            from java import jclass
            self.handler = jclass("android.os.Handler")(jclass("android.os.Looper").getMainLooper())
            self.Run = make_run()
            self._post(self._boot, 300)
        except Exception as e:
            self._fail("inicio", e)

    def on_plugin_unload(self):
        self.alive = False
        self._remove()
        self._teardown_translator()

    def on_plugin_disable(self):
        self.alive = False
        self._remove()
        self._teardown_translator()

    def on_activity_create(self, activity):
        if self.alive and self.handler is not None:
            self._post(lambda: self._apply(activity), 0)
            self._post(lambda: self._apply(activity), 700)

    def on_setting_changed(self, payload):
        self.enabled = bool(self.get_setting("es_enabled", True))
        if self.tr is not None:
            self.tr.enabled = bool(self.get_setting("es_plugins", True))
            self.tr.online = bool(self.get_setting("es_online", True))
        if self.handler is None:
            return
        if self.enabled:
            self._post(self._boot, 0)
        else:
            self._post(self._remove, 0)

    # ------------------------------------------------------------------ otros plugins
    def _setup_translator(self):
        try:
            path = None
            try:
                ctx = self.api.getApplicationContext()
                path = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "dolphy_es_cache.json")
            except Exception:
                pass
            self.tr = Translator(path, gtx, self._refresh_sessions)
            self.tr.enabled = bool(self.get_setting("es_plugins", True))
            self.tr.online = bool(self.get_setting("es_online", True))
            install_patches(runtime_module(), self.tr)
        except Exception as e:
            self._fail("otros plugins", e)

    def _teardown_translator(self):
        try:
            if self.tr is not None:
                self.tr.enabled = False
            uninstall_patches(runtime_module())
        except Exception:
            pass

    def _refresh_sessions(self, sessions):
        # Se llama desde el hilo del traductor: la actualización se hace en el hilo principal.
        def go():
            for s in sessions:
                try:
                    s.bridge.refresh()
                except Exception:
                    pass
        if self.handler is not None and self.Run is not None:
            self._post(go, 0)

    def _say(self, text):
        try:
            self.api.toast(str(text))
        except Exception:
            pass

    # ------------------------------------------------------------------ utilidades
    def _post(self, fn, delay=0):
        try:
            r = self.Run(fn)
            if delay:
                self.handler.postDelayed(r, delay)
            else:
                self.handler.post(r)
        except Exception as e:
            self._fail("post", e)

    def _fail(self, stage, e):
        try:
            tb = traceback.extract_tb(e.__traceback__)
            line = (" @L" + str(tb[-1].lineno)) if tb else ""
            self.err = "[" + stage + "] " + type(e).__name__ + line + ": " + str(e)[:160]
            self._say("Dolphy ES: " + self.err)
        except Exception:
            pass

    def _boot(self):
        if not self.alive or not self.enabled:
            return
        try:
            act = self.api.getActivity()
            if act is None:
                self.tries += 1
                if self.tries < 100:
                    self._post(self._boot, 600)
                return
            self._apply(act)
        except Exception as e:
            self._fail("boot", e)

    # ------------------------------------------------------------------ traducción
    def _ensure_loader(self, act):
        if self.loader is not None:
            return True
        from java import jclass
        sdk = int(jclass("android.os.Build$VERSION").SDK_INT)
        if sdk < 30:
            self._say("Dolphy ES: se necesita Android 11 o superior")
            return False
        res = act.getResources()
        pkg = str(act.getPackageName())
        entries = {}
        pkg_id = None
        type_id = None
        merged = dict(LIB_TEXTS)
        merged.update(TEXTS)
        for name, text in merged.items():
            rid = int(res.getIdentifier(name, "string", pkg))
            if rid == 0:
                continue
            p = (rid >> 24) & 0xFF
            t = (rid >> 16) & 0xFF
            e = rid & 0xFFFF
            if pkg_id is None:
                pkg_id, type_id = p, t
            if p != pkg_id or t != type_id:
                continue
            entries[e] = (name, text)
        if not entries:
            self._say("Dolphy ES: no se encontraron cadenas que traducir")
            return False
        data = build_arsc(pkg, pkg_id, type_id, entries)
        path = os.path.join(str(act.getCacheDir().getAbsolutePath()), "dolphy_es.arsc")
        with open(path, "wb") as f:
            f.write(data)
        File = jclass("java.io.File")
        PFD = jclass("android.os.ParcelFileDescriptor")
        pfd = PFD.open(File(path), PFD.MODE_READ_ONLY)
        provider = jclass("android.content.res.loader.ResourcesProvider").loadFromTable(pfd, None)
        loader = jclass("android.content.res.loader.ResourcesLoader")()
        loader.addProvider(provider)
        self.loader = loader
        self.count = len(entries)
        return True

    def _apply(self, act):
        if not self.alive or not self.enabled:
            return
        try:
            if not self._ensure_loader(act):
                return
            for getter in (lambda: act.getResources(),
                           lambda: act.getBaseContext().getResources(),
                           lambda: act.getApplicationContext().getResources()):
                try:
                    r = getter()
                    r.addLoaders(self.loader)
                    self.targets.append(r)
                except Exception:
                    pass
            self._kick(act)
        except Exception as e:
            self._fail("aplicar", e)

    def _remove(self):
        try:
            if self.loader is not None:
                for r in self.targets:
                    try:
                        r.removeLoaders(self.loader)
                    except Exception:
                        pass
            self.targets = []
            act = self.api.getActivity()
            if act is not None:
                self._kick(act)
        except Exception as e:
            self._fail("quitar", e)

    def _kick(self, act):
        # Hace que Compose vuelva a leer las cadenas sin recrear la actividad.
        def go():
            try:
                decor = act.getWindow().getDecorView()
                decor.dispatchConfigurationChanged(act.getResources().getConfiguration())
            except Exception as e:
                self._fail("refrescar", e)
        self._post(go, 150)
        self._post(go, 900)
