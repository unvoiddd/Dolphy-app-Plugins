NO_ENTRY = 0xFFFFFFFF


def _len8(n):
    return bytes([n]) if n < 0x80 else bytes([0x80 | (n >> 8), n & 0xFF])


def _pool(strings):
    data = bytearray()
    offs = []
    for s in strings:
        b = s.encode("utf-8")
        u16 = len(s.encode("utf-16-le")) // 2
        offs.append(len(data))
        data += _len8(u16) + _len8(len(b)) + b + b"\x00"
    while len(data) % 4:
        data.append(0)
    n = len(strings)
    start = 28 + 4 * n
    head = struct.pack("<HHIIIIII", 0x0001, 28, start + len(data), n, 0, 0x100, start, 0)
    return head + struct.pack("<%dI" % n, *offs) + bytes(data)


def _config(lang, sdk):
    cfg = bytearray(64)
    struct.pack_into("<I", cfg, 0, 64)
    if lang:
        cfg[8:10] = lang.encode("ascii")
    struct.pack_into("<H", cfg, 24, sdk)  # sdkVersion: gana a la config sin versión de la app
    return bytes(cfg)


def build_arsc(pkg_name, pkg_id, type_id, entries, langs=("", "ru")):
    """entries: {id_de_entrada: (nombre_clave, texto)} -> bytes de un resources.arsc"""
    texts = []
    tidx = {}
    keys = []
    kidx = {}
    for _eid, (kname, text) in entries.items():
        if text not in tidx:
            tidx[text] = len(texts)
            texts.append(text)
        if kname not in kidx:
            kidx[kname] = len(keys)
            keys.append(kname)
    count = max(entries) + 1
    type_names = ["t%d" % i for i in range(1, type_id)] + ["string"]
    type_pool = _pool(type_names)
    key_pool = _pool(keys)
    global_pool = _pool(texts)

    spec = struct.pack("<HHIBBHI", 0x0202, 16, 16 + 4 * count, type_id, 0, 0, count)
    spec += b"\x00" * (4 * count)
    chunks = [spec]
    ordered = sorted(entries)
    for lang in langs:
        body = bytearray()
        offs = [NO_ENTRY] * count
        for eid in ordered:
            kname, text = entries[eid]
            offs[eid] = len(body)
            body += struct.pack("<HHI", 8, 0, kidx[kname])
            body += struct.pack("<HBBI", 8, 0, 3, tidx[text])
        start = 84 + 4 * count
        head = struct.pack("<HHIBBHII", 0x0201, 84, start + len(body), type_id, 0, 0, count, start)
        head += _config(lang, 1)
        chunks.append(head + struct.pack("<%dI" % count, *offs) + bytes(body))

    name = pkg_name.encode("utf-16-le")[:254]
    name = name + b"\x00" * (256 - len(name))
    pkg_size = 288 + len(type_pool) + len(key_pool) + sum(len(c) for c in chunks)
    pkg = struct.pack("<HHI", 0x0200, 288, pkg_size) + struct.pack("<I", pkg_id) + name
    pkg += struct.pack("<IIIII", 288, 0, 288 + len(type_pool), 0, 0)
    pkg += type_pool + key_pool + b"".join(chunks)
    total = 12 + len(global_pool) + len(pkg)
    return struct.pack("<HHII", 0x0002, 12, total, 1) + global_pool + pkg


# ====================================================================== otros plugins
# Los plugins pintan su interfaz con ui.text(), ui.button()... que devuelven diccionarios
# JSON. Aquí se intercepta PluginRuntimeSession.render() y se traducen los textos antes de
# que lleguen a la pantalla. Orden de búsqueda: diccionario -> caché -> traductor en línea
# (en segundo plano; mientras llega la respuesta se ve el original y luego se refresca).

