__id__ = "minesweeper"
__name__ = "MineSweeper"
__version__ = "1.1.0"
__author__ = "@maratichka"
__description__ = "Classical MineSweeper game in your dolphy app."
__icon__ = "rounded:grid_on"

import random
import threading
import time
import traceback

WIDTH = 8
HEIGHTS = [8, 16, 32, 64]
MINE_COUNTS = {8: 10, 16: 20, 32: 40, 64: 80}
DIGITS = ["", "1️⃣", "2️⃣", "3️⃣", "4️⃣", "5️⃣", "6️⃣", "7️⃣", "8️⃣"]
FLAG = "🚩"
MINE = "💣"
HIDDEN = "⬛"
EMPTY = "⬜"

STRINGS = {
    "ru": {
        "heading": "MineSweeper!",
        "mines": "Мины",
        "time": "Время",
        "tips_title": "Подсказки:",
        "tip_open": "Режим «открыть»: нажатие открывает плитку.",
        "tip_flag": "Режим «флаг»: нажатие ставит или снимает флаг.",
        "field": "Поле игры",
        "mode_open": "Режим: открыть",
        "mode_flag": "Режим: флаг",
        "play_again": "Играть снова!",
        "size": "Размер:",
        "start": "Откройте любую плитку",
        "found": "Найдите все мины!",
        "win": "Победа!",
        "lose": "Взрыв! Попробуйте ещё раз",
        "error": "Ошибка",
    },
    "en": {
        "heading": "MineSweeper!",
        "mines": "Mines",
        "time": "Time",
        "tips_title": "Tips:",
        "tip_open": "Open mode: tap opens a square.",
        "tip_flag": "Flag mode: tap sets or removes a flag.",
        "field": "Game field",
        "mode_open": "Mode: open",
        "mode_flag": "Mode: flag",
        "play_again": "Play again!",
        "size": "Size:",
        "start": "Open any tile",
        "found": "Find all mines!",
        "win": "You win!",
        "lose": "Boom! Try again",
        "error": "Error",
    },
}


class Minesweeper(BasePlugin):
    def __init__(self):
        super().__init__()
        self.width = WIDTH
        self.height = 8
        self.lang = "ru"
        self.flag_mode = False
        self.mines = MINE_COUNTS[8]
        self.mine_set = set()
        self.revealed = set()
        self.flagged = set()
        self.placed = False
        self.game_over = False
        self.won = False
        self.start_time = None
        self.end_time = None
        self.timer_on = False
        self.status_key = "start"
        self.error_text = ""
        self._ready = False
        self.new_game()

    def t(self, key):
        return STRINGS[self.lang].get(key, key)

    def status_text(self):
        if self.error_text:
            return self.t("error") + ": " + self.error_text
        return self.t(self.status_key)

    def vibrate(self, ms):
        try:
            self.api.getAndroid().vibrate(ms)
        except Exception:
            pass

    def buzz_flag(self):
        self.vibrate(40)

    def buzz_mine(self):
        def job():
            for _ in range(3):
                self.vibrate(120)
                time.sleep(0.25)
        threading.Thread(target=job, daemon=True).start()

    def on_plugin_load(self):
        try:
            self.add_module(
                title="MineSweeper",
                description="Classical MineSweeper",
                icon="extension",
                screen="main",
                section="PLUGINS",
                order=20
            )
            self._ready = True
        except Exception as e:
            self.error_text = "Load: " + str(e)

    def on_plugin_unload(self):
        self.stop_timer()
        self._ready = False

    def total(self):
        return self.width * self.height

    def new_game(self):
        self.stop_timer()
        self.mines = MINE_COUNTS[self.height]
        self.mine_set = set()
        self.revealed = set()
        self.flagged = set()
        self.placed = False
        self.game_over = False
        self.won = False
        self.start_time = None
        self.end_time = None
        self.timer_on = False
        self.status_key = "start"
        self.error_text = ""

    def place_mines(self, first):
        safe = set([first] + self.neighbors(first))
        candidates = [i for i in range(self.total()) if i not in safe]
        self.mine_set = set(random.sample(candidates, self.mines))
        self.placed = True

    def neighbors(self, i):
        r, c = divmod(i, self.width)
        result = []
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nr = r + dr
                nc = c + dc
                if 0 <= nr < self.height and 0 <= nc < self.width:
                    result.append(nr * self.width + nc)
        return result

    def count_near(self, i):
        return sum(1 for j in self.neighbors(i) if j in self.mine_set)

    def start_timer(self):
        if self.start_time is not None:
            return
        self.start_time = time.monotonic()
        self.timer_on = True
        threading.Thread(target=self.timer_loop, daemon=True).start()

    def timer_loop(self):
        while self.timer_on:
            time.sleep(1)
            self.notify()

    def stop_timer(self):
        self.timer_on = False
        if self.start_time is not None and self.end_time is None:
            self.end_time = time.monotonic()

    def format_time(self):
        if self.start_time is None:
            return "00:00"
        end = self.end_time if self.end_time is not None else time.monotonic()
        s = int(end - self.start_time)
        return "%02d:%02d" % (s // 60, s % 60)

    def reveal(self, i):
        if self.game_over or i in self.flagged or i in self.revealed:
            return
        if not self.placed:
            self.place_mines(i)
            self.status_key = "found"
        self.start_timer()
        if i in self.mine_set:
            self.revealed.add(i)
            self.game_over = True
            self.status_key = "lose"
            self.stop_timer()
            self.buzz_mine()
            return
        stack = [i]
        while stack:
            j = stack.pop()
            if j in self.revealed or j in self.flagged:
                continue
            self.revealed.add(j)
            if self.count_near(j) == 0:
                stack.extend(self.neighbors(j))
        self.check_win()

    def check_win(self):
        if len(self.revealed) == self.total() - self.mines:
            self.game_over = True
            self.won = True
            self.status_key = "win"
            self.stop_timer()

    def toggle_flag(self, i):
        if self.game_over or i in self.revealed:
            return False
        if i in self.flagged:
            self.flagged.discard(i)
            return False
        self.flagged.add(i)
        return True

    def tap(self, i):
        self.error_text = ""
        try:
            if self.flag_mode:
                if self.toggle_flag(i):
                    self.buzz_flag()
            else:
                self.reveal(i)
        except Exception as e:
            self.error_text = str(e)
        self.notify()

    def toggle_mode(self):
        self.flag_mode = not self.flag_mode
        self.notify()

    def cell_text(self, i):
        if i in self.revealed:
            if i in self.mine_set:
                return MINE
            near = self.count_near(i)
            if near == 0:
                return EMPTY
            return DIGITS[near] if near < len(DIGITS) else str(near)
        if i in self.flagged:
            return FLAG
        if self.game_over and i in self.mine_set:
            return MINE
        return HIDDEN

    def cell_style(self, i):
        if i in self.revealed:
            return "text"
        return "outlined"

    def cell_action(self, i):
        def action():
            self.tap(i)
        return action

    def height_action(self, h):
        def action():
            self.set_height(h)
        return action

    def lang_action(self, code):
        def action():
            self.set_lang(code)
        return action

    def set_height(self, h):
        try:
            self.height = h
            self.new_game()
        except Exception as e:
            self.error_text = str(e)
        self.notify()

    def set_lang(self, code):
        self.lang = code
        self.notify()

    def play_again(self):
        try:
            self.new_game()
        except Exception as e:
            self.error_text = str(e)
        self.notify()

    def notify(self):
        if not self._ready:
            return
        try:
            self.refresh()
        except Exception:
            pass

    def cell_button(self, ui, i):
        return ui.button(
            self.cell_text(i),
            self.cell_action(i),
            style=self.cell_style(i),
            enabled=not self.game_over,
            fill_max_width=False,
        )

    def screen_main(self, ui, api, state):
        try:
            rows = []
            for r in range(self.height):
                cells = []
                for c in range(self.width):
                    cells.append(self.cell_button(ui, r * self.width + c))
                rows.append(ui.lazy_row(cells, spacing=2, fill_max_width=False))

            mode_text = self.t("mode_flag") if self.flag_mode else self.t("mode_open")

            children = [
                ui.button("RUSSIAN🇷🇺", self.lang_action("ru"),
                          style="filled" if self.lang == "ru" else "outlined",
                          fill_max_width=True),
                ui.button("ENGLISH🇬🇧/🇺🇲", self.lang_action("en"),
                          style="filled" if self.lang == "en" else "outlined",
                          fill_max_width=True),
                ui.spacer(height=12),
                ui.text(self.t("heading"), "headlineMedium"),
                ui.text(self.t("mines") + ": " + str(self.mines), "titleLarge"),
                ui.text(self.t("time") + ": " + self.format_time(), "titleLarge"),
                ui.text(self.status_text(), "bodyLarge"),
                ui.spacer(height=12),
                ui.text(self.t("tips_title"), "titleMedium"),
                ui.text(self.t("tip_open"), "bodyLarge"),
                ui.text(self.t("tip_flag"), "bodyLarge"),
                ui.spacer(height=12),
                ui.text(self.t("field"), "titleMedium"),
                ui.column(rows, spacing=2),
                ui.spacer(height=8),
                ui.button(mode_text, self.toggle_mode,
                          style="tonal", fill_max_width=True),
                ui.spacer(height=12),
                ui.button(self.t("play_again"), self.play_again,
                          style="filled", fill_max_width=True),
                ui.spacer(height=12),
                ui.text(self.t("size"), "titleMedium"),
            ]
            for h in HEIGHTS:
                children.append(ui.button(
                    str(self.width) + "x" + str(h),
                    self.height_action(h),
                    style="filled" if h == self.height else "outlined",
                    fill_max_width=True
                ))
            return ui.scaffold(
                title="MineSweeper",
                content=ui.column(children, padding=16, spacing=8)
            )
        except Exception as e:
            detail = traceback.format_exc()[-500:]
            return ui.scaffold(
                title="Error",
                content=ui.column([
                    ui.text(str(e), "bodyLarge"),
                    ui.text(detail, "bodySmall"),
                ], padding=16, spacing=8)
            )