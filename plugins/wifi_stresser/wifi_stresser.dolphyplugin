        return ui.scaffold(title=self.L("g_title"), content=ui.column(children, padding=16, spacing=12))

    def screen_report(self, ui, api, state):
        children = [
            ui.card([ui.text(self.L("rep_title"), "titleMedium"), ui.text(self.L("rep_sub"), "bodySmall")]),
            ui.card([ui.text_field(value=self.generated_report_text, on_change=lambda v: None, label=self.L("rep_lbl"), single_line=False, fill_max_width=True)]),
            ui.card([ui.button(self.L("rep_back"), on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)])
        ]
        return ui.scaffold(title=self.L("rep_title"), content=ui.column(children, padding=16, spacing=12))

    def screen_history(self, ui, api, state):
        children = [ui.card([ui.text(self.L("hist_title"), "titleMedium"), ui.text(self.L("hist_sub", n=len(self.session_history)), "bodySmall")])]
        for sess in self.session_history:
            children.append(ui.card([
                ui.text(f"📅 {sess.get('timestamp', '')}", "titleSmall"),
                ui.text(f"🎯 {sess.get('gateway', '')}:{sess.get('port', '')} · 🎭 {sess.get('vendor', '?')}", "bodySmall"),
                ui.text(f"⚡ {sess.get('method', '')} · {sess.get('total_packets', 0)} pkts · {sess.get('peak_pps', 0)} PPS", "bodySmall"),
                ui.text(f"🩺 {sess.get('vitality', '')}", "bodySmall")
            ]))
        children.append(ui.card([ui.button(self.L("hist_back"), on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)]))
        return ui.scaffold(title=self.L("hist_title"), content=ui.column(children, padding=16, spacing=12))

