    def _l2_once(self, idx):
        now = time.time()
        if now - self._last_l2_time < 1.5: return
        self._last_l2_time = now
        try:
            if self.has_shizuku: self.shizuku("cmd wifi start-scan")
            elif self.has_root: self.root("cmd wifi start-scan")
            with self.stats_lock: self.stats["l2"] += 1
        except Exception as e: self._record_error("L2 (Mixed)", e)

    def on_plugin_unload(self):
        self._stop_stress()
        with self.sockets_lock:
            for sock in list(self.sockets): self._safe_close_socket(sock)
            self.sockets.clear()