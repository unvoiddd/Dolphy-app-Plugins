    def _l2_worker(self, idx):
        if not (self.has_root or self.has_shizuku):
            self._log(self.L("l_l2_denied"), "ERR")
            return
        exec_cmd = self.shizuku if self.has_shizuku else self.root
        commands = ["cmd wifi start-scan", "cmd wifi list-scan-results", "cmd wifi list-networks"]
        while not self.stop_flag:
            try:
                exec_cmd(random.choice(commands))
                with self.stats_lock: self.stats["l2"] += 1
                if not self.throttle_ignore: time.sleep(0.3)
                else: time.sleep(0.1)
            except Exception as e:
                self._record_error("L2", e)
                break

    def _mixed_tcp_worker(self, idx):
        methods = self._get_mixed_tcp_methods()
        if not methods: return
        while not self.stop_flag:
            random.choice(methods)(idx)
            time.sleep(0.005)

    def _mixed_udp_worker(self, idx):
        methods = self._get_mixed_udp_methods()
        if not methods: return
        while not self.stop_flag:
            m = random.choice(methods)
            for _ in range(random.randint(5, 10)):
                if self.stop_flag: return
                m(idx)
            time.sleep(0.002)

