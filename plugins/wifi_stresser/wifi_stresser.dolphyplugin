    def _icmp_once(self, idx):
        if not (self.has_root or self.has_shizuku) or not is_valid_ip(self.gateway): return
        try:
            safe_gw = shlex.quote(self.gateway.strip())
            exec_cmd = self.shizuku if self.has_shizuku else self.root
            use_flood = self.has_root
            if use_flood: cmd = f"ping -c 1 -W 1 -f {safe_gw}"
            else: cmd = f"ping -c 1 -W 1 {safe_gw}"
            exec_cmd(cmd)
            with self.stats_lock: self.stats["icmp"] += 1
        except Exception as e:
            if idx == 0 and random.random() < 0.05: self._record_error("ICMP (Mixed)", e)

