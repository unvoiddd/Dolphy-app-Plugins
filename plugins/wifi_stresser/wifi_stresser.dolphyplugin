            with self.sockets_lock: self.sockets.append(sock)
            sock.sendall(f"GET / HTTP/1.1\r\nHost: {self.gateway}\r\nConnection: keep-alive\r\n\r\n".encode())
            sock.settimeout(2.0)
            for _ in range(5):
                if self.stop_flag: break
                try:
                    data = sock.recv(1)
                    if not data: break
                except socket.timeout: break
                with self.stats_lock: self.stats["slowread"] += 1
                time.sleep(0.3)
        except Exception as e:
            if idx == 0 and random.random() < 0.05: self._record_error("SlowRead (Mixed)", e)
        finally:
            with self.sockets_lock:
                if sock in self.sockets: self.sockets.remove(sock)
            self._safe_close_socket(sock)

