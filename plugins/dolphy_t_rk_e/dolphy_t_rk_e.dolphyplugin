__id__ = "dolphy_tr"
__name__ = "Dolphy Türkçe"
__version__ = "1.2.1"
__author__ = "Claude"
__description__ = "Dolphy 2.7 arayüzünü ve diğer eklentilerin metinlerini Türkçeleştirir"
__icon__ = "rounded:translate"
__permissions__ = []
__library__ = True

import collections
import json
import os
import re
import struct
import sys
import threading
import time
import traceback

# Dolphy Türkçe
# -----------------
# Dolphy 2.7 solo trae inglés y ruso. Este plugin crea en tiempo de ejecución una
# "tabla de recursos" (resources.arsc) con la traducción al español de las cadenas de la
# app y la superpone con ResourcesLoader (Android 11+). No modifica el APK.
#   * Las cadenas se buscan por NOMBRE (getIdentifier), así que sigue funcionando
#     aunque cambien los ID entre versiones; las que no existan se omiten.
#   * El texto escrito directamente en el código de la app (no en recursos) no se puede
#     traducir de esta forma.
#   * Los textos de OTROS plugins se traducen aparte (ver más abajo).
#   * Para volver al original basta con apagar los interruptores en los ajustes del plugin.

