INTENTS = [
    ("greet", ["привет", "здравств", "хай", "hello", "hi", "добрый"]),
    ("thanks", ["спасибо", "благодар", "thanks"]),
    ("bye", ["пока", "до свидания", "бай", "bye"]),
    ("mood", ["как дела", "как ты", "как жизнь"]),
    ("name", ["как тебя зовут", "ты кто", "кто ты", "твое имя", "твоё имя"]),
    ("help", ["помощь", "help", "что умеешь", "команды", "возможности"]),
    ("time", ["который час", "сколько времени", "время"]),
    ("date", ["какое число", "какой день", "дата", "какое сегодня"]),
    ("joke", ["шутк", "анекдот", "смешн", "рассмеш"]),
    ("tip", ["совет", "подскажи"]),
    ("fact", ["факт", "расскажи что-нибудь", "интересн"]),
