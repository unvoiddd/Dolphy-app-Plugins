    ("files", ["файл", "загруз", "прочит", "импорт", "сохрани"]),
    ("dolphy", ["dolphy", "долфи", "приложени"]),
    ("weather", ["погод"]),
    ("python", ["python", "питон", "скрипт"]),
    ("android", ["android", "андроид", "kotlin", "котлин", "java"]),
    ("bluetooth", ["bluetooth", "блютуз", "ble"]),
