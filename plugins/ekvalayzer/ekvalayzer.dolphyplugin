function drawPixelWaves(x,y,t){
 // Pixel wake trails behind the dolphin (it swims to the right).
 var phase=Math.floor(t*5)%4;
 for(var row=0;row<3;row++){
  var yy=y+5+row*4+Math.round(Math.sin(t*3+row)*1);
  var start=x-7-row*3-phase;
  px(start,yy,4,1,'rgba(112,205,239,.68)');
  px(start-3,yy+1,2,1,'rgba(112,205,239,.48)');
  px(start-7,yy,3,1,'rgba(184,237,255,.58)');
 }
 // Small pixel splash at the tail.
 px(x-3,y+2+phase%2,2,2,'rgba(205,246,255,.75)');
 px(x-6,y+8-phase%2,1,2,'rgba(125,215,246,.65)');
 px(x-10,y+4,2,1,'rgba(125,215,246,.55)');
}
function drawSpeech(x,y,t){
 // Change the short playful caption every ~14 seconds; show it for 5.5s.
 var slot=Math.floor(t/14)%phrases.length,phase=(t%14);
 if(phase>5.5)return;
 var msg=phrases[slot],w=Math.min(104,Math.max(48,Math.ceil(msg.length*4.5+12)));
 var bx=Math.max(2,Math.min(W-w-2,x-39)),by=Math.max(5,y-18);
 var alpha=phase<.25?phase/.25:phase>5.1?(5.5-phase)/.4:1;
 ctx.save();ctx.globalAlpha=Math.max(0,Math.min(1,alpha))*.92;
 // Pixel speech card with stepped corners and a tiny pointer.
 px(bx+2,by,w-4,15,'rgba(5,22,34,.90)');
 px(bx,by+2,w,11,'rgba(5,22,34,.90)');
 px(bx+2,by, w-4,1,'rgba(169,231,255,.95)');
 px(bx+2,by+14,w-4,1,'rgba(103,193,229,.9)');
 px(bx,by+4,1,7,'rgba(169,231,255,.9)');
 px(bx+w-1,by+4,1,7,'rgba(169,231,255,.9)');
 px(bx+Math.min(w-9,Math.max(5,x-bx+8)),by+15,3,2,'rgba(5,22,34,.90)');
 ctx.fillStyle='#eafaff';ctx.font='bold 7px monospace';ctx.textBaseline='middle';ctx.imageSmoothingEnabled=false;
 ctx.fillText(msg,bx+6,by+7.5,w-12);
 ctx.restore();
}
// Rare playful event: a tiny diving helmet, followed by a quick gentle dive.
// Rare full-screen trip: pause, put on a larger helmet with the flippers,
// then make one fast crossing and re-enter from the opposite edge without it.
var eventNext=78+Math.random()*42,eventStart=-1,reentryStart=-1;
var swimX=72,swimY=126,swimAngle=(Math.random()*1.0-.5),swimSpeed=10.5,swimLastTs=0;
function respawnAtRandomEdge(){
 var edge=Math.floor(Math.random()*4),a;
 if(edge===0){swimX=-30;swimY=18+Math.random()*(H-36);a=(Math.random()-.5)*1.15;}
 else if(edge===1){swimX=W+30;swimY=18+Math.random()*(H-36);a=Math.PI+(Math.random()-.5)*1.15;}
 else if(edge===2){swimX=18+Math.random()*(W-36);swimY=-24;a=Math.PI/2+(Math.random()-.5)*1.15;}
 else {swimX=18+Math.random()*(W-36);swimY=H+24;a=-Math.PI/2+(Math.random()-.5)*1.15;}
 swimAngle=a;
}

function drawHelmet(x,y,t,amount){
 // Larger, clearly readable pixel diving helmet; amount animates it into place.
 var bob=Math.round(Math.sin(t*1.8)*2),hx=x-1,hy=y-5+bob+Math.round((1-amount)*-9);
 ctx.save();ctx.globalAlpha=Math.max(0,Math.min(1,amount));
 px(hx+2,hy,8,1,'#e4faff');
 px(hx+1,hy+1,10,1,'#bdeeff');
 px(hx,hy+2,12,4,'rgba(118,207,239,.96)');
 px(hx+2,hy+2,7,2,'#8bd8f4');
 px(hx+3,hy+2,3,1,'#f5ffff');
 px(hx-1,hy+3,1,3,'#e8fbff');px(hx+12,hy+3,1,3,'#e8fbff');
 px(hx+1,hy+6,10,2,'#e0a94f');
 px(hx+3,hy+8,6,1,'#bd8136');
 ctx.restore();
}
function drawFlipperAdjust(x,y,t,progress){
 // Two small flippers reach toward the helmet during the fitting pause.
 var lift=Math.round(Math.sin(progress*Math.PI*5)*2);
 px(x+5,y+8-lift,3,1,'#b9efff');px(x+7,y+7-lift,2,1,'#8bdfff');
 px(x+13,y+8-lift,3,1,'#b9efff');px(x+13,y+7-lift,2,1,'#8bdfff');
}
function render(ts){if(document.hidden){raf=requestAnimationFrame(render);return;}if(ts-last<82){raf=requestAnimationFrame(render);return;}last=ts;frame++;
 // Clear the full framebuffer with an identity transform before every frame.
 ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.clearRect(0,0,C.width,C.height);
 ctx.setTransform(PIXEL_DENSITY,0,0,PIXEL_DENSITY,0,0);
 for(var i=0;i<stars.length;i++){var st=stars[i],a=.25+.25*Math.sin(frame*.035+i);px(st[0],st[1],1,1,'rgba(170,230,255,'+a+')');if(i%3===0)px(st[0]+1,st[1],1,1,'rgba(170,230,255,'+(a*.45)+')');}
 var t=frame/12;
 if(eventStart<0&&t>=eventNext){eventStart=t;eventNext=t+78+Math.random()*42;}
 var phase=eventStart<0?-1:t-eventStart;
 var fitting=phase>=2&&phase<4;
 var wearing=phase>=4&&phase<9.5;
 var crossing=wearing;
 var x,y;
 if(phase>=0&&phase<2){x=58;y=78+Math.sin(t*1.8)*2;}
 else if(fitting){x=58;y=78+Math.sin(t*1.8)*2;}
 else if(crossing){var p=Math.min(1,(phase-4)/7.86);x=-30+p*(W+60);y=78+Math.sin(t*2.0)*7;}
 else {
  // Swim in one steady direction. Only when fully off-screen, re-enter
  // from a randomly chosen edge with a new inward-facing direction.
  var dt=swimLastTs?Math.min(.06,(ts-swimLastTs)/1000):.016;
  swimLastTs=ts;
  swimX+=Math.cos(swimAngle)*swimSpeed*dt;
  swimY+=Math.sin(swimAngle)*swimSpeed*dt;
  if(swimX<-34||swimX>W+34||swimY<-28||swimY>H+28)respawnAtRandomEdge();
  x=swimX;y=swimY;
 }
 x=Math.round(x);y=Math.round(y);
 // Fish move independently in both directions behind the dolphin.
 for(var fidx=0;fidx<fish.length;fidx++)drawFish(fish[fidx],t);
 var showDolphin=!(phase>=9.5&&phase<10.0);
 if(showDolphin){
  drawPixelWaves(x,y,t);
  if(phase<2||fitting)drawSpeech(x,y,t);
  ctx.save();
  // Keep the dolphin aligned with its current straight swimming direction.
  var heading=(phase>=0&&phase<9.5)?0:swimAngle;
  ctx.translate(x+12,y+5);ctx.rotate(heading);ctx.translate(-(x+12),-(y+5));
  ctx.globalAlpha=.82;drawDolphin(x,y,t);
  if(fitting)drawFlipperAdjust(x,y,t,Math.min(1,(phase-2)/2));
  if(wearing)drawHelmet(x,y,t,Math.min(1,(phase-4)/.8));
  ctx.restore();
 }
 if(phase>=9.5){eventStart=-1;reentryStart=t;}
 // Ambient bubbles
 for(var b=0;b<bubbles.length;b++){var q=bubbles[b],yy=(q.y-frame*q.v+H)%(H);px(q.x,yy,q.s,q.s,'rgba(160,225,255,.58)');px(q.x+q.s,yy-1,1,1,'rgba(225,250,255,.72)');}
 ctx.globalAlpha=.22;ctx.fillStyle='#b8eaff';ctx.font='5px monospace';ctx.fillText('D O L P H Y',5,248);ctx.globalAlpha=1;
 raf=requestAnimationFrame(render);
}
window.addEventListener('resize',resize,{passive:true});document.addEventListener('visibilitychange',function(){if(!document.hidden&&!raf)raf=requestAnimationFrame(render);});
resize();raf=requestAnimationFrame(render);
})();
</script>
<script>
(function(){
// Performance: render the decorative background at 18% linear resolution (about 3.2% pixels).
var B=document.getElementById('bg'),dpr=window.devicePixelRatio||1;
if(window.__plain){B.style.display='none';return;}
var gl=B.getContext('webgl',{alpha:false,antialias:false});
if(!gl)return;
var VS='attribute vec2 a;void main(){gl_Position=vec4(a,0.0,1.0);}';
var FS='precision mediump float;uniform vec2 res;uniform float T;'+
'float bgL(vec2 p){vec2 uv=p/res;float w1=sin(uv.x*6.0+T*0.9+sin(uv.y*4.0-T*0.6)*2.0);'+
'float w2=sin(uv.y*5.0-T*0.7+cos(uv.x*3.0+T*0.4)*1.5);'+
'float l=smoothstep(0.82,1.0,abs(sin((w1+w2)*1.6)));return 0.05+0.05*uv.y+0.30*l;}'+
'void main(){vec2 p=vec2(gl_FragCoord.x,res.y-gl_FragCoord.y);gl_FragColor=vec4(vec3(bgL(p)),1.0);}';
function sh(t,src){var o=gl.createShader(t);gl.shaderSource(o,src);gl.compileShader(o);return o;}
var pr=gl.createProgram();gl.attachShader(pr,sh(gl.VERTEX_SHADER,VS));gl.attachShader(pr,sh(gl.FRAGMENT_SHADER,FS));
gl.linkProgram(pr);if(!gl.getProgramParameter(pr,gl.LINK_STATUS))return;
gl.useProgram(pr);
var buf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buf);
gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
var loc=gl.getAttribLocation(pr,'a');gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
var uRes=gl.getUniformLocation(pr,'res'),uT=gl.getUniformLocation(pr,'T');
function size(){B.width=Math.round(innerWidth*dpr*0.18);B.height=Math.round(innerHeight*dpr*0.18);gl.viewport(0,0,B.width,B.height);}
size();window.addEventListener('resize',size);
var t0=performance.now();
function frame(){
 if(window.__plain)return;
 if(document.hidden){setTimeout(function(){requestAnimationFrame(frame);},400);return;}
 gl.uniform2f(uRes,B.width,B.height);gl.uniform1f(uT,(performance.now()-t0)/1000);
 gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
 setTimeout(function(){requestAnimationFrame(frame);},window.__lite?100:33);
}
requestAnimationFrame(frame);
})();
(function(){
// Performance: the small refraction lens uses a 0.72x internal resolution.
var C=document.getElementById('lens'),dpr=(window.devicePixelRatio||1)*0.72;
if(window.__lite){C.style.display='none';return;}
var gl=C.getContext('webgl',{premultipliedAlpha:true,alpha:true,antialias:false});
if(!gl)return;
var VS='attribute vec2 a;void main(){gl_Position=vec4(a,0.0,1.0);}';
var FS='precision mediump float;uniform vec2 res;uniform vec2 mo;uniform float T;uniform float rad;uniform float al;'+
'float bgL(vec2 p){vec2 uv=p/res;float w1=sin(uv.x*6.0+T*0.9+sin(uv.y*4.0-T*0.6)*2.0);'+
'float w2=sin(uv.y*5.0-T*0.7+cos(uv.x*3.0+T*0.4)*1.5);'+
'float l=smoothstep(0.82,1.0,abs(sin((w1+w2)*1.6)));return 0.03+0.04*uv.y+0.18*l;}'+
'void main(){vec2 p=vec2(gl_FragCoord.x,res.y-gl_FragCoord.y);vec2 v=(p-mo)/rad;float d=length(v);'+
'if(d>=1.0){gl_FragColor=vec4(0.0);return;}'+
'float z=sqrt(1.0-d*d);float k=(1.0-z)*1.3;vec2 s=p-v*rad*k;'+
'float r=bgL(s-v*rad*k*0.04);float g=bgL(s);float b=bgL(s+v*rad*k*0.04);'+
'vec3 c=vec3(r,g,b);float rim=pow(1.0-z,2.2);c+=vec3(1.0)*rim*0.12;'+
'float a=smoothstep(1.0,0.9,d)*al*0.45;gl_FragColor=vec4(c*a,a);}';
function sh(t,src){var o=gl.createShader(t);gl.shaderSource(o,src);gl.compileShader(o);return o;}
var pr=gl.createProgram();gl.attachShader(pr,sh(gl.VERTEX_SHADER,VS));gl.attachShader(pr,sh(gl.FRAGMENT_SHADER,FS));
gl.linkProgram(pr);if(!gl.getProgramParameter(pr,gl.LINK_STATUS))return;
gl.useProgram(pr);
var buf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buf);
gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
var loc=gl.getAttribLocation(pr,'a');gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
var uRes=gl.getUniformLocation(pr,'res'),uMo=gl.getUniformLocation(pr,'mo'),uT=gl.getUniformLocation(pr,'T'),uRad=gl.getUniformLocation(pr,'rad'),uAl=gl.getUniformLocation(pr,'al');
gl.enable(gl.BLEND);gl.blendFunc(gl.ONE,gl.ONE_MINUS_SRC_ALPHA);
function size(){C.width=Math.round(innerWidth*dpr);C.height=Math.round(innerHeight*dpr);gl.viewport(0,0,C.width,C.height);}
size();window.addEventListener('resize',size);
var L={x:0,y:0,on:false,a:0},run=false;
function frame(){
 if(window.__lite){gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT);run=false;return;}
 L.a+=((L.on?1:0)-L.a)*0.3;
 gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT);
 if(L.a>0.003){
  gl.uniform2f(uRes,C.width,C.height);gl.uniform2f(uMo,L.x,L.y);
  gl.uniform1f(uT,performance.now()/1000);gl.uniform1f(uRad,22*dpr);gl.uniform1f(uAl,L.a);
  gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
 }
 if(L.on||L.a>0.003)requestAnimationFrame(frame);else run=false;
}
function kick(){if(!run){run=true;requestAnimationFrame(frame);}}
function pos(e){L.x=e.clientX*dpr;L.y=e.clientY*dpr;}
window.addEventListener('pointerdown',function(e){L.on=true;pos(e);kick();},true);
window.addEventListener('pointermove',function(e){if(L.on){pos(e);kick();}},true);
window.addEventListener('pointerup',function(){L.on=false;kick();},true);
window.addEventListener('pointercancel',function(){L.on=false;kick();},true);
})();
</script>
</body></html>
"""

AGSL_GLASS = """
uniform shader content;
uniform float2 res;
uniform float dpx;
uniform float n;
uniform float T;
uniform float4 R[40];
uniform float Rr[40];
uniform float Rd[40];
uniform float RD[40];

float3 bgAt(float2 q) {
    // Real scene captured from the host Activity through PixelCopy.
    float2 p = clamp(q, float2(0.5), res - 0.5);
    return float3(content.eval(p).rgb);
}

float3 glassBlur(float2 q, float radius) {
    // Five-tap low-cost blur. PixelCopy is half-resolution, keeping the
    // sampling budget practical on Adreno while preserving background detail.
    float2 p = clamp(q, float2(0.5), res - 0.5);
    float r = clamp(radius, 0.6, 5.0);
    float3 c = bgAt(p) * 0.36;
    c += bgAt(p + float2(r, 0.0)) * 0.16;
    c += bgAt(p - float2(r, 0.0)) * 0.16;
    c += bgAt(p + float2(0.0, r)) * 0.16;
    c += bgAt(p - float2(0.0, r)) * 0.16;
    return c;
}

float2 refrDisp(float3 N, float ior, float thickness) {
    float eta = 1.0 / ior;
    float ci = N.z;
    float k = max(1.0 - eta * eta * (1.0 - ci * ci), 0.0);
    float c = eta * ci - sqrt(k);
    float denom = max(eta - c * N.z, 0.25);
    return (c * N.xy / denom) * thickness;
}


half4 main(float2 p) {
    int hit = -1;
    float hdy = 0.0;
    float hv = 1.0;
    float4 hr = float4(0.0);
    float hrr = 0.0;
    for (int i = 0; i < 40; i++) {
        if (float(i) >= n) break;
        float tt = T - Rd[i];
        float dy = 0.0;
        if (tt < 0.34) {
            float u = max(tt, 0.0) / 0.34;
            dy = -RD[i] * (1.0 - u * u);
        } else if (tt < 0.6) {
            dy = -14.0 * dpx * sin(3.14159 * (tt - 0.34) / 0.26);
        }
        float ee = tt >= 0.0 ? 1.0 : 0.0;
        float4 r = R[i];
        float2 hs = r.zw * 0.5;
        float rad = min(Rr[i], min(hs.x, hs.y));
        float2 q = abs(p - float2(r.x + hs.x, r.y + hs.y + dy)) - hs + rad;
        float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - rad;
        if (d < 0.5 && ee > 0.0) { hit = i; hdy = dy; hv = ee; hr = r; hrr = Rr[i]; }
    }
    float3 outc = bgAt(p);
    if (hit < 0) return half4(half3(outc), 1.0);

    float4 r = hr;
    float2 hs = r.zw * 0.5;
    float2 c = float2(r.x + hs.x, r.y + hs.y + hdy);
    float rad = min(hrr, min(hs.x, hs.y));
    float2 q = abs(p - c) - hs + rad;
    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - rad;
    float2 sg = float2(p.x < c.x ? -1.0 : 1.0, p.y < c.y ? -1.0 : 1.0);
    float2 g = (q.x > 0.0 && q.y > 0.0) ? normalize(q) * sg : (q.x > q.y ? float2(sg.x, 0.0) : float2(0.0, sg.y));
    float dep = max(-d, 0.0);
    float bw = max(dpx * 10.0, min(dpx * 34.0, rad * 1.25));
    float t = clamp(dep / bw, 0.0, 1.0);
    float m = bw * 1.65 * pow(1.0 - t, 1.65);
    float bevel = (bw / max(rad, dpx)) * 0.72 * pow(1.0 - t, 0.72);
    float3 N = normalize(float3(-g * bevel, 1.0));
    float thick = bw * 0.92 * pow(1.0 - t, 1.45);
    float2 offR = refrDisp(N, 1.405, thick);
    float2 offG = refrDisp(N, 1.420, thick);
    float2 offB = refrDisp(N, 1.438, thick);
    float cover = smoothstep(0.0, 1.0, t);
    float blurRadius = dpx * (1.05 + 1.9 * cover);
    float3 col = float3(glassBlur(p + offR, blurRadius).r,
                        glassBlur(p + offG, blurRadius).g,
                        glassBlur(p + offB, blurRadius).b);
    // В центре сохраняем детали реального фона; рассеивание растёт к матовой кромке.
    float luma = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(float3(luma), col, 1.05);
    col = col * 0.97 + float3(0.018, 0.020, 0.030) * (0.25 + 0.35 * cover);
    // матовое покрытие и лёгкая фиолетовая тонировка, чтобы стекло читалось на любом фоне
    col = mix(col, float3(0.10, 0.11, 0.13), 0.08 + 0.06 * cover);
    col += float3(0.035, 0.040, 0.052) * (0.25 + 0.45 * cover);

    float2 L = normalize(float2(-0.55, -0.85));
    float sp = pow(max(dot(g, L), 0.0), 2.0) + 0.55 * pow(max(dot(g, -L), 0.0), 2.0) + 0.12;
    float fresnel = pow(1.0 - clamp(N.z, 0.0, 1.0), 5.0);
    col = mix(col, float3(0.88, 0.92, 1.0), clamp(fresnel * 1.8, 0.0, 0.28));
    col += exp(-dep / (dpx * 1.55)) * sp * 0.72;                                  // кромка как в Glass Bar
    col += float3(0.95, 0.90, 1.0) * exp(-dep / (dpx * 13.0)) * 0.075;
    float gl = clamp(1.0 - (p.y - (c.y - hs.y)) / max(hs.y * 1.1, 1.0), 0.0, 1.0);
    col += gl * gl * 0.045;                                                       // статичный глянец сверху
    float a = clamp(0.5 - d, 0.0, 1.0) * hv;
    return half4(half3(mix(outc, clamp(col, 0.0, 1.0), a)), 1.0);
}
"""

PRESETS = [  # (название, [(частота Гц, дБ), ...]) — интерполяция по логарифму частоты
    ("Плоская", [(60, 0), (14000, 0)]),
    ("Бас+", [(60, 6), (150, 4), (400, 1), (1000, 0), (14000, 0)]),
    ("Голос", [(60, -3), (250, -1), (1000, 2), (3000, 4), (8000, 1), (14000, -1)]),
    ("Высокие+", [(60, -1), (1000, 0), (4000, 3), (10000, 6)]),
    ("Рок", [(60, 4), (250, 2), (1000, -2), (3000, 2), (8000, 4)]),
    ("Поп", [(60, -1), (250, 2), (1000, 3), (4000, 1), (10000, -1)]),
    ("Электроника", [(60, 5), (250, 1), (1000, -1), (4000, 2), (10000, 4)]),
    ("Классика", [(60, 3), (250, 2), (1000, -1), (4000, 1), (10000, 3)]),
]


def curve_db(points, hz):
    # значение кривой в дБ на частоте hz
    x = math.log10(max(hz, 1))
    pts = [(math.log10(f), d) for f, d in points]
    if x <= pts[0][0]:
        return pts[0][1]
    if x >= pts[-1][0]:
        return pts[-1][1]
    for (xa, da), (xb, db) in zip(pts, pts[1:]):
        if xa <= x <= xb:
            t = (x - xa) / (xb - xa)
            return da + (db - da) * t
    return 0.0


class DolphyEq(BasePlugin):

    def on_plugin_load(self):
        self.chains = {}   # сессия -> {"dp"|"eq": ..., "bass": ..., "virt": ..., "loud": ...}
        self.info = {}     # сессия -> (движок, число полос)
        self.meta = None   # системный эквалайзер: {"n", "hz", "lo", "hi"} (lo/hi в мБ)
        self.errs = {}
        self.dp_ok = True
        self.alive = True
        self.lock = threading.RLock()
        self.handler = None
        self.Run = None
        self.audio_thread = None
        self.audio_handler = None
        self.AudioRun = None
        self.apply_queue_lock = threading.Lock()
        self.apply_queued = False
        self.apply_dirty = False
        self.last_apply_signature = None
        self.last_apply_sessions = None
        self.ui = None
        self.capture_active = False
        self.capture_busy = False
        self.shd_on = False
        self.shx = False
        self.busy = False
        self.rects = []
        self.bgbmp = None
        self.bg_buffers = []
        self.capture_index = 0
        self.capture_busy = False
        self.capture_active = False
        self.capture_last_log = 0.0
        self.capture_frames = 0
        self.capture_fps = 0.0
        self.render_last_log = 0.0
        self.render_frames = 0
        self.render_fps = 0.0
        self.rect_log_sig = None
        self.poll = None
        self.srv = None
        self.port = 0
        self.token = "%032x" % random.getrandbits(128)
        self.api.registerSettings("Эквалайзер", json.dumps([
            {"type": "header", "title": "Эквалайзер"},
            {"type": "nav", "title": "Эквалайзер", "subtitle": "Вертикальные полосы, пресеты, бас, громкость",
             "icon": "graphic_eq", "screen": "dolphy_eq"},
        ]), 40)
        self._log("INFO", "Эквалайзер " + str(globals().get("__version__", "?")) + " загружен")
        self._log("INFO", "Liquid Glass diagnostics enabled")
        self._start_audio_worker()
        self._start_server()
        self._start_poll()
        self._apply()

    def on_plugin_disable(self):
        self._shutdown()

    def on_plugin_unload(self):
        self._shutdown()

    def on_setting_changed(self, payload=None):
        self._log("INFO", "изменены настройки эквалайзера")
        self._apply()

    def _log(self, level, message):
        """Queue EQ diagnostics for the GLASS BAR log window via app-private SharedPreferences."""
        try:
            ctx = self.api.getContext()
            prefs = ctx.getSharedPreferences("dolphy_cross_plugin_state", 0)
            raw = str(prefs.getString("dolphy_eq_log_queue", "[]"))
            try:
                queue = json.loads(raw)
                if not isinstance(queue, list):
                    queue = []
            except Exception:
                queue = []
            item = {"ts": time.time(), "level": str(level).upper()[:8], "msg": str(message)[:700]}
            queue.append(item)
            queue = queue[-80:]
            prefs.edit().putString("dolphy_eq_log_queue", json.dumps(queue, ensure_ascii=False)).apply()
        except Exception:
            # Logging must never interrupt audio processing or UI lifecycle.
            pass

    # ------------------------------------------------------------------ служебное
    def _glassbar_state(self):
        """Returns (present, optimized). No bridge means a deliberately non-glass UI."""
        try:
            ctx = self.api.getContext()
            prefs = ctx.getSharedPreferences(GLASSBAR_PREFS, 0)
            valid = int(prefs.getInt("glass_bar_bridge_version", 0)) >= 1
            present = bool(valid and prefs.getBoolean("glass_bar_active", False))
            optimized = bool(present and prefs.getBoolean("glass_bar_opt", False))
            return present, optimized
        except Exception:
            return False, False

    def _glassbar_opt_enabled(self):
        return self._glassbar_state()[1]

    def _start_audio_worker(self):
        try:
            from java import jclass, dynamic_proxy
            HT = jclass("android.os.HandlerThread")
            self.audio_thread = HT("DolphyEq-Audio")
            self.audio_thread.start()
            self.audio_handler = jclass("android.os.Handler")(self.audio_thread.getLooper())
            class AudioRun(dynamic_proxy(jclass("java.lang.Runnable"))):
                def __init__(self, fn):
                    super().__init__()
                    self.fn = fn
                def run(self):
                    self.fn()
            self.AudioRun = AudioRun
        except Exception as e:
            self.errs["audio_worker"] = type(e).__name__ + ": " + str(e)[:80]
            self._log("ERROR", "audio worker: " + self.errs["audio_worker"])

    def _schedule_apply(self):
        if not self.alive:
            return
        with self.apply_queue_lock:
            self.apply_dirty = True
            if self.apply_queued:
                return
            self.apply_queued = True
        def drain():
            while self.alive:
                with self.apply_queue_lock:
                    if not self.apply_dirty:
                        self.apply_queued = False
                        return
                    self.apply_dirty = False
                try:
                    self._apply_now()
                except Exception as e:
                    self.errs["apply_worker"] = type(e).__name__ + ": " + str(e)[:80]
            with self.apply_queue_lock:
                self.apply_queued = False
        try:
            if self.audio_handler is not None and self.AudioRun is not None:
                self.audio_handler.post(self.AudioRun(drain))
            else:
                threading.Thread(target=drain, name="DolphyEq-AudioFallback", daemon=True).start()
        except Exception:
            threading.Thread(target=drain, name="DolphyEq-AudioFallback", daemon=True).start()

    def _f(self, key, default=0.0):
        try:
            return float(self.get_setting(key, default))
        except Exception:
            return float(default)

    def _on(self):
        return bool(self.get_setting("eq_on", False))

    def _nb(self):
        return int(self._f("eq_bands", 10))

    def _sdk(self):
        try:
            from java import jclass
            return int(jclass("android.os.Build$VERSION").SDK_INT)
        except Exception:
            return 99

    def _want_dp(self):
        return self._nb() > 0 and self.dp_ok and self._sdk() >= 28

    def _start_poll(self):
        try:
            from java import jclass, dynamic_proxy
            Looper = jclass("android.os.Looper")
            self.handler = jclass("android.os.Handler")(Looper.getMainLooper())

            class Run(dynamic_proxy(jclass("java.lang.Runnable"))):
                def __init__(self, fn):
                    super().__init__()
                    self.fn = fn

                def run(self):
                    self.fn()

            self.Run = Run
            self.poll = Run(self._tick)
            self.handler.postDelayed(self.poll, POLL_MS)
        except Exception as e:
            self.errs["poll"] = type(e).__name__ + ": " + str(e)[:80]

    def _tick(self):
        if not self.alive:
            return
        try:
            if self._on():
                self._apply()
        except Exception:
            pass
        try:
            self.handler.postDelayed(self.poll, POLL_MS)
        except Exception:
            pass

    def _shutdown(self):
        self._log("INFO", "выгрузка эквалайзера")
        self.alive = False
        try:
            self._close_ui()
        except Exception:
            pass
        try:
            if self.handler is not None and self.poll is not None:
                self.handler.removeCallbacks(self.poll)
        except Exception:
            pass
        try:
            if self.srv is not None:
                self.srv.shutdown()
                self.srv.server_close()
        except Exception:
            pass
        self.srv = None
        with self.lock:
            self._release_all()
        try:
            if self.audio_thread is not None:
                self.audio_thread.quitSafely()
        except Exception:
            pass

    def _release_chain(self, c):
        for e in c.values():
            try:
                e.setEnabled(False)
            except Exception:
                pass
            try:
                e.release()
            except Exception:
                pass

    def _release_all(self):
        for c in list(self.chains.values()):
            self._release_chain(c)
        self.chains = {}
        self.info = {}

    # ------------------------------------------------------------------ раскладка полос и уровни
    @staticmethod
    def _hz_layout(n):
        if n == 31:
            return list(ISO31)
        return [int(round(31.5 * (16000.0 / 31.5) ** (i / float(n - 1)))) for i in range(n)]

    def _layout(self):
        # UI/profile layout is independent from the active hardware engine.
        # If DynamicsProcessing is unavailable, keep the requested 5/10/15/31
        # profile visible and map it onto the device Equalizer in _push().
        n = self._nb()
        if n > 0:
            return self._hz_layout(n), -15.0, 15.0
        if self.meta:
            return list(self.meta["hz"]), self.meta["lo"] / 100.0, self.meta["hi"] / 100.0
        return [60, 230, 910, 3600, 14000], -15.0, 15.0

    def _levels(self):
        hz, lo, hi = self._layout()
        try:
            st = json.loads(str(self.get_setting("eq_levels", "[]")))
            shz = json.loads(str(self.get_setting("eq_lhz", "[]")))
        except Exception:
            st, shz = [], []
        if len(st) == len(hz) and shz == hz:
            return [max(lo, min(hi, float(v))) for v in st]
        if len(st) > 1 and len(shz) == len(st):
            pts = list(zip(shz, [float(v) for v in st]))
            lv = [max(lo, min(hi, curve_db(pts, f))) for f in hz]
        else:
            lv = [0.0] * len(hz)
        self._save_levels(hz, lv)
        return lv

    def _save_levels(self, hz, lv):
        self.set_setting("eq_levels", json.dumps([round(float(v), 2) for v in lv]))
        self.set_setting("eq_lhz", json.dumps(hz))

    def _set_level(self, i, db):
        hz, lo, hi = self._layout()
        lv = self._levels()
        if 0 <= i < len(lv):
            lv[i] = max(lo, min(hi, round(db * 2) / 2.0))
            self._save_levels(hz, lv)
            self._apply()

    def _set_levels_batch(self, d):
        # "i:db,i:db" — несколько полос за один запрос (несколько пальцев сразу)
        hz, lo, hi = self._layout()
        lv = self._levels()
        for part in d.split(","):
            try:
                a, b = part.split(":")
                i = int(a)
                if 0 <= i < len(lv):
                    lv[i] = max(lo, min(hi, round(float(b) * 2) / 2.0))
            except Exception:
                pass
        self._save_levels(hz, lv)
        self._apply()

    def _set_fx(self, key, val):
        lim = {"eq_bass": 1000.0, "eq_virt": 1000.0, "eq_loud": 1500.0}
        if key in lim:
            self.set_setting(key, max(0.0, min(lim[key], val)))
            self._apply()

    def _set_plain(self, key, val):
        if key in ("eq_on", "eq_global", "eq_auto"):
            self.set_setting(key, bool(val))
            self._apply()

    def _post_main(self, fn):
        try:
            self.handler.post(self.Run(fn))
        except Exception as e:
            self.errs["post"] = type(e).__name__ + ": " + str(e)[:70]

    # ------------------------------------------------------------------ полноэкранное стеклянное окно
    def _show_ui(self):
        from java import jclass
        self._close_ui()
        act = self.api.getActivity()
        if act is None or not self.port:
            return
        Dialog = jclass("android.app.Dialog")
        WebView = jclass("android.webkit.WebView")
        ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        theme = jclass("android.R$style").Theme_Translucent_NoTitleBar
        d = Dialog(act, theme)
        d.requestWindowFeature(1)
        wv = WebView(act)
        wv.getSettings().setJavaScriptEnabled(True)
        wv.setBackgroundColor(0)
        wv.setVerticalScrollBarEnabled(False)
        wv.setOverScrollMode(2)
        gb_present, gb_opt = self._glassbar_state()
        # This plugin owns its Liquid Glass renderer; it must not disappear
        # merely because the optional GLASS BAR bridge is absent.
        wv.loadUrl("http://127.0.0.1:%d/?k=%s&gb=1&opt=%d" %
                   (self.port, self.token, 1 if gb_opt else 0))
        FL = jclass("android.widget.FrameLayout")
        IV = jclass("android.widget.ImageView")
        root = FL(act)
        iv = IV(act)
        iv.setScaleType(IV.ScaleType.FIT_XY)
        iv.setBackgroundColor(-16777216)  # непрозрачный слой, чтобы RenderEffect шейдера выполнялся
        dm = jclass("android.util.DisplayMetrics")()
        act.getWindowManager().getDefaultDisplay().getRealMetrics(dm)
        iv.setPivotX(0.0)
        iv.setPivotY(0.0)
        iv.setScaleX(2.0)
        iv.setScaleY(2.0)
        root.addView(iv, FLP(max(8, int(dm.widthPixels) // 2), max(8, int(dm.heightPixels) // 2)))
        root.addView(wv, FLP(-1, -1))
        d.setContentView(root, FLP(-1, -1))
        win = d.getWindow()
        # RuntimeShader requires Android 13 (API 33). Older devices keep the
        # CSS backdrop-filter fallback instead of attempting unsupported APIs.
        shader_ok = self._sdk() >= 33
        win.setBackgroundDrawable(ColorDrawable(-15594472))
        win.setLayout(-1, -1)
        win.addFlags(256 | 512)
        d.show()
        self.ui = {"d": d, "wv": wv, "iv": iv, "sh": None, "act": act, "dens": float(act.getResources().getDisplayMetrics().density)}
        self.shx = False
        self._RE = jclass("android.graphics.RenderEffect")
        if shader_ok:
            try:
                sh = jclass("android.graphics.RuntimeShader")(AGSL_GLASS)
                self.ui["sh"] = sh
                self.shx = True
                self._log("INFO", "shader_active=1 AGSL compiled SDK=" + str(self._sdk()))
                # Capture the real host Activity behind the transparent dialog.
                # PixelCopy runs at reduced resolution and updates a double buffer.
                self._capture_bg(act, iv, sh)
                if self.rects:
                    self._apply_rects()
            except Exception as e:
                self.shx = False
                self.ui["sh"] = None
                self.errs["shader"] = type(e).__name__ + ": " + str(e)[:120]
                self._log("ERROR", "shader_active=0 compile: " + self.errs["shader"])
        else:
            self._log("INFO", "shader_active=0: Android API below 33; CSS glass fallback enabled")

    def _set_rects(self, txt, dpr):
        out = []
        for part in txt.split(";"):
            v = part.split(",")
            if len(v) in (5, 6, 7):
                try:
                    out.append([float(x) for x in v])
                except Exception:
                    pass
        self.rects = [r + [0.0] * (7 - len(r)) for r in out[:40]]
        sig = str(len(self.rects)) + "|" + str(round(float(dpr), 2))
        if sig != self.rect_log_sig:
            self.rect_log_sig = sig
            self._log("INFO", "rect_count=" + str(len(self.rects)) + " dpr=" + str(dpr))
        self._post_main(self._apply_rects)

    def _apply_rects(self):
        u = self.ui
        if not u or u.get("sh") is None or not self.rects:
            return
        from java import jclass, jarray, jfloat
        iv = u["iv"]
        w, h = int(iv.getWidth()), int(iv.getHeight())
        if w < 8 or h < 8:
            return
        sh = u["sh"]
        flat = []
        rr = []
        rd = []
        rD = []
        for r in self.rects:
            flat += [v * 0.5 for v in r[:4]]
            rr.append(r[4] * 0.5)
            rd.append(r[5])
            rD.append(r[6] * 0.5)
        while len(rr) < 40:
            flat += [0.0, 0.0, 0.0, 0.0]
            rr.append(0.0)
            rd.append(0.0)
            rD.append(0.0)
        sh.setFloatUniform("res", float(w), float(h))
        sh.setFloatUniform("dpx", float(u["dens"]) * 0.5)
        sh.setFloatUniform("n", float(len(self.rects)))
        sh.setFloatUniform("R", jarray(jfloat)(flat))
        sh.setFloatUniform("Rr", jarray(jfloat)(rr))
        sh.setFloatUniform("Rd", jarray(jfloat)(rd))
        sh.setFloatUniform("RD", jarray(jfloat)(rD))
        self._tick(True)
        self.shd_on = True
        try:
            u["wv"].evaluateJavascript("document.documentElement.classList.add('shd')", None)
        except Exception:
            pass
        if not u.get("shader_logged"):
            u["shader_logged"] = True
            self._log("INFO", "shader_active=1 render effect attached; rect_count=" + str(len(self.rects)))
        if not u.get("t0"):
            u["t0"] = time.time()
            try:
                u["wv"].evaluateJavascript("go()", None)
            except Exception:
                pass
            self._start_anim()

    def _tick(self, force=False):
        u = self.ui
        if not u or u.get("sh") is None:
            return
        t0 = u.get("t0")
        t = (time.time() - t0) if t0 else -1.0
        u["fr"] = u.get("fr", 0) + 1
        if not force and t > 1.4 and u["fr"] % 2:
            return
        self.render_frames += 1
        now = time.time()
        if now - self.render_last_log >= 5.0:
            self.render_fps = self.render_frames / max(0.001, now - (self.render_last_log or now - 5.0))
            self._log("INFO", "render_fps=" + str(round(self.render_fps, 1)) + " shader_active=1")
            self.render_frames = 0
            self.render_last_log = now
        u["sh"].setFloatUniform("T", float(t))
        u["iv"].setRenderEffect(self._RE.createRuntimeShaderEffect(u["sh"], "content"))

    def _start_anim(self):
        from java import jclass, dynamic_proxy
        u = self.ui
        VA = jclass("android.animation.ValueAnimator")
        UL = jclass("android.animation.ValueAnimator$AnimatorUpdateListener")
        plug = self

        class Upd(dynamic_proxy(UL)):
            def onAnimationUpdate(self, anim):
                try:
                    plug._tick()
                except Exception as e:
                    plug.errs["tick"] = type(e).__name__ + ": " + str(e)[:60]

        va = VA.ofFloat(0.0, 1.0)
        va.setDuration(3600000)
        va.setRepeatCount(-1)
        va.setInterpolator(jclass("android.view.animation.LinearInterpolator")())
        self._upd = Upd()
        va.addUpdateListener(self._upd)
        va.start()
        u["va"] = va

    def _capture_bg(self, act, iv, sh):
        """Start a double-buffered, continuous PixelCopy feed (no stale one-shot snapshot)."""
        try:
            from java import jclass
            Bitmap = jclass("android.graphics.Bitmap")
            Cfg = jclass("android.graphics.Bitmap$Config")
            decor = act.getWindow().getDecorView()
            W, H = int(decor.getWidth()), int(decor.getHeight())
            if W < 16 or H < 16:
                raise RuntimeError("Activity decor has invalid size %sx%s" % (W, H))
            bw, bh = max(16, W // 2), max(16, H // 2)
            buffers = [Bitmap.createBitmap(bw, bh, Cfg.ARGB_8888),
                       Bitmap.createBitmap(bw, bh, Cfg.ARGB_8888)]
            self.bg_buffers = buffers
            self.capture_index = 0
            self.capture_busy = False
            self.capture_active = True
            u = self.ui
            if u is None:
                return
            u["sh"] = sh
            u["capture_size"] = (W, H, bw, bh)
            self._log("INFO", "pixelcopy_status=starting source=%dx%d buffer=%dx%d rate=24fps" % (W,H,bw,bh))
            self._capture_once()
        except Exception as e:
            self.capture_active = False
            self.errs["copy"] = type(e).__name__ + ": " + str(e)[:120]
            self._log("ERROR", "pixelcopy_status=failed " + self.errs["copy"])

    def _capture_once(self):
        if not self.capture_active or self.capture_busy or not self.ui:
            return
        try:
            from java import jclass, dynamic_proxy
            u = self.ui
            act, iv = u.get("act"), u.get("iv")
            if act is None or iv is None or bool(act.isFinishing()):
                self.capture_active = False
                return
            decor = act.getWindow().getDecorView()
            W, H = int(decor.getWidth()), int(decor.getHeight())
            if W < 16 or H < 16:
                self._schedule_capture(250)
                return
            idx = 1 - int(self.capture_index)
            bmp = self.bg_buffers[idx]
            PCL = jclass("android.view.PixelCopy$OnPixelCopyFinishedListener")
            plug = self
            class Pcl(dynamic_proxy(PCL)):
                def __init__(self):
                    super().__init__()
                def onPixelCopyFinished(self, result):
                    plug._on_capture_done(int(result), idx, bmp, iv)
            self._capture_listener = Pcl()
            self.capture_busy = True
            jclass("android.view.PixelCopy").request(act.getWindow(),
                jclass("android.graphics.Rect")(0, 0, W, H), bmp, self._capture_listener, self.handler)
        except Exception as e:
            self.capture_busy = False
            self.errs["copy"] = type(e).__name__ + ": " + str(e)[:120]
            self._log("ERROR", "pixelcopy_status=request_error " + self.errs["copy"])
            self._schedule_capture(500)

    def _on_capture_done(self, result, idx, bmp, iv):
        self.capture_busy = False
        u = self.ui
        if not self.capture_active or not u or u.get("iv") is not iv:
            return
        if result == 0:
            try:
                iv.setImageBitmap(bmp)
                iv.invalidate()
                self.capture_index = idx
                self.bgbmp = bmp
                self.capture_frames += 1
                now = time.time()
                if now - self.capture_last_log >= 5.0:
                    self.capture_fps = self.capture_frames / max(0.001, now - (self.capture_last_log or now - 5.0))
                    self._log("INFO", "pixelcopy_status=ok capture_fps=" + str(round(self.capture_fps, 1)))
                    self.capture_frames = 0
                    self.capture_last_log = now
            except Exception as e:
                self.errs["copy"] = type(e).__name__ + ": " + str(e)[:100]
                self._log("ERROR", "pixelcopy_status=bitmap_swap_error " + self.errs["copy"])
        else:
            self.errs["copy"] = "PixelCopy result=" + str(result)
            self._log("WARN", "pixelcopy_status=error result=" + str(result))
        self._schedule_capture(42 if result == 0 else 180)

    def _schedule_capture(self, delay_ms):
        try:
            if self.capture_active and self.handler is not None and self.Run is not None:
                self.handler.postDelayed(self.Run(self._capture_once), int(delay_ms))
        except Exception as e:
            self._log("WARN", "pixelcopy_status=schedule_error " + str(e)[:100])

    def _close_ui(self):
        # Dialog / WebView lifecycle must be handled on Android's main thread.
        # During Activity teardown the DecorView may already be detached; calling
        # Dialog.dismiss() then can enqueue a removeViewImmediate() that crashes later.
        try:
            from java import jclass
            Looper = jclass("android.os.Looper")
            if Looper.myLooper() != Looper.getMainLooper():
                self._post_main(self._close_ui)
                return
        except Exception:
            pass

        u = self.ui
        self.ui = None
        self.capture_active = False
        self.capture_busy = False
        self.shd_on = False
        self.shx = False
        if not u:
            return
        try:
            va = u.get("va")
            if va is not None:
                va.cancel()
        except Exception:
            pass
        try:
            d = u.get("d")
            act = u.get("act")
            if d is not None and d.isShowing():
                decor = d.getWindow().getDecorView() if d.getWindow() is not None else None
                attached = bool(decor is not None and decor.isAttachedToWindow())
                finishing = bool(act is not None and act.isFinishing())
                destroyed = False
                try:
                    destroyed = bool(act is not None and act.isDestroyed())
                except Exception:
                    pass
                # Only dismiss a live, attached dialog. A detached dialog is already
                # being removed by the Activity's own window teardown.
                if attached and not finishing and not destroyed:
                    d.dismiss()
        except Exception as e:
            self.errs["dismiss"] = type(e).__name__ + ": " + str(e)[:70]
            self._log("ERROR", "закрытие окна: " + self.errs["dismiss"])
        try:
            self.bg_buffers = []
            self.bgbmp = None
        except Exception:
            pass
        try:
            wv = u.get("wv")
            if wv is not None:
                wv.stopLoading()
                wv.setWebViewClient(None)
                wv.destroy()
        except Exception:
            pass

    def _open_ui_cb(self):
        self._post_main(self._show_ui)

    def _preset(self, idx):
        if not (0 <= idx < len(PRESETS)):
            return
        hz, lo, hi = self._layout()
        pts = PRESETS[idx][1]
        self._save_levels(hz, [max(lo, min(hi, curve_db(pts, f))) for f in hz])
        self._apply()

    def _set_bands(self, n):
        self.set_setting("eq_bands", float(n))
        self.dp_ok = True
        self._apply()

    def _state(self):
        hz, lo, hi = self._layout()
        return {"hz": hz, "lv": self._levels(), "lo": lo, "hi": hi, "nb": self._nb(),
                "presets": [p[0] for p in PRESETS], "on": self._on(), "st": self._status(),
                "bass": int(self._f("eq_bass", 0)), "virt": int(self._f("eq_virt", 0)), "loud": int(self._f("eq_loud", 0)),
                "shd": bool(self.shd_on), "shx": bool(self.shx),
                "gb": bool(self._glassbar_state()[0]), "opt": bool(self._glassbar_opt_enabled()),
                "glob": bool(self.get_setting("eq_global", True)), "auto": bool(self.get_setting("eq_auto", True))}

    # ------------------------------------------------------------------ локальный сервер для страницы
    def _start_server(self):
        try:
            from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
            from urllib.parse import urlparse, parse_qs
            plug = self

            class H(BaseHTTPRequestHandler):
                def log_message(self, *a):
                    pass

                def _send(self, body, ctype="application/json", code=200):
                    b = body.encode("utf-8")
                    self.send_response(code)
                    self.send_header("Content-Type", ctype + "; charset=utf-8")
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Content-Length", str(len(b)))
                    self.end_headers()
                    self.wfile.write(b)

                def do_GET(self):
                    try:
                        u = urlparse(self.path)
                        q = parse_qs(u.query)
                        if q.get("k", [""])[0] != plug.token:
                            return self._send("forbidden", "text/plain", 403)
                        if u.path == "/":
                            return self._send(PAGE, "text/html")
                        if u.path == "/state":
                            return self._send(json.dumps(plug._state()))
                        if u.path == "/set":
                            plug._set_level(int(q["i"][0]), float(q["v"][0]))
                        elif u.path == "/preset":
                            plug._preset(int(q["i"][0]))
                        elif u.path == "/n":
                            plug._set_bands(int(q["v"][0]))
                        elif u.path == "/sets":
                            plug._set_levels_batch(q["d"][0])
                        elif u.path == "/fx":
                            plug._set_fx(q["key"][0], float(q["v"][0]))
                        elif u.path == "/on":
                            plug._set_plain("eq_on", q["v"][0] == "1")
                        elif u.path == "/flag":
                            plug._set_plain(q["key"][0], q["v"][0] == "1")
                        elif u.path == "/reset":
                            plug._reset_cb()
                        elif u.path == "/rects":
                            plug._set_rects(q["d"][0], float(q.get("dpr", ["1"])[0]))
                        elif u.path == "/busy":
                            plug.busy = q["v"][0] == "1"
                        elif u.path == "/close":
                            plug._post_main(plug._close_ui)
                        self._send("ok", "text/plain")
                    except Exception:
                        try:
                            self._send("err", "text/plain", 500)
                        except Exception:
                            pass

            self.srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
            self.port = int(self.srv.server_address[1])
            threading.Thread(target=self.srv.serve_forever, daemon=True).start()
        except Exception as e:
            self.errs["server"] = type(e).__name__ + ": " + str(e)[:80]

    # ------------------------------------------------------------------ сессии и эффекты
    def _sessions(self):
        s = []
        if bool(self.get_setting("eq_global", True)):
            s.append(0)
        if bool(self.get_setting("eq_auto", True)):
            try:
                am = self.api.getContext().getSystemService("audio")
                for cfg in am.getActivePlaybackConfigurations():
                    sid = None
                    for name in ("getAudioSessionId", "getSessionId"):
                        fn = getattr(cfg, name, None)
                        if fn is not None:
                            try:
                                sid = int(fn())
                                break
                            except Exception:
                                pass
                    if sid and sid > 0 and sid not in s:
                        s.append(sid)
            except Exception:
                pass
        return s

    def _chain(self, sess):
        want_dp = self._want_dp()
        n = self._nb() if want_dp else 0
        c = self.chains.get(sess)
        if c is not None and self.info.get(sess) == ("dp" if want_dp else "eq", n):
            return c
        if c is not None:
            self._release_chain(self.chains.pop(sess))
            self.info.pop(sess, None)
        from java import jclass
        c = {}
        engine = "eq"
        if want_dp:
            try:
                Builder = jclass(FX + "DynamicsProcessing$Config$Builder")
                cfg = Builder(1, 2, True, n, False, 0, False, 0, False).build()
                c["dp"] = jclass(FX + "DynamicsProcessing")(0, sess, cfg)
                engine = "dp"
                self.errs.pop((sess, "dp"), None)
            except Exception as e:
                self.dp_ok = False  # откат на системный эквалайзер
                self.errs[(sess, "dp")] = type(e).__name__ + ": " + str(e)[:70]
        for key, cls in (("eq", "Equalizer"), ("bass", "BassBoost"),
                         ("virt", "Virtualizer"), ("loud", "LoudnessEnhancer")):
            if key == "eq" and engine == "dp":
                continue
            try:
                C = jclass(FX + cls)
                c[key] = C(sess) if key == "loud" else C(0, sess)
                self.errs.pop((sess, key), None)
            except Exception as e:
                self.errs[(sess, key)] = type(e).__name__ + ": " + str(e)[:70]
        if c:
            self.chains[sess] = c
            self.info[sess] = (engine, n if engine == "dp" else 0)
        return c

    def _read_meta(self, eq):
        try:
            n = int(eq.getNumberOfBands())
            rng = eq.getBandLevelRange()
            self.meta = {"n": n, "lo": int(rng[0]), "hi": int(rng[1]),
                         "hz": [int(eq.getCenterFreq(i)) // 1000 for i in range(n)]}
        except Exception as e:
            self.errs["meta"] = type(e).__name__ + ": " + str(e)[:70]

    def _push(self, c, sess=None):
        self._pushing_session = sess
        from java import jclass
        dp = c.get("dp")
        if dp is not None:
            try:
                hz, lo, hi = self._layout()
                lv = self._levels()
                n = len(hz)
                # DynamicsProcessing accepts EQ cutoffs only within its valid
                # audio-frequency range. 21000 Hz caused AudioEffect's
                # "invalid parameter operation" on some Android DSP HALs.
                cut = [math.sqrt(hz[i] * hz[i + 1]) for i in range(n - 1)] + [min(20000.0, max(20.0, hz[-1] * 1.25))]
                Eq = jclass(FX + "DynamicsProcessing$Eq")
                Band = jclass(FX + "DynamicsProcessing$EqBand")
                eqo = Eq(True, True, n)
                for i in range(n):
                    eqo.setBand(i, Band(True, float(cut[i]), float(lv[i])))
                dp.setPreEqAllChannelsTo(eqo)
                dp.setEnabled(True)
            except Exception as e:
                self.errs["dp"] = type(e).__name__ + ": " + str(e)[:100]
                self.dp_ok = False
                self._log("ERROR", "DynamicsProcessing apply failed; using hardware Equalizer: " + self.errs["dp"])
                # Drop the failed DP instance and create a real system EQ for
                # this session. Do not change the user's selected band profile.
                try:
                    try:
                        dp.release()
                    except Exception:
                        pass
                    c.pop("dp", None)
                    sess = getattr(self, "_pushing_session", None)
                    if sess is not None:
                        C = jclass(FX + "Equalizer")
                        c["eq"] = C(0, int(sess))
                        self.info[int(sess)] = ("eq", 0)
                except Exception as fallback_error:
                    self.errs["eq"] = type(fallback_error).__name__ + ": " + str(fallback_error)[:80]
        eq = c.get("eq")
        if eq is not None:
            try:
                if self.meta is None:
                    self._read_meta(eq)
                eq.setEnabled(True)
                if self.meta:
                    profile_hz, _, _ = self._layout()
                    profile_lv = self._levels()
                    points = list(zip(profile_hz, profile_lv))
                    # Hardware Equalizer may expose only 5/10 bands. Sample
                    # the selected 31-band curve at each physical band center.
                    for i, center_hz in enumerate(self.meta["hz"][:self.meta["n"]]):
                        db = curve_db(points, center_hz)
                        mb = int(max(self.meta["lo"], min(self.meta["hi"], db * 100.0)))
                        eq.setBandLevel(i, mb)
            except Exception as e:
                self.errs["eq"] = type(e).__name__ + ": " + str(e)[:70]
        for key, setting in (("bass", "eq_bass"), ("virt", "eq_virt")):
            fx = c.get(key)
            if fx is None:
                continue
            try:
                v = int(max(0, min(1000, self._f(setting, 0))))
                if bool(fx.getStrengthSupported()):
                    fx.setStrength(v)
                    fx.setEnabled(v > 0)
            except Exception as e:
                self.errs[key] = type(e).__name__ + ": " + str(e)[:70]
        ld = c.get("loud")
        if ld is not None:
            try:
                g = int(max(0, min(1500, self._f("eq_loud", 0))))
                ld.setTargetGain(g)
                ld.setEnabled(g > 0)
            except Exception as e:
                self.errs["loud"] = type(e).__name__ + ": " + str(e)[:70]

    def _apply(self):
        # Public entry point: never construct or update Android audio effects on the UI thread.
        self._schedule_apply()

    def _apply_now(self):
        with self.lock:
            try:
                if not self._on():
                    if self.chains:
                        self._release_all()
                    self.last_apply_signature = None
                    self.last_apply_sessions = []
                    return
                want = self._sessions()
                signature = tuple(str(self.get_setting(k, d)) for k, d in (
                    ("eq_on", False), ("eq_global", True), ("eq_auto", True),
                    ("eq_bands", 10), ("eq_levels", "[]"), ("eq_lhz", "[]"),
                    ("eq_bass", 0), ("eq_virt", 0), ("eq_loud", 0)))
                if signature == self.last_apply_signature and want == self.last_apply_sessions:
                    return
                for sess in list(self.chains.keys()):
                    if sess not in want:
                        self._release_chain(self.chains.pop(sess))
                        self.info.pop(sess, None)
                for sess in want:
                    c = self._chain(sess)
                    if c:
                        self._push(c, sess)
                self.last_apply_signature = signature
                self.last_apply_sessions = list(want)
            except Exception as e:
                self.errs["apply"] = type(e).__name__ + ": " + str(e)[:80]
                self._log("ERROR", "применение аудиоэффектов: " + self.errs["apply"])

    # ------------------------------------------------------------------ интерфейс
    def _set(self, key, val):
        self.set_setting(key, val)
        self._apply()
        self.refresh()

    def _switch_cb(self, key):
        def cb(v):
            self._set(key, bool(v))
        return cb

    def _reset_cb(self):
        hz, lo, hi = self._layout()
        self._save_levels(hz, [0.0] * len(hz))
        for k in ("eq_bass", "eq_virt", "eq_loud"):
            self.set_setting(k, 0.0)
        self._apply()
        self.refresh()

    def _status(self):
        if not self._on():
            return "Выключен"
        if not self.chains:
            err = ""
            for k, v in self.errs.items():
                if k == "server" or (isinstance(k, tuple) and k[1] in ("eq", "dp")):
                    err = v
                    break
            return "Эффекты недоступны" + ((": " + err) if err else "")
        parts = []
        for sess, c in self.chains.items():
            eng, n = self.info.get(sess, ("eq", 0))
            if eng == "dp":
                desc = "%d полос · DynamicsProcessing" % n
            else:
                physical = int(self.meta.get("n", 0)) if self.meta else 0
                requested = self._nb()
                desc = ("системный EQ · профиль %d → %d аппаратных полос" % (requested, physical)) if requested > 0 and physical > 0 else "системный EQ"
            parts.append(("глобальная" if sess == 0 else "сессия " + str(sess)) + ": " + desc)
        return "Работает · " + " · ".join(parts)

    def screen_dolphy_eq(self, ui, api, state):
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"

        def sl(label, val, lo, hi, cb):
            return ui.column([
                ui.text(label, "titleSmall", W),
                ui.slider(val, cb, lo, hi, "", max(0, int(hi - lo) - 1)),
            ], 0, 2)

        bass = int(self._f("eq_bass", 0))
        virt = int(self._f("eq_virt", 0))
        loud = int(self._f("eq_loud", 0))
        items = [
            ui.text("Эквалайзер", "titleLarge", W),
            ui.text(self._status(), "bodySmall", W2),
            ui.button("Открыть стеклянный эквалайзер на весь экран", self._open_ui_cb),
            ui.text("На весь экран страница не прокручивается и можно вести несколько полос сразу разными пальцами. "
                    "Двойное касание полосы — сброс в 0.", "bodySmall", W2),
            ui.column([
                ui.text("Включить эквалайзер", "titleSmall", W),
                ui.switch(self._on(), self._switch_cb("eq_on"), "", ""),
            ], 0, 2),
        ]
        items += [
            ui.text("Эффекты", "titleMedium", W),
            sl("Бас: %d %%" % (bass // 10), bass // 10, 0, 100, lambda v: self._set("eq_bass", float(v) * 10.0)),
            sl("Виртуализатор: %d %%" % (virt // 10), virt // 10, 0, 100, lambda v: self._set("eq_virt", float(v) * 10.0)),
            sl("Усиление громкости: +%.1f дБ" % (loud / 100.0), loud // 10, 0, 150, lambda v: self._set("eq_loud", float(v) * 10.0)),
            ui.text("Сессии", "titleMedium", W),
            ui.column([
                ui.text("Глобальная сессия (все приложения)", "titleSmall", W),
                ui.switch(bool(self.get_setting("eq_global", True)), self._switch_cb("eq_global"), "", ""),
            ], 0, 2),
            ui.column([
                ui.text("Подхватывать сессии играющих плееров", "titleSmall", W),
                ui.switch(bool(self.get_setting("eq_auto", True)), self._switch_cb("eq_auto"), "", ""),
            ], 0, 2),
            ui.button("Сбросить всё", self._reset_cb),
            ui.spacer(40),
        ]
        return ui.scaffold(title="Эквалайзер", content=ui.lazy_column(items, 16, 12))
