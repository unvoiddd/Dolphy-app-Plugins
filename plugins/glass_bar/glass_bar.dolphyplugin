    def _bx_text(self, fmt, v):
        if fmt == "ior":
            return "%.2f" % (1.0 + (float(v) - 100.0) / 100.0)
        if fmt == "deg":
            return str(int(v)) + "\u00b0"
        return str(int(v))

    def screen_glass_beta(self, ui, api, state):
        self._read_settings()
        if not self.preview:
            self.preview = True
            if self.handler is not None:
                self._post(self._sync, 0)
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"
        P = {}
        for item in BETA_PARAMS:
            P[item[0]] = item

        def sl(key):
            _k, label, lo, hi, steps, dflt, fmt = P[key]
            val = float(self.bx.get(key, dflt))
            return ui.column([
                ui.text(label + ": " + self._bx_text(fmt, val), "titleSmall", W),
                ui.slider(val, self._slider_cb(key), lo, hi, "", max(0, int(hi - lo) - 1)),
            ], 0, 2)

        head = [
            ui.text("Реалистичное стекло", "titleMedium", W),
            ui.text("Отдельный физический шейдер: преломление по закону Снеллиуса с дисперсией, Френель, отражения, блики и каустика. При включении все обычные настройки стекла отключаются (их значения сохраняются), при выключении возвращается прежний шейдер.", "bodySmall", W2),
            ui.switch(self.beta_enabled, self._beta_toggle_cb, "", ""),
        ]
        if self.beta_failed:
            head.append(ui.text("Бета-шейдер не удалось скомпилировать на этом устройстве, используется обычный. Подробности в окне логов.", "bodySmall", "#FFFFB4A9"))
        cards = [
            ui.card([
                ui.text("Новогодний бар", "titleMedium", W),
                ui.text("Снег, сосульки и праздничный декор поверх панели. По умолчанию выключен.", "bodySmall", W2),
                ui.switch(bool(self.get_setting("glass_ny_beta_enabled", False)), self._ny_beta_toggle_cb, "", ""),
            ]),
            ui.card(head),
        ]
        if not self.beta_enabled:
            cards.append(ui.text("Параметры сохраняются, но применяются только при включённом бета-шейдере.", "bodySmall", W2))
        for gtitle, keys in BETA_GROUPS:
            cards.append(ui.card([ui.text(gtitle, "titleMedium", W)] + [sl(k) for k in keys]))
        cards.append(ui.button("Сбросить параметры бета", self._beta_reset_cb))
        cards.append(ui.text("Панель внизу — живой пример: она меняется вместе со слайдерами.", "bodySmall", W2))
        cards.append(ui.spacer(100))
        return ui.scaffold(
            title="Бета · Реалистичное стекло",
            content=ui.lazy_column(cards, 16, 12))

    def screen_glass_settings(self, ui, api, state):
        self._read_settings()
        if not self.preview:
            self.preview = True
            if self.handler is not None:
                self._post(self._sync, 0)
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"

        def sl(label, key, val, lo, hi, steps):
            # свой белый заголовок: у встроенного заголовка слайдера цвет не задаётся
            return ui.column([
                ui.text(label + ": " + str(int(val)), "titleSmall", W),
                ui.slider(val, self._slider_cb(key), lo, hi, "", max(0, int(hi - lo) - 1)),
            ], 0, 2)

        locked = bool(self.get_setting("glass_beta_enabled", False))

        def slx(label, key, val, lo, hi, steps):
            if locked:
                return ui.column([
                    ui.text(label + ": " + str(int(val)) + " · отключено", "titleSmall", "#66FFFFFF"),
                ], 0, 2)
            return sl(label, key, val, lo, hi, steps)

        banner = []
        if locked:
            banner = [ui.card([
                ui.text("Активен бета-шейдер", "titleSmall", W),
                ui.text("Настройки стекла ниже отключены, их значения сохранены. Управление теперь во вкладке «Бета · Реалистичное стекло».", "bodySmall", W2),
                ui.button("Выключить бета-режим", lambda: self._beta_toggle_cb(False)),
            ])]

        return ui.scaffold(
            title="Настройки панели",
            content=ui.lazy_column([
                *banner,
                ui.column([
                    ui.text("Эффект стекла", "titleSmall", W),
                    ui.text("Выключите, чтобы вернуть обычную панель", "bodySmall", W2),
                    ui.switch(bool(self.get_setting("glass_enabled", True)), self._enabled_cb, "", ""),
                ], 0, 2),
                slx("Свечение", "glass_glow_amt", self.glow_amt, 0, 100, 19),
                slx("Тема: 0 Классика · 1 Неон · 2 Фиолет · 3 Белый", "glass_theme", float(self.theme), 0, 3, 2),
                slx("Сила реверберации (преломление)", "glass_refr_amt", self.refr_amt, 0, 150, 14),
                slx("Ширина кромки искажения", "glass_edge_amt", self.edge_amt, 30, 300, 26),
                slx("Радужная кайма", "glass_disp_amt", self.disp_amt, 0, 300, 29),
                slx("Затемнение панели", "glass_tint_amt", self.tint_amt, 0, 200, 19),
                slx("Размытие фона", "glass_blur_amt", self.blur_amt, 0, 300, 29),
                slx("Матирование Frosted Glass", "glass_frost_amt", self.frost_amt, 0, 100, 20),
                slx("Микрозерно матового стекла", "glass_grain_amt", self.grain_amt, 0, 100, 20),
                sl("Желейность", "glass_jelly_amt", self.jelly_amt, 0, 200, 19),
                ui.text("Производительность", "titleMedium", W),
                sl("Масштаб рендера, % (меньше — быстрее)", "glass_scale_amt", self.scale_amt, 25, 100, 14),
                sl("Обновление фона, Гц (в покое)", "glass_fps_amt", self.fps_amt, 10, 120, 10),
                ui.button("Сбросить по умолчанию", self._reset_cb),
                ui.text("Панель внизу — живой пример: она меняется вместе со слайдерами.", "bodySmall", W2),
                ui.spacer(120),
            ], 16, 12))

    def _render_icons(self, sel_idx):
        # Иконки и подписи рисуем в bitmap размером с окно и отдаём шейдеру как второй вход.
        if not self.sh or self.shader is None:
            return
        try:
            from java import jclass, jint
            dp = self.bdp
            Bitmap = jclass("android.graphics.Bitmap")
            Cfg = jclass("android.graphics.Bitmap$Config")
            Canvas = jclass("android.graphics.Canvas")
            Paint = jclass("android.graphics.Paint")
            Align = jclass("android.graphics.Paint$Align")
            bmp = Bitmap.createBitmap(int(self.win_w), int(self.win_h), Cfg.ARGB_8888)
            cv = Canvas(bmp)
            tp = Paint(1)
            tp.setTextAlign(Align.CENTER)
            tp.setTextSize(float(10.5 * self.bk * self.act.getResources().getDisplayMetrics().scaledDensity))
            fm = tp.getFontMetrics()
            asc = float(fm.ascent)
            th = float(fm.descent) - asc
            ip = Paint(1)
            top = self.bar_top + (self.bar_h - (dp(22) + dp(1) + th)) / 2.0
            for i, (route, path_d, label, prefixes) in enumerate(TABS):
                sel = (i == sel_idx)
                cx = self.pad + i * self.tw + self.tw / 2.0
                icon = self._icon(path_d, argb(0xFFF3CCF7) if sel else argb(0xD9FFFFFF))
                cv.drawBitmap(icon, float(cx - dp(11)), float(top), ip)
                icon.recycle()
                tp.setColor(jint(argb(0xFFFFFFFF)))
                cv.drawText(label, float(cx), float(top + dp(22) + dp(1) - asc), tp)
            BS = jclass("android.graphics.BitmapShader")
            TM = jclass("android.graphics.Shader$TileMode")
            self.shader.setInputShader("icons", BS(bmp, TM.CLAMP, TM.CLAMP))
            old_icons = self.icons_bmp
            self.icons_bmp = bmp
            self._recycle_bitmap(old_icons)
            self._push(True)
        except Exception as e:
            self.stage = "icons"
            self._fail(e)

    def _set_lens(self, x, scx, scy):
        self.cur_x, self.cur_sx, self.cur_sy = x, scx, scy
        bub = self.bub
        if bub is None:
            return
        bub.setTranslationX(float(x))
        if self.sh:
            self._push()
        else:
            bub.setScaleX(float(scx))
            bub.setScaleY(float(scy))

    def _push(self, force=False):
        sh = self.shader
        iv = self.glass_iv
        if sh is None or iv is None or self.RE is None:
            return
        try:
            dp = self.bdp
            cx = self.cur_x + self.bub_w / 2.0
            cy = self.bub_top + self.bub_h / 2.0
            g = max(0.0, min(1.0, self.infl * 1.3))
            if self.preview:
                g = 1.0  # в примере линза всегда стеклянная
            jelly_mode = bool(self.get_setting("glass_anim_jelly", False))
            if jelly_mode:
                rest_w = self.tw - dp(6)
                rest_h = self.bub_h - dp(22)
                hw = (rest_w + (self.bub_w - rest_w) * g) * self.cur_sx / 2.0
                hh = (rest_h + (self.bub_h - rest_h) * g) * self.cur_sy / 2.0
            else:
                # Сохраняем исходный размер линзы в спокойном состоянии;
                # при касании и движении её ширина и высота не меняются.
                hw = (self.tw - dp(6)) / 2.0
                hh = (self.bub_h - dp(22)) / 2.0
            v = max(-1.0, min(1.0, self.sv / (self.tw * 8.0))) if self.tw else 0.0
            touch_x_ = self.touch_x if not jelly_mode else 0.0
            touch_y_ = self.touch_y if not jelly_mode else 0.0
            touch_s_ = self.touch_strength if not jelly_mode else 0.0
            key = (round(cx, 1), round(cy, 1), round(hw, 1), round(hh, 1),
                   round(g, 3), round(v, 3), round(touch_x_, 1),
                   round(touch_y_, 1), round(touch_s_, 3),
                   round(time.time() * 30.0) if touch_s_ > 0.01 else 0)
            if key == self.last_push and not force:
                return  # ничего не изменилось — не пересоздаём эффект
            self.last_push = key
            sh.setFloatUniform("bub", float(cx), float(cy), float(hw), float(hh))
            try:
                self._ny_mask(cx, cy, hw, hh)
            except Exception:
                pass
            sh.setFloatUniform("infl", float(g))
            sh.setFloatUniform("vel", float(v))
            sh.setFloatUniform("lean", float(v * 0.22 * self.jelly) if jelly_mode else float(v * 0.08))
            sh.setFloatUniform("touch", float(touch_x_), float(touch_y_), float(touch_s_))
            if self.shader_mode != "beta":
                sh.setFloatUniform("tm", float(time.time() % 1000.0))
            iv.setRenderEffect(self.RE.createRuntimeShaderEffect(sh, "content"))
        except Exception as e:
            self.shader = None
            self._fail(e)

    def _tab_x(self, i):
        return float(self.pad + i * self.tw + (self.tw - self.bub_w) // 2)

    def _idx_at(self, fx):
        i = int(fx // self.tw)
        return max(0, min(len(TABS) - 1, i))

    def _ensure_spring(self):
        if self.bub is None or self.anim is not None or bool(self.get_setting("glass_reduce_motion", False)):
            return
        import time
        from java import jclass, jarray, jfloat
        self.sx = float(self.bub.getTranslationX())
        self.sv = 0.0
        self.infl = 0.0
        self.last_t = time.time()
        VA = jclass("android.animation.ValueAnimator")
        anim = VA.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(1000)
        anim.setRepeatCount(-1)
        anim.setInterpolator(jclass("android.view.animation.LinearInterpolator")())
        anim.addUpdateListener(self.Upd(self._spring_step))
        anim.start()
        self.anim = anim

    def _on_touch(self, e):
        # Нажатие: линза надувается под пальцем. Движение: линза следует за пальцем
        # (через пружину). Отпускание: выбирается вкладка под пальцем.
        try:
            if self.row is None or self.bub is None:
                return False
            act = int(e.getActionMasked())
            x = float(e.getX())
            y = float(e.getY())
            if act == 0:
                if self.pressed:
                    # Новый DOWN без завершающего UP означает потерянное касание
                    # (часто при быстрой смене Activity/перекрытии окон).
                    self._log("touch: сброшено незавершённое предыдущее касание")
                    self.pressed = False
                    self.dragging = False
                    self.touch_strength = 0.0
                    self.hover = None
                self.touch_x = float(self.pad + x)
                self.touch_y = float(self.bar_top + y)
                self.touch_strength = 1.0
                self.pressed = True
                self.dragging = False
                self.down_x = x
                self.down_y = y
                self.drag_nav_idx = None
                self.hover = self._idx_at(x)
                try:
                    # не даём родителю/хосту перехватить жест, пока палец ведёт линзу
                    p_ = self.row.getParent()
                    if p_ is not None:
                        p_.requestDisallowInterceptTouchEvent(True)
                except Exception:
                    pass
                self._log("touch DOWN tab=" + str(self.hover))
                self.bub_target = self._tab_x(self.hover)
                self._ensure_spring()
                try:
                    self.infl = max(self.infl, 0.6)
                    self._push(force=True)
                except Exception:
                    pass
                return True
            if act == 2:
                if not self.pressed:
                    return True
                self.touch_x = float(self.pad + x)
                self.touch_y = float(self.bar_top + y)
                self.touch_strength = 1.0
                self._push()
                if not self.dragging and abs(x - self.down_x) > self.dp(6):
                    self.dragging = True
                    self._log("drag: старт x=" + str(int(x)) + " (из " + str(int(self.down_x)) + ")")
                    self._ensure_spring()
                if self.dragging:
                    lo = self.pad - self.dp(4)
                    hi = self.pad + self.w_bar - self.bub_w + self.dp(4)
                    lx = self.pad + x - self.bub_w / 2.0
                    self.bub_target = float(max(lo, min(hi, lx)))
                    self._ensure_spring()
                    if self.anim is None:
                        # аниматор недоступен (например, «Уменьшить движение»): двигаем линзу напрямую
                        self._set_lens(self.bub_target, 1.0, 1.0)
                    idx = self._idx_at(x)
                    if idx != self.hover:
                        # Во время жеста только подсвечиваем целевую вкладку и
                        # двигаем линзу. Реальную навигацию выполняем один раз на UP.
                        self.hover = idx
                        self._fill_tabs(idx, move=False)
                return True
            if act == 1 or act == 3:
                if not self.pressed:
                    self._log("touch: запоздавший UP/CANCEL без активного DOWN пропущен")
                    return True
                self.touch_x = float(self.pad + x)
                self.touch_y = float(self.bar_top + y)
                self.pressed = False
                was_drag = self.dragging
                self.dragging = False
                self.hover = None
                try:
                    p_ = self.row.getParent() if self.row is not None else None
                    if p_ is not None:
                        p_.requestDisallowInterceptTouchEvent(False)
                except Exception:
                    pass
                if self.touch_strength > 0.0:
                    self._ensure_spring()
                # Некоторые устройства (жесты навигации у нижнего края, оверлеи) присылают
                # ACTION_CANCEL вместо ACTION_UP. Если палец почти не сдвинулся, это тап.
                tap_cancel = (act == 3 and not was_drag
                              and abs(x - self.down_x) < self.dp(10)
                              and abs(y - self.down_y) < self.dp(10))
                self._log(("touch UP" if act == 1 else ("touch CANCEL→tap" if tap_cancel else "touch CANCEL"))
                          + " dx=" + str(int(x - self.down_x)) + " dy=" + str(int(y - self.down_y)))
                if act == 1 or tap_cancel:
                    idx = self._idx_at(self.down_x if tap_cancel else x)
                    self._fill_tabs(idx)
                    self._ensure_spring()
                    # Один переход после завершения касания/свайпа.
                    self._log(("drag: завершён, вкладка " if was_drag else "tap: вкладка ") + str(idx))
                    self._go(idx)
                else:
                    self._fill_tabs()
                    self._ensure_spring()
                return True
            return True
        except Exception as ex:
            self._fail(ex)
            return False

    # ------------------------------------------------------------------ окно логов
    def _log(self, msg):
        try:
            t = time.time()
            self.logs.append(time.strftime("%H:%M:%S", time.localtime(t)) + "." + ("%03d" % int((t % 1.0) * 1000))
                             + " " + str(msg))
            if len(self.logs) > 400:
                del self.logs[:100]
            self.log_dirty = True
        except Exception:
            pass

    def _drain_eq_logs(self):
        """Import queued Dolphy EQ messages into this plugin's normal log buffer."""
        try:
            now = time.time()
            if now - self.eq_log_poll_t < 0.5:
                return
            self.eq_log_poll_t = now
            prefs = self.api.getContext().getSharedPreferences("dolphy_cross_plugin_state", 0)
            raw = str(prefs.getString("dolphy_eq_log_queue", "[]"))
            queue = json.loads(raw)
            if not isinstance(queue, list) or not queue:
                return
            # Clear only after successfully decoding; EQ writes into the same small queue.
            prefs.edit().putString("dolphy_eq_log_queue", "[]").apply()
            accepted = 0
            for item in queue[-80:]:
                if not isinstance(item, dict):
                    continue
                level = str(item.get("level", "INFO")).upper()[:8]
                msg = str(item.get("msg", ""))[:700]
                stamp = float(item.get("ts", now))
                dt = time.localtime(stamp)
                ms = int((stamp % 1.0) * 1000)
                source_time = time.strftime("%H:%M:%S", dt) + ".%03d" % ms
                self._log("%s [EQ/%s] %s" % (source_time, level, msg))
                self.eq_log_imported += 1
                accepted += 1
            if accepted:
                self._log("EQ log bridge: импортировано " + str(accepted) + " сообщений; всего=" + str(self.eq_log_imported))
        except Exception as ex:
            if not self.log_err_once:
                self.log_err_once = True
                self._log("WARN импорт логов EQ: " + type(ex).__name__ + ": " + str(ex)[:100])

    def _log_device(self):
        try:
            from java import jclass
            B = jclass("android.os.Build")
            self._log("устройство: " + str(B.MANUFACTURER) + " " + str(B.MODEL) + ", Android "
                      + str(jclass("android.os.Build$VERSION").RELEASE) + " (SDK "
                      + str(jclass("android.os.Build$VERSION").SDK_INT) + ")")
        except Exception as e:
            self._log("устройство: не удалось получить (" + str(e)[:80] + ")")

    def _request_copy(self, key, window, rect, bmp):
        from java import jclass
        generation = self.ui_generation
        self.copy_sequence += 1
        token = self.copy_sequence
        bid = id(bmp)
        self.copy_inflight[bid] = bmp
        def finished(result):
            self.copy_callbacks.pop(token, None)
            self.copy_inflight.pop(bid, None)
            retired = self.copy_retired.pop(bid, None)
            if generation != self.ui_generation:
                self._recycle_bitmap(bmp)
                return
            try:
                self._on_copy(key, result)
            finally:
                if retired is not None:
                    self._recycle_bitmap(retired)
        cb = self.Pcl(finished)
        self.copy_callbacks[token] = cb
        try:
            # PixelCopy нельзя вызывать, пока окно Activity пересоздаётся:
            # Android в этот момент может не иметь backing Surface.
            decor = window.getDecorView()
            if (decor is None or not decor.isAttachedToWindow()
                    or decor.getWindowToken() is None
                    or int(decor.getWidth()) <= 0 or int(decor.getHeight()) <= 0):
                raise RuntimeError("Activity window is not attached")
            jclass("android.view.PixelCopy").request(window, rect, bmp, cb, self.handler)
        except Exception as ex:
            self.copy_callbacks.pop(token, None)
            self.copy_inflight.pop(bid, None)
            retired = self.copy_retired.pop(bid, None)
            self.busy[key] = False
            if self.pending.get(key) is bmp:
                self.pending.pop(key, None)
            self._recycle_bitmap(bmp)
            if retired is not None:
                self._recycle_bitmap(retired)
            # IllegalArgumentException: Window doesn't have a backing surface!
            # Это штатная гонка при смене Activity; ставим паузу и продолжаем позже.
            self.copy_pause_until = max(getattr(self, "copy_pause_until", 0.0), time.time() + 0.85)
            if "backing surface" not in str(ex).lower() and "not attached" not in str(ex).lower():
                if not getattr(self, "copy_req_err_once", False):
                    self.copy_req_err_once = True
                    self._log("WARN PixelCopy request[" + str(key) + "]: " + type(ex).__name__ + ": " + str(ex)[:100])

    def _recycle_bitmap(self, bmp):
        # Намеренно НЕ вызываем Bitmap.recycle(): bitmap мог остаться в ImageView/шейдере, и отрисовка
        # следующего кадра падала бы с «Canvas: trying to use a recycled bitmap» (вылет приложения).
        # Достаточно отпустить ссылку — память освободит сборщик мусора.
        return

    def _recycle_bitmaps(self, bitmaps):
        if bitmaps is None:
            return
        for bmp in list(bitmaps):
            self._recycle_bitmap(bmp)

    def _copy_logs(self):
        try:
            head = "Glass Bar " + str(globals().get("__version__", "?")) + " — логи (" + str(len(self.logs)) + " строк)\n"
            ok = self.api.getAndroid().clipboardSet(head + "\n".join(self.logs))
            self._log("логи скопированы" if ok else "WARN clipboardSet вернул false")
            self.toast("Логи скопированы (" + str(len(self.logs)) + ")" if ok else "GlassBar: не удалось скопировать логи")
        except Exception as e:
            self._log("ERR копирование: " + str(e)[:120])
            try:
                self.toast("GlassBar: не удалось скопировать логи")
            except Exception:
                pass

    def _clear_logs(self):
        self.logs = []
        self._log("логи очищены")

    def _hide_logs(self):
        self.set_setting("glass_logs", False)
        self._log("окно логов скрыто (включить: Настройки → Glass Bar → Окно логов)")
        self._sync_log()

    def _setup_log(self, act, w, base):
        self.logw = None
        if not self.get_setting("glass_logs", True):
            return
        from java import jclass, jarray, jint
        dp = self.dp
        Dialog = jclass("android.app.Dialog")
        FrameLayout = jclass("android.widget.FrameLayout")
        LinearLayout = jclass("android.widget.LinearLayout")
        ScrollView = jclass("android.widget.ScrollView")
        TextView = jclass("android.widget.TextView")
        ImageView = jclass("android.widget.ImageView")
        View = jclass("android.view.View")
        GD = jclass("android.graphics.drawable.GradientDrawable")
        GDO = jclass("android.graphics.drawable.GradientDrawable$Orientation")
        ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
        Typeface = jclass("android.graphics.Typeface")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        LLP = jclass("android.widget.LinearLayout$LayoutParams")
        pw = int(w)
        ph = dp(150)
        inset = dp(5)

        dlg = Dialog(act)
        dlg.requestWindowFeature(1)
        root = FrameLayout(act)
        iv = None
        if self.sh:
            iv = ImageView(act)
            iv.setScaleType(ImageView.ScaleType.FIT_XY)
            root.addView(iv, FLP(-1, -1))
            rs = jclass("android.graphics.RuntimeShader")(AGSL_LOG)
            rs.setFloatUniform("res", float(pw), float(ph))
            rs.setFloatUniform("dpx", float(self.dens))
            iv.setRenderEffect(self.RE.createRuntimeShaderEffect(rs, "content"))

        tint = View(act)
        tg = GD()
        tg.setOrientation(GDO.TOP_BOTTOM)
        if self.sh:
            cols = [0x70221C2A, 0x8C15121B]
        else:
            cols = [0xD0221C2A, 0xE015121B]
        tg.setColors(jarray(jint)([argb(c) for c in cols]))
        tg.setCornerRadius(float(dp(20)))
        tg.setStroke(max(1, dp(1)), argb(0x55FFFFFF))
        tint.setBackground(tg)
        tlp = FLP(-1, -1)
        tlp.setMargins(inset, inset, inset, inset)
        root.addView(tint, tlp)

        col = LinearLayout(act)
        col.setOrientation(1)
        clp = FLP(-1, -1)
        clp.setMargins(inset + dp(12), inset + dp(8), inset + dp(12), inset + dp(8))
        root.addView(col, clp)

        head = LinearLayout(act)
        head.setOrientation(0)
        head.setGravity(16)
        title = TextView(act)
        title.setText("Логи")
        title.setTextColor(argb(0xFFFFFFFF))
        title.setTextSize(11.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        head.addView(title, LLP(0, -2, 1.0))
        refs = []

        def mk_btn(label, fn):
            b = TextView(act)
            b.setText(label)
            b.setTextColor(argb(0xFFF3CCF7))
            b.setTextSize(10.0)
            b.setGravity(17)
            b.setPadding(dp(8), dp(3), dp(8), dp(3))
            bg = GD()
            bg.setColor(argb(0x33FFFFFF))
            bg.setCornerRadius(float(dp(10)))
            bg.setStroke(max(1, dp(1)), argb(0x44FFFFFF))
            b.setBackground(bg)
            b.setClickable(True)
            cl = self.Clk(fn)
            refs.append(cl)
            b.setOnClickListener(cl)
            lp = LLP(-2, -2)
            lp.leftMargin = dp(4)
            head.addView(b, lp)

        mk_btn("Копировать", self._copy_logs)
        mk_btn("Очистить", self._clear_logs)
        mk_btn("✕", self._hide_logs)
        col.addView(head, LLP(-1, -2))

        sv = ScrollView(act)
        sv.setVerticalScrollBarEnabled(False)
        body = TextView(act)
        body.setTextColor(argb(0xE6FFFFFF))
        body.setTextSize(9.0)
        body.setTypeface(Typeface.MONOSPACE)
        body.setPadding(0, dp(4), 0, 0)
        sv.addView(body)
        col.addView(sv, LLP(-1, 0, 1.0))

        dlg.setContentView(root, FLP(pw, ph))
        win = dlg.getWindow()
        win.setBackgroundDrawable(ColorDrawable(0))
        win.clearFlags(2)
        win.addFlags(8 | 32)  # NOT_FOCUSABLE | NOT_TOUCH_MODAL: кнопки нажимаются, остальное пропускает касания
        win.setLayout(pw, ph)
        win.setGravity(80 | 1)
        lp = win.getAttributes()
        lp.y = dp(70)
        lp.windowAnimations = 0
        win.setAttributes(lp)
        self.logw = {"dlg": dlg, "root": root, "iv": iv, "tv": body, "sv": sv, "title": title, "refs": refs,
                     "shown": False, "bufs": None, "idx": 0, "pidx": 0, "last": 0.0,
                     "base": int(base) + dp(3), "pw": pw, "ph": ph}
        self.log_dirty = True

    def _place_log(self):
        lw = self.logw
        if lw is None or self.dlg is None:
            return
        want = int(self.dlg.getWindow().getAttributes().y) + lw["base"]
        win = lw["dlg"].getWindow()
        lp = win.getAttributes()
        if int(lp.y) != want:
            lp.y = want
            win.setAttributes(lp)

    def _sync_log(self):
        lw = self.logw
        if lw is None:
            return
        want = bool(self.shown) and bool(self.get_setting("glass_logs", True))
        if want and not lw["shown"]:
            self._place_log()
            lw["dlg"].show()
            lw["shown"] = True
            self.log_dirty = True
        elif not want and lw["shown"]:
            lw["dlg"].hide()
            lw["shown"] = False

    def _flush_log(self):
        lw = self.logw
        if lw is None or not lw["shown"] or not self.log_dirty:
            return
        now = time.time()
        if now - self.log_flush_t < 0.25:
            return
        self.log_flush_t = now
        self.log_dirty = False
        tv = lw["tv"]
        sv = lw["sv"]
        tv.setText("\n".join(self.logs[-120:]))
        lw["title"].setText("Логи · " + str(len(self.logs)))
        self._post(lambda: sv.scrollTo(0, int(tv.getHeight())), 0)

    def _capture_log(self):
        if time.time() < max(getattr(self, "nav_quiet", 0.0), getattr(self, "copy_pause_until", 0.0)):
            return
        lw = self.logw
        if lw is None or not lw["shown"] or lw["iv"] is None or self.busy.get("log"):
            return
        now = time.time()
        if now - lw["last"] < 1.0 / max(10.0, self.fps_amt):
            return
        root = lw["root"]
        if int(root.getWidth()) <= 0:
            return
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        loc = jarray(jint)([0, 0])
        dloc = jarray(jint)([0, 0])
        root.getLocationOnScreen(loc)
        decor.getLocationOnScreen(dloc)
        l = max(0, int(loc[0] - dloc[0]))
        t = max(0, int(loc[1] - dloc[1]))
        r = min(int(decor.getWidth()), int(loc[0] - dloc[0]) + int(root.getWidth()))
        b = min(int(decor.getHeight()), int(loc[1] - dloc[1]) + int(root.getHeight()))
        if r - l < 16 or b - t < 16:
            return
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        bufs = lw["bufs"]
        if bufs is None or int(bufs[0].getWidth()) != r - l or int(bufs[0].getHeight()) != b - t:
            self._recycle_bitmaps(bufs)
            bufs = [Bitmap.createBitmap(r - l, b - t, Cfg.ARGB_8888), Bitmap.createBitmap(r - l, b - t, Cfg.ARGB_8888)]
            lw["bufs"] = bufs
            lw["idx"] = 1
        pidx = 1 if lw["idx"] == 0 else 0
        lw["pidx"] = pidx
        lw["last"] = now
        self.pending["log"] = bufs[pidx]
        self.busy["log"] = True
        self._request_copy("log", self.act.getWindow(), jclass("android.graphics.Rect")(l, t, r, b), bufs[pidx])

    def _go(self, idx):
        # Переход только при смене вкладки. Повторные тапы/дублирующиеся UP
        # не должны перезагружать текущий экран и провоцировать teardown Activity.
        route = TABS[idx][0]
        changed = idx != self._sel_index()
        now = time.time()
        if not changed:
            self._log("tap: уже открыта вкладка " + route + " — без повторной навигации")
            self.nav_pending = None
            return
        if now - self._last_go_t < 0.16:
            self._log("tap: слишком быстрый повторный переход на " + route + " подавлен")
            return
        self._last_go_route = route
        self._last_go_t = now
        self._log("navigate_app('" + route + "') из " + str(self.route or "-"))
        self.last_nav_call = now
        self.navigate_app(route)
        self.nav_pending = (route, time.time(), 0)

    def _sync(self):
        if self.dlg is None:
            return
        try:
            self._sync_ovs()
            self._fill_tabs()
            if self._route_visible():
                if not self.shown:
                    self.dlg.show()
                    self.shown = True
            else:
                if self.shown:
                    self.dlg.hide()
                    self.shown = False
            self._sync_log()
        except Exception as e:
            self.stage = "sync"
            self._fail(e)

    def _teardown_ui(self):
        self.pm_wave_pending = False
        self.pm_wave_t0 = None
        self.ui_generation += 1
        self.tick_running = False
        try:
            self.choreo.getInstance().removeFrameCallback(self.frame_cb)
        except Exception:
            pass
        self._tilt_stop()
        self.tab_views = []
        lw = self.logw
        self.logw = None
        if lw is not None:
            try:
                lw["dlg"].dismiss()
            except Exception:
                pass
            self._recycle_bitmaps(lw.get("bufs"))
        self._scr_kill()
        ovs = self.ovs
        self.ovs = {}
        self.ov_route = ""
        for o in ovs.values():
            try:
                o["dlg"].dismiss()
            except Exception:
                pass
        dlg = self.dlg
        self.dlg = None
        self.root = None
        self.row = None
        if self.anim is not None:
            try:
                self.anim.cancel()
            except Exception:
                pass
        self.anim = None
        self.bub = None
        self.glass_iv = None
        self.shader = None
        self.sh = False
        self.bub_target = None
        self.targets = {}
        self.shown = False
        self.busy = {}
        self._recycle_bitmaps(self.rendered.values())
        self.rendered = {}
        self._recycle_bitmaps(self.pending.values())
        self.pending = {}
        self._recycle_bitmaps(self.bufs)
        self.bufs = None
        self._recycle_bitmap(self.icons_bmp)
        self.icons_bmp = None
        self.cap_rect = None
        self.cur_idx = -1
        self.last_push = None
        if dlg is not None:
            try:
                dlg.dismiss()
            except Exception:
                pass

    # ------------------------------------------------------------------ блюр
    def _governor(self):
        # Авто-качество: если во время движения кадров мало (<~45/с), снижаем эффекты на один уровень
        now = time.time()
        dt = now - self.gv_t
        self.gv_t = now
        if not self.gv_on or self.q_tier >= 3 or dt <= 0 or dt > 0.25:
            self.gv_buf = []
            return
        busy = self.pressed or self.infl > 0.05 or getattr(self, "scr_infl", 0.0) > 0.05
        if not busy:
            self.gv_buf = []
            return
        self.gv_buf.append(dt)
        if len(self.gv_buf) < 36:
            return
        avg = sum(self.gv_buf) / len(self.gv_buf)
        self.gv_buf = []
        if avg > 0.022 and now > self.gv_cool:
            self.q_tier += 1
            self.gv_cool = now + 4.0
            self._log("авто-качество: уровень " + str(self.q_tier) + " (кадр " + str(int(avg * 1000)) + " мс)")
            self._read_settings()
            self._apply_live()
            if self.q_tier >= 2 and self.shader_mode == "beta" and self.handler is not None:
                self._post(self._setup, 0)

    def _tick(self):
        if not self.alive or not self.tick_running:
            return
        if time.time() - getattr(self, "_nys_t", 0.0) > 1.0:
            self._nys_t = time.time()
            try:
                self._ny_sync()
            except Exception:
                pass
        try:
            self._governor()
        except Exception:
            pass
        if self.anim is None and self.bub is not None and self.bub_target is not None:
            try:
                self._spring_step(0.0)
            except Exception as sx_:
                self._log("ERR линза (кадр): " + type(sx_).__name__ + ": " + str(sx_)[:120])
        try:
            if (not self.native_ok and not self.err and not self.err_shown
                    and self.get_setting("glass_enabled", True) and time.time() - self.t0 > 5.0):
                self.err_shown = True
                self.err = "[" + str(self.stage) + "] настройка не завершилась"
                self.refresh()
        except Exception:
            pass
        try:
            pend = self.nav_pending
            if pend is not None and self._route_matches_target(self.route, pend[0]):
                self.nav_pending = None
                pend = None
            if (pend is not None and pend[0] == getattr(self, "_last_go_route", None)
                    and time.time() - pend[1] > 1.0):
                try:
                    focus = str(self.act.hasWindowFocus()) if self.act is not None else "?"
                except Exception:
                    focus = "?"
                if pend[2] < 1:
                    # хост мог проглотить первый вызов: повторяем один раз (если переход всё же случился,
                    # on_navigation уже сбросил ожидание и сюда мы не попадём)
                    self._log("WARN нет подтверждения за 1 с, повтор navigate_app('" + pend[0]
                              + "') route=" + str(self.route) + " focus=" + focus)
                    self.nav_pending = (pend[0], time.time(), 1)
                    self.last_nav_call = time.time()
                    self.navigate_app(pend[0])
                else:
                    self.nav_pending = None
                    self._log("WARN переход на " + pend[0] + " не подтверждён и после повтора, route="
                              + str(self.route) + " focus=" + focus)
                    self.toast("GlassBar: переход на «" + pend[0] + "» не произошёл (route=" + str(self.route) + ")")
        except Exception:
            pass
        try:
            self._drain_eq_logs()
            if self.logw is not None:
                now_ = time.time()
                if now_ - self.log_place_t > 0.25:
                    self.log_place_t = now_
                    self._place_log()
                self._flush_log()
                self._capture_log()
        except Exception as lex:
            self.busy["log"] = False
            if not self.log_err_once:
                self.log_err_once = True
                self._log("ERR tick панели логов: " + type(lex).__name__ + ": " + str(lex)[:160])
        try:
            if self.dlg is not None:
                now_g = time.time()
                if now_g - self.geo_t > 0.2:
                    self.geo_t = now_g
                    self._check_geometry()
                    if self.dlg is not None and self.shown:
                        self._adjust_position()
                for key in tuple(self.targets.keys()):
                    self._capture(key)
        except Exception:
            for k in list(self.busy.keys()):
                self.busy[k] = False
        try:
            self._pm_wave_tick(time.time())
            self._anim_ovs()
            self._fx_all()
            for k in ("btn", "ttl"):
                self._capture_ov(k)
        except Exception:
            self.busy["btn"] = False
            self.busy["ttl"] = False
        try:
            self._scr_tick()
        except Exception as sx:
            self._scr_fail(sx)
        try:
            if self.alive and self.tick_running:
                self.choreo.getInstance().postFrameCallback(self.frame_cb)
        except Exception:
            pass

    def _check_geometry(self):
        # Activity может изменить размер без пересоздания плагина: поворот,
        # split-screen, свободное окно или появление системной навигации.
        # Основное окно панели нельзя надёжно растянуть на месте, поэтому при
        # устойчивом изменении геометрии пересобираем его целиком.
        if self.act is None or self.dlg is None or self.geom_pending:
            return
        try:
            decor = self.act.getWindow().getDecorView()
            w = int(decor.getWidth())
            h = int(decor.getHeight())
            if w <= 0 or h <= 0:
                return
            from java import jarray, jint
            loc = jarray(jint)([0, 0])
            decor.getLocationOnScreen(loc)
            inset = 0
            ins = decor.getRootWindowInsets()
            if ins is not None:
                inset = int(ins.getSystemWindowInsetBottom())
            sig = (w, h, int(loc[0]), int(loc[1]), inset)
            old = self.geom_sig
            if old is None:
                self.geom_sig = sig
                return
            if old == sig:
                return
            now = time.time()
            if now - self.geom_last < 0.8:
                return
            self.geom_last = now
            self.geom_sig = sig
            self.geom_pending = True
            self._log("геометрия Activity изменилась: " + str(old) + " → " + str(sig) + "; пересборка")
            self._post(self._setup, 0)
        except Exception as e:
            self._log("ERR проверка геометрии: " + type(e).__name__ + ": " + str(e)[:120])

    def _adjust_position(self):
        # Если окно оказалось под системной навигацией, поднимаем его.
        if self.adjusted >= 3 or self.root is None or self.root.getWidth() <= 0:
            return
        from java import jarray, jint
        decor = self.act.getWindow().getDecorView()
        loc = jarray(jint)([0, 0])
        dloc = jarray(jint)([0, 0])
        self.root.getLocationOnScreen(loc)
        decor.getLocationOnScreen(dloc)
        bottom_gap = (dloc[1] + decor.getHeight()) - (loc[1] + self.root.getHeight())
        inset = 0
        ins = decor.getRootWindowInsets()
        if ins is not None:
            inset = int(ins.getSystemWindowInsetBottom())
        desired = inset + self.dp(2)
        diff = desired - bottom_gap
        self.adjusted += 1
        if abs(diff) > self.dp(4):
            win = self.dlg.getWindow()
            lp = win.getAttributes()
            lp.y = int(lp.y + diff)
            win.setAttributes(lp)

    def _mk_ov(self, act, src, x, y, w, h):
        from java import jclass
        Dialog = jclass("android.app.Dialog")
        FL = jclass("android.widget.FrameLayout")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        IV = jclass("android.widget.ImageView")
        ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
        d = Dialog(act)
        d.requestWindowFeature(1)
        root = FL(act)
        iv = IV(act)
        iv.setScaleType(IV.ScaleType.FIT_XY)
        root.addView(iv, FLP(-1, -1))
        d.setContentView(root, FLP(w, h))
        win = d.getWindow()
        win.setBackgroundDrawable(ColorDrawable(0))
        win.clearFlags(2)
        win.addFlags(8 | 16 | 32 | 256 | 512)  # не фокусируется, не ловит касания, поверх всего экрана
        win.setLayout(w, h)
        win.setGravity(51)  # TOP | LEFT
        lp = win.getAttributes()
        lp.x = int(x)
        lp.y = int(y)
        lp.windowAnimations = 0
        win.setAttributes(lp)
        sh = jclass("android.graphics.RuntimeShader")(src)
        sh.setFloatUniform("res", float(w), float(h))
        sh.setFloatUniform("dpx", float(self.dens))
        iv.setRenderEffect(self.RE.createRuntimeShaderEffect(sh, "content"))
        return {"dlg": d, "iv": iv, "x": int(x), "y": int(y), "w": int(w), "h": int(h),
                "shown": False, "last": 0.0, "sh": sh,
                "p": 0.0, "pv": 0.0, "fxk": None, "fx_t": 0.0,
                "root": root, "wf": float(w), "xf": float(x), "tw": None, "tx": 0.0, "fit_t": 0.0,
                "probe_at": None, "probe_n": 0}

    def _setup_ovs(self, act):
        # Стеклянные накладки поверх родных элементов (положение — доля ширины экрана, как в Dolphy)
        self.fx_on = bool(self.get_setting("glass_fx", True)) and not self.get_setting("glass_reduce_motion", False)
        self._log("анимация верхних элементов: " + ("вкл" if self.fx_on else "выкл"))
        if not self.sh:
            return
        dp = self.dp
        W = int(act.getWindow().getDecorView().getWidth()) or int(act.getResources().getDisplayMetrics().widthPixels)
        pad = 2 * dp(6)
        try:
            if self.get_setting("glass_btn", True):
                D, bx_, by_ = self._btn_geom(W)
                self.ovs["btn"] = self._mk_ov(act, AGSL_BTN, bx_, by_, D, D)
            if self.get_setting("glass_ttl", True):
                tw_ = int(0.50 * W) + pad
                th_ = int(0.105 * W) + pad
                self.ovs["ttl"] = self._mk_ov(act, AGSL_TTL, 0.5 * W - tw_ / 2.0, 0.164 * W - th_ / 2.0, tw_, th_)
        except Exception as e:
            try:
                self.toast("GlassBar накладки: " + str(e)[:100])
            except Exception:
                pass

    def _btn_geom(self, W):
        # базовое положение — доли ширины экрана, плюс ручная подстройка (dp и %)
        pad = 2 * self.dp(6)
        k = max(0.5, self._fval("glass_btn_sz", 100.0) / 100.0)
        D = int(0.084 * W * k) + pad
        x = 0.0755 * W - D / 2.0 + self._fval("glass_btn_dx", 0.0) * self.dens
        y = 0.164 * W - D / 2.0 + self._fval("glass_btn_dy", 0.0) * self.dens
        return D, x, y

    def _btn_apply_calib(self):
        o = self.ovs.get("btn")
        if not o or self.act is None:
            return
        try:
            act = self.act
            W = int(act.getWindow().getDecorView().getWidth()) or int(act.getResources().getDisplayMetrics().widthPixels)
            D, x, y = self._btn_geom(W)
            o["x"] = int(x)
            o["y"] = int(y)
            o["w"] = D
            o["h"] = D
            o["wf"] = float(D)
            o["xf"] = float(x)
            win = o["dlg"].getWindow()
            win.setLayout(D, D)
            lp = win.getAttributes()
            lp.x = int(x + float(o.get("off", 0.0)))
            lp.y = int(y)
            win.setAttributes(lp)
            rl = o["root"].getLayoutParams()
            rl.width = D
            rl.height = D
            o["root"].setLayoutParams(rl)
            o["sh"].setFloatUniform("res", float(D), float(D))
            o["effect"] = self.RE.createRuntimeShaderEffect(o["sh"], "content")
            o["iv"].setRenderEffect(o["effect"])
            self._log("кнопка назад: x=" + str(int(x)) + " y=" + str(int(y)) + " размер=" + str(D))
        except Exception as e:
            self._log("ERR подстройка кнопки назад: " + str(e)[:120])

    def _ov_x(self, o):
        o["cx"] = o["x"] + o["off"]
        win = o["dlg"].getWindow()
        lp = win.getAttributes()
        lp.x = int(o["cx"])
        win.setAttributes(lp)

    def _ttl_fixed(self, o):
        # страница «Плагины»: капсула заголовка сразу фиксированного размера (35% ширины), по центру, без подгонки
        W = float(self.act.getWindow().getDecorView().getWidth()) or float(self.act.getResources().getDisplayMetrics().widthPixels)
        tw = 0.35 * W
        tx = W / 2.0 - tw / 2.0
        o["tw"] = tw
        o["tx"] = tx
        o["wf"] = tw
        o["xf"] = tx
        o["probe_at"] = None
        nw = int(round(tw))
        nx = int(round(tx))
        if nw != o["w"] or nx != o["x"]:
            o["w"] = nw
            o["x"] = nx
            o["dlg"].getWindow().setLayout(nw, int(o["h"]))
            lp = o["root"].getLayoutParams()
            lp.width = nw
            o["root"].setLayoutParams(lp)
            o["sh"].setFloatUniform("res", float(nw), float(o["h"]))
            # Создаём RenderEffect только при первом вызове или после пересоздания шейдера
        if o.get("effect") is None:
            o["effect"] = self.RE.createRuntimeShaderEffect(o["sh"], "content")
            o["iv"].setRenderEffect(o["effect"])

    def _is_pm(self):
        return "plugin" in str(self.route).lower()

    def _start_ov_anim(self, o, delay):
        now = time.time()
        if not self.fx_on:
            o["off"] = 0.0
            o["v"] = 0.0
            o["anim"] = False
            o["p"] = 0.0
            o["pv"] = 0.0
            o["probe_at"] = now + 0.1
            self._ov_x(o)
            return
        o["off"] = -float(o["x"] + o["w"])  # старт за левым краем экрана
        o["v"] = 0.0
        o["anim"] = True
        o["p"] = 0.0
        o["pv"] = 0.0
        o["probe_at"] = None
        o["t0"] = now + delay
        o["tl"] = o["t0"]
        self._ov_x(o)

    def _anim_ovs(self):
        # пружина с лёгким перелётом: накладки выезжают слева направо
        now = time.time()
        for o in self.ovs.values():
            if not o.get("anim") or now < o["t0"]:
                continue
            dt = min(now - o["tl"], 1.0 / 30.0)
            o["tl"] = now
            if dt <= 0:
                continue
            n = max(1, int(dt / 0.008))
            h = dt / n
            for _ in range(n):
                o["v"] += (-230.0 * o["off"] - 2.0 * 0.5 * math.sqrt(230.0) * o["v"]) * h
                o["off"] += o["v"] * h
            if abs(o["off"]) < 0.5 and abs(o["v"]) < 5.0:
                o["off"] = 0.0
                o["v"] = 0.0
                o["anim"] = False
                # Plugin Manager has one coordinated five-capsule wave.
                o["pop_kick"] = self.route.lower() != "plugin_manager"
                o["probe_at"] = now + 0.4
                o["probe_n"] = 0
            self._ov_x(o)

    def _fx_ov(self, o, now):
        # Желейная анимация верхних накладок: сплющивание от скорости, наклон,
        # «шлепок» при остановке (пружина масштаба).
        if not o["shown"]:
            return
        iv = o["iv"]
        t_prev = o.get("fx_t", 0.0)
        o["fx_t"] = now
        dt = 0.0 if t_prev <= 0.0 else min(max(now - t_prev, 0.0), 1.0 / 30.0)
        if not self.fx_on:
            if o.get("fxk") is not None:
                o["fxk"] = None
                iv.setScaleX(1.0)
                iv.setScaleY(1.0)
                iv.setRotation(0.0)
            return
        v = float(o.get("v", 0.0)) if o.get("anim") else 0.0
        vn = max(-1.0, min(1.0, v / 5000.0))
        s_ = abs(vn)
        if o.pop("pop_kick", False):
            o["p"] = -0.09
            o["pv"] = 0.0
        pp = o["p"]
        pv = o["pv"]
        if dt > 0.0 and (pp != 0.0 or pv != 0.0):
            n = max(1, int(dt / 0.008))
            h = dt / n
            for _ in range(n):
                pv += (-420.0 * pp - 2.0 * 0.32 * math.sqrt(420.0) * pv) * h
                pp += pv * h
            if abs(pp) < 0.0005 and abs(pv) < 0.02:
                pp = 0.0
                pv = 0.0
            o["p"] = pp
            o["pv"] = pv
        sx = 1.0 + 0.025 * s_ + 0.6 * pp
        sy = 1.0 - 0.16 * s_ + pp
        rot = vn * 2.0
        px, py, _ = self._pm_press(o, now)
        sx *= px
        sy *= py
        key = (round(sx, 3), round(sy, 3), round(rot, 2))
        if key != o.get("fxk"):
            o["fxk"] = key
            iv.setScaleX(float(sx))
            iv.setScaleY(float(sy))
            iv.setRotation(float(rot))

    # --- подгонка ширины капсулы заголовка под текст ---------------------------------
    # Текст заголовка рисует хост, его ширину плагин не знает. Поэтому после выезда капсулы
    # снимаем полосу экрана на уровне заголовка (окна плагина в PixelCopy окна Activity не попадают),
    # находим светлые пиксели текста и растягиваем/сжимаем капсулу по найденным границам.
    def _title_probe(self, o, now):
        pa = o.get("probe_at")
        if pa is None or now < pa or not o["shown"] or self.busy.get("probe"):
            return
        n = int(o.get("probe_n", 0))
        o["probe_n"] = n + 1
        o["probe_at"] = (now + 0.7) if n < 2 else None  # три замера: 0.4, 1.1 и 1.8 с после выезда
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        dw = int(decor.getWidth())
        t = max(0, int(o["y"]) - int(dloc[1]))
        bt = min(int(decor.getHeight()), t + int(o["h"]))
        if dw < 64 or bt - t < 16:
            return
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        dest = Bitmap.createBitmap(max(8, dw // 3), max(4, (bt - t) // 3), Cfg.ARGB_8888)
        self.pending["probe"] = dest
        self.busy["probe"] = True
        self.probe_dw = dw
        self._request_copy("probe", self.act.getWindow(), jclass("android.graphics.Rect")(0, t, dw, bt), dest)

    def _on_probe(self, bmp, result):
        o = self.ovs.get("ttl")
        if result != 0 or bmp is None or o is None:
            self._recycle_bitmap(bmp)
            return
        try:
            from java import jarray, jint
            w = int(bmp.getWidth())
            h = int(bmp.getHeight())
            arr = jarray(jint)(w * h)
            bmp.getPixels(arr, 0, w, 0, 0, w, h)
            vals = list(arr)
            bmp.recycle()
            x0 = int(0.14 * w)       # правее кнопки «назад»
            x1 = w - int(0.03 * w)
            cols = [0] * w
            for y in range(h):
                base = y * w
                for x in range(x0, x1):
                    pv = vals[base + x]
                    if max((pv >> 16) & 255, (pv >> 8) & 255, pv & 255) > 110:
                        cols[x] += 1
            hits = [x for x in range(x0, x1) if cols[x] >= 2]
            if not hits:
                self._log("заголовок: текст не найден, ширина капсулы не меняется")
                return
            clusters = []
            start = prev = hits[0]
            for x in hits[1:]:
                if x - prev > 14:
                    clusters.append((start, prev))
                    start = x
                prev = x
            clusters.append((start, prev))
            mid = w / 2.0
            best = min(clusters, key=lambda c: (0.0 if c[0] <= mid <= c[1] else min(abs(c[0] - mid), abs(c[1] - mid))))
            scale = float(self.probe_dw) / float(w)
            text_w = (best[1] - best[0] + 1) * scale
            text_cx = (best[0] + best[1] + 1) / 2.0 * scale
            dp = self.dp
            win_w = text_w + 2 * dp(26) + 2 * dp(5)
            win_w = max(float(dp(130)), min(win_w, float(self.probe_dw - dp(12))))
            cx = max(win_w / 2.0 + dp(6), min(text_cx, self.probe_dw - win_w / 2.0 - dp(6)))
            if "plugin" in str(self.route).lower():
                # страница «Плагины»: капсула всегда фиксированного размера по центру
                win_w = 0.35 * float(self.probe_dw)
                cx = float(self.probe_dw) / 2.0
            o["tw"] = float(win_w)
            o["tx"] = float(cx - win_w / 2.0)
            self._log("заголовок: текст " + str(int(text_w)) + " px, капсула " + str(int(win_w)) + " px")
        except Exception as e:
            self._log("ERR подгонка заголовка: " + type(e).__name__ + ": " + str(e)[:120])

    def _title_fit(self, o, now):
        if not o["shown"]:
            return
        t_prev = o.get("fit_t", 0.0)
        o["fit_t"] = now
        tw = o.get("tw")
        if tw is None or t_prev <= 0.0:
            return
        dt = min(max(now - t_prev, 0.0), 1.0 / 30.0)
        if dt <= 0.0:
            return
        k = 1.0 - math.exp(-dt * 14.0)
        wf = o["wf"] + (tw - o["wf"]) * k
        xf = o["xf"] + (o["tx"] - o["xf"]) * k
        if abs(tw - wf) < 0.6:
            wf = float(tw)
        if abs(o["tx"] - xf) < 0.6:
            xf = float(o["tx"])
        o["wf"] = wf
        o["xf"] = xf
        nw = int(round(wf))
        nx = int(round(xf))
        if nw == o["w"] and nx == o["x"]:
            return
        o["w"] = nw
        o["x"] = nx
        win = o["dlg"].getWindow()
        win.setLayout(nw, int(o["h"]))
        lp = o["root"].getLayoutParams()
        lp.width = nw
        o["root"].setLayoutParams(lp)
        o["sh"].setFloatUniform("res", float(nw), float(o["h"]))
        o["iv"].setRenderEffect(self.RE.createRuntimeShaderEffect(o["sh"], "content"))
        self._ov_x(o)

    def _fx_all(self):
        now = time.time()
        for k, o in tuple(self.ovs.items()):
            if k == "ttl":
                try:
                    self._title_probe(o, now)
                    self._title_fit(o, now)
                except Exception as ex:
                    o["tw"] = None
                    o["probe_at"] = None
                    self._log("ERR подгонка заголовка отключена: " + type(ex).__name__ + ": " + str(ex)[:140])
            try:
                self._fx_ov(o, now)
            except Exception as ex:
                self.fx_on = False
                self._log("ERR анимация верхних элементов отключена: " + type(ex).__name__ + ": " + str(ex)[:140])

    # One entrance gesture for the five Plugin Manager capsules. These are
    # visual transforms only: no synthetic clicks or navigation callbacks.
    PM_PRESS_OFFSETS = (0.0, 0.24, 0.60, 0.68, 0.76)

    def _pm_wave_tick(self, now):
        if (self.route.lower() != "plugin_manager" or not self.alive
                or not self.fx_on or self.get_setting("glass_reduce_motion", False)):
            self.pm_wave_pending = False
            self.pm_wave_t0 = None
            return
        if not self.pm_wave_pending:
            return
        # Wait for the slide-in and image capture. A slow first PixelCopy must
        # not consume the wave while the small capsules are still invisible.
        uppers = tuple(self.ovs.values())
        smalls = tuple(o for o in self.scr.values() if o.get("rt") == "pm")
        if not uppers and not smalls:
            return
        if any(not o["shown"] or o.get("anim", False) for o in uppers):
            return
        if any(not o["shown"] or not o["have"] or o["intro"] < 0.98
               or abs(o["introv"]) > 0.1 for o in smalls):
            return
        self.pm_wave_t0 = now + 0.10
        self.pm_wave_pending = False

    def _pm_press(self, o, now):
        step = o.get("pm_step")
        t0 = self.pm_wave_t0
        if (step is None or t0 is None or self.route.lower() != "plugin_manager"
                or not self.fx_on or self.get_setting("glass_reduce_motion", False)
                or (o.get("rt") == "pm" and not self.scr_fx)):
            return 1.0, 1.0, 0.0
        age = now - t0 - self.PM_PRESS_OFFSETS[step]
        duration = 0.32 if step < 2 else 0.23
        if age <= 0.0 or age >= duration:
            return 1.0, 1.0, 0.0
        u = age / duration
        if u < 0.30:
            q = u / 0.30
            amount = -0.12 * q * q * (3.0 - 2.0 * q)
        else:
            q = (u - 0.30) / 0.70
            amount = -0.12 * math.exp(-3.0 * q) * math.cos(2.0 * math.pi * q) * (1.0 - q)
        return 1.0 + amount * 0.45, 1.0 + amount, max(0.0, -amount) * 4.0

    def _sync_ovs(self):
        r = self.route.lower()
        want = r not in BACK_HIDE
        fresh = want and r != self.ov_route
        self.ov_route = r if want else ""
        if fresh and r == "plugin_manager":
            self.pm_wave_t0 = None
            self.pm_wave_pending = True
        elif r != "plugin_manager":
            self.pm_wave_t0 = None
            self.pm_wave_pending = False
        for k, o in self.ovs.items():
            o["pm_step"] = 0 if k == "btn" else 1
            if want:
                if fresh:
                    self._start_ov_anim(o, 0.07 if k == "ttl" else 0.0)
                if not o["shown"]:
                    o["dlg"].show()
                    o["shown"] = True
            elif o["shown"]:
                o["dlg"].hide()
                o["shown"] = False

    def _capture_ov(self, key):
        if time.time() < max(getattr(self, "nav_quiet", 0.0), getattr(self, "copy_pause_until", 0.0)):
            return
        o = self.ovs.get(key)
        if o is None or not o["shown"] or self.busy.get(key):
            return
        now = time.time()
        if now - o["last"] < 1.0 / max(1.0, float(getattr(self, "fps_amt", 30))):
            return
        o["last"] = now
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        cx = int(o.get("cx", o["x"])) - int(dloc[0])
        if cx + o["w"] <= 8:
            return
        l = max(0, cx)
        t = max(0, o["y"] - int(dloc[1]))
        r = min(int(decor.getWidth()), cx + o["w"])
        bt = min(int(decor.getHeight()), t + o["h"])
        if r - l < 16 or bt - t < 16:
            return
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        bmp = Bitmap.createBitmap(r - l, bt - t, Cfg.ARGB_8888)
        self.pending[key] = bmp
        self.busy[key] = True
        self._request_copy(key, self.act.getWindow(), jclass("android.graphics.Rect")(l, t, r, bt), bmp)

    def _capture_glass(self):
        tgt = self.targets.get("glass")
        if tgt is None or self.busy.get("glass"):
            return
        now = time.time()
        active = self.pressed or self.infl > 0.02 or abs(self.sv) > 2.0
        interval = 1.0 / max(1.0, self.fps_amt)
        if now - self.last_cap < interval * 0.9:
            return
        view = tgt[0]
        if view.getWidth() <= 0:
            return
        from java import jclass, jarray, jint
        if self.cap_rect is None or now - self.cap_rect_t > 0.4:
            decor = self.act.getWindow().getDecorView()
            loc = jarray(jint)([0, 0])
            dloc = jarray(jint)([0, 0])
            view.getLocationOnScreen(loc)
            decor.getLocationOnScreen(dloc)
            l = max(0, int(loc[0] - dloc[0]))
            t = max(0, int(loc[1] - dloc[1]))
            r = min(int(decor.getWidth()), l + int(view.getWidth()))
            b = min(int(decor.getHeight()), t + int(view.getHeight()))
            self.cap_rect = (l, t, r, b)
            self.cap_rect_t = now
        l, t, r, b = self.cap_rect
        if r - l < 16 or b - t < 16:
            return
        sc = max(0.25, min(1.0, self.scale_amt / 100.0))
        bw = max(8, int((r - l) * sc))
        bh = max(4, int((b - t) * sc))
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        bufs = self.bufs
        if bufs is None or int(bufs[0].getWidth()) != bw or int(bufs[0].getHeight()) != bh:
            self._recycle_bitmaps(bufs)
            bufs = [Bitmap.createBitmap(bw, bh, Cfg.ARGB_8888), Bitmap.createBitmap(bw, bh, Cfg.ARGB_8888)]
            self.bufs = bufs
            self.cur_idx = -1
        idx = 1 if self.cur_idx == 0 else 0  # пишем в буфер, который сейчас не показывается
        self.pend_idx = idx
        self.pending["glass"] = bufs[idx]
        self.busy["glass"] = True
        self.last_cap = now
        Rect = jclass("android.graphics.Rect")
        self._request_copy("glass", self.act.getWindow(), Rect(l, t, r, b), bufs[idx])

    def _capture(self, key):
        if time.time() < max(getattr(self, "nav_quiet", 0.0), getattr(self, "copy_pause_until", 0.0)):
            return
        if key == "glass":
            return self._capture_glass()
        tgt = self.targets.get(key)
        if tgt is None or self.busy.get(key):
            return
        view, iv, ix, iy, stop_w = tgt
        nowc = time.time()
        if nowc - self.cap_t.get(key, 0.0) < 1.0 / max(1.0, float(getattr(self, "fps_amt", 30))):
            return
        self.cap_t[key] = nowc
        if view.getWidth() <= 0:
            return
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        loc = jarray(jint)([0, 0])
        dloc = jarray(jint)([0, 0])
        view.getLocationOnScreen(loc)
        decor.getLocationOnScreen(dloc)
        # учитываем масштаб линзы во время анимации
        vw = int(view.getWidth() * float(view.getScaleX()))
        vh = int(view.getHeight() * float(view.getScaleY()))
        l = int(loc[0] - dloc[0]) + ix
        t = int(loc[1] - dloc[1]) + iy
        r = int(loc[0] - dloc[0]) + vw - ix
        b = int(loc[1] - dloc[1]) + vh - iy
        dw = int(decor.getWidth())
        dh = int(decor.getHeight())
        l = max(0, l)
        t = max(0, t)
        r = min(dw, r)
        b = min(dh, b)
        if r - l < 16 or b - t < 16:
            return
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        Rect = jclass("android.graphics.Rect")
        PixelCopy = jclass("android.view.PixelCopy")
        bmp = Bitmap.createBitmap(max(8, (r - l) // 2), max(4, (b - t) // 2), Cfg.ARGB_8888)
        self.pending[key] = bmp
        self.busy[key] = True
        self._request_copy(key, self.act.getWindow(), Rect(l, t, r, b), bmp)

    def _make_copy_cb(self, key):
        def cb(result):
            self._on_copy(key, result)
        return cb

    def _on_copy(self, key, result):
        self.busy[key] = False
        bmp = self.pending.pop(key, None)
        if self.pc_err.get(key, 0) != result:
            self.pc_err[key] = result
            if result != 0:
                self.copy_pause_until = max(getattr(self, "copy_pause_until", 0.0), time.time() + 0.85)
                if time.time() >= getattr(self, "nav_quiet", 0.0):
                    self._log("WARN PixelCopy[" + str(key) + "] result=" + str(result))
        if key.startswith("s_"):
            try:
                self._scr_on_copy(key, result)
            except Exception as sc:
                self._scr_fail(sc)
            return
        if key == "btdet":
            self._bt_det_done(bmp, result)
            return
        if key == "probe":
            self._on_probe(bmp, result)
            return
        if key == "log":
            lw = self.logw
            if result == 0 and lw is not None and bmp is not None and lw.get("iv") is not None:
                try:
                    lw["iv"].setImageBitmap(bmp)
                    lw["idx"] = lw["pidx"]
                except Exception:
                    pass
            return
        if key in ("btn", "ttl"):
            o = self.ovs.get(key)
            if result == 0 and o is not None and bmp is not None:
                try:
                    o["iv"].setImageBitmap(bmp)
                except Exception:
                    pass
            return
        if key == "glass":
            tgt = self.targets.get(key)
            if result == 0 and tgt is not None and bmp is not None:
                try:
                    tgt[1].setImageBitmap(bmp)
                    self.cur_idx = self.pend_idx
                except Exception:
                    pass
            return
        try:
            tgt = self.targets.get(key)
            if result != 0 or tgt is None or bmp is None:
                if bmp is not None:
                    bmp.recycle()
                return
            from java import jclass
            Bitmap = jclass("android.graphics.Bitmap")
            stop_w = tgt[4]
            w = int(bmp.getWidth())
            h = int(bmp.getHeight())
            b = bmp
            # Уменьшаем только до нужной детализации, освобождая промежуточные bitmap.
            while w > stop_w:
                nw = max(stop_w, w // 2)
                nh = max(5, h // 2)
                scaled = Bitmap.createScaledBitmap(b, nw, nh, True)
                if b is not bmp:
                    b.recycle()
                b = scaled
                w, h = nw, nh
            if b is not bmp:
                bmp.recycle()
            old = self.rendered.get(key)
            tgt[1].setImageBitmap(b)
            self.rendered[key] = b
            # old не освобождаем вручную (см. _recycle_bitmap): его мог ещё рисовать ImageView
        except Exception:
            try:
                if bmp is not None and not bmp.isRecycled():
                    bmp.recycle()
            except Exception:
                pass

    # ------------------------------------------------------------------ стекло на экране Bluetooth
    # Переключатель All/BLE/Advert закрыт целиком стеклянным окном (оно ловит касания и передаёт их хосту);
    # остальные элементы получают накладки-окна, которые рисуют кромку стекла (преломление, радужная кайма,
    # блик, жёлоб) и лёгкую вуаль, середина остаётся живым интерфейсом хоста. Положение задано по
    # скриншоту (доли ширины экрана), плюс калибровка сдвигом в настройках. Секция All/BLE/Advert
    # определяется по яркости переключателя на снимке окна, а не по недокументированным событиям.
    def _fval(self, key, default):
        try:
            return float(self.get_setting(key, default))
        except Exception:
            return float(default)

    def _scr_rt_ok(self, o):
        r = self.route.lower()
        if o.get("rt") == "pm":
            return r == "plugin_manager"
        return r in ("", "bluetooth")

    def _scr_route_ok(self):
        # маршрут ещё не известен (после возврата в приложение) — показываем, как на Bluetooth
        r = self.route.lower()
        return r in ("", "bluetooth", "plugin_manager")

    PM_TABLE = {  # масштаб: (центр «+», центр магазина, центр шестерёнки, центр по Y) — доли ширины экрана
        0.9: (0.756, 0.839, 0.924, 0.165),
        1.0: (0.725, 0.820, 0.915, 0.170),
        1.1: (0.700, 0.806, 0.909, 0.181),
    }

    BT_TABLE = {  # масштаб: (центр верхней панели, центр «Выберите», центр «Старт») — доли высоты экрана
        0.9: (0.0905, 0.524, 0.742),
        1.0: (0.0963, 0.477, 0.720),
        1.1: (0.102, 0.429, 0.696),
    }

    bt_dy = {}

    bt_boxes = {}

    CARD_TABLE = {  # масштаб: (отступ слева, верх, низ) — доли ширины / высоты экрана, измерено
        0.9: (0.0461, 0.4602, 0.8065),
        1.0: (0.0535, 0.4055, 0.7906),
        1.1: (0.0617, 0.3504, 0.7742),
    }

    @staticmethod
    def _table_lerp_extrapolate(table, k):
        # Линейная интерполяция между контрольными точками и экстраполяция
        # по ближайшему сегменту за их пределами. Не зажимаем ui_scale на 90–110%.
        pts = sorted(table.items())
        if k <= pts[0][0]:
            (k0, v0), (k1, v1) = pts[0], pts[1]
        elif k >= pts[-1][0]:
            (k0, v0), (k1, v1) = pts[-2], pts[-1]
        else:
            for (ka, va), (kb, vb) in zip(pts, pts[1:]):
                if ka <= k <= kb:
                    k0, v0, k1, v1 = ka, va, kb, vb
                    break
        t = (k - k0) / (k1 - k0)
        if isinstance(v0, (tuple, list)):
            return tuple(v0[i] + (v1[i] - v0[i]) * t for i in range(len(v0)))
        return v0 + (v1 - v0) * t

    def _card_frac(self, k):
        return self._table_lerp_extrapolate(self.CARD_TABLE, k)

    def _scr_btn_scale(self):
        # Масштабируются только стеклянные накладки двух кнопок Bluetooth.
        # 100% — точный базовый размер, снятый с предоставленного скриншота.
        try:
            return max(0.70, min(1.30, self._fval("glass_scr_btn_scale", 100.0) / 100.0))
        except Exception:
            return 1.0

    # ------------------------------------------------------------------ геометрия экрана Bluetooth
    # Порядок: 1) автоопределение по цвету (PixelCopy 1/4, один замер на заход/смену масштаба),
    # 2) расчёт по dp (строка состояния сверху, жестовая панель снизу, середина — доля высоты),
    # 3) старые таблицы BT_TABLE / CARD_TABLE. Любая ошибка — молча переходим к следующему способу.
    BT_DET_SC = 0.25
    bt_det = {}       # ключ (W, H, ui_k, density) -> найденная геометрия (метод «цвет»)
    bt_dp_memo = {}   # то же для расчёта по dp
    bt_try = {}       # ключ -> число замеров
    bt_want = False
    bt_sched_t = 0.0
    bt_ins = (0.0, 0.0)

    def _bt_det_key(self, dh=None):
        return (int(getattr(self, "scr_W_full", 0.0)),
                int(dh if dh is not None else getattr(self, "scr_H_full", 0.0)),
                round(float(getattr(self, "ui_k", 1.0)), 2),
                round(float(getattr(self, "dens", 1.0)), 2))

    def _bt_table_geom(self, dh, W, k):
        f = self._table_lerp_extrapolate(self.BT_TABLE, k)
        yP, yD, yG = f[0] * dh, f[1] * dh, f[2] * dh
        # Эталон при 100%: отступ 153 px и высота 180 px на размере 1216x2688.
        m0 = 0.1258 * k * W
        h0 = 0.0670 * k * dh
        cl, ct, cb = self._card_frac(k)
        return {"method": "таблица", "yP": yP, "yD": yD, "yG": yG,
                "boxes": {"dev": (m0, yD - h0 / 2.0, W - m0, yD + h0 / 2.0),
                          "go": (m0, yG - h0 / 2.0, W - m0, yG + h0 / 2.0),
                          "card": (cl * W, ct * dh, W - cl * W, cb * dh)}}

    def _bt_dp_geom(self, dh, W, k):
        # Размеры в dp (эталон 1216x2688, density 3.19, строка состояния 30 dp, жестовая панель 40 dp)
        d = float(getattr(self, "dens", 0.0)) or 3.0
        t_in, b_in = self.bt_ins
        yP = t_in + d * (2.6 + 48.6 * k)                 # верхняя панель: под строкой состояния
        yG = dh - b_in - d * (2.4 + 194.0 * k)           # «Старт»: от низа над жестовой панелью
        yD = yP + (yG - yP) * (0.6104 - 0.574 * (k - 1.0))  # «Выберите»: доля оставшейся высоты
        h = d * 56.4 * k
        m0 = d * 48.0 * k
        card = (d * 20.4 * k, yD - h / 2.0 - d * 32.0 * k, W - d * 20.4 * k, yG + h / 2.0 + d * 31.2 * k)
        return {"method": "dp", "yP": yP, "yD": yD, "yG": yG,
                "boxes": {"dev": (m0, yD - h / 2.0, W - m0, yD + h / 2.0),
                          "go": (m0, yG - h / 2.0, W - m0, yG + h / 2.0),
                          "card": card}}

    def _bt_geom(self, dh):
        W = float(getattr(self, "scr_W_full", 0.0))
        k = float(getattr(self, "ui_k", 1.0))
        try:
            key = self._bt_det_key(dh)
            g = self.bt_det.get(key)
            if g is not None:
                self.bt_last_color = g
                return g
            last = getattr(self, "bt_last_color", None)
            if last is not None:
                return last  # уже найдено по цвету: не переходим на dp (иначе карточка прыгает)
            mk = (key, int(self.bt_ins[0]), int(self.bt_ins[1]))
            g = self.bt_dp_memo.get(mk)
            if g is None:
                g = self._bt_dp_geom(dh, W, k)
                self.bt_dp_memo[mk] = g
            return g
        except Exception as e:
            self._log("BT-геометрия: dp не посчитан (" + type(e).__name__ + "), беру таблицу")
            return self._bt_table_geom(dh, W, k)

    def _bt_boxes(self, dh, W, k, yD, yG):
        # Стеклянная накладка кнопок масштабируется вокруг центра настоящей кнопки.
        g = self._bt_geom(dh)
        bs = self._scr_btn_scale()
        out = {}
        for key in ("dev", "go"):
            x0, y0, x1, y1 = g["boxes"][key]
            cx, cy = (x0 + x1) / 2.0, (y0 + y1) / 2.0
            w, h = (x1 - x0) * bs, (y1 - y0) * bs
            out[key] = (cx - w / 2.0, cy - h / 2.0, cx + w / 2.0, cy + h / 2.0)
        out["card"] = tuple(g["boxes"]["card"])
        for key in list(out):
            x0, y0, x1, y1 = out[key]
            x0, x1 = max(0.0, x0), min(float(W), x1)
            y0, y1 = max(0.0, y0), min(float(dh), y1)
            out[key] = (x0, y0, x1, y1)
        return out

    def _bt_all(self, dh):
        g = self._bt_geom(dh)
        return g["yP"], g["yD"], g["yG"]

    def _bt_targets(self, dh):
        g = self._bt_geom(dh)
        return g["yP"], g["yG"]

    # --- автоопределение по цвету
    @staticmethod
    def _bt_accent(p):
        # светлый насыщенный цвет акцента (розовые кнопки, выбранная секция); белый и серый текст не подходят
        r = (p >> 16) & 255
        g = (p >> 8) & 255
        b = p & 255
        mx = max(r, g, b)
        return mx >= 150 and (mx - min(r, g, b)) >= 0.10 * mx

    @staticmethod
    def _bt_runs(vals, test, minlen, gap=2):
        out = []
        a = None
        last = -10
        for i, p in enumerate(vals):
            if test(p):
                if a is None:
                    a = i
                last = i
            elif a is not None and i - last > gap:
                if last - a + 1 >= minlen:
                    out.append((a, last))
                a = None
        if a is not None and last - a + 1 >= minlen:
            out.append((a, last))
        return out

    pm_det = {}   # ключ -> найденные центры иконок шапки «Плагины»

    def _bt_kind(self):
        r = str(self.route).lower()
        if r in ("", "bluetooth"):
            return "bt"
        if r == "plugin_manager":
            return "pm"
        return None

    def _bt_det_entry(self):
        # заход на экран Bluetooth / «Плагины» или смена масштаба: нужен один новый замер
        try:
            if self._bt_kind() is None:
                return
            self.bt_want = True
            self.bt_sched_t = 0.0
            self.bt_sched_n = 0
            self.bt_try = {}
            self._bt_det_ensure()
        except Exception as e:
            self._log("BT-замер: ERR " + type(e).__name__ + ": " + str(e)[:100])

    def _bt_det_ensure(self):
        # вызывается из _scr_layout каждые 0.5 с — только проверка флагов, без работы с пикселями
        try:
            if self.act is None or self.handler is None or getattr(self, "scr_H_full", 0.0) < 100.0:
                return
            kind = self._bt_kind()
            if kind is None:
                return
            key = self._bt_det_key()
            tk = (kind,) + key
            tries = self.bt_try.get(tk, 0)
            cache = self.pm_det if kind == "pm" else self.bt_det
            need = self.bt_want or (key not in cache and tries < 3)
            if not need or tries >= 3:
                return
            now = time.time()
            if self.bt_sched_t and now - self.bt_sched_t < 2.5:
                return
            if getattr(self, "bt_sched_n", 0) >= 8:
                return  # запрос не доходит (окно пересобирается): не долбим бесконечно
            self.bt_sched_n = getattr(self, "bt_sched_n", 0) + 1
            self.bt_sched_t = now
            self._post(self._bt_det_run, 450 if tries == 0 else 700)  # даём экрану закончить анимацию входа
        except Exception as e:
            self._log("BT-замер: ERR " + type(e).__name__ + ": " + str(e)[:100])

    def _bt_det_run(self):
        try:
            kind = self._bt_kind()
            if self.act is None or self.busy.get("btdet") or kind is None:
                self.bt_sched_t = 0.0
                return
            from java import jclass, jarray, jint
            decor = self.act.getWindow().getDecorView()
            W = int(decor.getWidth())
            H = int(decor.getHeight())
            if W < 64 or H < 64:
                self.bt_sched_t = 0.0
                return
            dloc = jarray(jint)([0, 0])
            decor.getLocationOnScreen(dloc)
            key = self._bt_det_key(H)
            self.bt_run = (key, W, H, int(dloc[0]), int(dloc[1]), time.time(), kind)
            Bitmap = jclass("android.graphics.Bitmap")
            Cfg = jclass("android.graphics.Bitmap$Config")
            sc = self.BT_DET_SC
            dest = Bitmap.createBitmap(max(16, int(W * sc)), max(16, int(H * sc)), Cfg.ARGB_8888)
            self.pending["btdet"] = dest
            self.busy["btdet"] = True
            self._request_copy("btdet", self.act.getWindow(), jclass("android.graphics.Rect")(0, 0, W, H), dest)
        except Exception as e:
            self.busy["btdet"] = False
            self.bt_sched_t = 0.0
            self._log("BT-замер: ERR " + type(e).__name__ + ": " + str(e)[:100])

    def _bt_det_done(self, bmp, result):
        run = getattr(self, "bt_run", None)
        det = None
        t0 = time.time()
        try:
            if result == 0 and bmp is not None and run is not None:
                if run[6] == "pm":
                    det = self._pm_find(bmp, run[1], run[2], run[3], run[4])
                else:
                    det = self._bt_find(bmp, run[1], run[2], run[3], run[4])
        except Exception as e:
            det = None
            self._log("BT-замер: ERR поиск " + type(e).__name__ + ": " + str(e)[:100])
        self._recycle_bitmap(bmp)
        self.bt_sched_t = 0.0
        if run is None:
            return
        key = run[0]
        kind = run[6]
        tk = (kind,) + key
        self.bt_try[tk] = self.bt_try.get(tk, 0) + 1
        ms = int((time.time() - t0) * 1000)
        try:
            if det is not None:
                (self.pm_det if kind == "pm" else self.bt_det)[key] = det
                self.bt_want = False
                self.scr_rl_t = 0.0  # ближайший такт сразу пересчитает положение окон
                if kind == "pm":
                    self._pm_log(det, key, ms)
                else:
                    self._bt_log(det, key, ms)
            elif self.bt_try.get(tk, 0) >= 3:
                self.bt_want = False
                if kind == "pm":
                    self._log("PM-геометрия: метод=таблица [иконки не найдены] | экран " + str(key[0]) + "x" + str(key[1])
                              + " density=" + str(key[3]) + " ui_k=" + str(key[2]) + " | " + str(ms) + " мс")
                else:
                    g = self._bt_geom(key[1])
                    self._bt_log(g, key, ms, "кнопки не найдены")
        except Exception as e:
            self._log("BT-замер: ERR " + type(e).__name__ + ": " + str(e)[:100])

    def _pm_log(self, d, key, ms):
        self._log("PM-геометрия: метод=" + str(d["method"]) + " центры_x=" + ",".join(str(int(round(v))) for v in d["cx"])
                  + " cy=" + str(int(round(d["cy"]))) + " D=" + str(int(round(d["D"])))
                  + " | экран " + str(key[0]) + "x" + str(key[1]) + " density=" + str(key[3])
                  + " ui_k=" + str(key[2]) + " | " + str(ms) + " мс")

    def _pm_find(self, bmp, W, H, ox, oy):
        # Три светлых значка шапки «Плагины» (+, магазин, шестерёнка) в правой части под строкой состояния.
        # Столбцы с яркими пикселями группируются в три кластера; пока считаем только эти столбцы.
        from java import jarray, jint
        w = int(bmp.getWidth())
        h = int(bmp.getHeight())
        sc_x = w / float(W)
        sc_y = h / float(H)
        y0 = int(max(float(self.bt_ins[0]) + 4.0, 0.04 * H) * sc_y)
        y1 = int(0.115 * H * sc_y)
        x0 = int(0.69 * w)
        gw, gh = w - x0, y1 - y0
        if gh < 6 or gw < 12:
            return None
        arr = jarray(jint)(gw * gh)
        bmp.getPixels(arr, 0, gw, x0, y0, gw, gh)
        vals = list(arr)

        def bright(p):
            r = (p >> 16) & 255
            g = (p >> 8) & 255
            b = p & 255
            return r >= 150 and g >= 150 and b >= 150 and max(r, g, b) - min(r, g, b) <= 70
        colc = [0] * gw
        rowc = [0] * gh
        mask = [False] * (gw * gh)
        for y in range(gh):
            base = y * gw
            for x in range(gw):
                if bright(vals[base + x]):
                    mask[base + x] = True
                    colc[x] += 1
                    rowc[y] += 1
        gap = max(3, int(0.01 * w))
        groups = []
        a = None
        last = -99
        for x in range(gw):
            if colc[x] > 0:
                if a is None:
                    a = x
                last = x
            elif a is not None and x - last > gap:
                groups.append((a, last))
                a = None
        if a is not None:
            groups.append((a, last))
        groups = [g for g in groups if g[1] - g[0] + 1 >= max(3, int(0.02 * w))]
        if len(groups) != 3:
            return None
        cxs = []
        cys = []
        for (ga, gb) in groups:
            ys = [y for y in range(gh) for x in range(ga, gb + 1) if mask[y * gw + x]]
            if not ys:
                return None
            cxs.append(((x0 + ga + x0 + gb + 1) / 2.0) / sc_x + ox)
            cys.append(((y0 + min(ys) + y0 + max(ys) + 1) / 2.0) / sc_y + oy)
        p1, p2 = cxs[1] - cxs[0], cxs[2] - cxs[1]
        if p1 <= 0 or p2 <= 0 or abs(p1 - p2) > 0.25 * max(p1, p2):
            return None
        pitch = (cxs[2] - cxs[0]) / 2.0
        D = pitch / 1.132  # эталон: кружки 68 px с шагом 77 px
        if not (0.05 * W <= D <= 0.12 * W):
            return None
        return {"method": "цвет", "cx": cxs, "cy": sum(cys) / 3.0, "D": D}

    def _bt_log(self, g, key, ms, note=""):
        r = lambda t: "(" + ",".join(str(int(round(v))) for v in t) + ")"
        b = g["boxes"]
        self._log("BT-геометрия: метод=" + str(g["method"]) + (" [" + note + "]" if note else "")
                  + " dev=" + r(b["dev"]) + " go=" + r(b["go"]) + " card=" + r(b["card"])
                  + " панель_cy=" + str(int(round(g["yP"])))
                  + " | экран " + str(key[0]) + "x" + str(key[1]) + " density=" + str(key[3])
                  + " ui_k=" + str(key[2]) + " | " + str(ms) + " мс")

    def _bt_find(self, bmp, W, H, ox, oy):
        # Сканирование отдельных столбцов и строк уменьшенного снимка: несколько вызовов getPixels,
        # без перебора всех пикселей. Возвращает геометрию в пикселях экрана или None.
        from java import jarray, jint
        w = int(bmp.getWidth())
        h = int(bmp.getHeight())
        acc = self._bt_accent

        def col(x):
            arr = jarray(jint)(h)
            bmp.getPixels(arr, 0, 1, int(x), 0, 1, h)
            return list(arr)

        def row(y):
            arr = jarray(jint)(w)
            bmp.getPixels(arr, 0, w, 0, int(y), w, 1)
            return list(arr)

        # 1) большие горизонтальные «таблетки» акцента: «Выберите устройство» и «Старт»
        minb = max(6, int(0.030 * h))
        cands = []
        for xl, xr_ in ((0.25, 0.75), (0.18, 0.82)):  # запасные вертикали для других экранов
            ca = self._bt_runs(col(xl * w), acc, minb)
            cb = self._bt_runs(col(xr_ * w), acc, minb)
            for (a1, b1) in ca:
                for (a2, b2) in cb:
                    if abs(a1 - a2) <= 4 and abs(b1 - b2) <= 4:
                        y0, y1 = (a1 + a2) // 2, (b1 + b2) // 2
                        rw = row((y0 + y1) // 2)
                        xs = [i for i in range(w) if acc(rw[i])]
                        if xs and (xs[-1] - xs[0] + 1) >= 0.45 * w:
                            cands.append((y0, y1, xs[0], xs[-1]))
            if len(cands) >= 2:
                break
        if len(cands) < 2:
            return None
        cands.sort()
        dev, go = cands[0], cands[-1]
        hd, hg = dev[1] - dev[0] + 1, go[1] - go[0] + 1
        if go[0] <= dev[1] or abs(hd - hg) > 0.25 * max(hd, hg):
            return None
        f = 1.0 / (w / float(W))   # снимок -> пиксели окна
        fy = 1.0 / (h / float(H))
        dp_g = self._bt_dp_geom(float(H), float(W), float(getattr(self, "ui_k", 1.0)))
        method = "цвет"

        def box(c):
            return (c[2] * f + ox, c[0] * fy + oy, (c[3] + 1) * f + ox, (c[1] + 1) * fy + oy)
        b_dev, b_go = box(dev), box(go)

        # 2) верхняя панель: выбранная секция All/BLE/Advert (маленькая таблетка акцента у верха экрана)
        yP = None
        top_lim = int(0.25 * h)
        for xr in (0.11, 0.43, 0.70):  # края секций: мимо подписей All / BLE / Advert
            x = int(xr * w)
            vals = col(x)[:top_lim]
            for (a, b) in self._bt_runs(vals, acc, max(4, int(0.02 * h)), gap=max(3, int(0.06 * h * 0.25))):
                if b - a + 1 > 0.07 * h:
                    continue
                rw = row((a + b) // 2)
                l = r_ = x
                while l > 0 and acc(rw[l - 1]):
                    l -= 1
                while r_ < w - 1 and acc(rw[r_ + 1]):
                    r_ += 1
                if 0.12 * w <= (r_ - l + 1) <= 0.45 * w:
                    yP = ((a + b + 1) / 2.0) * fy + oy
                    break
            if yP is not None:
                break
        if yP is None:
            yP = dp_g["yP"]
            method += "+dp(панель)"

        # 3) тёмная карточка: цвет берём в промежутке под «Выберите», границы ищем от центра наружу
        card = None
        xc = w // 2
        bh = hd
        ys = min(h - 1, dev[1] + max(2, int(0.12 * bh)))
        rw = row(ys)
        pc = rw[xc]
        cr, cg, cb_ = (pc >> 16) & 255, (pc >> 8) & 255, pc & 255
        mx = max(cr, cg, cb_)
        if 20 <= mx <= 110 and mx - min(cr, cg, cb_) <= 36:
            same = lambda p: (abs(((p >> 16) & 255) - cr) <= 10 and abs(((p >> 8) & 255) - cg) <= 10
                              and abs((p & 255) - cb_) <= 10)
            l = xc
            while l > 0 and same(rw[l - 1]):
                l -= 1
            r_ = xc
            while r_ < w - 1 and same(rw[r_ + 1]):
                r_ += 1
            cv = col(xc)
            t = max(0, dev[0] - max(2, int(0.12 * bh)))
            while t > 0 and same(cv[t - 1]):
                t -= 1
            bt = min(h - 1, go[1] + max(2, int(0.12 * bh)))
            while bt < h - 1 and same(cv[bt + 1]):
                bt += 1
            if t < dev[0] and bt > go[1] and l < dev[2] and r_ > dev[3]:
                card = (l * f + ox, t * fy + oy, (r_ + 1) * f + ox, (bt + 1) * fy + oy)
        if card is None:
            k = float(getattr(self, "ui_k", 1.0))
            d = float(getattr(self, "dens", 3.0))
            card = (d * 20.4 * k + ox, b_dev[1] - d * 32.0 * k, W - d * 20.4 * k + ox, b_go[3] + d * 31.2 * k)
            method += "+dp(карточка)"

        return {"method": "цвет" if method == "цвет" else method, "yP": yP,
                "yD": (b_dev[1] + b_dev[3]) / 2.0, "yG": (b_go[1] + b_go[3]) / 2.0,
                "boxes": {"dev": b_dev, "go": b_go, "card": card}}

    def _pm_frac(self, idx, k):
        pts = sorted(self.PM_TABLE.items())
        k = max(pts[0][0], min(pts[-1][0], k))
        for (k0, v0), (k1, v1) in zip(pts, pts[1:]):
            if k0 <= k <= k1:
                t = (k - k0) / (k1 - k0)
                return v0[idx] + (v1[idx] - v0[idx]) * t, v0[3] + (v1[3] - v0[3]) * t
        return pts[-1][1][idx], pts[-1][1][3]

    def _pm_box(self, x0, y0, x1, y1, spm, pad):
        # кнопки шапки «Плагины»: положение по таблице масштаба Dolphy, размер — доля ширины
        W = float(getattr(self, "scr_W_full", spm * SCR_PM_REF_W))
        k = float(getattr(self, "ui_k", 1.0))
        idx = 0 if x0 < 700 else (1 if x0 < 770 else 2)
        try:
            d = self.pm_det.get(self._bt_det_key())
            if d is not None:
                D = d["D"]
                return (d["cx"][idx] - D / 2.0 - pad, d["cy"] - D / 2.0 - pad, D + 2 * pad, D + 2 * pad, D / 2.0)
        except Exception:
            pass
        fx, fy = self._pm_frac(idx, k)
        cx = fx * W
        cy = fy * W
        D = (x1 - x0) / SCR_PM_REF_W * W
        return (cx - D / 2.0 - pad, cy - D / 2.0 - pad, D + 2 * pad, D + 2 * pad, D / 2.0)

    def _ui_scale(self, act):
        import re
        try:
            d = str(act.getApplicationContext().getApplicationInfo().dataDir)
            with open(d + "/shared_prefs/DolphyPrefs.xml", encoding='utf-8', errors='ignore') as fh:
                txt = fh.read()
            m = re.search(r'<\w+\s+name="ui_scale"\s+value="([^"]+)"', txt)
            if m:
                return max(0.8, min(1.2, float(m.group(1))))
        except Exception as e:
            self._log("масштаб Dolphy: не прочитан (" + type(e).__name__ + ")")
        return 1.0

    def _scale_recheck(self, force=False):
        if self.act is None:
            return
        if not force and time.time() - getattr(self, "k_check_t", 0.0) < 0.5:
            return
        self.k_check_t = time.time()
        kk = self._ui_scale(self.act)
        if abs(kk - getattr(self, "ui_k", 1.0)) > 1e-3:
            self.ui_k = kk
            self._log("масштаб Dolphy: " + str(round(kk, 2)) + " — перестраиваю стекло")
            self._bt_det_entry()
            self._post(self._setup, 0)

    def _scr_layout(self, act):
        from java import jarray, jint
        dm = act.getResources().getDisplayMetrics()
        decor = act.getWindow().getDecorView()
        width = int(decor.getWidth()) or int(dm.widthPixels)
        S = float(width) / SCR_REF_W
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        dh = float(decor.getHeight())
        if dh < 100.0:
            dh = float(dm.heightPixels)
        inset = 0.0
        ins = decor.getRootWindowInsets()
        if ins is not None:
            inset = float(ins.getSystemWindowInsetBottom())
        try:
            self.bt_ins = (float(ins.getSystemWindowInsetTop()) if ins is not None else 0.0, inset)
        except Exception:
            self.bt_ins = (0.0, inset)
        origin_y = float(dloc[1])
        base = origin_y + dh - inset
        # Эталонный скриншот задаёт координаты по ширине, но высота рабочей
        # области у разных телефонов и режимов навигации отличается. Подгоняем
        # вертикальный масштаб по фактической области Activity и ограничиваем
        # коррекцию, чтобы ошибочный inset не растянул интерфейс чрезмерно.
        Sy = S
        if bool(self.get_setting("glass_scr_auto_cal", True)):
            expected_h = max(1.0, SCR_REF_BOTTOM * S)
            actual_h = max(1.0, base - origin_y)
            ratio = actual_h / expected_h
            Sy = S * max(0.88, min(1.12, ratio))
        ox = float(dloc[0])
        self.ui_k = self._ui_scale(act)
        self.scr_W_full = float(width)
        self.scr_H_full = float(dh)
        self._bt_det_ensure()
        # верхняя панель и низ стекла: по таблице масштаба Dolphy (кнопка «Старт» — якорь низа)
        yP, yD, yG = self._bt_all(float(dh))
        origin_y = yP - 234.5 * Sy
        base = yG + (SCR_REF_BOTTOM - 1913.0) * Sy
        pred_dev = base - (SCR_REF_BOTTOM - 1351.5) * Sy
        self.bt_dy = {"dev": yD - pred_dev}
        self.bt_boxes = self._bt_boxes(float(dh), float(width), float(getattr(self, "ui_k", 1.0)), yD, yG)
        self.scr_Sy = Sy
        self.scr_origin_y = origin_y
        self.scr_origin_x = ox
        return S, base, inset

    def _text_center(self, root, text, Rect):
        found = root.findAccessibilityNodeInfosByText(text)
        if found is None or found.isEmpty():
            return None
        r = Rect()
        found.get(0).getBoundsInScreen(r)
        return ((r.left + r.right) / 2.0, (r.top + r.bottom) / 2.0)

    def _anchor_fit(self, act, S, ox, oy, base, Sy):
        # привязка к реальным подписям переключателя All / BLE / Advert через дерево доступности Dolphy:
        # по их положению подстраиваем масштаб и смещение стекла. Если подписи не найдены — оставляем расчёт.
        from java import jclass
        try:
            decor = act.getWindow().getDecorView()
            stack = [(decor, 0)]
            host = None
            while stack and host is None:
                v, d = stack.pop()
                try:
                    if v.getAccessibilityNodeProvider() is not None:
                        host = v
                        break
                except Exception:
                    pass
                if d < 12:
                    try:
                        for i in range(int(v.getChildCount())):
                            stack.append((v.getChildAt(i), d + 1))
                    except Exception:
                        pass
            if host is None:
                self._log("якорь: дерево доступности не найдено")
                return S, ox, oy, base, Sy
            root = host.getAccessibilityNodeProvider().createAccessibilityNodeInfo(-1)
            Rect = jclass("android.graphics.Rect")
            centers = {}
            for name in SCR_NAMES:
                found = root.findAccessibilityNodeInfosByText(name)
                if found is None or found.isEmpty():
                    continue
                r = Rect()
                found.get(0).getBoundsInScreen(r)
                centers[name] = ((r.left + r.right) / 2.0, (r.top + r.bottom) / 2.0)
            if len(centers) < 3:
                self._log("якорь: найдено подписей " + str(len(centers)) + " из 3")
                return S, ox, oy, base, Sy
            ax, ay = centers["All"]
            bx, by = centers["BLE"]
            dx_, dy_ = centers["Advert"]
            real_sp = (dx_ - ax) / 2.0
            pred_sp = (SCR_SEG_X1 - SCR_SEG_X0) / 3.0 * S
            k = real_sp / pred_sp if pred_sp > 0 else 1.0
            if not (0.7 <= k <= 1.4):
                self._log("якорь: масштаб вне диапазона " + str(round(k, 3)) + ", не применяю")
                return S, ox, oy, base, Sy
            S2 = S * k
            Sy2 = Sy * k
            mid = (SCR_SEG_X0 + SCR_SEG_X1) / 2.0
            ox2 = bx - mid * S2
            cy = (ay + by + dy_) / 3.0
            oy2 = cy - 234.5 * Sy2
            self._log("якорь: подписи найдены, k=" + str(round(k, 3)) + " смещение=" + str(round(ox2)) + "," + str(round(oy2)))
            base2 = base + (oy2 - oy)
            stc = self._text_center(root, "Старт", Rect)
            if stc is not None:
                # низ стекла привязан к реальной кнопке «Старт» (центр эталона 1913 px)
                base2 = stc[1] + (SCR_REF_BOTTOM - 1913.0) * Sy2
                self._log("якорь: низ по кнопке Старт, base=" + str(round(base2)))
            else:
                self._log("якорь: кнопка Старт не найдена, низ по верхней подписи")
            return S2, ox2, oy2, base2, Sy2
        except Exception as e:
            self._log("якорь ERR: " + type(e).__name__ + ": " + str(e)[:120])
            return S, ox, oy, base, Sy

    def _seg_labels(self, o, S):
        # Подписи секций рисуем в bitmap размером с окно и отдаём шейдеру вторым входом
        from java import jclass, jint
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        Canvas = jclass("android.graphics.Canvas")
        Paint = jclass("android.graphics.Paint")
        Align = jclass("android.graphics.Paint$Align")
        w, h = int(o["w"]), int(o["h"])
        bmp = Bitmap.createBitmap(w, h, Cfg.ARGB_8888)
        cv = Canvas(bmp)
        tp = Paint(1)
        tp.setTextAlign(Align.CENTER)
        tp.setTextSize(float(34.0 * S))
        tp.setColor(jint(argb(0xFFFFFFFF)))
        try:
            tf = jclass("android.graphics.Typeface")
            tp.setTypeface(tf.create("sans-serif-medium", 0))
        except Exception:
            pass
        fm = tp.getFontMetrics()
        base = h / 2.0 - (float(fm.ascent) + float(fm.descent)) / 2.0
        segw = (SCR_SEG_X1 - SCR_SEG_X0) / 3.0 * S
        left0 = (SCR_SEG_X0 - SCR_PILL_X0) * S + o["pad"]
        for i in range(3):
            cv.drawText(SCR_NAMES[i], float(left0 + segw * (i + 0.5)), float(base), tp)
        BS = jclass("android.graphics.BitmapShader")
        TM = jclass("android.graphics.Shader$TileMode")
        o["sh"].setInputShader("icons", BS(bmp, TM.CLAMP, TM.CLAMP))
        o["lbl"] = bmp

    def _scr_fwd_only(self, o, ev):
        try:
            self._scr_fwd(o, ev)
        except Exception as e:
            self._log("ERR передача касания: " + type(e).__name__ + ": " + str(e)[:120])
        return True

    def _scr_fwd(self, o, ev, action=None):
        # передаём родному интерфейсу копию касания (координаты окна → координаты Activity)
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        cp = jclass("android.view.MotionEvent").obtain(ev)
        if action is not None:
            cp.setAction(int(action))
        cp.offsetLocation(float(o["x"] - int(dloc[0])), float(o["y"] - int(dloc[1])))
        decor.dispatchTouchEvent(cp)
        cp.recycle()

    def _scr_tap_host(self, o, ev, idx):
        # после перетаскивания «нажимаем» центр нужной секции родного переключателя
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        # Native BluetoothContainerContent uses statusBarsPadding and a 16dp
        # outer margin. The overlay's calibrated Y is not a native hit target.
        # Send a complete tap inside the actual host row, independently of
        # whether the user touched the top, middle or bottom of the glass.
        margin = float(self.dp(16))
        native_width = float(decor.getWidth())
        fx = margin + (native_width - 2.0 * margin) / 3.0 * (idx + 0.5)
        ins = decor.getRootWindowInsets()
        if ins is not None:
            fy = float(ins.getSystemWindowInsetTop()) + margin + float(self.dp(24))
        else:
            fy = float(o["y"] - int(dloc[1]) + o["pad"] + (o["h"] - 2 * o["pad"]) * 0.25)
        ME = jclass("android.view.MotionEvent")
        for act_ in (0, 1):
            cp = ME.obtain(ev)
            cp.setAction(act_)
            cp.setLocation(fx, fy)
            try:
                cp.setDownTime(ev.getEventTime())
            except Exception:
                pass
            decor.dispatchTouchEvent(cp)
            cp.recycle()

    def _scr_touch(self, o, ev):
        # The glass owns the gesture. Only a completed selection produces one
        # native DOWN/UP pair; raw touches must not also activate content below.
        try:
            a = int(ev.getActionMasked())
            x = float(ev.getX())
            y = float(ev.getY())
            segw = (SCR_SEG_X1 - SCR_SEG_X0) / 3.0 * self.scr_S
            left0 = (SCR_SEG_X0 - SCR_PILL_X0) * self.scr_S + o["pad"]
            slop = float(self.dp(10))
            if a == 0:
                o["dx"], o["dy"] = x, y
                o["drag"] = False
                o["cancelled"] = False
                self.scr_press = True
            elif a == 2:
                if o["dx"] is None or o.get("cancelled"):
                    return True
                if not o["drag"] and abs(y - o["dy"]) > slop and abs(y - o["dy"]) > abs(x - o["dx"]):
                    o["cancelled"] = True
                    self.scr_press = False
                elif abs(x - o["dx"]) > slop:
                    o["drag"] = True
                if o["drag"]:
                    self.scr_lt = max(self._scr_lens_x(0), min(self._scr_lens_x(2), x - o["lw"] / 2.0))
            elif a in (1, 3):
                self.scr_press = False
                started = o["dx"] is not None
                dragged = o["drag"]
                valid = started and a == 1 and not o.get("cancelled")
                valid = valid and 0.0 <= y <= o["h"] and (dragged or 0.0 <= x <= o["w"])
                o["drag"] = False
                o["dx"] = None
                o["dy"] = None
                if valid:
                    idx = max(0, min(2, int((x - left0) // segw)))
                    self.scr_lt = self._scr_lens_x(idx)
                    if idx != self.scr_sel:
                        # Set pending state before dispatch: the host hook can
                        # synchronously confirm and clear it during the tap.
                        self.scr_opt = (idx, time.time())
                        self._scr_tap_host(o, ev, idx)
                    else:
                        self.scr_opt = None
                else:
                    self.scr_opt = None
                    self.scr_lt = self._scr_lens_x(self.scr_sel if self.scr_sel is not None else 0)
        except Exception as e:
            self.scr_press = False
            self._log("ERR касание переключателя: " + type(e).__name__ + ": " + str(e)[:120])
        return True

    def _mk_scr(self, act, key, sec, x, y, w, h, rad, band, seed, delay, pad, seg=False, fwd=False):
        from java import jclass
        Dialog = jclass("android.app.Dialog")
        FL = jclass("android.widget.FrameLayout")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        IV = jclass("android.widget.ImageView")
        ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        x, y, w, h = int(x), int(y), int(w), int(h)
        d = Dialog(act)
        d.requestWindowFeature(1)
        root = FL(act)
        iv = IV(act)
        iv.setScaleType(IV.ScaleType.FIT_XY)
        root.addView(iv, FLP(-1, -1))
        d.setContentView(root, FLP(w, h))
        win = d.getWindow()
        win.setBackgroundDrawable(ColorDrawable(0))
        win.clearFlags(2)
        # накладка не ловит касания (16); заменяющий переключатель их ловит и передаёт хосту
        win.addFlags((8 | 32 | 256 | 512) if (seg or fwd) else (8 | 16 | 32 | 256 | 512))
        win.setLayout(w, h)
        win.setGravity(51)  # TOP | LEFT
        lp = win.getAttributes()
        lp.x = x
        lp.y = y
        lp.windowAnimations = 0
        win.setAttributes(lp)
        sh = jclass("android.graphics.RuntimeShader")(AGSL_SEG if seg else AGSL_RIM)
        sh.setFloatUniform("res", float(w), float(h))
        sh.setFloatUniform("dpx", float(self.dens))
        sh.setFloatUniform("rad", float(rad))
        sh.setFloatUniform("pad", float(pad))
        sh.setFloatUniform("t", 0.8)
        sh.setFloatUniform("intro", 0.0)
        sh.setFloatUniform("vis", 0.0)
        sh.setFloatUniform("pulse", 0.0)
        sh.setFloatUniform("seed", float(seed))
        sh.setFloatUniform("k", 1.0)
        if seg:
            sh.setFloatUniform("lens", 0.0, 0.0, 1.0, 1.0)
            sh.setFloatUniform("lensA", 0.0)
            sh.setFloatUniform("stretch", 0.0)
            sh.setFloatUniform("infl", 0.0)
            sh.setFloatUniform("tilt", 0.0, 0.0)
            sh.setFloatUniform("sty", 1.0, 1.0, 0.9, 0.022)
        else:
            sh.setFloatUniform("band", float(band))
        area = float(w) * float(h)
        osc = 0.35 if area > 350000.0 else (0.5 if area > 120000.0 else 0.7)  # кромке не нужен полный размер
        if bool(self.get_setting("glass_opt", True)):
            osc = min(osc, 0.4)
        bw = max(8, int(w * osc))
        bh = max(8, int(h * osc))
        bufs = [Bitmap.createBitmap(bw, bh, Cfg.ARGB_8888), Bitmap.createBitmap(bw, bh, Cfg.ARGB_8888)]
        o = {"key": key, "sec": sec, "dlg": d, "iv": iv, "sh": sh, "x": x, "y": y, "w": w, "h": h,
             "pad": int(pad), "delay": float(delay), "bufs": bufs, "cur": 1, "pidx": 0, "seg": seg,
             "on": False, "shown": False, "have": False, "vis": 0.0, "intro": 0.0, "introv": 0.0,
             "intro_at": 0.0, "pulse": 0.0, "last": 0.0, "push_t": 0.0, "pk": None, "err": 0,
             "dx": None, "dy": None, "drag": False, "rt": "pm" if fwd else "bt",
             "effect": None}  # кэш RenderEffect
        if seg:
            self._seg_labels(o, self.scr_S)
            root.setClickable(True)
            root.setOnTouchListener(self.Tch(lambda ev: self._scr_touch(o, ev)))
        elif fwd:
            root.setClickable(True)
            root.setOnTouchListener(self.Tch(lambda ev: self._scr_fwd_only(o, ev)))
        iv.setRenderEffect(self.RE.createRuntimeShaderEffect(sh, "content"))
        return o

    def _setup_scr(self, act):
        self.scr = {}
        self.scr_resize_pending = False
        # scr_dead НЕ сбрасываем здесь автоматически —
        # его сбрасывает только явное on_setting_changed при включении glass_scr
        self.scr_fails = 0
        self.scr_pause_until = 0.0
        self.scr_miss = 0
        self.scr_cand = -1
        self.scr_cand_n = 0
        self.scr_fx = (bool(self.get_setting("glass_scr_fx", True)) and not self.get_setting("glass_reduce_motion", False)
                       and not self.get_setting("glass_opt", True) and int(self.q_tier) < 1)
        self.scr_tl = 0.0
        self.scr_t0 = time.time()
        self.scr_opt = None
        self.scr_la = 0.0
        self.scr_st = 0.0
        self.scr_press = False
        self.scr_infl = 0.0
        self.scr_rl_t = 0.0
        if self.RE is None or not self.get_setting("glass_scr", True):
            self._log("стекло экрана: выключено" + (" (нужен Android 13+ и AGSL)" if self.RE is None else " в настройках"))
            return
        S, base, inset = self._scr_layout(act)
        Sy = self.scr_Sy
        self.scr_S = S
        dens = float(self.dens)
        dy_top = self._fval("glass_scr_dy_top", 0.0) * dens
        dy_bot = self._fval("glass_scr_dy_bot", 0.0) * dens
        pad = self._pad()
        self._log("стекло экрана: S=" + str(round(S, 3)) + " Sy=" + str(round(Sy, 3))
                  + " низ=" + str(int(base)) + " inset=" + str(int(inset))
                  + " dy_top=" + str(int(dy_top)) + " dy_bot=" + str(int(dy_bot)))
        top_on = bool(self.get_setting("glass_scr_top_on", True))
        bot_on = bool(self.get_setting("glass_scr_bot_on", True))
        for (key, sec, x0, y0, x1, y1, r, band, seed, delay, bot) in SCR_ELEMS:
            if (bot and not bot_on) or ((not bot) and not top_on):
                continue  # блок выключен тумблером на вкладке Bluetooth
            top = (base - (SCR_REF_BOTTOM - y0) * Sy + dy_bot + self.bt_dy.get(key, 0.0)) if bot else (self.scr_origin_y + y0 * Sy + dy_top)
            bb = self.bt_boxes.get(key)
            if bb is not None:
                ox_, oy_ = bb[0] - pad, bb[1] - pad
                ow_, oh_ = (bb[2] - bb[0]) + 2 * pad, (bb[3] - bb[1]) + 2 * pad
            else:
                ox_, oy_ = x0 * S - pad + self.scr_origin_x, top - pad
                ow_, oh_ = (x1 - x0) * S + 2 * pad, (y1 - y0) * Sy + 2 * pad
            radius_scale = self._scr_btn_scale() if key in ("dev", "go") else 1.0
            o = self._mk_scr(act, key, sec, ox_, oy_, ow_, oh_, r * min(S, Sy) * radius_scale, band * dens, seed, delay, pad, key == "pill")
            self.scr[key] = o
            self._log("  слой " + key + ": x=" + str(o["x"]) + " y=" + str(o["y"]) + " " + str(o["w"]) + "x" + str(o["h"])
                      + (" (заменяет родной переключатель)" if o["seg"] else ""))
        spm = S * SCR_REF_W / SCR_PM_REF_W
        for (key, x0, y0, x1, y1, seed, delay) in SCR_PM:
            bx, by, bw, bh, br = self._pm_box(x0, y0, x1, y1, spm, pad)
            o = self._mk_scr(act, key, None, bx, by, bw, bh, br, 4.0 * dens, seed, delay, pad, False, True)
            o["pm_step"] = {"pm_add": 2, "pm_store": 3, "pm_gear": 4}[key]
            o["kb"] = 0.42  # базовая яркость кругов шапки: спокойнее, без пёстрой каймы
            self.scr[key] = o
            self._log("  слой " + key + ": x=" + str(o["x"]) + " y=" + str(o["y"]) + " " + str(o["w"]) + "x" + str(o["h"]))
        pill = self.scr.get("pill")
        if pill is not None:
            pill["lw"] = (SCR_SEG_X1 - SCR_SEG_X0) / 3.0 * S
            pill["lh"] = (295.0 - 175.0) * Sy
            pill["lt"] = pad + (175.0 - 147.0) * Sy
        self._tilt_start()
        self.scr_lt = self._scr_lens_x(self.scr_sel if self.scr_sel is not None else 0)
        self.scr_lx = self.scr_lt
        self.scr_lv = 0.0

    def _pad(self):
        # Толщина стеклянной кромки: настройка «Масштаб стекла» (70–130%). Элементы не двигаются.
        try:
            k = 1.0
        except Exception:
            k = 1.0
        return self.dp(12) * k

    def _tilt_start(self):
        # Датчик наклона (акселерометр): сверено с документацией — getAndroid().sensorStart(type, onEvent).
        # Формат события в документации не описан, поэтому разбираем защитно и пишем первые события в лог.
        self._tilt_stop()
        if not self.get_setting("glass_tilt", False) or self.get_setting("glass_opt", True) or int(self.q_tier) >= 2:
            return
        try:
            # sensorStart ожидает kotlin.jvm.functions.Function1, а не Python
            # callable. Создаём настоящий JVM proxy с методом invoke(Object).
            from java import dynamic_proxy, jclass
            Function1 = jclass("kotlin.jvm.functions.Function1")
            owner = self
            class SensorCallback(dynamic_proxy(Function1)):
                def __init__(self):
                    super().__init__()
                def invoke(self, ev):
                    owner._tilt_on(ev)
                    return None
            self.tilt_callback = SensorCallback()  # держим ссылку на время работы датчика
            self.tilt_id = self.api.getAndroid().sensorStart(1, self.tilt_callback)
            self._log("наклон: датчик " + ("включён" if self.tilt_id else "недоступен"))
        except Exception as e:
            self.tilt_id = None
            self._log("ERR датчик наклона: " + type(e).__name__ + ": " + str(e)[:120])

    def _tilt_stop(self):
        sid = self.tilt_id
        callback = getattr(self, "tilt_callback", None)
        self.tilt_id = None
        self.tilt_x = 0.0
        self.tilt_y = 0.0
        self.tilt_tx = 0.0
        self.tilt_ty = 0.0
        if sid is not None:
            try:
                self.api.getAndroid().sensorStop(sid)
            except Exception:
                pass
        self.tilt_callback = None

    def _tilt_on(self, ev):
        try:
            vals = None
            # Android SensorEvent передаёт значения в float[]; некоторые обёртки
            # возвращают JSON-строку или объект с полем values.
            try:
                vals = getattr(ev, "values", None)
            except Exception:
                vals = None
            if vals is None:
                d = json.loads(str(ev))
                vals = d if isinstance(d, list) else (d.get("values") or d.get("v") or [])
            ax = float(vals[0])
            ay = float(vals[1])
        except Exception:
            if self.tilt_n < 3:
                self._log("наклон: не разобрано событие: " + str(ev)[:160])
                self.tilt_n += 1
            return
        if self.tilt_n < 2:
            self._log("наклон: событие: " + str(ev)[:160])
            self.tilt_n += 1
        self.tilt_tx = max(-1.0, min(1.0, -ax / 9.8))
        self.tilt_ty = max(-1.0, min(1.0, ay / 9.8))

    def _buzz(self):
        try:
            self.api.getAndroid().vibrate(12)
        except Exception:
            pass

    def _scr_lens_x(self, idx):
        # левый край линзы в координатах окна переключателя
        pill = self.scr.get("pill")
        pad = pill["pad"] if pill is not None else 0
        segw = (SCR_SEG_X1 - SCR_SEG_X0) / 3.0
        return (SCR_SEG_X0 - SCR_PILL_X0) * self.scr_S + pad + segw * self.scr_S * idx

    def _scr_place(self, o, x):
        ix = int(round(x))
        if ix != o["x"]:
            o["x"] = ix
            win = o["dlg"].getWindow()
            lp = win.getAttributes()
            lp.x = ix
            win.setAttributes(lp)

    def _scr_relayout(self):
        # Пересчитываем геометрию теми же таблицами, что и при создании окон.
        # Раньше здесь использовались только старые SCR_ELEMS-координаты:
        # каждые 500 мс они затирали BT_TABLE/CARD_TABLE и отменяли масштаб кнопок.
        if not self.scr or self.act is None or self.scr_dead:
            return
        from java import jarray, jint
        S, base, inset = self._scr_layout(self.act)
        Sy = self.scr_Sy
        dens = float(self.dens)
        dy_top = self._fval("glass_scr_dy_top", 0.0) * dens
        dy_bot = self._fval("glass_scr_dy_bot", 0.0) * dens
        decor = self.act.getWindow().getDecorView()
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        pad = self._pad()
        spm = S * SCR_REF_W / SCR_PM_REF_W

        # Отдельно обновляем положение верхних значков экрана «Плагины».
        for (key, x0, y0, x1, y1, seed, delay) in SCR_PM:
            o = self.scr.get(key)
            if o is None:
                continue
            bx, by, bw, bh, br = self._pm_box(x0, y0, x1, y1, spm, pad)
            if abs(int(bw) - o["w"]) > 1 or abs(int(bh) - o["h"]) > 1:
                if not self.scr_resize_pending:
                    self.scr_resize_pending = True
                    self._post(self._setup, 0)
                return
            nx = int(round(bx))
            ny = int(round(by))
            if abs(nx - o["x"]) > 1 or abs(ny - o["y"]) > 1:
                o["x"] = nx
                o["y"] = ny
                win = o["dlg"].getWindow()
                lp = win.getAttributes()
                lp.x = nx
                lp.y = ny
                win.setAttributes(lp)

        # All/BLE/Advert, карточка и кнопки. Для dev/go/card обязательно
        # используем те же прямоугольники bt_boxes, что применены в _setup_scr.
        for (key, sec, x0, y0, x1, y1, r, band, seed, delay, bot) in SCR_ELEMS:
            o = self.scr.get(key)
            if o is None:
                continue
            top = (base - (SCR_REF_BOTTOM - y0) * Sy + dy_bot + self.bt_dy.get(key, 0.0)) if bot else (self.scr_origin_y + y0 * Sy + dy_top)
            bb = self.bt_boxes.get(key)
            if bb is not None:
                bx, by, br, btm = bb
                nx_f, ny_f = bx - pad, by - pad
                nw_f, nh_f = (br - bx) + 2 * pad, (btm - by) + 2 * pad
            else:
                nx_f = x0 * S - pad + self.scr_origin_x
                ny_f = top - pad
                nw_f = (x1 - x0) * S + 2 * pad
                nh_f = (y1 - y0) * Sy + 2 * pad
            nw, nh = int(nw_f), int(nh_f)
            if abs(nw - o["w"]) > 1 or abs(nh - o["h"]) > 1:
                # Размер окна/bitmap/RuntimeShader задаётся при создании.
                # Пересобираем, а не растягиваем старый bitmap с неверной геометрией.
                if not self.scr_resize_pending:
                    self.scr_resize_pending = True
                    self._post(self._setup, 0)
                return
            nx = int(round(nx_f))
            ny = int(round(ny_f))
            if abs(nx - o["x"]) > 1 or abs(ny - o["y"]) > 1:
                o["x"] = nx
                o["y"] = ny
                win = o["dlg"].getWindow()
                lp = win.getAttributes()
                lp.x = nx
                lp.y = ny
                win.setAttributes(lp)
        self.scr_S = S

    def _scr_watch_start(self):
        if self.watch_on or not self.alive or self.handler is None:
            return
        self.watch_on = True
        self.handler.postDelayed(self.watch_run, 40)

    def _scr_watch(self):
        # Проверка стеклянных окон каждые 5 мс, но только пока открыт экран Bluetooth.
        # Окно, которое должно быть показано, но не видно, показываем снова; если окон нет — пересобираем
        # (не чаще раза в секунду).
        self.watch_on = False
        if not self.alive or self.handler is None or not self._scr_route_ok():
            return
        try:
            if self.act is not None:
                if self.scr:
                    for o in tuple(self.scr.values()):
                        if o.get("shown") and not o["dlg"].isShowing():
                            if not self._scr_rt_ok(o):
                                o["dlg"].hide()
                                o["shown"] = False
                                o["vis"] = 0.0
                                o["have"] = False
                                continue
                            o["dlg"].show()
                            o["have"] = False
                            self._log("стекло: окно «" + str(o["key"]) + "» восстановлено")
                elif not self.scr_dead and self.native_ok and self.get_setting("glass_scr", True):
                    now = time.time()
                    if now - self.watch_rb_t > 1.0:
                        self.watch_rb_t = now
                        self._log("стекло: окон нет, пересборка")
                        self._post(self._setup, 0)
        except Exception as e:
            self._log("ERR проверка стекла: " + type(e).__name__ + ": " + str(e)[:120])
        if self.alive and self.handler is not None and self._scr_route_ok():
            self.watch_on = True
            self.handler.postDelayed(self.watch_run, 40)

    def _scr_kill(self):
        scr = getattr(self, "scr", None) or {}
        self.scr = {}
        for o in scr.values():
            try:
                o["dlg"].dismiss()
            except Exception:
                pass
            self._recycle_bitmaps(o.get("bufs"))
            self._recycle_bitmap(o.get("lbl"))

    def _scr_fail(self, e):
        msg = str(e).lower()
        if ("backing surface" in msg or "not attached" in msg
                or time.time() < getattr(self, "nav_quiet", 0.0)):
            self.scr_pause_until = max(getattr(self, "scr_pause_until", 0.0), time.time() + 1.0)
            return
        self.scr_fails += 1
        if self.scr_fails >= 20:
            self._scr_kill()
            self.scr_dead = True
            self._log("ERR стекло экрана отключено после 20 сбоев подряд: " + type(e).__name__ + ": " + str(e)[:140])
            try:
                self.toast("GlassBar: стекло экрана отключено (" + str(e)[:80] + ")")
            except Exception:
                pass
        else:
            # окна не трогаем: пауза на 1,5 с, и захват продолжится сам
            self.scr_pause_until = time.time() + 1.5
            if self.scr_fails == 1:
                self._log("стекло: сбой захвата (" + type(e).__name__ + "), пауза 1.5 с, окна сохранены")

    def hook_bluetooth_section_select(self, payload):
        # Основной источник состояния вкладки. PixelCopy остаётся fallback для
        # внешних изменений UI и старых сборок хоста.
        try:
            data = payload
            if isinstance(payload, str):
                data = json.loads(payload)
            if not isinstance(data, dict):
                return None
            idx = data.get("index")
            section = str(data.get("section", "")).lower()
            if section in SCR_NAMES:
                idx = SCR_NAMES.index(section)
            elif section in ("all", "ble", "advert"):
                idx = ("all", "ble", "advert").index(section)
            idx = int(idx)
            if idx < 0 or idx >= len(SCR_NAMES):
                return None
            self.scr_action_sel = idx
            self.scr_action_t = time.time()
            if self.scr:
                self._scr_set_sel(idx)
            self._log("action: секция Bluetooth → " + SCR_NAMES[idx])
        except Exception as e:
            self._log("ERR action секции Bluetooth: " + type(e).__name__ + ": " + str(e)[:100])
        return None

    def _scr_set_sel(self, idx):
        old = self.scr_sel
        self.scr_sel = idx
        self.scr_opt = None
        if not (self.scr.get("pill") or {}).get("drag"):
            self.scr_lt = self._scr_lens_x(idx)
        self._log("секция Bluetooth: " + SCR_NAMES[idx])
        if self.get_setting("haptic_sections", False):
            self._buzz()
        o = self.scr.get("pill")
        if old is not None and self.scr_fx and o is not None:
            o["pulse"] = 1.0

    def _scr_detect(self, o, bmp):
        # Once the host reports a section, pixel brightness is no longer an
        # authority: snapshots contain the host's moving selection animation.
        if self.scr_action_sel is not None or self.scr_press or o.get("drag"):
            return
        S = self.scr_S
        w = int(bmp.getWidth())
        h = int(bmp.getHeight())
        sx = w / float(o["w"])
        sy = h / float(o["h"])
        segw = (SCR_SEG_X1 - SCR_SEG_X0) / 3.0 * S
        left0 = (SCR_SEG_X0 - SCR_PILL_X0) * S + o["pad"]
        yy = max(0, min(h - 1, int(o["h"] * 0.5 * sy)))
        lum = []
        for i in range(3):
            acc = 0.0
            for fr in (0.16, 0.84):
                xx = max(0, min(w - 1, int((left0 + segw * i + segw * fr) * sx)))
                pv = int(bmp.getPixel(xx, yy)) & 0xFFFFFFFF
                acc += 0.299 * ((pv >> 16) & 255) + 0.587 * ((pv >> 8) & 255) + 0.114 * (pv & 255)
            lum.append(acc / 2.0)
        best = -1
        bd = 0.0
        for i in range(3):
            oth = [lum[j] for j in range(3) if j != i]
            diff = abs(lum[i] - (oth[0] + oth[1]) / 2.0)
            if diff > bd and abs(oth[0] - oth[1]) < diff * 0.5:
                best = i
                bd = diff
        if best < 0 or bd < 22.0:
            self.scr_miss += 1
            return
        self.scr_miss = 0
        if best == self.scr_cand:
            self.scr_cand_n += 1
        else:
            self.scr_cand = best
            self.scr_cand_n = 1
        if o.get("drag"):
            return  # палец ведёт линзу: снимок хоста не должен её перебивать
        opt = self.scr_opt
        if opt is not None:
            # ждём переключения: промежуточная подсветка хоста (например, на All) не считается выбором
            if best == opt[0]:
                self.scr_opt = None
                if best != self.scr_sel:
                    self._scr_set_sel(best)
            return
        if self.scr_cand_n >= 2 and best != self.scr_sel:
            self._scr_set_sel(best)

    def _scr_capture(self, o, now, animating):
        if now < max(getattr(self, "nav_quiet", 0.0), getattr(self, "copy_pause_until", 0.0)):
            return
        k = "s_" + o["key"]
        if self.busy.get(k):
            return
        if o["key"] == "pill":
            iv = (1.0 / 30.0) if animating else (1.0 / 12.0)
        elif o["rt"] == "pm":
            iv = 1.0 / 30.0  # кнопки шапки «Плагины»: всегда живые
        else:
            iv = (1.0 / 30.0) if animating else (1.0 / 4.0)
        if self.opt:
            iv = max(iv, (1.0 / 20.0) if animating else (1.0 / 3.0))
        iv = max(iv, 1.0 / max(1.0, self.fps_amt))
        if now - o["last"] < iv:
            return
        cb = self.pcls.get(k)
        if cb is None:
            return
        from java import jclass, jarray, jint
        decor = self.act.getWindow().getDecorView()
        dloc = jarray(jint)([0, 0])
        decor.getLocationOnScreen(dloc)
        l = o["x"] - int(dloc[0])
        t = o["y"] - int(dloc[1])
        r = l + o["w"]
        b = t + o["h"]
        if l < 0 or t < 0 or r > int(decor.getWidth()) or b > int(decor.getHeight()):
            return  # окно вышло за экран: снимок исказился бы
        o["last"] = now
        idx = 1 - o["cur"]
        o["pidx"] = idx
        self.busy[k] = True
        self._request_copy(k, self.act.getWindow(), jclass("android.graphics.Rect")(l, t, r, b), o["bufs"][idx])

    def _scr_on_copy(self, key, result):
        o = self.scr.get(key[2:])
        if o is None:
            return
        if result != 0:
            o["err"] = o.get("err", 0) + 1
            self._log("WARN PixelCopy[" + str(key) + "] result=" + str(result))
            self._scr_fail(RuntimeError("PixelCopy result=" + str(result)))
            return
        o["err"] = 0
        self.scr_fails = 0
        bmp = o["bufs"][o["pidx"]]
        o["iv"].setImageBitmap(bmp)
        o["cur"] = o["pidx"]
        o["have"] = True
        if o["key"] == "pill":
            self._scr_detect(o, bmp)

    # ------------------------------------------------------------------ журнал анимации
    # glass_anim.json в приватной папке плагина (создаётся редактором). Дорожки: light, opacity, pulse, rot.
    def _anim_load(self):
        self.anim_j = None
        try:
            txt = self.api.getAndroid().filesRead("glass_anim.json")
            if txt is None:
                return
            j = json.loads(str(txt))
            tracks = j.get("tracks", {})
            clean = {}
            for k in ANIM_KEYS:
                pts = sorted(tracks.get(k, []), key=lambda p: float(p["t"]))
                if pts:
                    clean[k] = [(float(p["t"]), float(p["v"]), str(p.get("ease", "lin"))) for p in pts]
            dur = float(j.get("dur", 2.0))
            if dur <= 0.05:
                dur = 2.0
            self.anim_j = {"dur": dur, "loop": bool(j.get("loop", True)), "tracks": clean}
            self.anim_t0 = time.time()
            self._log("журнал анимации: " + str(j.get("name", "без имени")) + ", " + str(round(dur, 2))
                      + " с, дорожек " + str(len(clean)))
        except Exception as e:
            self.anim_j = None
            self._log("ERR журнал анимации: " + type(e).__name__ + ": " + str(e)[:140])

    def _ease(self, name, x):
        if name == "in":
            return x * x
        if name == "out":
            return 1.0 - (1.0 - x) * (1.0 - x)
        if name == "inout":
            return 0.5 * (1.0 - math.cos(math.pi * x))
        return x

    def _anim_eval(self, pts, t):
        if t <= pts[0][0]:
            return pts[0][1]
        if t >= pts[-1][0]:
            return pts[-1][1]
        for i in range(len(pts) - 1):
            t0, v0, e = pts[i]
            t1, v1, _ = pts[i + 1]
            if t0 <= t <= t1:
                x = 0.0 if t1 <= t0 else (t - t0) / (t1 - t0)
                return v0 + (v1 - v0) * self._ease(e, x)
        return pts[-1][1]

    def _anim_now(self):
        j = self.anim_j
        if j is None:
            self.anim_active = False
            return {}
        elapsed = time.time() - self.anim_t0
        d = j["dur"]
        if j["loop"]:
            self.anim_active = True
            t = elapsed % d
        else:
            self.anim_active = elapsed < d
            t = min(elapsed, d)
        return {k: self._anim_eval(p, t) for k, p in j["tracks"].items()}

    def _anim_xform(self, o):
        # Появление как в версии 25: масштаб 84% → 100% с перелётом.
        x = min(max(o["intro"], 0.0), 1.12)
        sc = 0.84 + 0.16 * x
        px, py, _ = self._pm_press(o, time.time())
        return sc * px, sc * py, 0.0, 0.0

    def _scr_push(self, o, t):
        sh = o["sh"]
        sh.setFloatUniform("t", float(t))
        sh.setFloatUniform("intro", float(o["intro"]))
        av = self.anim_cur
        _, _, press_glow = self._pm_press(o, time.time())
        sh.setFloatUniform("pulse", float(min(1.0, o["pulse"] + press_glow + max(0.0, av.get("pulse", 0.0)))))
        sh.setFloatUniform("k", float(max(0.0, av.get("light", 1.0))) * float(o.get("kb", 1.0)))
        sh.setFloatUniform("vis", float(o["vis"] * min(1.0, max(0.0, av.get("opacity", 1.0)))))
        o["iv"].setRotation(float(av.get("rot", 0.0)))
        if o["seg"]:
            sh.setFloatUniform("lens", float(self.scr_lx), float(o["lt"]), float(o["lw"]), float(o["lh"]))
            sh.setFloatUniform("lensA", float(self.scr_la))
            sh.setFloatUniform("stretch", float(self.scr_st))
            sh.setFloatUniform("infl", float(self.scr_infl))
            sh.setFloatUniform("tilt", float(self.tilt_x), float(self.tilt_y))
            sh.setFloatUniform("sty", 1.0, 1.0, 0.9, 0.022)
        sx, sy, tx, ty = self._anim_xform(o)
        o["iv"].setScaleX(float(sx))
        o["iv"].setScaleY(float(sy))
        o["iv"].setTranslationX(float(tx))
        o["iv"].setTranslationY(float(ty))
        o["iv"].setRenderEffect(self.RE.createRuntimeShaderEffect(sh, "content"))

    def _scr_tick(self):
        scr = self.scr
        if not scr or self.scr_dead or self.act is None:
            return
        if time.time() < self.scr_pause_until:
            return
        if not self._scr_route_ok() and not any(o.get("shown") for o in scr.values()):
            return
        now = time.time()
        if now - self.scr_rl_t > 0.5:
            self.scr_rl_t = now
            try:
                self._scr_relayout()
            except Exception as rx:
                self._log("ERR пересчёт стекла: " + type(rx).__name__ + ": " + str(rx)[:120])
        dt = (now - self.scr_tl) if self.scr_tl > 0.0 else 0.0
        self.scr_tl = now
        dt = min(max(dt, 0.0), 0.05)
        fx = self.scr_fx
        reduced = bool(self.get_setting("glass_reduce_motion", False))
        route_ok = self._scr_route_ok()
        sel = self.scr_sel
        t = (now - self.scr_t0) if fx else 0.8
        tdt = min(max(now - self.tilt_tl, 0.0), 0.05) if self.tilt_tl else 0.0
        self.tilt_tl = now
        kx = 1.0 - math.exp(-tdt * 5.0)
        self.tilt_x += (self.tilt_tx - self.tilt_x) * kx
        self.tilt_y += (self.tilt_ty - self.tilt_y) * kx
        self.anim_cur = {} if reduced else self._anim_now()
        opt = self.scr_opt
        if opt is not None and now - opt[1] > 2.5:
            # хост так и не подтвердил: снимаем ожидание и ставим линзу на фактически выбранную секцию
            self.scr_opt = None
            if sel is not None and not (self.scr.get("pill") or {}).get("drag"):
                self.scr_lt = self._scr_lens_x(sel)
        self.scr_la += ((1.0 if sel is not None else 0.0) - self.scr_la) * (1.0 - math.exp(-dt * 10.0))
        self.scr_infl += ((1.0 if self.scr_press else 0.0) - self.scr_infl) * (1.0 - math.exp(-dt * 14.0))
        if self.scr_infl < 0.002:
            self.scr_infl = 0.0
        for key, o in tuple(scr.items()):
            want = self._scr_rt_ok(o) and (o["sec"] is None or o["sec"] == sel)
            if want and not o["on"]:
                o["on"] = True
                o["intro"] = 0.0 if fx else 1.0
                o["introv"] = 0.0
                o["intro_at"] = now + o["delay"]
                o["pulse"] = 0.0
                if o["seg"]:
                    self.scr_lx = self.scr_lt
                    self.scr_lv = 0.0
                if not o["shown"]:
                    o["dlg"].show()
                    o["shown"] = True
            elif not want and o["on"]:
                o["on"] = False
            o["vis"] += ((1.0 if want else 0.0) - o["vis"]) * (1.0 - math.exp(-dt * (10.0 if want else 14.0)))
            if not want and o["shown"] and o["vis"] < 0.01:
                o["dlg"].hide()
                o["shown"] = False
                o["vis"] = 0.0
                o["have"] = False
            if not o["shown"]:
                if o["seg"]:
                    self.scr_press = False
                continue
            moving = False
            if reduced:
                self.scr_lx = self.scr_lt
                self.scr_lv = 0.0
                self.scr_st = 0.0
                self.scr_infl = 0.0
                o["intro"] = 1.0
                o["introv"] = 0.0
                o["pulse"] = 0.0
            if o["seg"] and o["on"] and not reduced:
                x = self.scr_lx
                v = self.scr_lv
                tx = self.scr_lt
                if abs(tx - x) > 0.3 or abs(v) > 3.0:
                    kk = 900.0 if o["drag"] else 420.0
                    zz = 0.9 if o["drag"] else 0.42
                    n = max(1, int(dt / 0.008))
                    hh = dt / n
                    for _ in range(n):
                        v += (-kk * (x - tx) - 2.0 * zz * math.sqrt(kk) * v) * hh
                        x += v * hh
                    if abs(tx - x) < 0.3 and abs(v) < 3.0:
                        x = tx
                        v = 0.0
                    self.scr_lx = x
                    self.scr_lv = v
                    moving = True
                    self.scr_st = min(1.0, abs(v) / (o["lw"] * 6.0))
                    if fx:
                        o["pulse"] = max(o["pulse"], min(0.5 if o["drag"] else 1.0, abs(v) / (o["lw"] * 5.0)))
                else:
                    self.scr_st = 0.0
            running = False
            if o["on"] and o["have"] and now >= o["intro_at"] and (o["intro"] != 1.0 or o["introv"] != 0.0):
                x = o["intro"]
                v = o["introv"]
                n = max(1, int(dt / 0.008))
                hh = dt / n
                for _ in range(n):
                    v += (-110.0 * (x - 1.0) - 2.0 * 0.42 * math.sqrt(110.0) * v) * hh
                    x += v * hh
                if abs(x - 1.0) < 0.002 and abs(v) < 0.01:
                    x = 1.0
                    v = 0.0
                o["intro"] = x
                o["introv"] = v
                running = True
            if fx and o["pulse"] > 0.0:
                o["pulse"] *= math.exp(-dt * 3.2)
                if o["pulse"] < 0.01:
                    o["pulse"] = 0.0
            animating = moving or running or o["pulse"] > 0.01 or self.anim_active or bool(self.tilt_id) or (o["seg"] and (self.scr_press or self.scr_infl > 0.01))
            try:
                self._scr_capture(o, now, animating)
            except Exception as ce:
                self.busy["s_" + key] = False
                o["err"] += 1
                if o["err"] >= 20:
                    raise ce
            if o["vis"] < 0.01:
                continue
            live = o["rt"] == "pm"  # кнопки шапки «Плагины»: плавно, без округления времени
            tq = round(t, 3) if (animating or live) else round(t, 1)
            pk = (round(o["vis"], 3), round(o["intro"], 3), round(o["pulse"], 3), tq if fx else 0.0)
            pk = pk + tuple(round(x, 2) for x in self.anim_cur.values())
            if live:
                pk += tuple(round(x, 4) for x in self._pm_press(o, now))
            if o["seg"]:
                pk = pk + (round(self.scr_lx, 1), round(self.scr_la, 2), round(self.scr_st, 2), round(self.scr_infl, 2), round(self.tilt_x, 2), round(self.tilt_y, 2))
            interval = 0.0 if live else ((1.0 / 40.0) if animating else ((1.0 / 12.0) if fx else 0.0))
            if pk != o["pk"] and now - o["push_t"] >= interval:
                o["pk"] = pk
                o["push_t"] = now
                self._scr_push(o, t)

    # ------------------------------------------------------------------ штатная панель
    def screen_bar(self, ui, api, state):
        if self.native_ok and self.get_setting("glass_enabled", True):
            return ui.spacer(height=1)

        # запасной вариант: обычная плавающая панель
        def go(route):
            def click():
                self.navigate_app(route)
            return click
        bar = ui.floating_toolbar([
            ui.toolbar_item("bluetooth", go("bluetooth"), label="Bluetooth"),
            ui.toolbar_item("extension", go("other"), label="Функции"),
            ui.toolbar_item("settings", go("settings"), label="Настройки"),
            ui.toolbar_item("extension", go("plugin_manager"), label="Плагины"),
        ])
        if self.err:
            return ui.column([
                ui.text("GlassBar: " + self.err, "labelSmall", "error", 6),
                bar,
            ], padding=4, spacing=4)
        return bar
