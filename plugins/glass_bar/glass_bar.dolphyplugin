        self.api.registerSettings("Glass Bar", json.dumps([
            {"type": "header", "title": "GLASS BAR · УПРАВЛЕНИЕ"},
            {"type": "switch", "key": "glass_opt", "title": "⚡ ОПТИМИЗИРОВАННЫЙ РЕЖИМ  (рекомендуется)",
             "subtitle": "Стекло без лагов: 60 кадров/с даже на слабых телефонах. Реалистичная кромка, преломление и блики остаются; "
                         "тяжёлое (трещины, размытие, зерно, дисперсия, наклон, бета-шейдер) отключается",
             "default": True},
            {"type": "nav", "title": "Основная панель", "subtitle": "Внешний вид, стеклянные элементы и масштаб панели",
             "icon": "tune", "screen": "glass_panel"},
            {"type": "nav", "title": "Визуальные параметры", "subtitle": "Свечение, преломление, прозрачность и Frosted Glass",
             "icon": "tune", "screen": "glass_settings"},
            {"type": "switch", "key": "glass_ny_beta_enabled", "title": "Новогодний бар (бета)",
             "subtitle": "Снег, сосульки и праздничный декор. По умолчанию выключен",
             "default": False},
            {"type": "nav", "title": "Бета · Реалистичное стекло", "subtitle": "Физический шейдер: преломление, дисперсия, Френель, блики. Отключает обычные настройки стекла",
             "icon": "science", "screen": "glass_beta"},
            {"type": "nav", "title": "Анимация", "subtitle": "Желейная анимация, верхние накладки, наклон, движение",
             "icon": "tune", "screen": "glass_anim"},
            {"type": "nav", "title": "Bluetooth", "subtitle": "Стекло на экране All/BLE/Advert и калибровка",
             "icon": "tune", "screen": "glass_bt"},
            {"type": "nav", "title": "Система", "subtitle": "Профиль производительности и окно логов",
             "icon": "speed", "screen": "glass_system"},
        ]), 30)
        self._publish_eq_bridge(True)
        self._log("Glass Bar " + str(globals().get("__version__", "?")) + " загружен")
        self._anim_load()
        self._log_device()
        self._start()

    def on_plugin_unload(self):
        self._publish_eq_bridge(False)
        self._stop()

    def on_plugin_disable(self):
        self._publish_eq_bridge(False)
        self._stop()

    def _publish_eq_bridge(self, active=True):
        """Share only the public optimized-mode state with Dolphy EQ via app-private prefs."""
        try:
            ctx = self.api.getContext()
            prefs = ctx.getSharedPreferences("dolphy_cross_plugin_state", 0)
            edit = prefs.edit()
            edit.putBoolean("glass_bar_active", bool(active))
            edit.putBoolean("glass_bar_opt", bool(self.get_setting("glass_opt", True)))
            edit.putInt("glass_bar_bridge_version", 1)
            edit.putLong("glass_bar_state_updated", int(time.time() * 1000))
            edit.apply()
        except Exception as e:
            try:
                self._log("EQ bridge unavailable: " + type(e).__name__ + ": " + str(e)[:90])
            except Exception:
                pass

    def on_activity_create(self, activity):
        self._log("activity create (маршрут=" + (self.route or "-") + ")")
        self.scr_miss = 0
        self._scr_watch_start()
        if self.alive and self.handler is not None:
            self._post(self._setup, 300)

    def on_activity_destroy(self, activity):
        self._log("activity destroy")
        self.pressed = False
        self.dragging = False
        self.hover = None
        self.touch_strength = 0.0
        self.nav_pending = None
        self._teardown_ui()

    def _route_matches_target(self, route, target):
        r = str(route or "").lower()
        t = str(target or "").lower()
        if t == "plugin_manager":
            return r.startswith("plugin")
        if t == "other":
            return any(r.startswith(p) for p in TABS[1][3])
        if t == "settings":
            return any(r.startswith(p) for p in TABS[2][3])
        if t == "bluetooth":
            return any(r.startswith(p) for p in TABS[0][3])
        return r == t or r.startswith(t + "/")

    def on_navigation(self, route):
        incoming = str(route)
        if incoming.startswith("other/"):
            incoming = incoming[len("other/"):]
        # Dolphy иногда доставляет старое событие навигации через несколько секунд.
        # Если пользователь уже выбрал другую вкладку, не даём этому событию
        # откатить маршрут и запустить повторную синхронизацию/пересборку окон.
        intent_t = getattr(self, "_last_go_t", 0.0)
        intent_route = getattr(self, "_last_go_route", None)
        age = time.time() - intent_t if intent_t else 999.0
        if (intent_route and age < 8.0
                and not self._route_matches_target(incoming, intent_route)):
            self._log("nav: устаревшее событие " + incoming + " пропущено; ожидается "
                      + str(intent_route) + " (" + str(int(age * 1000)) + " мс после выбора)")
            return
        self.route = incoming
        if intent_route and self._route_matches_target(self.route, intent_route):
            self.nav_pending = None
        elif not intent_route or age >= 8.0:
            self.nav_pending = None
        self.scr_miss = 0
        self.nav_quiet = time.time() + 0.70  # ждём, пока Activity и её Surface стабилизируются
        self._scr_watch_start()
        lc = getattr(self, "last_nav_call", 0.0)
        late = (" (+" + str(int((time.time() - lc) * 1000)) + " мс после navigate_app)") if lc and time.time() - lc < 10.0 else ""
        self._log("nav → " + self.route + late)
        self._scale_recheck(force=True)
        self._bt_det_entry()
        if not self.route.lower().startswith("plugin/"):
            self.preview = False
        if self.handler is not None:
            self._post(self._sync, 0)
            if self._winter_decor_enabled() != getattr(self, "ice_applied", False):
                self._post(self._apply_live, 0)
        self.refresh()

    def on_setting_changed(self, payload):
        self._publish_eq_bridge(True)
        self._log("setting " + str(payload))
        if self.get_setting("glass_enabled", True):
            if self.handler is not None:
                self.scr_dead = False  # явное включение — разрешаем пересборку
                self.geom_pending = True  # изменение настроек требует явного обновления UI
                self.tick_running = True
                self._post(self._setup, 0)
        else:
            self._teardown_ui()
            self.native_ok = False
        self.refresh()

    # ------------------------------------------------------------------ служебное
    def _start(self):
        try:
            from java import jclass
            Handler = jclass("android.os.Handler")
            Looper = jclass("android.os.Looper")
            self.handler = Handler(Looper.getMainLooper())
            self.Run, self.Clk, self.Pcl, self.Upd, self.Tch, self.Frm = make_proxies()
            self.choreo = jclass("android.view.Choreographer")
            self.frame_cb = self.Frm(self._tick)
            self.tick_run = self.Run(self._tick)
            self.watch_run = self.Run(self._scr_watch)
            for key in ("bar", "bub", "glass", "btn", "ttl", "log", "probe", "s_pill", "s_card", "s_dev", "s_go", "s_pm_add", "s_pm_store", "s_pm_gear"):
                self.pcls[key] = self.Pcl(self._make_copy_cb(key))
            self._post(self._setup, 200)
            self.tick_running = True
            self.handler.postDelayed(self.tick_run, 400)
        except Exception as e:
            self._fail(e)

    def _stop(self):
        self.alive = False
        self.watch_on = False
        self._tilt_stop()
        try:
            self.handler.removeCallbacks(self.watch_run)
        except Exception:
            pass
        self._teardown_ui()

    def _post(self, fn, delay=0):
        try:
            r = self.Run(fn)
            if delay:
                self.handler.postDelayed(r, delay)
            else:
                self.handler.post(r)
        except Exception as e:
            self._fail(e)

    def _fail(self, e):
        self.native_ok = False
        try:
            line = ""
            try:
                fr = traceback.extract_tb(e.__traceback__)
                if fr:
                    line = " @L" + str(fr[-1].lineno)
            except Exception:
                pass
            self.err = "[" + str(self.stage) + "] " + type(e).__name__ + line + ": " + str(e)[:200]
        except Exception:
            self.err = "[" + str(self.stage) + "] error"
        self._log("ERR " + str(self.err))
        try:
            tb = "".join(traceback.format_exception(type(e), e, e.__traceback__)).strip().splitlines()
            self._log("TB " + " | ".join(x.strip() for x in tb[-4:]))
        except Exception:
            pass
        try:
            self._teardown_ui()
        except Exception:
            pass
        try:
            self.toast("GlassBar: " + self.err[:140])
        except Exception:
            pass
        try:
            self.refresh()
        except Exception:
            pass
        # Планируем повторную попытку сборки через 1.5 с
        try:
            if self.alive and self.handler is not None:
                self._post(self._setup, 1500)
        except Exception:
            pass

    def _sel_index(self):
        r = self.route.lower()
        if r.startswith("plugin"):
            return 3
        for i, tab in enumerate(TABS):
            if i == 3:
                continue
            if any(r.startswith(p) for p in tab[3]):
                return i
        return 0

    def _route_visible(self):
        return self.route.lower() in VISIBLE_ROUTES or self.preview

    # ------------------------------------------------------------------ сборка окна
    def _glass(self, h, base, filt, tint, stroke_w, stroke_col):
        from java import jclass, jarray, jint
        act = self.act
        FrameLayout = jclass("android.widget.FrameLayout")
        ImageView = jclass("android.widget.ImageView")
        View = jclass("android.view.View")
        GD = jclass("android.graphics.drawable.GradientDrawable")
        GDO = jclass("android.graphics.drawable.GradientDrawable$Orientation")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        PDM = jclass("android.graphics.PorterDuff$Mode")
        radius = float(h) / 2.0

        cont = FrameLayout(act)
        bg = GD()
        bg.setColor(argb(base))
        bg.setCornerRadius(radius)
        cont.setBackground(bg)
        cont.setClipToOutline(True)

        iv = ImageView(act)
        iv.setScaleType(ImageView.ScaleType.FIT_XY)
        iv.setColorFilter(argb(filt), PDM.SRC_ATOP)
        cont.addView(iv, FLP(-1, -1))

        tv = View(act)
        tg = GD()
        tg.setOrientation(GDO.TOP_BOTTOM)
        tg.setColors(jarray(jint)([argb(c) for c in tint]))
        tg.setCornerRadius(radius)
        tg.setStroke(stroke_w, argb(stroke_col))
        tv.setBackground(tg)
        cont.addView(tv, FLP(-1, -1))
        return cont, iv

    def _setup(self):
        # Несколько событий lifecycle/setting/navigation могут поставить setup
        # в очередь почти одновременно. Не пересоздаём Dialog повторно для той же Activity.
        if self._setup_busy:
            return
        try:
            current_act = self.api.getActivity()
        except Exception:
            current_act = None
        if (self.dlg is not None and self.shown and not self.geom_pending
                and current_act is not None and current_act == self.act):
            return
        self._setup_busy = True
        try:
            self._setup_impl()
        finally:
            self._setup_busy = False

    def _setup_impl(self):
        self.geom_pending = False
        self.scr_resize_pending = False
        self.geom_sig = None
        if not self.alive or not self.get_setting("glass_enabled", True):
            return
        try:
            from java import jclass
            self.stage = "activity"
            act = self.api.getActivity()
            if act is None:
                self.retries += 1
                if self.retries == 12:
                    self._log("ERR getActivity() вернул None (12 попыток)")
                    self.err = "getActivity() вернул None"
                    self.refresh()
                if self.retries < 200:
                    self._post(self._setup, 600)
                return
            self.retries = 0  # успешно — сбрасываем серию неудач
            self.stage = "teardown"
            self._teardown_ui()
            self.act = act
            dens = act.getResources().getDisplayMetrics().density
            self.dens = dens
            dp = lambda v: int(v * dens + 0.5)
            self.dp = dp
            try:
                bk = float(self.get_setting("glass_bar_scale", 100)) / 100.0
            except Exception:
                bk = 1.0
            bk = max(0.7, min(1.3, bk))
            self.bk = bk
            bdp = lambda v: int(v * dens * bk + 0.5)
            self.bdp = bdp

            Dialog = jclass("android.app.Dialog")
            FrameLayout = jclass("android.widget.FrameLayout")
            LinearLayout = jclass("android.widget.LinearLayout")
            ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
            FLP = jclass("android.widget.FrameLayout$LayoutParams")

            screen_w = int(act.getWindow().getDecorView().getWidth()) or int(act.getResources().getDisplayMetrics().widthPixels)
            w = int(min(screen_w * 0.92, dp(460)) * 0.77 * bk)
            w = max(dp(120), min(w, screen_w - 2 * bdp(14) - dp(8)))
            self.pad = bdp(14)               # запас по бокам, чтобы линза могла «надуваться»
            self.tw = w // len(TABS)
            self.w_bar = w
            self.stage = "shader"
            sh = self._try_shader()
            # Если пользователь выбрал классический стиль — принудительно fallback
            if sh and bool(self.get_setting("glass_style_fallback", False)):
                sh = False
                self.shader = None
            self.stage = "window"
            bar_h = bdp(54)
            bar_top = bdp(19) if sh else bdp(11)
            win_h = bdp(85) if sh else bdp(77)
            win_w = w + 2 * self.pad
            bub_h = (bar_h + bdp(12)) if sh else bdp(45)
            self.bub_w = int(self.tw * 1.18) if sh else (self.tw - bdp(3))
            bub_top = bar_top + (bar_h - bub_h) // 2
            self.bar_top, self.bar_h = bar_top, bar_h  # нужны касаниям даже без шейдера
            self.ny_geo = (win_w, win_h, bar_top, bar_h, w, self.pad)
            self.ny_iv = None

            dlg = Dialog(act)
            dlg.requestWindowFeature(1)

            root = FrameLayout(act)

            self.stage = "layers"
            glass_iv = None
            if sh:
                View = jclass("android.view.View")
                ImageView = jclass("android.widget.ImageView")
                glass_iv = ImageView(act)
                glass_iv.setScaleType(ImageView.ScaleType.FIT_XY)
                root.addView(glass_iv, FLP(-1, -1))
                bub = View(act)  # невидимый держатель состояния линзы (в окно не добавляется)
            else:
                bar, bar_iv = self._glass(
                    bar_h, 0xCC1B1720, 0x26000000,
                    [0x26FFFFFF, 0x06FFFFFF, 0x12FFFFFF], max(1, dp(1)), 0x44FFFFFF)
                lpb = FLP(w, bar_h)
                lpb.topMargin = bar_top
                lpb.leftMargin = self.pad
                root.addView(bar, lpb)

                bub, bub_iv = self._glass(
                    bub_h, 0xCC2A2430, 0x08000000,
                    [0x38FFFFFF, 0x10FFFFFF, 0x20FFFFFF], max(2, dp(1)), 0x66FFFFFF)
                lpu = FLP(self.bub_w, bub_h)
                lpu.topMargin = bub_top
                root.addView(bub, lpu)

            self.stage = "row"
            row = LinearLayout(act)
            row.setOrientation(0)
            # Android dispatches OnTouchListener events only when the view is clickable
            # or long-clickable. Without this, the whole tab row can ignore taps/swipes.
            row.setClickable(True)
            row.setFocusable(True)
            row.setContentDescription("Glass Bar: навигация по разделам")
            row.setOnTouchListener(self.Tch(self._on_touch))
            row.setImportantForAccessibility(2)  # вкладки доступны как отдельные кнопки
            lpr = FLP(w, bar_h)
            lpr.topMargin = bar_top
            lpr.leftMargin = self.pad
            root.addView(row, lpr)

            dlg.setContentView(root, FLP(win_w, win_h))

            win = dlg.getWindow()
            win.setBackgroundDrawable(ColorDrawable(0))
            win.clearFlags(2)  # FLAG_DIM_BEHIND
            win.addFlags(8 | 32)  # NOT_FOCUSABLE | NOT_TOUCH_MODAL
            win.setLayout(win_w, win_h)
            win.setGravity(80 | 1)  # BOTTOM | CENTER_HORIZONTAL
            lp = win.getAttributes()
            lp.y = dp(4)
            lp.windowAnimations = 0
            win.setAttributes(lp)

            self.stage = "dialog"
            self.dlg = dlg
            self.root = root
            self.row = row
            self.tab_views = []
            self.bub = bub
            # key -> (контейнер, картинка, отступ по x, отступ по y, конечная ширина блюра)
            self.sh = sh
            self.glass_iv = glass_iv
            self.bub_top = bub_top
            self.bub_h = bub_h
            self._read_settings()
            if sh:
                self.targets = {"glass": (root, glass_iv, 0, 0, 720)}
                self.busy = {"glass": False}
                self.stage = "uniforms"
                self._init_uniforms(win_w, win_h, bar_top, bar_h, w)
            else:
                self.targets = {
                    "bar": (bar, bar_iv, 0, 0, 20),
                    "bub": (bub, bub_iv, dp(3), dp(4), 36),
                }
                self.busy = {"bar": False, "bub": False}
            self.adjusted = 0
            self.bub_target = None
            self.stage = "btn"
            self._setup_ovs(act)
            self.stage = "scr"
            try:
                self._setup_scr(act)
            except Exception as se:
                self._scr_kill()
                self._log("ERR стекло экрана: " + type(se).__name__ + ": " + str(se)[:160])
            self.stage = "log"
            try:
                self._setup_log(act, w, win_h - bar_top)
            except Exception as le:
                self.logw = None
                self._log("ERR панель логов: " + type(le).__name__ + ": " + str(le)[:160])
            self.stage = "tabs"
            self._fill_tabs()
            try:
                self._ny_sync()
            except Exception as ne:
                self._log("ERR новогодний декор: " + type(ne).__name__ + ": " + str(ne)[:120])
            self.native_ok = True
            self.err = ""
            self.stage = "show"
            self._sync()
            self.stage = "ok"
            # Возобновляем тик после teardown+setup
            if not self.tick_running:
                self.tick_running = True
                try:
                    self.choreo.getInstance().postFrameCallback(self.frame_cb)
                except Exception:
                    pass
            self._log("setup ok: стиль=" + ("шейдер" if sh else "классика") + " окно=" + str(win_w) + "x" + str(win_h)
                      + " bar_w=" + str(w) + " dens=" + str(round(float(dens), 2)))
            self.refresh()
        except Exception as e:
            self._fail(e)

    def _icon(self, path_d, color):
        from java import jclass, jint
        size = self.bdp(22)
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        bmp = Bitmap.createBitmap(size, size, Cfg.ARGB_8888)
        canvas = jclass("android.graphics.Canvas")(bmp)
        paint = jclass("android.graphics.Paint")(1)
        paint.setColor(jint(color))
        path = make_path(path_d)
        m = jclass("android.graphics.Matrix")()
        s = size / 24.0
        m.setScale(s, s)
        path.transform(m)
        canvas.drawPath(path, paint)
        return bmp

    def _on_tab_touch(self, idx, event):
        from java import jclass
        row = self.row  # бар могли пересобрать между касаниями
        child = row.getChildAt(idx) if row is not None else None
        if child is None:
            return False
        cp = jclass("android.view.MotionEvent").obtain(event)
        try:
            cp.offsetLocation(float(child.getLeft()), 0.0)
            return self._on_touch(cp)
        except Exception as e:
            self._log("ERR касание вкладки: " + type(e).__name__ + ": " + str(e)[:100])
            return False
        finally:
            cp.recycle()

    def _fill_tabs(self, idx=None, move=True):
        if self.row is None:
            return
        from java import jclass
        act = self.act
        dp = self.bdp
        LLP = jclass("android.widget.LinearLayout$LayoutParams")
        sel_idx = self._sel_index() if idx is None else idx
        if not self.tab_views:
            self.row.removeAllViews()
            self.tab_click_refs = []
            for i, (route, path_d, label, prefixes) in enumerate(TABS):
                col = jclass("android.widget.LinearLayout")(act)
                col.setOrientation(1)
                col.setGravity(17)
                iv = jclass("android.widget.ImageView")(act)
                iv.setImportantForAccessibility(2)
                col.addView(iv, LLP(dp(22), dp(22)))
                tv = jclass("android.widget.TextView")(act)
                tv.setText(label)
                tv.setTextSize(float(10.5 * self.bk))
                tv.setSingleLine(True)
                tv.setGravity(17)
                tv.setImportantForAccessibility(2)
                tlp = LLP(-2, -2)
                tlp.topMargin = dp(1)
                col.addView(tv, tlp)
                if self.sh:
                    iv.setAlpha(0.0)
                    tv.setAlpha(0.0)
                def click_for(k):
                    def click():
                        self._go(k)
                    return click
                def touch_for(k):
                    return lambda ev: self._on_tab_touch(k, ev)
                cl = self.Clk(click_for(i))
                touch = self.Tch(touch_for(i))
                self.tab_click_refs.extend((cl, touch))
                col.setFocusable(True)
                col.setClickable(True)
                col.setContentDescription(label)
                col.setOnClickListener(cl)
                col.setOnTouchListener(touch)
                self.row.addView(col, LLP(0, -1, 1.0))
                self.tab_views.append((col, iv, tv, None))
        for i, (col, iv, tv, was_selected) in enumerate(self.tab_views):
            selected = i == sel_idx
            col.setSelected(selected)
            if selected != was_selected:
                if not self.sh:
                    iv.setImageBitmap(self._icon(TABS[i][1], argb(0xFFF3CCF7) if selected else argb(0xD9FFFFFF)))
                tv.setTextColor(argb(0xFFFFFFFF) if selected else argb(0xB3FFFFFF))
                self.tab_views[i] = (col, iv, tv, selected)
        if self.sh:
            self._render_icons(sel_idx)
        if move:
            self._spring_to(self._tab_x(sel_idx))

    # --- пружинная физика линзы ------------------------------------------------
    # Линза — это масса на пружине: её тянет к выбранной вкладке, она разгоняется,
    # слегка перелетает и затухает. Размер зависит от скорости и расстояния:
    # в движении надувается и вытягивается вдоль движения, у цели сдувается.
    def _spring_to(self, x1):
        if self.bub is None:
            return
        if bool(self.get_setting("glass_reduce_motion", False)):
            self.bub_target = float(x1)
            self.sx = float(x1)
            self.sv = 0.0
            self.infl = 0.0
            self._set_lens(float(x1), 1.0, 1.0)
            return
        if self.bub_target is not None and abs(self.bub_target - x1) < 1.0:
            return
        first = self.bub_target is None
        self.bub_target = x1
        if first:
            self._set_lens(float(x1), 1.0, 1.0)
            self.sx = float(x1)
            self.sv = 0.0
            self.infl = 0.0
            return
        if self.anim is not None:
            return  # пружина уже работает: у неё просто новая цель
        import time
        from java import jclass, jarray, jfloat
        self.sx = float(self.bub.getTranslationX())
        self.sv = 0.0
        self.infl = 0.0
        self.last_t = time.time()
        VA = jclass("android.animation.ValueAnimator")
        anim = VA.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(1000)
        anim.setRepeatCount(-1)
        anim.setInterpolator(jclass("android.view.animation.LinearInterpolator")())
        anim.addUpdateListener(self.Upd(self._spring_step))
        anim.start()
        self.anim = anim

    def _spring_step(self, p):
        bub = self.bub
        if bub is None or self.bub_target is None:
            return
        import time
        now = time.time()
        dt = min(now - self.last_t, 1.0 / 30.0)
        self.last_t = now
        if dt <= 0:
            return
        jelly_mode = bool(self.get_setting("glass_anim_jelly", False))
        if jelly_mode:
            k = 380.0                              # жёсткость пружины (стиль 21.5)
            c = 2.0 * 0.72 * math.sqrt(k)         # затухание: почти без качелей
        else:
            k = 300.0                              # упругое, без желейных перелётов
            c = 2.0 * 1.0 * math.sqrt(k)          # критическое затухание
        steps = max(1, int(dt / 0.008))
        h = dt / steps
        for _ in range(steps):
            a = -k * (self.sx - self.bub_target) - c * self.sv
            self.sv += a * h
            self.sx += self.sv * h
        tw = float(self.tw)
        if jelly_mode:
            # Вторая, «желейная» пружина: форма догоняет скорость, перелетает и дрожит
            kq = 420.0
            cq = 2.0 * 0.30 * math.sqrt(kq)
            qt = min(0.34, abs(self.sv) / (tw * 7.0)) * self.jelly
            for _ in range(steps):
                aq = kq * (qt - self.wq) - cq * self.wv
                self.wv += aq * h
                self.wq += self.wv * h
        else:
            # Водяная пластика создаётся шейдером локально под пальцем
            self.wq = 0.0
            self.wv = 0.0
            if not self.pressed and self.touch_strength > 0.0:
                self.touch_strength *= math.exp(-dt * 5.5)
                if self.touch_strength < 0.015:
                    self.touch_strength = 0.0
        speed = abs(self.sv) / (tw * 7.0)
        dist = abs(self.sx - self.bub_target) / tw
        want = min(1.0, speed + dist * 0.7)
        if self.pressed:
            want = 1.0  # пока палец на панели, линза остаётся надутой
        self.infl += (want - self.infl) * min(1.0, dt * 14.0)
        q = self.wq
        if jelly_mode:
            self._set_lens(float(self.sx), float(1.0 + 0.04 * self.infl + q),
                           float(1.0 + 0.03 * self.infl - 0.6 * q))
            stopped = (abs(self.sx - self.bub_target) < 0.4 and abs(self.sv) < 3.0
                       and self.infl < 0.01 and abs(self.wq) < 0.004
                       and abs(self.wv) < 0.08 and not self.pressed)
        else:
            self._set_lens(float(self.sx), 1.0, 1.0)
            stopped = (abs(self.sx - self.bub_target) < 0.4 and abs(self.sv) < 3.0
                       and self.infl < 0.01 and self.touch_strength <= 0.0
                       and not self.pressed)
        if stopped:
            self.infl = 0.0
            self.sv = 0.0
            self.wq = 0.0
            self.wv = 0.0
            self._set_lens(float(self.bub_target), 1.0, 1.0)
            try:
                self.anim.cancel()
            except Exception:
                pass
            self.anim = None

    def _animate_to(self, x1):
        if self.bub is None:
            return
        if self.bub_target is not None and abs(self.bub_target - x1) < 1.0:
            return
        prev = self.bub_target
        self.bub_target = x1
        if prev is None:
            self.bub.setTranslationX(float(x1))
            return
        from java import jclass, jarray, jfloat
        if self.anim is not None:
            try:
                self.anim.cancel()
            except Exception:
                pass
        bub = self.bub
        x0 = float(bub.getTranslationX())
        VA = jclass("android.animation.ValueAnimator")
        anim = VA.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(ANIM_MS)
        anim.setInterpolator(jclass("android.view.animation.LinearInterpolator")())

        def update(p):
            p = min(1.0, max(0.0, p))
            # easeOutBack: мягкий перелёт и возврат
            c1 = 1.25
            c3 = c1 + 1.0
            q = p - 1.0
            e = 1.0 + c3 * q * q * q + c1 * q * q
            bub.setTranslationX(float(x0 + (x1 - x0) * e))
            # линза «надувается» в середине пути и сдувается к концу
            s = math.sin(math.pi * p)
            bub.setScaleX(float(1.0 + 0.30 * s))
            bub.setScaleY(float(1.0 + 0.45 * s))

        anim.addUpdateListener(self.Upd(update))
        anim.start()
        self.anim = anim

    # ------------------------------------------------------------------ шейдер (Android 13+)
    def _try_shader(self):
        try:
            from java import jclass
            if int(jclass("android.os.Build$VERSION").SDK_INT) < 33:
                return False
            self.RE = jclass("android.graphics.RenderEffect")
            RS = jclass("android.graphics.RuntimeShader")
            self.beta_enabled = bool(self.get_setting("glass_beta_enabled", False)) and not bool(self.get_setting("glass_opt", True))
            self.beta_failed = False
            self.shader = None
            self.shader_mode = "standard"
            if self.beta_enabled:
                try:
                    self.shader = RS(AGSL_BETA)
                    self.shader_mode = "beta"
                except Exception as e:
                    # бета не скомпилировалась: не ломаем панель, возвращаем обычный шейдер
                    self.shader = None
                    self.beta_failed = True
                    self._log("ERR бета-шейдер не скомпилирован: " + str(e)[:300])
                    try:
                        self.toast("GlassBar: бета-шейдер не скомпилировался, включён обычный (" + str(e)[:80] + ")")
                    except Exception:
                        pass
            if self.shader is None:
                self.shader = RS(AGSL)
                self.shader_mode = "standard"
            return True
        except Exception as e:
            self.shader = None
            if not self.sh_failed:
                self.sh_failed = True
                try:
                    self.toast("GlassBar: шейдер недоступен, обычный режим (" + str(e)[:100] + ")")
                except Exception:
                    pass
            return False

    def _init_uniforms(self, win_w, win_h, bar_top, bar_h, w):
        sh = self.shader
        sh.setFloatUniform("res", float(win_w), float(win_h))
        sh.setFloatUniform("bar", float(self.pad + w / 2.0), float(bar_top + bar_h / 2.0),
                           float(w / 2.0), float(bar_h / 2.0))
        sh.setFloatUniform("dpx", float(self.dens * self.bk))
        sh.setFloatUniform("glowK", float(self.glow_amt / 30.0))
        sh.setFloatUniform("lsK", float(1.0 if self.get_setting("glass_ls_style", True) else 0.0))
        self._theme_uniforms(sh)
        sh.setFloatUniform("refr", float(self.refr_amt / 100.0))
        sh.setFloatUniform("tintK", float(self.tint_amt / 100.0))
        sh.setFloatUniform("blurK", float(self.blur_amt / 100.0))
        sh.setFloatUniform("frostK", float(self.frost_amt / 100.0))
        sh.setFloatUniform("grainK", float(self.grain_amt / 100.0))
        sh.setFloatUniform("dispK", float(self.disp_amt / 100.0))
        sh.setFloatUniform("edgeK", float(max(self.edge_amt, 10.0) / 100.0))
        sh.setFloatUniform("touch", float(self.touch_x), float(self.touch_y), 0.0)
        if self.shader_mode != "beta":
            sh.setFloatUniform("tm", float(time.time() % 1000.0))
        if self.shader_mode == "beta":
            self._apply_beta_uniforms(sh)
        self.win_w, self.win_h, self.bar_top, self.bar_h = win_w, win_h, bar_top, bar_h
        self.cur_x = self._tab_x(self._sel_index())
        self._render_icons(self._sel_index())

    def _apply_beta_uniforms(self, sh):
        # Только для AGSL_BETA: значения независимы от стандартных настроек панели.
        if not self.bx:
            self._read_settings()
        b = self.bx
        ior = 1.0 + (b["glass_bx_ior"] - 100.0) / 100.0
        thick = b["glass_bx_thick"] / 60.0
        bevel = b["glass_bx_bevel"] / 100.0
        disp = b["glass_bx_disp"] / 100.0 * 0.12
        fres = b["glass_bx_fres"] / 100.0
        spec = b["glass_bx_spec"] / 100.0
        shin = 24.0 + (b["glass_bx_sharp"] / 100.0) * (520.0 - 24.0)
        sat = b["glass_bx_sat"] / 100.0
        ang = math.radians(b["glass_bx_light"])
        sh.setFloatUniform("bA", float(ior), float(thick), float(bevel), float(disp))
        sh.setFloatUniform("bB", float(fres), float(spec), float(shin), float(sat))
        sh.setFloatUniform("bC", float(b["glass_bx_rough"]), float(b["glass_bx_dens"] / 100.0),
                           float(b["glass_bx_depth"] / 100.0), float(b["glass_bx_env"] / 100.0))
        sh.setFloatUniform("bD", float(b["glass_bx_caus"] / 100.0), float(b["glass_bx_shadow"] / 100.0))
        sh.setFloatUniform("bL", float(math.cos(ang)), float(math.sin(ang)))
        sh.setFloatUniform("bG", float(b["glass_bx_sglow"] / 100.0),
                           float(1.5 + b["glass_bx_sglow_w"] / 100.0 * 5.5),
                           float(b["glass_bx_sglow_f"] / 100.0))

    def _theme_uniforms(self, sh):
        i = max(0, min(len(THEMES) - 1, int(getattr(self, "theme", 0))))
        rim, glow, refr = THEMES[i]
        sh.setFloatUniform("refrTint", float(refr[0]), float(refr[1]), float(refr[2]))
        sh.setFloatUniform("crackK", 1.0 if (bool(self.get_setting("glass_cracks", False)) and not bool(self.get_setting("glass_opt", True)) and int(self.q_tier) < 2) else 0.0)
        sh.setFloatUniform("rimTint", float(rim[0]), float(rim[1]), float(rim[2]))
        sh.setFloatUniform("glowTint", float(glow[0]), float(glow[1]), float(glow[2]))

    DEFAULTS = {"glass_glow_amt": 30.0, "glass_refr_amt": 100.0,
                "glass_tint_amt": 100.0, "glass_blur_amt": 100.0,
                "glass_frost_amt": 55.0, "glass_grain_amt": 28.0,
                "glass_jelly_amt": 100.0, "glass_disp_amt": 100.0, "glass_edge_amt": 100.0,
                "glass_scale_amt": 50.0, "glass_fps_amt": 20.0, "glass_theme": 0.0}

    def _winter_decor_enabled(self):
        # Отдельный переключатель в бета-разделе выключен по умолчанию.
        # Совместимость с внешним new_year_winter сохраняется.
        now = time.time()
        if now - getattr(self, "_ice_t", 0.0) < 0.5:
            return getattr(self, "_ice_v", False)
        self._ice_t = now
        v = bool(self.get_setting("glass_ny_beta_enabled", False))
        try:
            sp = self.api.getContext().getSharedPreferences("dolphy_cross_plugin_state", 0)
            beat = int(sp.getLong("new_year_beat", 0))
            external = bool(sp.getBoolean("new_year_active", False)) and (int(time.time() * 1000) - beat) < 15000
            v = v or external
        except Exception:
            pass
        self._ice_v = v
        return v

    def _read_settings(self):
        def val(k):
            try:
                return float(self.get_setting(k, self.DEFAULTS[k]))
            except Exception:
                return self.DEFAULTS[k]
        self.glow_amt = val("glass_glow_amt")
        self.theme = int(round(val("glass_theme")))
        self.refr_amt = val("glass_refr_amt")
        self.tint_amt = val("glass_tint_amt")
        self.blur_amt = val("glass_blur_amt")
        self.frost_amt = val("glass_frost_amt")
        self.grain_amt = val("glass_grain_amt")
        self.jelly_amt = val("glass_jelly_amt")
        self.jelly = self.jelly_amt / 100.0
        self.disp_amt = val("glass_disp_amt")
        self.edge_amt = val("glass_edge_amt")
        self.scale_amt = val("glass_scale_amt")
        self.fps_amt = val("glass_fps_amt")
        self.beta_enabled = bool(self.get_setting("glass_beta_enabled", False))
        bx = {}
        for k, _lab, lo, hi, _st, dflt, _fmt in BETA_PARAMS:
            try:
                v = float(self.get_setting(k, dflt))
            except Exception:
                v = float(dflt)
            bx[k] = max(float(lo), min(float(hi), v))
        self.bx = bx
        profile = str(self.get_setting("glass_perf_profile", "balanced")).lower()
        self.perf_profile = profile if profile in ("quality", "balanced", "battery", "manual") else "balanced"
        self.opt = bool(self.get_setting("glass_opt", True))
        if self.opt:
            # Оптимизированный режим: дорогие эффекты выключены, буферы захвата уменьшены, цель — 60 кадров/с
            self.scale_amt = min(self.scale_amt, 55.0)
            self.fps_amt = max(self.fps_amt, 60.0)
            self.blur_amt = min(self.blur_amt, 60.0)
            self.frost_amt = min(self.frost_amt, 40.0)   # матовость остаётся (было 0 — стекло выглядело плоским)
            self.grain_amt = 0.0
            self.disp_amt = min(self.disp_amt, 60.0)     # радужная кайма остаётся, только слабее
            self.beta_enabled = False
        self.gv_on = bool(self.get_setting("glass_auto_q", True))
        t = int(self.q_tier)
        if t >= 1:
            self.scale_amt = min(self.scale_amt, 60.0)
            self.grain_amt = 0.0
        if t >= 2:
            self.scale_amt = min(self.scale_amt, 45.0)
            self.frost_amt = min(self.frost_amt, 30.0)
            self.disp_amt = min(self.disp_amt, 40.0)
            self.blur_amt = min(self.blur_amt, 60.0)
            self.beta_enabled = False
        if t >= 3:
            self.scale_amt = min(self.scale_amt, 35.0)
            self.frost_amt = 0.0
            self.disp_amt = 0.0
            self.blur_amt = min(self.blur_amt, 35.0)

    def _ny_bitmap(self):
        from java import jclass, jint
        win_w, win_h, bar_top, bar_h, w, pad = self.ny_geo
        Bitmap = jclass("android.graphics.Bitmap")
        cached = getattr(self, "_ny_cached_bitmap", None)
        if cached is None or int(cached.getWidth()) != int(win_w) or int(cached.getHeight()) != int(win_h):
            bmp = Bitmap.createBitmap(int(win_w), int(win_h), jclass("android.graphics.Bitmap$Config").ARGB_8888)
            self._ny_cached_bitmap = bmp
            self._ny_cached_canvas = jclass("android.graphics.Canvas")(bmp)
        else:
            bmp = cached
        cv = getattr(self, "_ny_cached_canvas", None)
        if cv is None:
            cv = jclass("android.graphics.Canvas")(bmp)
            self._ny_cached_canvas = cv
        PorterDuff = jclass("android.graphics.PorterDuff")
        cv.drawColor(0, PorterDuff.Mode.CLEAR)
        Paint = jclass("android.graphics.Paint")
        Path = jclass("android.graphics.Path")
        LG = jclass("android.graphics.LinearGradient")
        RG = jclass("android.graphics.RadialGradient")
        TM = jclass("android.graphics.Shader$TileMode")
        Style = jclass("android.graphics.Paint$Style")
        Cap = jclass("android.graphics.Paint$Cap")

        def C(c):
            return jint(argb((int(c[3]) << 24) | (int(c[0]) << 16) | (int(c[1]) << 8) | int(c[2])))

        u = self.bdp(10) / 10.0
        for op in ny_shapes(win_w, win_h, bar_top, bar_h, w, pad, u):
            kind = op[0]
            p = Paint(1)
            if kind == "poly":
                pts = op[1]
                path = Path()
                path.moveTo(float(pts[0][0]), float(pts[0][1]))
                for q in pts[1:]:
                    path.lineTo(float(q[0]), float(q[1]))
                path.close()
                ys = [q[1] for q in pts]
                y0, y1 = float(min(ys)), float(max(ys)) + 0.01
                p.setShader(LG(0.0, y0, 0.0, y1, C(op[2]), C(op[3]), TM.CLAMP))
                cv.drawPath(path, p)
                if len(op) > 3 and op[3] is not None:
                    ep = Paint(1)
                    ep.setStyle(Style.STROKE)
                    ep.setStrokeWidth(float(max(1.0, 0.45 * u)))
                    ep.setColor(C(op[3]))
                    cv.drawPath(path, ep)
            elif kind == "line":
                pts = op[1]
                path = Path()
                path.moveTo(float(pts[0][0]), float(pts[0][1]))
                for q in pts[1:]:
                    path.lineTo(float(q[0]), float(q[1]))
                p.setStyle(Style.STROKE)
                p.setStrokeWidth(float(op[2]))
                p.setStrokeCap(Cap.ROUND if (len(op) < 5 or op[4]) else Cap.BUTT)
                p.setColor(C(op[3]))
                cv.drawPath(path, p)
            else:
                x, y, r, col, gl = op[1], op[2], op[3], op[4], op[5]
                if gl:
                    gp = Paint(1)
                    gp.setShader(RG(float(x), float(y), float(gl), C((col[0], col[1], col[2], 110)), C((col[0], col[1], col[2], 0)), TM.CLAMP))
                    cv.drawCircle(float(x), float(y), float(gl), gp)
                p.setColor(C(col))
                cv.drawCircle(float(x), float(y), float(r), p)
        return bmp

    def _ny_mask(self, cx, cy, hw, hh):
        # линза всегда сверху: декор под ней «вырезается»
        sh = getattr(self, "ny_sh", None)
        if sh is None or self.ny_iv is None:
            return
        sh.setFloatUniform("bub", float(cx), float(cy), float(hw), float(hh))
        self.ny_iv.setRenderEffect(self.RE.createRuntimeShaderEffect(sh, "content"))

    def _ny_sync(self):
        # декор как у новогоднего плагина: снег, сосульки, подарок, леденец, гирлянда
        root = self.root
        if root is None or self.ny_geo is None:
            return
        want = bool(self._winter_decor_enabled())
        if want:
            self._ny_off_t = None
        if want and self.ny_iv is None:
            from java import jclass
            FLP = jclass("android.widget.FrameLayout$LayoutParams")
            IV = jclass("android.widget.ImageView")
            if self.ny_bmp is None or getattr(self, "ny_bmp_geo", None) != self.ny_geo:
                self.ny_bmp = self._ny_bitmap()
                self.ny_bmp_geo = self.ny_geo
            iv = IV(self.act)
            iv.setScaleType(IV.ScaleType.FIT_XY)
            iv.setImageBitmap(self.ny_bmp)
            iv.setClickable(False)
            iv.setFocusable(False)
            iv.setImportantForAccessibility(2)
            root.addView(iv, FLP(-1, -1))
            self.ny_iv = iv
            self.ny_sh = None
            try:
                if self.RE is not None:
                    self.ny_sh = jclass("android.graphics.RuntimeShader")(AGSL_NYMASK)
                    self._ny_mask(-9999.0, -9999.0, 1.0, 1.0)
            except Exception as me:
                self.ny_sh = None
                self._log("ERR маска декора: " + str(me)[:100])
            self._log("новогодний декор: включён")
        elif not want and self.ny_iv is not None:
            # гистерезис: убираем декор только если флаг выключен непрерывно дольше 2.5 с
            now = time.time()
            if getattr(self, "_ny_off_t", None) is None:
                self._ny_off_t = now
                return
            if now - self._ny_off_t < 2.5:
                return
            self._ny_off_t = None
            try:
                root.removeView(self.ny_iv)
            except Exception:
                pass
            self.ny_iv = None
            self._log("новогодний декор: выключен")

    def _apply_live(self):
        # применяем настройки сразу, без пересборки окна
        try:
            self._ny_sync()
        except Exception as e:
            self._log("ERR новогодний декор: " + type(e).__name__ + ": " + str(e)[:120])
        self._read_settings()

        sh = self.shader
        if sh is None or not self.sh:
            self._log("Frosted Glass: настройки прочитаны, но шейдер не активен (sh=" + str(bool(self.sh)) + ", shader=" + str(sh is not None) + ")")
            return
        try:
            sh.setFloatUniform("glowK", float(self.glow_amt / 30.0))
            sh.setFloatUniform("lsK", float(1.0 if self.get_setting("glass_ls_style", True) else 0.0))
            self._theme_uniforms(sh)
            sh.setFloatUniform("refr", float(self.refr_amt / 100.0))
            sh.setFloatUniform("tintK", float(self.tint_amt / 100.0))
            sh.setFloatUniform("blurK", float(self.blur_amt / 100.0))
            sh.setFloatUniform("frostK", float(self.frost_amt / 100.0))
            sh.setFloatUniform("grainK", float(self.grain_amt / 100.0))
            self._log("Frosted Glass применён: матирование=" + str(round(self.frost_amt, 1)) + ", зерно=" + str(round(self.grain_amt, 1)))
            sh.setFloatUniform("dispK", float(self.disp_amt / 100.0))
            sh.setFloatUniform("edgeK", float(max(self.edge_amt, 10.0) / 100.0))
            if self.shader_mode == "beta":
                self._apply_beta_uniforms(sh)
            self._push(True)
        except Exception as e:
            self.stage = "settings"
            self._fail(e)

    def _slider_cb(self, key):
        def cb(v):
            if key in ("glass_scale_amt", "glass_fps_amt", "glass_blur_amt"):
                self.set_setting("glass_perf_profile", "manual")
            self.set_setting(key, float(v))
            if key in ("glass_frost_amt", "glass_grain_amt"):
                self._log("ползунок " + key + " → " + str(round(float(v), 1)))
            if key.startswith("glass_btn_"):
                if self.handler is not None:
                    self._post(self._btn_apply_calib, 0)
                else:
                    self._btn_apply_calib()
                self.refresh()
            elif key == "glass_scr_btn_scale":
                # _scr_relayout заметит новую геометрию и один раз пересоберёт
                # окна с актуальными размерами после завершения движения ползунка.
                self._log("масштаб кнопок Bluetooth → " + str(int(float(v))) + "%")
                self.refresh()
            else:
                self._apply_live()
                self.refresh()
        return cb

    def _enabled_cb(self, v):
        self.set_setting("glass_enabled", bool(v))
        self.on_setting_changed(None)

    def _beta_toggle_cb(self, enabled):
        # Полная пересборка основной панели гарантирует замену RuntimeShader.
        # При выключении _try_shader создаёт исходный AGSL, а стандартные
        # параметры Glass Bar остаются в своих прежних ключах настроек.
        enabled = bool(enabled)
        self.set_setting("glass_beta_enabled", enabled)
        if enabled:
            # режим «стекло без шейдера» несовместим с бета-шейдером
            self.set_setting("glass_style_fallback", False)
        self.beta_enabled = enabled
        self._log("Реалистичное стекло (бета): " + ("включено" if enabled else "выключено"))
        if self.handler is not None:
            self._post(self._setup, 0)
        else:
            self._teardown_ui()
        self.refresh()

    def _ny_beta_toggle_cb(self, enabled):
        enabled = bool(enabled)
        self.set_setting("glass_ny_beta_enabled", enabled)
        # Сбрасываем кэш, чтобы переключатель применился сразу.
        self._ice_t = 0.0
        self._ice_v = enabled
        self._log("Новогодний бар (бета): " + ("включён" if enabled else "выключен"))
        if self.handler is not None:
            self._post(self._apply_live, 0)
        else:
            self._apply_live()
        self.refresh()

    def _beta_reset_cb(self):
        for k, _lab, _lo, _hi, _st, dflt, _fmt in BETA_PARAMS:
            self.set_setting(k, float(dflt))
        self._read_settings()
        self._apply_live()
        self.refresh()

    def _reset_cb(self):
        self.set_setting("glass_perf_profile", "manual")
        for k, v in self.DEFAULTS.items():
            self.set_setting(k, v)
        self._apply_live()
        self.refresh()

    PERF_PROFILES = {
        "quality": {"title": "Качество", "subtitle": "Максимальная детализация: масштаб 100%, до 60 кадров/с",
                     "scale": 100.0, "fps": 60.0, "blur": 100.0},
        "balanced": {"title": "Баланс", "subtitle": "Оптимальный режим для повседневного использования",
                      "scale": 70.0, "fps": 20.0, "blur": 85.0},
        "battery": {"title": "Экономия батареи", "subtitle": "Меньше захватов экрана и ниже разрешение буферов",
                     "scale": 45.0, "fps": 15.0, "blur": 55.0},
        "manual": {"title": "Свои значения", "subtitle": "Используются значения из ручных слайдеров",
                    "scale": None, "fps": None, "blur": None},
    }

    def _set_perf_profile(self, name):
        profile = self.PERF_PROFILES.get(name)
        if profile is None:
            return
        self.set_setting("glass_perf_profile", name)
        self.q_tier = 0  # явный выбор профиля сбрасывает авто-снижение
        if profile["scale"] is not None:
            self.set_setting("glass_scale_amt", profile["scale"])
            self.set_setting("glass_fps_amt", profile["fps"])
            self.set_setting("glass_blur_amt", profile["blur"])
        self._read_settings()
        self._apply_live()
        self._log("профиль производительности: " + profile["title"])
        self.perf_profile = name  # явно синхронизируем до refresh
        self.refresh()

    def _profile_cb(self, name):
        def click():
            self._set_perf_profile(name)
        return click

    MODES = {1: ("1 · Бар с LS", True, False), 2: ("2 · Обычный", False, False), 3: ("3 · Версия 21.5", False, True)}

    def _mode_cur(self):
        ls = bool(self.get_setting("glass_ls_style", True))
        jl = bool(self.get_setting("glass_anim_jelly", False))
        for n, (_, l, j) in self.MODES.items():
            if l == ls and j == jl:
                return n
        return 0

    def _mode_cb(self, n):
        def click():
            _, ls, jl = self.MODES[n]
            self.set_setting("glass_ls_style", ls)
            self.set_setting("glass_anim_jelly", jl)
            self.set_setting("glass_mode", n)
            self._log("режим панели: " + self.MODES[n][0])
            self.on_setting_changed(None)
        return click

    def _mode_items(self, ui):
        cur = self._mode_cur()
        name = self.MODES[cur][0] if cur else "свой набор"
        items = [ui.text("Режим панели", "titleMedium", "#FFFFFF"),
                 ui.text("Сейчас: " + name, "bodySmall", "#CCFFFFFF")]
        for n in (1, 2, 3):
            items.append(ui.button(self.MODES[n][0], self._mode_cb(n)))
        return items

    def _key_cb(self, key):
        def cb(v):
            self.set_setting(key, bool(v))
            self.on_setting_changed(None)
        return cb

    def _rows_screen(self, ui, title, rows, extra=None, locked=()):
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"
        beta_on = bool(self.get_setting("glass_beta_enabled", False))
        items = []
        for r in rows:
            if beta_on and r[1] in locked:
                items.append(ui.column([
                    ui.text(r[2] + " · отключено", "titleSmall", "#66FFFFFF"),
                    ui.text("Активен бета-шейдер: эта настройка сейчас не применяется", "bodySmall", "#55FFFFFF"),
                ], 0, 2))
                continue
            if r[0] == "sw":
                _, key, t, sub, dflt = r
                items.append(ui.column([
                    ui.text(t, "titleSmall", W),
                    ui.text(sub, "bodySmall", W2),
                    ui.switch(bool(self.get_setting(key, dflt)), self._key_cb(key), "", ""),
                ], 0, 2))
            else:
                _, key, label, lo, hi, steps, dflt = r
                val = float(self.get_setting(key, dflt))
                items.append(ui.column([
                    ui.text(label + ": " + str(int(val)), "titleSmall", W),
                    ui.slider(val, self._slider_cb(key), lo, hi, "", max(0, int(hi - lo) - 1)),
                ], 0, 2))
        if extra:
            items.extend(extra)
        items.append(ui.spacer(120))
        return ui.scaffold(
            title=title,
            content=ui.lazy_column(items, 16, 12))

    def screen_glass_panel(self, ui, api, state):
        self._read_settings()
        return self._rows_screen(ui, "Панель", [
            ("sw", "glass_enabled", "Эффект стекла", "Выключите, чтобы вернуть обычную плавающую панель", True),
            ("sw", "glass_ls_style", "Стиль LSPosed", "Сильное увеличение иконок под линзой и синяя кромка", True),
            ("sw", "glass_style_fallback", "Стиль бара: стекло без шейдера", "Классическая круглая линза без AGSL-шейдера", False),
            ("sw", "glass_cracks", "Трещины", "Имитация треснувшего стекла: трещины, блики и преломление у линий", False),
            ("sw", "glass_btn", "Стеклянная кнопка «назад»", "Стекло поверх кнопки в левом верхнем углу", True),
            ("sl", "glass_btn_dx", "Кнопка «назад»: сдвиг по X, dp (вправо +)", -30, 30, 59, 0),
            ("sl", "glass_btn_dy", "Кнопка «назад»: сдвиг по Y, dp (вниз +)", -30, 30, 59, 0),
            ("sl", "glass_btn_sz", "Кнопка «назад»: размер, %", 60, 140, 80, 100),
            ("sw", "glass_ttl", "Стеклянный заголовок", "Парящая стеклянная капсула над названием экрана", True),
            ("sl", "glass_bar_scale", "Масштаб нижней панели, %", 70, 130, 59, 100),
        ], extra=self._mode_items(ui), locked=("glass_ls_style", "glass_cracks", "glass_style_fallback"))

    def screen_glass_anim(self, ui, api, state):
        self._read_settings()
        return self._rows_screen(ui, "Анимация", [
            ("sw", "glass_anim_jelly", "Желейная анимация (стиль 21.5)", "Линза растягивается и раскачивается. Выключено — водяной бугорок (21.6)", True),
            ("sw", "glass_fx", "Анимация верхних элементов", "Желейный разгон и «шлепок» при остановке верхних накладок", True),
            ("sw", "glass_tilt", "Наклон: вода в стекле", "Фон и блик смещаются при наклоне телефона (датчик)", False),
            ("sw", "glass_reduce_motion", "Уменьшить движение", "Отключает перелёты и пружинные анимации для доступности", False),
            ("sw", "haptic_sections", "Вибрация при смене секции", "Короткий отклик, когда переключается All, BLE или Advert", False),
        ])

