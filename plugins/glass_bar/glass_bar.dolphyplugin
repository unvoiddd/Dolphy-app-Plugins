        return ui.scaffold(
            title="Профиль производительности",
            content=ui.lazy_column([
                ui.text("Профиль влияет на частоту PixelCopy, размер буферов и силу размытия.", "bodyMedium", W2),
                ui.text("Текущий режим: " + self.PERF_PROFILES[self.perf_profile]["title"], "titleSmall", W),
                *items,
