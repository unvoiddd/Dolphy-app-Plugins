}
"""
AGSL_BTN = """
uniform shader content;
uniform float2 res;
uniform float dpx;
float sdSeg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}
half4 main(float2 p) {
    float2 c = res * 0.5;
    float2 q = p - c;
    float R = min(res.x, res.y) * 0.5 - dpx * 5.0;
    float l = length(q);
    float d = l - R;
    if (d > dpx * 8.0) return half4(0.0);
    float a = clamp(0.5 - d, 0.0, 1.0);
    float2 n = l > 0.001 ? q / l : float2(0.0, -1.0);
    float dep = max(-d, 0.0);
    float m = R * 0.28 * pow(1.0 - clamp(dep / (R * 0.30), 0.0, 1.0), 2.0);
    float2 off = -n * m;
    float2 lo = float2(0.5);
    float2 hi = res - 0.5;
    float3 col = float3(content.eval(clamp(p + off * 0.88, lo, hi)).r,
                        content.eval(clamp(p + off, lo, hi)).g,
                        content.eval(clamp(p + off * 1.12, lo, hi)).b);
    // центр закрываем непрозрачной заливкой: старая серая стрелка не видна, у кромки остаётся преломление
    float cover = smoothstep(dpx * 3.0, dpx * 9.0, dep);
    float3 fill = float3(0.17, 0.15, 0.20) + 0.04 * (1.0 - (q.y + R) / (2.0 * R));
    col = mix(mix(col, float3(0.14, 0.12, 0.16), 0.12) + 0.03, fill, cover);
    // своя стрелка «назад»
    float2 A = float2(-0.36 * R, 0.0);
    float da = min(sdSeg(q, A, float2(0.36 * R, 0.0)),
                   min(sdSeg(q, A, float2(-0.08 * R, -0.30 * R)), sdSeg(q, A, float2(-0.08 * R, 0.30 * R))));
    float aw = dpx * 1.25;
    col = mix(col, float3(0.96, 0.93, 0.98), 1.0 - smoothstep(aw - 0.7, aw + 0.7, da));
    float2 L = normalize(float2(-0.55, -0.85));
    float sp = pow(max(dot(n, L), 0.0), 2.0) + 0.55 * pow(max(dot(n, -L), 0.0), 2.0) + 0.12;
    col += exp(-dep / (dpx * 1.2)) * sp * 0.55;
    col = clamp(col, 0.0, 1.0);
    float gl = exp(-max(d, 0.0) / (dpx * 3.0)) * 0.02;
    float3 gc = float3(0.95, 0.8, 0.98);
    return half4(float4(col * a + gc * gl * (1.0 - a), a + gl * (1.0 - a)));
}
"""

AGSL = """
uniform shader content;
uniform shader icons;
uniform float2 res;
uniform float4 bar;    // cx, cy, halfW, halfH (px)
uniform float4 bub;    // линза: cx, cy, halfW, halfH (px)
uniform float infl;
uniform float vel;
uniform float dpx;
uniform float glowK;
uniform float3 rimTint;
uniform float3 glowTint;
uniform float3 refrTint;
uniform float lsK;     // стиль LSPosed
uniform float crackK;
uniform float refr;
uniform float lean;    // наклон линзы при движении
uniform float dispK;   // сила радужной каймы
uniform float edgeK;   // ширина полосы искажения
uniform float tintK;   // непрозрачность заливки панели
uniform float blurK;   // множитель размытия фона
uniform float frostK;  // матирование: рассеивание и мягкое снижение насыщенности
uniform float grainK;  // интенсивность мелкой фактуры матового стекла
uniform float3 touch;  // x, y и сила водяного бугорка
uniform float tm;      // время для волн от пальца

float sdBox(float2 p, float2 c, float2 hs) {
    float r = min(hs.x, hs.y);
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float smin2(float a, float b, float k) {
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * k * 0.25;
}
float dB(float2 p) { return sdBox(p, bar.xy, bar.zw); }
float dL(float2 p) { return sdBox(float2(p.x - lean * (p.y - bub.y), p.y), bub.xy, bub.zw); }
float dU(float2 p) { return min(dB(p), dL(p)); }

float2 gradU(float2 p) {
    float e = 1.0;
    float2 g = float2(dB(p + float2(e, 0.0)) - dB(p - float2(e, 0.0)),
                      dB(p + float2(0.0, e)) - dB(p - float2(0.0, e)));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}
float2 gradL(float2 p) {
    float e = 1.0;
    float2 g = float2(dL(p + float2(e, 0.0)) - dL(p - float2(e, 0.0)),
                      dL(p + float2(0.0, e)) - dL(p - float2(0.0, e)));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}

float2 cp(float2 q) { return clamp(q, float2(0.5), res - 0.5); }

float3 tap3(float2 qr, float2 qg, float2 qb, float2 o) {
    return float3(content.eval(cp(qr + o)).r, content.eval(cp(qg + o)).g, content.eval(cp(qb + o)).b);
}

float3 blur3(float2 qr, float2 qg, float2 qb, float rad) {
    float3 s = tap3(qr, qg, qb, float2(0.0));
    for (int i = 0; i < 6; i++) {
        float a = 1.0472 * float(i) + 0.5;
        s += tap3(qr, qg, qb, float2(cos(a), sin(a)) * rad);
        s += tap3(qr, qg, qb, float2(cos(a + 0.5236), sin(a + 0.5236)) * rad * 0.5);
    }
    return s / 13.0;
}

// размытие, когда каналы не разведены (почти вся панель): 19 отсчётов, три кольца
float3 blurMono(float2 q, float rad) {
    float3 s = content.eval(cp(q)).rgb;
    for (int i = 0; i < 6; i++) {
        float a = 1.0472 * float(i) + 0.5;
        s += content.eval(cp(q + float2(cos(a), sin(a)) * rad)).rgb;
        s += content.eval(cp(q + float2(cos(a + 0.5236), sin(a + 0.5236)) * rad * 0.66)).rgb;
        s += content.eval(cp(q + float2(cos(a + 0.2618), sin(a + 0.2618)) * rad * 0.33)).rgb;
    }
    return s / 19.0;
}

float spec(float2 n, float2 L) {
    return pow(max(dot(n, L), 0.0), 2.0) + 0.55 * pow(max(dot(n, -L), 0.0), 2.0) + 0.12;
}

float2 crackHash(float2 c) {
    return fract(sin(float2(dot(c, float2(127.1, 311.7)), dot(c, float2(269.5, 183.3)))) * 43758.5453);
}
// расстояние до линии излома (px) и номер осколка (ячейки Вороного)
float3 crackVor(float2 p, float sc) {
    float2 q = p / sc;
    float2 ip = floor(q);
    float2 fp = fract(q);
    float f1 = 9.0;
    float f2 = 9.0;
    float2 best = float2(0.0);
    for (float j = -1.0; j <= 1.0; j += 1.0) {
        for (float i = -1.0; i <= 1.0; i += 1.0) {
            float2 g = float2(i, j);
            float2 cell = ip + g;
            float2 r = g + crackHash(cell) - fp;
            float d = dot(r, r);
            if (d < f1) { f2 = f1; f1 = d; best = cell; }
            else if (d < f2) { f2 = d; }
        }
    }
    return float3((sqrt(f2) - sqrt(f1)) * sc, best);
}

half4 main(float2 p) {
    float du = dU(p);
    float dl = dL(p);
    if (du > dpx * 14.0) return half4(0.0);

    float3 glowCol = glowTint;
    float gl = 0.0;
    if (glowK > 0.0) {
        gl = exp(-max(du, 0.0) / (dpx * 4.0)) * 0.014;
        gl += exp(-max(dl, 0.0) / (dpx * 5.0)) * (0.012 + 0.03 * infl) * infl;
        gl *= glowK;
    }
    float a = clamp(0.5 - du, 0.0, 1.0);
    if (a <= 0.0) return half4(float4(glowCol * gl, gl));

    float2 nU = gradU(p);
    float2 nL = gradL(p);
    float2 nq = (p - bub.xy) / max(bub.zw, float2(1.0));
    float rq = length(nq);
    float ring = exp(-pow(rq - 1.0, 2.0) * 3.0) * lsK;
    float2 pw = p + (p - bub.xy) * ring * 0.22;
    float db = dB(pw);
    float depU = max(-db, 0.0);
    float depL = max(-dl, 0.0);
    float lensIn = 1.0 - smoothstep(-1.0, 1.0, dl);
    float g = clamp(infl, 0.0, 1.0);
    float lensG = lensIn * g;

    // преломление: панель (слабое) и линза (сильное увеличение + складка у кромки)
    float tU = clamp(depU / (bar.w * 0.28 * edgeK), 0.0, 1.0);
    float mU = bar.w * 0.26 * refr * pow(1.0 - tU, 2.0) * (1.0 - lensG * (1.0 - 0.6 * lsK));
    float tL = clamp(depL / (bub.w * 0.32 * edgeK), 0.0, 1.0);
    float mL = bub.w * (0.34 + 0.04 * infl) * refr * pow(1.0 - tL, 2.0) * lensG;
    float mag = (0.03 + 0.10 * lsK) * min(refr, 1.3) * lensG;

    float2 base = p + (bub.xy - p) * mag;
    // трещины: каждый осколок смещает фон на свой угол; у линии излома смещение резче
    float3 cvK = float3(9999.0, 0.0, 0.0);
    if (crackK > 0.0) {
        cvK = crackVor(p, dpx * 46.0);
        float2 hid = crackHash(cvK.yz);
        float nearLine = exp(-cvK.x / (dpx * 1.6));
        float keep = crackK * (1.0 - 0.6 * lensG);
        base += ((hid - 0.5) * dpx * 11.0 + (hid.yx - 0.5) * dpx * 4.0 * nearLine) * keep;
    }
    float2 off = -nU * mU - nL * mL;

    // Локальная водяная выпуклость под пальцем: без изменения геометрии панели.
    float2 td = p - touch.xy;
    float tr = max(dpx * 15.0, 1.0);
    float water = clamp(touch.z, 0.0, 1.0) * exp(-dot(td, td) / (tr * tr));
    float2 waterDir = td / max(length(td), 1.0);
    base += waterDir * water * dpx * 5.0;
    // расходящаяся волна от пальца: кольца затухают с расстоянием
    float ripple = sin(length(td) * 0.12 - tm * 7.0) * exp(-length(td) / (dpx * 45.0)) * water;
    base += waterDir * ripple * dpx * 3.0;

    // дисперсия: R, G, B преломляются по-разному
    float disp = (0.14 + 0.06 * g) * dispK;
    float2 sh = float2(vel * dpx * 2.0 * lensG, 0.0);
    float2 pr = base + off * (1.0 - disp) - sh;
    float2 pg = base + off;
    float2 pb = base + off * (1.0 + disp) + sh;

    float frost = clamp(frostK, 0.0, 1.0) * (1.0 - 0.72 * lensG);
    // Frosted Glass добавляет собственное рассеивание поверх обычного blur.
    float rad = mix(dpx * 3.4, dpx * 1.2, lensG) * blurK + dpx * 2.2 * frost;
    float3 col;
    if (distance(pr, pb) < 0.75) {
        col = blurMono(pg, rad);
    } else {
        col = blur3(pr, pg, pb, rad);
    }

    // Цвет стекла: линза чистая и сочная, панель дымчатая.
    // Световой валик вокруг касания имитирует водяной бугорок.
    float waterRim = exp(-abs(length(td) - dpx * 7.0) / (dpx * 2.0)) * water;
    col += float3(0.16, 0.21, 0.25) * waterRim * 0.42;
    col += float3(0.42, 0.48, 0.52) * exp(-dot(td - float2(-dpx * 2.0, -dpx * 3.0),
                                                  td - float2(-dpx * 2.0, -dpx * 3.0)) /
                                             (dpx * dpx * 18.0)) * water * 0.24;
    float luma = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(float3(luma), col, 1.0 + 0.30 * lensG);

    // Frosted Glass: матовая поверхность рассеивает детали, слегка смягчает
    // насыщенность и добавляет очень мелкую равномерную микрофактуру.
    // Эффект сильнее на панели и слабее внутри чистой активной линзы.
    float frostLuma = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(col, float3(frostLuma), frost * 0.42);
    float2 grainCell = floor(p / max(dpx * 0.72, 1.0));
    float grainHash = fract(sin(dot(grainCell, float2(127.1, 311.7))) * 43758.5453);
    col += (grainHash - 0.5) * clamp(grainK, 0.0, 1.0) * frost * 0.10;

    // цвет преломления: тема окрашивает фон, который виден сквозь стекло
    col *= mix(float3(1.0), refrTint, 0.9);
    col = mix(col, float3(0.14, 0.12, 0.16), mix(0.15, 0.04, lensG) * tintK * (1.0 - 0.7 * lsK));
    // в покое линза — плоская светлая таблетка без преломления
    col = mix(col, float3(0.28, 0.26, 0.31), 0.40 * lensIn * (1.0 - g));
    col += 0.015 + 0.03 * lensG;

    // иконки и подписи преломляет только линза (панель их не искажает)
    float2 offI = -nL * mL;
    float4 ir = float4(icons.eval(cp(p + (bub.xy - p) * mag + offI * (1.0 - disp) - sh)));
    float4 ig = float4(icons.eval(cp(p + (bub.xy - p) * mag + offI)));
    float4 ib = float4(icons.eval(cp(p + (bub.xy - p) * mag + offI * (1.0 + disp) + sh)));
    col = float3(col.r * (1.0 - ir.a) + ir.r,
                 col.g * (1.0 - ig.a) + ig.g,
                 col.b * (1.0 - ib.a) + ib.b);

    float yN = clamp((p.y - (bar.y - bar.w)) / (2.0 * bar.w), 0.0, 1.0);
    col += 0.03 * (1.0 - yN) * (1.0 - lensG);

    float2 L = normalize(float2(-0.55 + vel * 0.4, -0.85));

    // кромка панели
    col += exp(-depU / (dpx * 1.1)) * spec(nU, L) * 0.35 * (1.0 - lensG);
    // край панели просвечивает сквозь линзу
    col += 0.20 * exp(-abs(db) / (dpx * 0.9)) * lensG * step(db, 0.0);

    // кромка линзы: радужная обводка (R/B со сдвигом) + свет, «слипающийся» у края
    float wR = dpx * 1.3;
    float s1 = spec(nL, L);
    float3 rim = float3(exp(-abs(dl + dpx * 0.8) / wR),
                        exp(-abs(dl) / wR),
                        exp(-abs(dl - dpx * 0.8) / wR));
    col += rim * rimTint * s1 * 0.85 * g;
    float band = exp(-depL / (dpx * 5.5)) * lensG;
    col += band * (pow(max(dot(nL, -L), 0.0), 1.5) * 0.16 + pow(max(dot(nL, L), 0.0), 2.0) * 0.12);
    // тёмная канавка сразу за яркой кромкой: толстое стекло
    col *= 1.0 - 0.16 * exp(-abs(depL - dpx * 3.4) / (dpx * 1.7)) * lensG;
    float3 lsBlue = float3(0.25, 0.62, 1.0);
    float3 lsWarm = float3(1.0, 0.55, 0.85);
    float edgeL = exp(-abs(dl) / (dpx * 1.6));
    float sideL = clamp(-nL.x, 0.0, 1.0);
    float sideR = clamp(nL.x, 0.0, 1.0);
    col = mix(col, col * float3(0.94, 1.0, 1.08), lsK * lensG * 0.30);
    col += lsBlue * lsK * lensG * edgeL * sideL * 0.95;
    col += lsWarm * lsK * lensG * edgeL * sideR * 0.75;
    col += lsBlue * lsK * lensG * band * 0.12;

    if (glowK > 0.0) {
        float cg = exp(-depL / (dpx * 3.0)) * lensG * (0.012 + 0.03 * g);
        // рассеивание: спад как у реального света (обратно-квадратичный), без жёсткого края
        float halo = lensG * g * 0.026 / (1.0 + pow(max(depL, 0.0) / (dpx * 6.0), 2.0));
        col += (glowCol * cg + rimTint * halo) * glowK;
    }

    // трещины: тёмная сердцевина, светлая кромка, блик отражения вдоль линии
    if (crackK > 0.0) {
        float e = cvK.x;
        float line = exp(-e / (dpx * 0.45));
        float glint = exp(-e / (dpx * 0.18));
        float mask = crackK * (1.0 - 0.55 * lensG);
        col *= (0.90 + 0.20 * crackHash(cvK.yz).x) * (1.0 - 0.35 * line * mask);
        col += glowTint * (line * 0.30 + glint * 0.40) * mask;
        col += glint * pow(max(sin(p.x * 0.07 + p.y * 0.031), 0.0), 6.0) * 0.22 * mask;
    }
    col = clamp(col, 0.0, 1.0);
    float3 outRgb = col * a + glowCol * gl * (1.0 - a);
    float outA = a + gl * (1.0 - a);
    return half4(float4(outRgb, outA));
}
"""


# ---------------------------------------------------------------------------
# Бета · Реалистичное стекло (Optical Glass 2)
# Отдельный физический шейдер: профиль скоса «сквиркл» -> нормаль -> закон Снеллиуса
# (преломление по каждому каналу RGB отдельно = настоящая дисперсия), Френель по Шлику,
# отражение студийного окружения, два зеркальных блика, каустика, поглощение, тень.
# Параметры не зависят от обычных настроек стекла (они в бета-режиме отключены).
# ---------------------------------------------------------------------------
# (ключ, подпись, мин, макс, шаги, по умолчанию, формат)
BETA_PARAMS = (
    ("glass_bx_ior", "Показатель преломления (IOR)", 100, 220, 24, 150, "ior"),
    ("glass_bx_thick", "Толщина стекла", 0, 100, 20, 60, "int"),
    ("glass_bx_bevel", "Ширина скоса кромки", 10, 100, 18, 55, "int"),
    ("glass_bx_disp", "Хроматическая дисперсия", 0, 100, 20, 35, "int"),
    ("glass_bx_fres", "Отражение Френеля", 0, 150, 30, 100, "int"),
    ("glass_bx_env", "Отражение окружения", 0, 100, 20, 55, "int"),
    ("glass_bx_spec", "Яркость бликов", 0, 150, 30, 100, "int"),
    ("glass_bx_sharp", "Острота бликов", 0, 100, 20, 45, "int"),
    ("glass_bx_light", "Направление света", 0, 355, 71, 235, "deg"),
    ("glass_bx_caus", "Каустика (свет внутри кромки)", 0, 100, 20, 45, "int"),
    ("glass_bx_rough", "Матовость (рассеивание)", 0, 40, 20, 8, "int"),
    ("glass_bx_sat", "Насыщенность фона", 0, 100, 20, 40, "int"),
    ("glass_bx_dens", "Плотность / затемнение", 0, 100, 20, 20, "int"),
    ("glass_bx_depth", "Глубина (тень у кромки)", 0, 100, 20, 35, "int"),
    ("glass_bx_shadow", "Тень под стеклом", 0, 100, 20, 35, "int"),
    ("glass_bx_sglow", "Яркость бокового свечения", 0, 150, 30, 35, "int"),
    ("glass_bx_sglow_w", "Рассеивание свечения", 0, 100, 20, 50, "int"),
    ("glass_bx_sglow_f", "Только по бокам (100) / вокруг (0)", 0, 100, 20, 100, "int"),
)
# (заголовок группы, ключи)
BETA_GROUPS = (
    ("Оптика преломления", ("glass_bx_ior", "glass_bx_thick", "glass_bx_bevel", "glass_bx_disp")),
    ("Свет и отражения", ("glass_bx_fres", "glass_bx_env", "glass_bx_spec", "glass_bx_sharp",
                          "glass_bx_light", "glass_bx_caus")),
    ("Тело стекла", ("glass_bx_rough", "glass_bx_sat", "glass_bx_dens", "glass_bx_depth",
                     "glass_bx_shadow")),
    ("Боковое свечение линзы", ("glass_bx_sglow", "glass_bx_sglow_w", "glass_bx_sglow_f")),
)

AGSL_BETA = """
uniform shader content;
uniform shader icons;
uniform float2 res;
uniform float4 bar;    // cx, cy, halfW, halfH (px)
uniform float4 bub;    // линза: cx, cy, halfW, halfH (px)
uniform float infl;
uniform float vel;
uniform float dpx;
uniform float glowK;
uniform float3 rimTint;
uniform float3 glowTint;
uniform float3 refrTint;
uniform float lsK;
uniform float crackK;
uniform float refr;
uniform float lean;
uniform float dispK;
uniform float edgeK;
uniform float tintK;
uniform float blurK;
uniform float frostK;
uniform float grainK;
uniform float3 touch;
uniform float4 bA;     // IOR, множитель толщины, ширина скоса (доля), разброс IOR для дисперсии
uniform float4 bB;     // Френель, блики, степень блика, насыщенность
uniform float4 bC;     // матовость (px), плотность, глубина, отражение окружения
uniform float2 bD;     // каустика, тень
uniform float2 bL;     // направление света (экранные x, y), нормировано
uniform float3 bG;     // боковое свечение: яркость, рассеивание (множитель dpx), доля «только по бокам»

float sdBox(float2 p, float2 c, float2 hs) {
    float r = min(hs.x, hs.y);
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float dB(float2 p) { return sdBox(p, bar.xy, bar.zw); }
float dL(float2 p) { return sdBox(float2(p.x - lean * (p.y - bub.y), p.y), bub.xy, bub.zw); }

float2 gradU(float2 p) {
    float e = 1.0;
    float2 g = float2(dB(p + float2(e, 0.0)) - dB(p - float2(e, 0.0)),
                      dB(p + float2(0.0, e)) - dB(p - float2(0.0, e)));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}
float2 gradL(float2 p) {
    float e = 1.0;
    float2 g = float2(dL(p + float2(e, 0.0)) - dL(p - float2(e, 0.0)),
                      dL(p + float2(0.0, e)) - dL(p - float2(0.0, e)));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}

float2 cp(float2 q) { return clamp(q, float2(0.5), res - 0.5); }

float3 tap3(float2 qr, float2 qg, float2 qb, float2 o) {
    return float3(content.eval(cp(qr + o)).r, content.eval(cp(qg + o)).g, content.eval(cp(qb + o)).b);
}

float3 blur3(float2 qr, float2 qg, float2 qb, float rad) {
    float3 s = tap3(qr, qg, qb, float2(0.0));
    for (int i = 0; i < 6; i++) {
        float a = 1.0472 * float(i) + 0.5;
        s += tap3(qr, qg, qb, float2(cos(a), sin(a)) * rad);
        s += tap3(qr, qg, qb, float2(cos(a + 0.5236), sin(a + 0.5236)) * rad * 0.5);
    }
    return s / 13.0;
}

float3 blurMono(float2 q, float rad) {
    float3 s = content.eval(cp(q)).rgb;
    for (int i = 0; i < 6; i++) {
        float a = 1.0472 * float(i) + 0.5;
        s += content.eval(cp(q + float2(cos(a), sin(a)) * rad)).rgb;
        s += content.eval(cp(q + float2(cos(a + 0.5236), sin(a + 0.5236)) * rad * 0.66)).rgb;
        s += content.eval(cp(q + float2(cos(a + 0.2618), sin(a + 0.2618)) * rad * 0.33)).rgb;
    }
    return s / 19.0;
}

// Профиль скоса: выпуклый «сквиркл» h(t) = (1 - (1 - t)^4)^(1/4), t = глубина / ширина скоса.
// Возвращает производную dh/dt (у самой кромки стремится к бесконечности, поэтому ограничена).
float bevelS(float t) {
    float u = clamp(1.0 - t, 0.0, 1.0);
    float u3 = u * u * u;
    float q = max(1.0 - u3 * u, 0.0004);
    return min(u3 / pow(q, 0.75), 7.0);
}

// Преломление по Снеллиусу: луч смотрит строго в экран, N - нормаль поверхности (z к зрителю),
// iv - показатель преломления, th - толщина стекла (px). Возвращает смещение точки фона.
float2 refrDisp(float3 N, float iv, float th) {
    float eta = 1.0 / iv;
    float ci = N.z;
    float k = max(1.0 - eta * eta * (1.0 - ci * ci), 0.0);
    float c = eta * ci - sqrt(k);
    float tzm = max(eta - c * N.z, 0.25);
    return (c * N.xy / tzm) * th;
}

// Простое студийное окружение: небо сверху, тёмный пол, два софтбокса (по и против света).
float3 envCol(float3 R, float3 L3) {
    float up = clamp(-R.y * 0.5 + 0.5, 0.0, 1.0);
    float3 sky = mix(float3(0.10, 0.11, 0.14), float3(0.78, 0.86, 1.0), up);
    float b1 = smoothstep(0.80, 0.98, dot(R, L3));
    float b2 = smoothstep(0.88, 0.99, dot(R, float3(-L3.x, -L3.y, L3.z)));
    return sky + float3(1.0, 0.98, 0.94) * b1 * 1.1 + float3(0.80, 0.90, 1.0) * b2 * 0.5;
}

half4 main(float2 p) {
    // Старые uniform-ы панели объявлены ради совместимости с кодом плагина; эта проверка
    // никогда не срабатывает, но не даёт компилятору выбросить их.
    float keep = refr + lsK + crackK + dispK + edgeK + tintK + blurK + frostK + grainK + glowK
               + dot(rimTint, glowTint) + dot(refrTint, float3(1.0));
    if (keep > 1.0e30) return half4(0.0);

    float dBv = dB(p);
    float dl = dL(p);
    float du = min(dBv, dl);
    if (du > dpx * 14.0) return half4(0.0);

    float2 L2 = bL;
    float3 L3 = normalize(float3(L2 * 0.8, 0.62));
    float2 nL = gradL(p);
    float g = clamp(infl, 0.0, 1.0);
    float lensIn = 1.0 - smoothstep(-1.0, 1.0, dl);

    // боковое белое свечение: мягкий рассеянный свет слева и справа от линзы
    float gw = 0.0;
    if (bG.x > 0.0) {
        float side = mix(1.0, pow(clamp(abs(nL.x), 0.0, 1.0), 2.0), bG.z);
        float sp = max(dpx * bG.y, 0.5);
        float outer = exp(-max(dl, 0.0) / sp);
        float inner = exp(-max(-dl, 0.0) / (sp * 0.6)) * 0.35;
        gw = mix(outer, inner, lensIn) * side * bG.x * 0.55 * (0.35 + 0.65 * g);
        gw = clamp(gw, 0.0, 1.0);
    }

    float a = clamp(0.5 - du, 0.0, 1.0);
    if (a <= 0.0) {
        // мягкая контактная тень под стеклом + свечение
        float ds = min(dB(p - float2(0.0, dpx * 2.5)), dL(p - float2(0.0, dpx * 2.5)));
        float sa = exp(-max(ds, 0.0) / (dpx * 4.5)) * bD.y * 0.34;
        return half4(float4(gw, gw, gw, sa * (1.0 - gw) + gw));
    }

    float ior = bA.x;
    float thickMul = bA.y;
    float bevelF = bA.z;
    float dispD = bA.w;
    float fresK = bB.x;
    float specK = bB.y;
    float shin = bB.z;
    float satK = bB.w;
    float roughPx = bC.x;
    float densK = bC.y;
    float depthK = bC.z;
    float envK = bC.w;
    float causK = bD.x;

    float2 nU = gradU(p);
    float lensG = lensIn * g;
    float inB = 1.0 - smoothstep(-1.0, 1.0, dBv);

    // геометрия скоса: панель (тоньше) и линза (толще); наклоны складываются как высоты
    float depB = max(-dBv, 0.0);
    float depL = max(-dl, 0.0);
    float wB = max(bar.w * bevelF * 0.9, dpx * 2.0);
    float wL = max(bub.w * bevelF, dpx * 2.0);
    float thB = bar.w * 0.42 * thickMul;
    float thL = bub.w * 0.62 * thickMul;
    float tB = clamp(depB / wB, 0.0, 1.0);
    float tL = clamp(depL / wL, 0.0, 1.0);
    float sB = min((thB / wB) * bevelS(tB), 8.0) * (1.0 - lensG) * inB;
    float sL = min((thL / wL) * bevelS(tL), 8.0) * lensG;
    float3 N = normalize(float3(nU * sB + nL * sL, 1.0));
    float tEff = mix(tB, tL, lensG);
    float thEff = mix(thB, thL, lensG);

    // точка фона: водяной бугорок под пальцем + лёгкое увеличение под линзой
    float2 base = p;
    float2 td = p - touch.xy;
    float tr = max(dpx * 15.0, 1.0);
    float water = clamp(touch.z, 0.0, 1.0) * exp(-dot(td, td) / (tr * tr));
    base += td / max(length(td), 1.0) * water * dpx * 5.0;
    base += (bub.xy - p) * (0.045 * lensG * min(thickMul, 1.5));

    // преломление отдельно для R, G, B: у синего IOR выше, у красного ниже
    float2 oR = refrDisp(N, max(ior - dispD, 1.0), thEff);
    float2 oG = refrDisp(N, ior, thEff);
    float2 oB = refrDisp(N, ior + dispD, thEff);
    float2 shf = float2(vel * dpx * 2.0 * lensG, 0.0);
    float2 pr = base + oR - shf;
    float2 pg = base + oG;
    float2 pb = base + oB + shf;

    // матовость: слабое рассеивание, внутри активной линзы стекло чище
    float rad = dpx * roughPx * 0.22 * mix(1.0, 0.55, lensG);
    float3 col;
    if (rad < 0.4) {
        col = tap3(pr, pg, pb, float2(0.0));
    } else if (distance(pr, pb) < 0.75) {
        col = blurMono(pg, rad);
    } else {
        col = blur3(pr, pg, pb, rad);
    }

    // цвет стекла: насыщенность фона, лёгкое осветление, поглощение (толще у кромки)
    float luma = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(float3(luma), col, 1.0 + satK * 0.9);
    col = col * (1.0 + 0.05 * satK) + 0.012;
    float edgeAbs = 1.0 - tEff;
    col = mix(col, float3(0.07, 0.08, 0.11), densK * (0.20 + 0.28 * edgeAbs) * (1.0 - lensG));
    // в покое линза - светлая таблетка без преломления
    col = mix(col, float3(0.28, 0.26, 0.31), 0.40 * lensIn * (1.0 - g));

    // сама панель (оттенок и кромка) тоже видна сквозь линзу и преломляется (бета)
    float2 pPan = p + (pg - p) * 4.0;  // сдвиг слоя панели усилен, чтобы её край был виден
    float dBq = dB(pPan);
    float pA = (1.0 - smoothstep(-1.0, 1.0, dBq)) * lensG;
    col = mix(col, float3(0.07, 0.08, 0.11), 0.50 * pA);
    float2 gBq = float2(dB(pPan + float2(1.0, 0.0)) - dB(pPan - float2(1.0, 0.0)),
                        dB(pPan + float2(0.0, 1.0)) - dB(pPan - float2(0.0, 1.0)));
    float2 nBq = length(gBq) > 0.0001 ? normalize(gBq) : float2(0.0, -1.0);
    float ringB = exp(-abs(dBq) / (dpx * 1.3)) * lensG;
    col += ringB * (pow(max(dot(nBq, L2), 0.0), 2.0) + 0.55 * pow(max(dot(nBq, -L2), 0.0), 2.0) + 0.10) * 0.60;

    // иконки и подписи преломляет только линза (панель их не искажает)
    float3 NI = normalize(float3(nL * sL, 1.0));
    float2 bI = p + (bub.xy - p) * (0.045 * lensG * min(thickMul, 1.5));
    float4 ir = float4(icons.eval(cp(bI + refrDisp(NI, max(ior - dispD, 1.0), thL) * lensG - shf)));
    float4 ig = float4(icons.eval(cp(bI + refrDisp(NI, ior, thL) * lensG)));
    float4 ib = float4(icons.eval(cp(bI + refrDisp(NI, ior + dispD, thL) * lensG + shf)));
    col = float3(col.r * (1.0 - ir.a) + ir.r,
                 col.g * (1.0 - ig.a) + ig.g,
                 col.b * (1.0 - ib.a) + ib.b);

    float yN = clamp((p.y - (bar.y - bar.w)) / (2.0 * bar.w), 0.0, 1.0);
    col += 0.03 * (1.0 - yN) * (1.0 - lensG);

    // Френель (Шлик) и отражение окружения
    float cz = N.z;
    float f0 = pow((ior - 1.0) / (ior + 1.0), 2.0);
    float fr = f0 + (1.0 - f0) * pow(1.0 - cz, 5.0);
    float3 R = float3(2.0 * cz * N.xy, 2.0 * cz * cz - 1.0);
    float3 envC = envCol(R, L3);
    float reflA = clamp(fr * fresK * 1.5, 0.0, 0.92);
    col = mix(col, mix(float3(0.92, 0.94, 1.0), envC, envK), reflA);

    // два зеркальных блика: со стороны света и приглушённый с противоположной
    float3 Hh = normalize(L3 + float3(0.0, 0.0, 1.0));
    float3 L3b = normalize(float3(-L3.x, -L3.y, L3.z * 0.8));
    float3 Hb = normalize(L3b + float3(0.0, 0.0, 1.0));
    float s1 = pow(max(dot(N, Hh), 0.0), shin);
    float s2 = pow(max(dot(N, Hb), 0.0), shin * 0.8);
    col += float3(1.0, 0.99, 0.96) * (s1 + 0.55 * s2) * specK * 1.2;

    // тонкая яркая кромка по границе, зависит от направления света
    float2 nE = mix(nU, nL, step(dl, dBv));
    float dep = max(-du, 0.0);
    float ang1 = max(dot(nE, L2), 0.0);
    float ang2 = max(dot(nE, -L2), 0.0);
    float rim = exp(-dep / (dpx * 0.9)) * (0.10 + 0.90 * pow(ang1, 1.4) + 0.55 * pow(ang2, 1.8));
    col += float3(0.96, 0.97, 1.0) * rim * 0.55 * min(fresK, 1.5);

    // глубина: тёмная канавка за яркой кромкой и мягкое затемнение к краю
    col *= 1.0 - depthK * 0.30 * exp(-abs(dep - dpx * 3.6) / (dpx * 2.0));
    col *= 1.0 - depthK * 0.14 * (1.0 - tEff);

    // каустика: свет, собранный скосом, ложится на сторону, противоположную источнику
    float wE = mix(wB, wL, lensG);
    float cband = exp(-abs(dep - wE * 0.55) / max(wE * 0.28, dpx));
    col += float3(1.0, 0.95, 0.88) * causK * pow(ang2, 1.5) * cband * 0.30;

    col += float3(1.0) * gw * 0.6;
    col = clamp(col, 0.0, 1.0);
    float3 outRgb = col * a + float3(gw) * (1.0 - a);
    float outA = a + gw * (1.0 - a);
    return half4(float4(outRgb, outA));
}
"""

# Стекло на экране Bluetooth (координаты сняты со скриншота шириной 1165 px; всё считается долями ширины экрана)
SCR_REF_W = 1165.0
SCR_REF_BOTTOM = 2448.0   # нижняя граница области контента на скриншоте: 2576 px минус ~128 px системной панели
SCR_PILL_X0 = 44.0        # левый край переключателя All/BLE/Advert
SCR_SEG_X0 = 66.0         # внутренняя дорожка переключателя: три равные секции
SCR_SEG_X1 = 1098.0
SCR_NAMES = ("All", "BLE", "Advert")
# (ключ, секция: None — всегда, 0 — только «All»; x0, y0, x1, y1; радиус; ширина кромки dp; фаза блика; задержка появления, с; якорь снизу)
SCR_ELEMS = (
    ("pill", None, 44.0, 147.0, 1120.0, 322.0, 88.0, 11.0, 0.0, 0.00, False),
    ("card", 0, 44.0, 1187.0, 1120.0, 2078.0, 76.0, 13.0, 1.7, 0.10, True),
    ("dev", 0, 132.0, 1274.0, 1033.0, 1429.0, 58.0, 9.0, 3.1, 0.20, True),
    ("go", 0, 132.0, 1836.0, 1033.0, 1990.0, 77.0, 9.0, 4.6, 0.28, True),
)

AGSL_RIM = """
uniform shader content;
uniform float2 res;
uniform float dpx;
uniform float rad;
uniform float band;
uniform float pad;
uniform float t;
uniform float intro;
uniform float vis;
uniform float pulse;
uniform float seed;
uniform float k;
float sd(float2 p, float2 c, float2 hs, float r) {
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
half4 main(float2 p) {
    float f = vis * clamp(intro * 1.6, 0.0, 1.0);
    float2 c = res * 0.5;
    float2 hs = res * 0.5 - pad;
    float r = min(rad, min(hs.x, hs.y));
    float d = sd(p, c, hs, r);
    if (d > dpx * 10.0 || f <= 0.002) return half4(0.0);
    float a = clamp(0.5 - d, 0.0, 1.0);
    float dep = max(-d, 0.0);
    float2 q0 = p - c;
    float yN = clamp(0.5 + q0.y / (2.0 * hs.y), 0.0, 1.0);
    // лёгкая вуаль по всей поверхности: середина остаётся живым интерфейсом
    float Av = a * (0.035 + 0.06 * (1.0 - yN)) * k;
    float3 Cv = float3(0.92, 0.90, 1.0);
    if (dep > band * 1.5) {
        return half4(float4(Cv * Av * f, Av * f));
    }
    float2 g = float2(sd(p + float2(1.0, 0.0), c, hs, r) - sd(p - float2(1.0, 0.0), c, hs, r),
                      sd(p + float2(0.0, 1.0), c, hs, r) - sd(p - float2(0.0, 1.0), c, hs, r));
    float gl0 = length(g);
    float2 n = gl0 > 0.0001 ? g / gl0 : float2(0.0, -1.0);
    float3 cr = float3(0.0);
    float Ab = 0.0;
    if (dep < band) {
        float tt = clamp(dep / band, 0.0, 1.0);
        float m = band * 0.95 * pow(1.0 - tt, 2.0) * k;
        float2 off = -n * m;
        float2 lo = float2(0.5);
        float2 hi = res - 0.5;
        cr = float3(content.eval(clamp(p + off * 0.86, lo, hi)).r,
                    content.eval(clamp(p + off, lo, hi)).g,
                    content.eval(clamp(p + off * 1.14, lo, hi)).b);
        Ab = a * (1.0 - smoothstep(band * 0.45, band, dep)) * 0.92;
    }
    float A = Av + Ab * (1.0 - Av);
    float3 P = Cv * Av + cr * Ab * (1.0 - Av);
    // бегущий по кромке блик, «пробег» света при появлении и вспышка при импульсе
    float ang = t * 0.45 + seed;
    float2 L = float2(cos(ang), sin(ang));
    float edge = exp(-dep / (dpx * 1.3));
    float sp = pow(max(dot(n, L), 0.0), 3.0) + 0.45 * pow(max(dot(n, -L), 0.0), 3.0) + 0.10;
    float th = atan(q0.y, q0.x) / 6.2831853 + 0.5;
    float dth = abs(th - intro);
    dth = min(dth, 1.0 - dth);
    float sweep = exp(-dth * dth * 260.0) * (1.0 - smoothstep(0.88, 1.0, intro)) * step(0.001, intro);
    float s = edge * (sp * 0.50 + sweep * 1.1 + pulse * 0.6) * a * k;
    // радужная кайма по кромке
    float wR = dpx * 1.2;
    float3 rim = float3(exp(-abs(d + dpx * 0.8) / wR), exp(-abs(d) / wR), exp(-abs(d - dpx * 0.8) / wR));
    float rs = (0.55 * pow(max(dot(n, L), 0.0), 2.0) + 0.10) * 0.55 * a * k;
    P += rim * rs;
    A = clamp(A + rim.g * rs * 0.7, 0.0, 1.0);
    P += float3(s);
    A = clamp(A + s * 0.85, 0.0, 1.0);
    // тёмный жёлоб сразу за кромкой: толстое стекло
    float gv = 0.16 * exp(-abs(dep - dpx * 3.6) / (dpx * 1.8)) * a * k;
    P *= (1.0 - gv);
    A = A + gv * (1.0 - A);
    // внешнее свечение
    float go = exp(-max(d, 0.0) / (dpx * 3.2)) * (0.05 + 0.10 * pulse) * (1.0 - a) * k;
    P += float3(0.95, 0.80, 0.98) * go;
    A = clamp(A + go, 0.0, 1.0);
    P = min(P, float3(A));
    return half4(float4(P * f, A * f));
}
"""

AGSL_SEG = """
uniform shader content;
uniform shader icons;
uniform float2 res;
uniform float dpx;
uniform float rad;
uniform float pad;
uniform float t;
uniform float intro;
uniform float vis;
uniform float pulse;
uniform float seed;
uniform float4 lens;
uniform float lensA;
uniform float stretch;
uniform float infl;
uniform float2 tilt;
uniform float4 sty;
uniform float k;
float sd(float2 p, float2 c, float2 hs, float r) {
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float2 sdn(float2 p, float2 c, float2 hs, float r) {
    float2 g = float2(sd(p + float2(1.0, 0.0), c, hs, r) - sd(p - float2(1.0, 0.0), c, hs, r),
                      sd(p + float2(0.0, 1.0), c, hs, r) - sd(p - float2(0.0, 1.0), c, hs, r));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}
half4 main(float2 p) {
    float f = vis * clamp(intro * 1.6, 0.0, 1.0);
    float2 c = res * 0.5;
    float2 hs = res * 0.5 - pad + dpx * 0.6;
    float r = min(rad + dpx * 0.6, min(hs.x, hs.y));
    float d = sd(p, c, hs, r);
    if (d > dpx * 10.0 || f <= 0.002) return half4(0.0);
    float a = clamp(0.5 - d, 0.0, 1.0);
    float dep = max(-d, 0.0);
    float2 n = sdn(p, c, hs, r);
    float2 lo = float2(0.5);
    float2 hi = res - 0.5;
    // Фон берём из левого поля снимка на той же высоте: родной переключатель под окном закрыт целиком.
    float2 wv = float2(sin(p.y * 0.045 + t * 1.7 + tilt.x * 2.0), cos(p.x * 0.035 - t * 1.3 + tilt.y * 2.0)) * dpx * 1.6 * sty.y;
    wv += tilt * dpx * 5.0;
    float2 wd = -n * dpx * 5.0 * exp(-dep / (dpx * 4.0));
    float2 bq = clamp(float2(2.0, p.y) + wv + wd, lo, hi);
    float bo = dpx * 2.5;
    float3 bg = (content.eval(bq).rgb * 2.0
                 + content.eval(clamp(bq + float2(bo, 0.0), lo, hi)).rgb
                 + content.eval(clamp(bq - float2(bo, 0.0), lo, hi)).rgb
                 + content.eval(clamp(bq + float2(0.0, bo), lo, hi)).rgb
                 + content.eval(clamp(bq - float2(0.0, bo), lo, hi)).rgb) / 6.0;
    float yN = clamp((p.y - (c.y - hs.y)) / (2.0 * hs.y), 0.0, 1.0);
    // Дорожка почти прозрачная: фон страницы плюс лёгкая дымка.
    float3 col = bg * sty.z + float3(0.012, 0.012, 0.018) + 0.012 * (1.0 - yN);
    // матовость: мелкое зерно вместо гладкого стекла
    float nz = fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453) - 0.5;
    col += nz * sty.w;
    // Две диагональные световые полосы медленно скользят по стеклу.
    float u = (p.x * 0.82 + p.y * 0.57) / res.y;
    float ph = fract(u * 0.55 - t * 0.06 + seed * 0.13);
    float z = (ph - 0.5) * 7.0;
    col += float3(0.030, 0.030, 0.042) * exp(-z * z) * k;
    float ang = t * 0.45 + seed;
    float2 L = float2(cos(ang), sin(ang));
    float edge = exp(-dep / (dpx * 1.3));
    float sp = pow(max(dot(n, L), 0.0), 3.0) + 0.45 * pow(max(dot(n, -L), 0.0), 3.0) + 0.12;
    float2 q0 = p - c;
    float th = atan(q0.y, q0.x) / 6.2831853 + 0.5;
    float dth = abs(th - intro);
    dth = min(dth, 1.0 - dth);
    float sweep = exp(-dth * dth * 260.0) * (1.0 - smoothstep(0.88, 1.0, intro)) * step(0.001, intro);
    col += edge * (sp * 0.38 + sweep * 0.8 + pulse * 0.3) * k;
    col += exp(-dep / (dpx * 6.0)) * 0.05;
    float wR = dpx * 1.2;
    float3 rim = float3(exp(-abs(d + dpx * 0.8) / wR), exp(-abs(d) / wR), exp(-abs(d - dpx * 0.8) / wR));
    col += rim * (0.30 * pow(max(dot(n, L), 0.0), 2.0) + 0.06) * 0.40 * k;
    col *= 1.0 - 0.10 * exp(-abs(dep - dpx * 3.4) / (dpx * 1.7));
    float sideK = pow(abs(n.x), 4.0);
    col += float3(0.85, 0.80, 1.0) * sideK * exp(-dep / (dpx * 4.0)) * 0.10 * k * sty.x;
    // Линза: прозрачное стекло, которое увеличивает подписи и преломляет их у кромки.
    float2 lc = float2(lens.x + lens.z * 0.5, lens.y + lens.w * 0.5);
    float wob = sin(t * 2.6 + lc.y * 0.03) * 0.010 * (1.0 + 2.0 * stretch);
    float2 lhs = float2(lens.z * 0.5 * (1.0 + 0.10 * stretch + 0.10 * infl + wob),
                        lens.w * 0.5 * (1.0 + 0.05 * stretch + 0.08 * infl + wob * 0.6)) - dpx * 1.0;
    float lr = lhs.y;
    float dl = sd(p, lc, lhs, lr);
    float la = clamp(0.5 - dl, 0.0, 1.0) * lensA;
    float depl = max(-dl, 0.0);
    float2 nl = sdn(p, lc, lhs, lr);
    col *= 1.0 - 0.20 * exp(max(dl, 0.0) / (-dpx * 3.5)) * lensA * (1.0 - la);
    float yl = clamp((p.y - (lc.y - lhs.y)) / (2.0 * lhs.y), 0.0, 1.0);
    float3 lcol = col * 0.94 + float3(0.020, 0.018, 0.030) + 0.020 * (1.0 - yl) + 0.02 * infl;
    float2 L2 = float2(cos(ang + 1.3), sin(ang + 1.3));
    float s2 = pow(max(dot(nl, L2), 0.0), 3.0) + 0.45 * pow(max(dot(nl, -L2), 0.0), 3.0) + 0.14;
    lcol += exp(-depl / (dpx * 1.3)) * (s2 * 0.40 + pulse * 0.3);
    float3 rl = float3(exp(-abs(dl + dpx * 0.8) / wR), exp(-abs(dl) / wR), exp(-abs(dl - dpx * 0.8) / wR));
    lcol += rl * (0.30 * pow(max(dot(nl, L2), 0.0), 2.0) + 0.06) * 0.45;
    lcol += nz * 0.018;
    lcol *= 1.0 - 0.16 * exp(-abs(depl - dpx * 3.2) / (dpx * 1.6));
    col = mix(col, lcol, la);
    col += (nl.x * tilt.x + nl.y * tilt.y) * 0.04 * la;
    float rr = length(p - c) / (res.x * 0.5);
    col += float3(0.70, 0.62, 1.0) * exp(-pow(rr - intro * 1.2, 2.0) * 60.0) * 0.12 * f * (1.0 - intro);
    // Подписи: вне линзы обычные, внутри увеличены, со складкой у кромки и радужной дисперсией.
    float tt = clamp(depl / (lhs.y * 0.55), 0.0, 1.0);
    float em = lhs.y * 0.32 * pow(1.0 - tt, 2.0);
    float mag = 1.14 + 0.12 * infl;
    float2 bs = lc + (p - lc) / mag;
    float2 off = -nl * em;
    float ar = float4(icons.eval(clamp(bs + off * 0.85, lo, hi))).a;
    float ag = float4(icons.eval(clamp(bs + off, lo, hi))).a;
    float ab = float4(icons.eval(clamp(bs + off * 1.15, lo, hi))).a;
    float a0 = float4(icons.eval(clamp(p, lo, hi))).a;
    float3 cov = mix(float3(a0), float3(ar, ag, ab), la);
    float3 lab = mix(float3(0.66, 0.64, 0.72), float3(0.90, 0.89, 0.93), la);
    col = float3(mix(col.r, lab.r, cov.r), mix(col.g, lab.g, cov.g), mix(col.b, lab.b, cov.b));
    col = clamp(col, 0.0, 1.0);
    float go = exp(-max(d, 0.0) / (dpx * 3.2)) * (0.05 + 0.10 * pulse) * (1.0 - a) * k;
    go += pow(abs(n.x), 3.0) * exp(-max(d, 0.0) / (dpx * 6.0)) * 0.12 * (0.8 + 0.2 * sin(t * 1.5)) * (1.0 - a) * k * sty.x;
    float3 P = col * a + float3(0.95, 0.80, 0.98) * go;
    float A = clamp(a + go, 0.0, 1.0);
    P = min(P, float3(A));
    return half4(float4(P * f, A * f));
}
"""

SCR_PM_REF_W = 905.0
# (ключ, x0, y0, x1, y1, seed, задержка появления, с) — иконки шапки вкладки «Плагины»
SCR_PM = (
    ("pm_add", 649.0, 113.0, 717.0, 181.0, 0.0, 0.00),
    ("pm_store", 726.0, 113.0, 794.0, 181.0, 1.3, 0.08),
    ("pm_gear", 801.0, 113.0, 869.0, 181.0, 2.6, 0.16),
)
ANIM_KEYS = ("light", "opacity", "pulse", "rot")
CMDS = set("MmLlHhVvCcSsZz")
NUM_RE = re.compile(r"[MmLlHhVvCcSsZz]|-?(?:\d+\.?\d*|\.\d+)(?:[eE]-?\d+)?")


def argb(v):
    return v - 0x100000000 if v >= 0x80000000 else v


def make_path(d):
    from java import jclass
    p = jclass("android.graphics.Path")()
    toks = NUM_RE.findall(d)
    n = len(toks)
    i = 0
    cmd = ""
    x = y = sx = sy = 0.0
    px = py = None
    while i < n:
        t = toks[i]
        if t in CMDS:
            cmd = t
            i += 1
            if cmd in "Zz":
                p.close()
                x, y = sx, sy
                px = py = None
            continue
        rel = cmd.islower()
        c = cmd.upper()
        if c == "M":
            a, b = float(toks[i]), float(toks[i + 1])
            i += 2
            x, y = (x + a, y + b) if rel else (a, b)
            p.moveTo(x, y)
            sx, sy = x, y
            cmd = "l" if rel else "L"
            px = py = None
        elif c == "L":
            a, b = float(toks[i]), float(toks[i + 1])
            i += 2
            x, y = (x + a, y + b) if rel else (a, b)
            p.lineTo(x, y)
            px = py = None
        elif c == "H":
            a = float(toks[i])
            i += 1
            x = x + a if rel else a
            p.lineTo(x, y)
            px = py = None
        elif c == "V":
            a = float(toks[i])
            i += 1
            y = y + a if rel else a
            p.lineTo(x, y)
            px = py = None
        elif c == "C":
            v = [float(toks[i + k]) for k in range(6)]
            i += 6
            if rel:
                v = [v[0] + x, v[1] + y, v[2] + x, v[3] + y, v[4] + x, v[5] + y]
            p.cubicTo(v[0], v[1], v[2], v[3], v[4], v[5])
            px, py = v[2], v[3]
            x, y = v[4], v[5]
        elif c == "S":
            v = [float(toks[i + k]) for k in range(4)]
            i += 4
            if rel:
                v = [v[0] + x, v[1] + y, v[2] + x, v[3] + y]
            if px is None:
                c1x, c1y = x, y
            else:
                c1x, c1y = 2 * x - px, 2 * y - py
            p.cubicTo(c1x, c1y, v[0], v[1], v[2], v[3])
            px, py = v[0], v[1]
            x, y = v[2], v[3]
        else:
            i += 1
    return p


def make_proxies():
    from java import dynamic_proxy, jclass
    Runnable = jclass("java.lang.Runnable")
    ClickL = jclass("android.view.View$OnClickListener")
    PcL = jclass("android.view.PixelCopy$OnPixelCopyFinishedListener")
    UpdL = jclass("android.animation.ValueAnimator$AnimatorUpdateListener")

    class Run(dynamic_proxy(Runnable)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def run(self):
            self.fn()

    class Clk(dynamic_proxy(ClickL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onClick(self, v):
            self.fn()

    class Pcl(dynamic_proxy(PcL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onPixelCopyFinished(self, result):
            self.fn(int(result))

    class Upd(dynamic_proxy(UpdL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onAnimationUpdate(self, anim):
            self.fn(float(anim.getAnimatedFraction()))

    TouchL = jclass("android.view.View$OnTouchListener")

    class Tch(dynamic_proxy(TouchL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onTouch(self, v, event):
            return bool(self.fn(event))

    FrameL = jclass("android.view.Choreographer$FrameCallback")

    class Frm(dynamic_proxy(FrameL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def doFrame(self, t):
            self.fn()

    return Run, Clk, Pcl, Upd, Tch, Frm


# Темы бара: (кромка, свечение, цвет преломления). Тема 0 — прежний вид.
THEMES = (
    ((1.00, 1.00, 1.00), (0.95, 0.80, 0.98), (1.00, 1.00, 1.00)),  # 0 Классика
    ((0.30, 0.80, 1.00), (0.20, 0.62, 1.00), (0.45, 0.80, 1.00)),  # 1 Неон-голубой
    ((1.00, 0.35, 0.90), (0.72, 0.25, 1.00), (1.00, 0.55, 0.95)),  # 2 Фиолетово-розовый
    ((0.95, 0.97, 1.00), (0.85, 0.90, 1.00), (0.95, 0.97, 1.00)),  # 3 Стеклянный белый
    ((0.78, 0.93, 1.00), (0.55, 0.84, 1.00), (0.80, 0.93, 1.00)),  # 4 Лёд (включается новогодним плагином)
)


# ---- Новогодний декор бара: чистая геометрия (без Android), отрисовка отдельно ----
AGSL_NYMASK = """
uniform shader content;
uniform float4 bub;
float sdL(float2 p) {
    float r = min(bub.z, bub.w);
    float2 q = abs(p - bub.xy) - bub.zw + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
half4 main(float2 p) {
    float d = sdL(p);
    if (d > 0.0) return content.eval(p);          // вне линзы декор как есть: панель его не преломляет
    float e = 1.0;
    float2 g = float2(sdL(p + float2(e, 0.0)) - sdL(p - float2(e, 0.0)),
                      sdL(p + float2(0.0, e)) - sdL(p - float2(0.0, e)));
    float gl = length(g);
    g = gl > 0.0001 ? g / gl : float2(0.0, -1.0);
    float dep = -d;
    float t = clamp(dep / (bub.w * 0.32), 0.0, 1.0);
    float m = bub.w * 0.34 * pow(1.0 - t, 2.0);
    float2 base = p + (bub.xy - p) * 0.03;
    float2 oR = base - g * m * 0.86;
    float2 oG = base - g * m;
    float2 oB = base - g * m * 1.14;
    float4 cr = float4(content.eval(oR));
    float4 cg = float4(content.eval(oG));
    float4 cb = float4(content.eval(oB));
    return half4(half(cr.r), half(cg.g), half(cb.b), half(cg.a));
}
"""


def ny_shapes(win_w, win_h, bar_top, bar_h, bar_w, pad, u):
    """Список операций рисования. u — пикселей в одном dp бара."""
    import math, random
    rnd = random.Random(11)
    ops = []
    L = float(pad)
    R_ = float(pad + bar_w)
    T = float(bar_top)
    B = float(bar_top + bar_h)
    rad = bar_h / 2.0
    WH = (255, 250, 253, 255)
    WB = (255, 200, 220, 255)
    ICE0 = (235, 225, 240, 255)
    ICE1 = (150, 190, 245, 255)

    def blob(x0, x1, ybase, thick_top, thick_bot, seed, fade=True, wob=1.0):
        r = random.Random(seed)
        p1, p2, p3 = r.uniform(0, 6), r.uniform(0, 6), r.uniform(0, 6)
        n = max(12, int((x1 - x0) / (2.0 * u)))
        top, bot = [], []
        for i in range(n + 1):
            f = i / n
            x = x0 + (x1 - x0) * f
            env = math.sin(math.pi * f) ** 0.35 if fade else 1.0
            w1 = 0.5 + 0.5 * math.sin(f * 17.0 + p1) * wob
            w2 = 0.5 + 0.5 * math.sin(f * 41.0 + p2)
            top.append((x, ybase - (thick_top * (0.55 + 0.45 * w1)) * u * env))
            drip = abs(math.sin(f * 23.0 + p3)) ** 1.6
            bot.append((x, ybase + (thick_bot * (0.45 + 0.9 * drip) * (0.7 + 0.3 * w2)) * u * env))
        return top + bot[::-1]

    # 1. снежная шапка по верхней кромке
    x0, x1 = L + rad * 0.55, R_ - rad * 0.55
    cap = blob(x0, x1, T + 0.5 * u, 7.0, 5.0, 3)
    ops.append(("poly", cap, WH, (215, 228, 255, 255)))
    # 2. сосульки под шапкой (в бар) и тонкие по нижней кромке
    x = x0 + 6 * u
    while x < x1 - 6 * u:
        ln = rnd.uniform(4.5, 12.0) * u
        wd = rnd.uniform(1.4, 2.6) * u
        ops.append(("poly", [(x - wd, T + 3.5 * u), (x + wd, T + 3.5 * u), (x, T + 3.5 * u + ln)], ICE0, ICE1))
        x += rnd.uniform(9.0, 17.0) * u
    x = L + rad
    while x < R_ - rad:
        ln = rnd.uniform(2.0, 6.0) * u
        wd = rnd.uniform(1.0, 1.9) * u
        ops.append(("poly", [(x - wd, B - 0.5 * u), (x + wd, B - 0.5 * u), (x, B - 0.5 * u + ln)], ICE0, ICE1))
        x += rnd.uniform(10.0, 20.0) * u
    # 3. сугробы по нижним углам
    for side in (0, 1):
        cx = (L + rad * 0.15) if side == 0 else (R_ - rad * 0.15)
        wid = rad * 2.1
        xa, xb = (cx - rad * 0.5, cx + wid) if side == 0 else (cx - wid, cx + rad * 0.5)
        m = blob(xa, xb, B + 2.5 * u, 9.0, 3.0, 21 + side, True, 1.3)
        ops.append(("poly", m, WH, (205, 222, 255, 255)))
        for k in range(3):
            tx = (xa + (xb - xa) * (0.18 + 0.27 * k)) if side == 0 else (xa + (xb - xa) * (0.25 + 0.27 * k))
            ops.append(("dot", tx, B - 3.0 * u + k * 1.5 * u, 1.1 * u, (200, 255, 255, 255), 0))
    # верхние углы: небольшие сугробы
    for side in (0, 1):
        xa, xb = (L - 2 * u, L + rad * 1.3) if side == 0 else (R_ - rad * 1.3, R_ + 2 * u)
        ops.append(("poly", blob(xa, xb, T + 3 * u, 6.0, 4.5, 31 + side, True, 1.2), WH, (214, 226, 255, 255)))
    # 4. подарок (слева сверху)
    gx, gy = L + 5.0 * u, T + 0.5 * u
    bw, bh = 15.0 * u, 10.0 * u
    ops.append(("poly", [(gx, gy - bh), (gx + bw, gy - bh), (gx + bw, gy), (gx, gy)], (235, 70, 70, 255), (175, 30, 45, 255)))
    ops.append(("poly", [(gx - 1.5 * u, gy - bh - 3.0 * u), (gx + bw + 1.5 * u, gy - bh - 3.0 * u),
                         (gx + bw + 1.5 * u, gy - bh), (gx - 1.5 * u, gy - bh)], (245, 85, 85, 255), (200, 45, 55, 255)))
    ops.append(("poly", [(gx + bw / 2 - 1.8 * u, gy - bh - 3.0 * u), (gx + bw / 2 + 1.8 * u, gy - bh - 3.0 * u),
                         (gx + bw / 2 + 1.8 * u, gy), (gx + bw / 2 - 1.8 * u, gy)], (150, 200, 120, 255), (80, 140, 80, 255)))
    for s in (-1, 1):
        bx = gx + bw / 2 + s * 4.2 * u
        ops.append(("poly", [(gx + bw / 2, gy - bh - 3.0 * u), (bx - s * 0.5 * u, gy - bh - 7.5 * u),
                             (bx + s * 3.0 * u, gy - bh - 5.0 * u), (bx + s * 1.0 * u, gy - bh - 3.0 * u)],
                    (170, 215, 130, 255), (80, 150, 80, 255)))
    ops.append(("poly", blob(gx - 1.5 * u, gx + bw + 1.5 * u, gy - bh - 4.5 * u, 2.6, 1.6, 41, True, 1.0), WH, (225, 235, 255, 255)))
    # 5. леденец (справа сверху)
    hx, hy0 = R_ - 12.5 * u, T + 3.0 * u
    hr = 5.0 * u
    hy1 = T - 12.0 * u
    pts = []
    nv = 8
    for i in range(nv):
        pts.append((hx, hy0 + 2.0 * u + (hy1 - hy0 - 2.0 * u) * i / nv))
    for i in range(1, 15):
        a = math.pi * i / 14.0
        pts.append((hx - hr + hr * math.cos(a), hy1 - hr * math.sin(a)))
    for i in range(1, 4):
        pts.append((hx - 2.0 * hr, hy1 + 1.2 * u * i))
    ops.append(("line", pts, 4.2 * u, (255, 250, 250, 255)))
    seg = []
    for i in range(len(pts) - 1):
        if (i // 2) % 2 == 1:
            ops.append(("line", [pts[i], pts[i + 1]], 4.2 * u, (225, 40, 55, 255), False))
    # 6. гирлянда: провод и огоньки вокруг боковых торцов бара
    cols = [(255, 120, 200, 255), (130, 170, 255, 255), (255, 225, 120, 255), (150, 235, 190, 255), (200, 140, 255, 255)]
    k = 0
    for side in (0, 1):
        cx = L + rad if side == 0 else R_ - rad
        wire = []
        for i in range(0, 21):
            a = math.radians(105 + 150.0 * i / 20.0) if side == 0 else math.radians(-75 + 150.0 * i / 20.0)
            wire.append((cx + (rad + 1.2 * u) * math.cos(a), (T + B) / 2 - (rad + 1.2 * u) * math.sin(a)))
        ops.append(("line", wire, 0.9 * u, (60, 50, 70, 200)))
        for i in range(2, 19, 4):
            ops.append(("dot", wire[i][0], wire[i][1], 1.7 * u, cols[k % 5], 5.0 * u))
            k += 1
    # 7. искры/снежинки на баре
    for _ in range(14):
        sx = rnd.uniform(L + rad * 0.5, R_ - rad * 0.5)
        sy = rnd.uniform(T + 6 * u, B - 4 * u)
        ops.append(("dot", sx, sy, rnd.uniform(0.6, 1.4) * u, (235, 235, 245, 255), 0))
    return ops


class GlassBar(BasePlugin):
    # ------------------------------------------------------------------ жизненный цикл
