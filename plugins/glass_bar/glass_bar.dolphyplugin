AGSL_BTN = """
uniform shader content;
uniform float2 res;
uniform float dpx;
float sdSeg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}
half4 main(float2 p) {
    float2 c = res * 0.5;
    float2 q = p - c;
    float R = min(res.x, res.y) * 0.5 - dpx * 5.0;
    float l = length(q);
    float d = l - R;
    if (d > dpx * 8.0) return half4(0.0);
    float a = clamp(0.5 - d, 0.0, 1.0);
    float2 n = l > 0.001 ? q / l : float2(0.0, -1.0);
    float dep = max(-d, 0.0);
    float m = R * 0.28 * pow(1.0 - clamp(dep / (R * 0.30), 0.0, 1.0), 2.0);
    float2 off = -n * m;
    float2 lo = float2(0.5);
    float2 hi = res - 0.5;
    float3 col = float3(content.eval(clamp(p + off * 0.88, lo, hi)).r,
                        content.eval(clamp(p + off, lo, hi)).g,
                        content.eval(clamp(p + off * 1.12, lo, hi)).b);
    // центр закрываем непрозрачной заливкой: старая серая стрелка не видна, у кромки остаётся преломление
    float cover = smoothstep(dpx * 3.0, dpx * 9.0, dep);
    float3 fill = float3(0.17, 0.15, 0.20) + 0.04 * (1.0 - (q.y + R) / (2.0 * R));
    col = mix(mix(col, float3(0.14, 0.12, 0.16), 0.12) + 0.03, fill, cover);
    // своя стрелка «назад»
    float2 A = float2(-0.36 * R, 0.0);
    float da = min(sdSeg(q, A, float2(0.36 * R, 0.0)),
                   min(sdSeg(q, A, float2(-0.08 * R, -0.30 * R)), sdSeg(q, A, float2(-0.08 * R, 0.30 * R))));
    float aw = dpx * 1.25;
    col = mix(col, float3(0.96, 0.93, 0.98), 1.0 - smoothstep(aw - 0.7, aw + 0.7, da));
    float2 L = normalize(float2(-0.55, -0.85));
    float sp = pow(max(dot(n, L), 0.0), 2.0) + 0.55 * pow(max(dot(n, -L), 0.0), 2.0) + 0.12;
    col += exp(-dep / (dpx * 1.2)) * sp * 0.55;
    col = clamp(col, 0.0, 1.0);
    float gl = exp(-max(d, 0.0) / (dpx * 3.0)) * 0.02;
    float3 gc = float3(0.95, 0.8, 0.98);
    return half4(float4(col * a + gc * gl * (1.0 - a), a + gl * (1.0 - a)));
}
"""

AGSL = """
uniform shader content;
uniform shader icons;
uniform float2 res;
uniform float4 bar;    // cx, cy, halfW, halfH (px)
uniform float4 bub;    // линза: cx, cy, halfW, halfH (px)
uniform float infl;
uniform float vel;
uniform float dpx;
uniform float glowK;
uniform float3 rimTint;
uniform float3 glowTint;
uniform float3 refrTint;
uniform float lsK;
uniform float bendK;  // сила изгиба линзы
uniform float sideK;  // сила белого свечения по бокам
     // стиль LSPosed
uniform float crackK;
uniform float refr;
uniform float lean;    // наклон линзы при движении
uniform float dispK;   // сила радужной каймы
uniform float edgeK;   // ширина полосы искажения
uniform float tintK;   // непрозрачность заливки панели
uniform float blurK;   // множитель размытия фона
uniform float frostK;  // матирование: рассеивание и мягкое снижение насыщенности
uniform float grainK;  // интенсивность мелкой фактуры матового стекла
uniform float3 touch;  // x, y и сила водяного бугорка

float sdBox(float2 p, float2 c, float2 hs) {
    float r = min(hs.x, hs.y);
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float smin2(float a, float b, float k) {
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * k * 0.25;
}
float dB(float2 p) { return sdBox(p, bar.xy, bar.zw); }
float dL(float2 p) { return sdBox(float2(p.x - lean * (p.y - bub.y), p.y), bub.xy, bub.zw); }
float dU(float2 p) { return min(dB(p), dL(p)); }

float2 gradU(float2 p) {
    float e = 1.0;
    float2 g = float2(dB(p + float2(e, 0.0)) - dB(p - float2(e, 0.0)),
                      dB(p + float2(0.0, e)) - dB(p - float2(0.0, e)));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}
float2 gradL(float2 p) {
    float e = 1.0;
    float2 g = float2(dL(p + float2(e, 0.0)) - dL(p - float2(e, 0.0)),
                      dL(p + float2(0.0, e)) - dL(p - float2(0.0, e)));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}

float2 cp(float2 q) { return clamp(q, float2(0.5), res - 0.5); }

float3 tap3(float2 qr, float2 qg, float2 qb, float2 o) {
    return float3(content.eval(cp(qr + o)).r, content.eval(cp(qg + o)).g, content.eval(cp(qb + o)).b);
}

float3 blur3(float2 qr, float2 qg, float2 qb, float rad) {
    float3 s = tap3(qr, qg, qb, float2(0.0));
    for (int i = 0; i < 6; i++) {
        float a = 1.0472 * float(i) + 0.5;
        s += tap3(qr, qg, qb, float2(cos(a), sin(a)) * rad);
        s += tap3(qr, qg, qb, float2(cos(a + 0.5236), sin(a + 0.5236)) * rad * 0.5);
    }
    return s / 13.0;
}

// размытие, когда каналы не разведены (почти вся панель): 19 отсчётов, три кольца
float3 blurMono(float2 q, float rad) {
    float3 s = content.eval(cp(q)).rgb;
    for (int i = 0; i < 6; i++) {
        float a = 1.0472 * float(i) + 0.5;
        s += content.eval(cp(q + float2(cos(a), sin(a)) * rad)).rgb;
        s += content.eval(cp(q + float2(cos(a + 0.5236), sin(a + 0.5236)) * rad * 0.66)).rgb;
        s += content.eval(cp(q + float2(cos(a + 0.2618), sin(a + 0.2618)) * rad * 0.33)).rgb;
    }
    return s / 19.0;
}

float spec(float2 n, float2 L) {
    return pow(max(dot(n, L), 0.0), 2.0) + 0.55 * pow(max(dot(n, -L), 0.0), 2.0) + 0.12;
}

float2 crackHash(float2 c) {
    return fract(sin(float2(dot(c, float2(127.1, 311.7)), dot(c, float2(269.5, 183.3)))) * 43758.5453);
}
// расстояние до линии излома (px), нормаль к линии и хэш осколка (ячейки Вороного)
void crackVor(float2 p, float sc, out float dist, out float2 nrm, out float2 cellH) {
    float2 q = p / sc;
    float2 ip = floor(q);
    float2 fp = fract(q);
    float f1 = 9.0;
    float f2 = 9.0;
    float2 r1 = float2(0.0);
    float2 r2 = float2(0.0);
    float2 best = float2(0.0);
    for (float j = -1.0; j <= 1.0; j += 1.0) {
        for (float i = -1.0; i <= 1.0; i += 1.0) {
            float2 g = float2(i, j);
            float2 cell = ip + g;
            float2 r = g + crackHash(cell) - fp;
            float d = dot(r, r);
            if (d < f1) { f2 = f1; r2 = r1; f1 = d; r1 = r; best = cell; }
            else if (d < f2) { f2 = d; r2 = r; }
        }
    }
    dist = (sqrt(f2) - sqrt(f1)) * sc;
    float2 dn = r2 - r1;
    nrm = length(dn) > 1e-5 ? normalize(dn) : float2(1.0, 0.0);
    cellH = crackHash(best);
}

half4 main(float2 p) {
    float du = dU(p);
    float dl = dL(p);
    if (du > dpx * 14.0) return half4(0.0);

    float3 glowCol = glowTint;
    float gl = 0.0;
    if (glowK > 0.0) {
        gl = exp(-max(du, 0.0) / (dpx * 4.0)) * 0.014;
        gl += exp(-max(dl, 0.0) / (dpx * 5.0)) * (0.012 + 0.03 * infl) * infl;
        gl *= glowK;
    }
    float a = clamp(0.5 - du, 0.0, 1.0);
    if (a <= 0.0) return half4(float4(glowCol * gl, gl));

    float2 nU = gradU(p);
    float2 nL = gradL(p);
    float2 nq = (p - bub.xy) / max(bub.zw, float2(1.0));
    float rq = length(nq);
    // изгиб только внутри линзы (у края гаснет в 0) и только пока палец нажимает (infl > 0)
    float ring = (1.0 - smoothstep(0.30, 1.0, rq)) * lsK * clamp(infl, 0.0, 1.0);
    float2 pw = p + (p - bub.xy) * ring * bendK;
    float db = dB(pw);
    float depU = max(-db, 0.0);
    float depL = max(-dl, 0.0);
    float lensIn = 1.0 - smoothstep(-1.0, 1.0, dl);
    float g = clamp(infl, 0.0, 1.0);
    float lensG = lensIn * g;

    // преломление: панель (слабое) и линза (сильное увеличение + складка у кромки)
    float tU = clamp(depU / (bar.w * 0.28 * edgeK), 0.0, 1.0);
    float mU = bar.w * 0.26 * refr * pow(1.0 - tU, 2.0) * (1.0 - lensG * (1.0 - 0.6 * lsK));
    float tL = clamp(depL / (bub.w * 0.32 * edgeK), 0.0, 1.0);
    float mL = bub.w * (0.34 + 0.04 * infl) * refr * pow(1.0 - tL, 2.0) * lensG;
    float mag = (0.03 + 0.10 * lsK) * min(refr, 1.3) * lensG;

    float2 base = p + (bub.xy - p) * mag;
    // трещины: каждый осколок смещает фон на свой угол; у линии излома смещение резче
    float cvDist = 9999.0;
    float2 cvN = float2(1.0, 0.0);
    float2 cvH = float2(0.0);
    if (crackK > 0.0) {
        crackVor(p, dpx * 46.0, cvDist, cvN, cvH);
        // линия не прямая: неровная, волнистая
        cvDist += (sin(p.x * 0.045 + cvH.x * 6.0) + sin(p.y * 0.061 + cvH.y * 5.0)) * dpx * 1.1;
        float nearLine = exp(-max(cvDist, 0.0) / (dpx * 2.0));
        float keep = crackK * (1.0 - 0.6 * lensG);
        // грани трещины сдвинуты друг относительно друга по нормали: видна ступенька
        base += cvN * nearLine * dpx * 5.0 * keep;
        base += (cvH - 0.5) * dpx * 4.0 * keep;
    }
    float2 off = -nU * mU - nL * mL;
    off += (p - bub.xy) * ring * bendK;  // иконки и подписи изгибаются вместе с панелью
    // краевое преломление (как в KernelSU): смещение по нормали к кромке линзы,
    // сильнее у самого края, плавно гаснет внутрь на высоту refractionHeight
    float edgeR = max(-dl, 0.0);
    float refrR = 1.0 - smoothstep(0.0, bub.w * 0.9, edgeR);
    off += nL * refrR * lensG * lsK * bub.w * bendK * 1.2;

    // Локальная водяная выпуклость под пальцем: без изменения геометрии панели.
    float2 td = p - touch.xy;
    float tr = max(dpx * 15.0, 1.0);
    float water = clamp(touch.z, 0.0, 1.0) * exp(-dot(td, td) / (tr * tr));
    float2 waterDir = td / max(length(td), 1.0);
    base += waterDir * water * dpx * 5.0;

    // дисперсия: R, G, B преломляются по-разному
    float disp = (0.14 + 0.06 * g) * dispK;
    float2 sh = float2(vel * dpx * 2.0 * lensG, 0.0);
    float2 pr = base + off * (1.0 - disp) - sh;
    float2 pg = base + off;
    float2 pb = base + off * (1.0 + disp) + sh;

    float frost = clamp(frostK, 0.0, 1.0) * (1.0 - 0.72 * lensG);
    // Frosted Glass добавляет собственное рассеивание поверх обычного blur.
    float rad = mix(dpx * 3.4, dpx * 1.2, lensG) * blurK + dpx * 2.2 * frost;
    float3 col;
    if (distance(pr, pb) < 0.75) {
        col = blurMono(pg, rad);
    } else {
        col = blur3(pr, pg, pb, rad);
    }

    // Цвет стекла: линза чистая и сочная, панель дымчатая.
    // Световой валик вокруг касания имитирует водяной бугорок.
    float waterRim = exp(-abs(length(td) - dpx * 7.0) / (dpx * 2.0)) * water;
    col += float3(0.16, 0.21, 0.25) * waterRim * 0.42;
    col += float3(0.42, 0.48, 0.52) * exp(-dot(td - float2(-dpx * 2.0, -dpx * 3.0),
                                                  td - float2(-dpx * 2.0, -dpx * 3.0)) /
                                             (dpx * dpx * 18.0)) * water * 0.24;
    float luma = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(float3(luma), col, 1.0 + 0.30 * lensG);

    // Frosted Glass: матовая поверхность рассеивает детали, слегка смягчает
    // насыщенность и добавляет очень мелкую равномерную микрофактуру.
    // Эффект сильнее на панели и слабее внутри чистой активной линзы.
    float frostLuma = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(col, float3(frostLuma), frost * 0.42);
    float2 grainCell = floor(p / max(dpx * 0.72, 1.0));
    float grainHash = fract(sin(dot(grainCell, float2(127.1, 311.7))) * 43758.5453);
    col += (grainHash - 0.5) * clamp(grainK, 0.0, 1.0) * frost * 0.10;

    // цвет преломления: тема окрашивает фон, который виден сквозь стекло
    col *= mix(float3(1.0), refrTint, 0.9);
    col = mix(col, float3(0.14, 0.12, 0.16), mix(0.15, 0.04, lensG) * tintK * (1.0 - 0.7 * lsK));
    // в покое линза — плоская светлая таблетка без преломления
    col = mix(col, float3(0.28, 0.26, 0.31), 0.40 * lensIn * (1.0 - g));
    col += 0.015 + 0.03 * lensG;

    // иконки и подписи проходят через то же преломление (и дисперсию по каналам)
    float4 ir = float4(icons.eval(cp(pr)));
    float4 ig = float4(icons.eval(cp(pg)));
    float4 ib = float4(icons.eval(cp(pb)));
    col = float3(col.r * (1.0 - ir.a) + ir.r,
                 col.g * (1.0 - ig.a) + ig.g,
                 col.b * (1.0 - ib.a) + ib.b);

    float yN = clamp((p.y - (bar.y - bar.w)) / (2.0 * bar.w), 0.0, 1.0);
    col += 0.03 * (1.0 - yN) * (1.0 - lensG);

    float2 L = normalize(float2(-0.55 + vel * 0.4, -0.85));

    // кромка панели
    col += exp(-depU / (dpx * 1.1)) * spec(nU, L) * 0.35 * (1.0 - lensG);
    // край панели просвечивает сквозь линзу
    col += 0.20 * exp(-abs(db) / (dpx * 0.9)) * lensG * step(db, 0.0);

    // кромка линзы: радужная обводка (R/B со сдвигом) + свет, «слипающийся» у края
    float wR = dpx * 1.3;
    float s1 = spec(nL, L);
    float3 rim = float3(exp(-abs(dl + dpx * 0.8) / wR),
                        exp(-abs(dl) / wR),
                        exp(-abs(dl - dpx * 0.8) / wR));
    col += mix(rim, float3(dot(rim, float3(0.333333))), lsK) * rimTint * s1 * 0.70 * g;
    float band = exp(-depL / (dpx * 5.5)) * lensG;
    col += band * (pow(max(dot(nL, -L), 0.0), 1.5) * 0.16 + pow(max(dot(nL, L), 0.0), 2.0) * 0.12);
    // тёмная канавка сразу за яркой кромкой: толстое стекло
    col *= 1.0 - 0.16 * exp(-abs(depL - dpx * 3.4) / (dpx * 1.7)) * lensG;
    float edgeL = exp(-abs(dl) / (dpx * 1.6));
    float sideL = clamp(-nL.x, 0.0, 1.0);
    float sideR = clamp(nL.x, 0.0, 1.0);
    float dyn = 0.55 + 0.45 * clamp(abs(vel) * 2.0, 0.0, 1.0);  // ярче при движении линзы
    col = mix(col, col * float3(0.97, 1.0, 1.03), lsK * lensG * 0.30);
    col += float3(1.0) * lsK * lensG * edgeL * (sideL + sideR) * sideK * dyn * 0.9;
    col += float3(1.0) * lsK * lensG * band * 0.10 * sideK * dyn;
    // тонкий блик по верхней кромке линзы, как на стекле под светом
    float topHL = exp(-abs(p.y - (bub.y - bub.w * 0.82)) / (dpx * 1.2))
                  * clamp(1.0 - abs(p.x - bub.x) / bub.z, 0.0, 1.0);
    col += float3(1.0) * lsK * lensG * topHL * 0.35;
    // свет от линзы на панель: мягкое белое пятно вокруг линзы, смещено в сторону движения
    float dlh = sdBox(float2(p.x - vel * dpx * 10.0, p.y), bub.xy, bub.zw);
    float halo = exp(-max(dlh, 0.0) / (dpx * 12.0));
    col += float3(1.0) * lsK * halo * g * sideK * dyn * 0.22;

    if (glowK > 0.0) {
        float cg = exp(-depL / (dpx * 3.0)) * lensG * (0.012 + 0.03 * g);
        col += glowCol * cg * glowK;
    }

    // трещины: тёмная сердцевина, светлая кромка, блик отражения вдоль линии
    if (crackK > 0.0) {
        float line = exp(-max(cvDist, 0.0) / (dpx * 0.5));
        float glint = exp(-max(cvDist, 0.0) / (dpx * 0.2));
        float mask = crackK * (1.0 - 0.55 * lensG);
        // тонкие ответвления: мелкая сетка, только в части осколков
        float dist2;
        float2 n2;
        float2 h2;
        crackVor(p, dpx * 19.0, dist2, n2, h2);
        float branch = exp(-max(dist2, 0.0) / (dpx * 0.35)) * step(0.55, h2.x) * 0.35;
        float flicker = 0.7 + 0.3 * sin(p.x * 0.09 + cvH.x * 9.0) * sin(p.y * 0.07 + cvH.y * 7.0);
        col *= (0.92 + 0.16 * cvH.x) * (1.0 - 0.38 * line * mask) * (1.0 - 0.25 * branch * mask);
        col += glowTint * (line * 0.28 + glint * 0.42 * flicker + branch * 0.25) * mask;
        col += glint * pow(max(sin(p.x * 0.07 + p.y * 0.031), 0.0), 6.0) * 0.22 * mask;
    }
    col = clamp(col, 0.0, 1.0);
    float3 outRgb = col * a + glowCol * gl * (1.0 - a);
    float outA = a + gl * (1.0 - a);
    return half4(float4(outRgb, outA));
}
"""

# Стекло на экране Bluetooth (координаты сняты со скриншота шириной 1165 px; всё считается долями ширины экрана)
SCR_REF_W = 1165.0
SCR_REF_BOTTOM = 2448.0   # нижняя граница области контента на скриншоте: 2576 px минус ~128 px системной панели
SCR_PILL_X0 = 44.0        # левый край переключателя All/BLE/Advert
SCR_SEG_X0 = 66.0         # внутренняя дорожка переключателя: три равные секции
SCR_SEG_X1 = 1098.0
SCR_NAMES = ("All", "BLE", "Advert")
# (ключ, секция: None — всегда, 0 — только «All»; x0, y0, x1, y1; радиус; ширина кромки dp; фаза блика; задержка появления, с; якорь снизу)
SCR_ELEMS = (
    ("pill", None, 44.0, 147.0, 1120.0, 322.0, 88.0, 11.0, 0.0, 0.00, False),
    ("card", 0, 44.0, 1187.0, 1120.0, 2078.0, 76.0, 13.0, 1.7, 0.10, True),
    ("dev", 0, 132.0, 1274.0, 1033.0, 1429.0, 58.0, 9.0, 3.1, 0.20, True),
    ("go", 0, 132.0, 1836.0, 1033.0, 1990.0, 77.0, 9.0, 4.6, 0.28, True),
)

AGSL_RIM = """
uniform shader content;
uniform float2 res;
uniform float dpx;
uniform float rad;
uniform float band;
uniform float pad;
uniform float t;
uniform float intro;
uniform float vis;
uniform float pulse;
uniform float seed;
uniform float k;
float sd(float2 p, float2 c, float2 hs, float r) {
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
half4 main(float2 p) {
    float f = vis * clamp(intro * 1.6, 0.0, 1.0);
    float2 c = res * 0.5;
    float2 hs = res * 0.5 - pad;
    float r = min(rad, min(hs.x, hs.y));
    float d = sd(p, c, hs, r);
    if (d > dpx * 10.0 || f <= 0.002) return half4(0.0);
    float a = clamp(0.5 - d, 0.0, 1.0);
    float dep = max(-d, 0.0);
    float2 q0 = p - c;
    float yN = clamp(0.5 + q0.y / (2.0 * hs.y), 0.0, 1.0);
    // лёгкая вуаль по всей поверхности: середина остаётся живым интерфейсом
    float Av = a * (0.035 + 0.06 * (1.0 - yN)) * k;
    float3 Cv = float3(0.92, 0.90, 1.0);
    if (dep > band * 1.5) {
        return half4(float4(Cv * Av * f, Av * f));
    }
    float2 g = float2(sd(p + float2(1.0, 0.0), c, hs, r) - sd(p - float2(1.0, 0.0), c, hs, r),
                      sd(p + float2(0.0, 1.0), c, hs, r) - sd(p - float2(0.0, 1.0), c, hs, r));
    float gl0 = length(g);
    float2 n = gl0 > 0.0001 ? g / gl0 : float2(0.0, -1.0);
    float3 cr = float3(0.0);
    float Ab = 0.0;
    if (dep < band) {
        float tt = clamp(dep / band, 0.0, 1.0);
        float m = band * 0.95 * pow(1.0 - tt, 2.0) * k;
        float2 off = -n * m;
        float2 lo = float2(0.5);
        float2 hi = res - 0.5;
        cr = float3(content.eval(clamp(p + off * 0.86, lo, hi)).r,
                    content.eval(clamp(p + off, lo, hi)).g,
                    content.eval(clamp(p + off * 1.14, lo, hi)).b);
        Ab = a * (1.0 - smoothstep(band * 0.45, band, dep)) * 0.92;
    }
    float A = Av + Ab * (1.0 - Av);
    float3 P = Cv * Av + cr * Ab * (1.0 - Av);
    // бегущий по кромке блик, «пробег» света при появлении и вспышка при импульсе
    float ang = t * 0.45 + seed;
    float2 L = float2(cos(ang), sin(ang));
    float edge = exp(-dep / (dpx * 1.3));
    float sp = pow(max(dot(n, L), 0.0), 3.0) + 0.45 * pow(max(dot(n, -L), 0.0), 3.0) + 0.10;
    float th = atan(q0.y, q0.x) / 6.2831853 + 0.5;
    float dth = abs(th - intro);
    dth = min(dth, 1.0 - dth);
    float sweep = exp(-dth * dth * 260.0) * (1.0 - smoothstep(0.88, 1.0, intro)) * step(0.001, intro);
    float s = edge * (sp * 0.50 + sweep * 1.1 + pulse * 0.6) * a * k;
    // радужная кайма по кромке
    float wR = dpx * 1.2;
    float3 rim = float3(exp(-abs(d + dpx * 0.8) / wR), exp(-abs(d) / wR), exp(-abs(d - dpx * 0.8) / wR));
    float rs = (0.55 * pow(max(dot(n, L), 0.0), 2.0) + 0.10) * 0.55 * a * k;
    P += rim * rs;
    A = clamp(A + rim.g * rs * 0.7, 0.0, 1.0);
    P += float3(s);
    A = clamp(A + s * 0.85, 0.0, 1.0);
    // тёмный жёлоб сразу за кромкой: толстое стекло
    float gv = 0.16 * exp(-abs(dep - dpx * 3.6) / (dpx * 1.8)) * a * k;
    P *= (1.0 - gv);
    A = A + gv * (1.0 - A);
    // внешнее свечение
    float go = exp(-max(d, 0.0) / (dpx * 3.2)) * (0.05 + 0.10 * pulse) * (1.0 - a) * k;
    P += float3(0.95, 0.80, 0.98) * go;
    A = clamp(A + go, 0.0, 1.0);
    P = min(P, float3(A));
    return half4(float4(P * f, A * f));
}
"""

AGSL_SEG = """
uniform shader content;
uniform shader icons;
uniform float2 res;
uniform float dpx;
uniform float rad;
uniform float pad;
uniform float t;
uniform float intro;
uniform float vis;
uniform float pulse;
uniform float seed;
uniform float4 lens;
uniform float lensA;
uniform float stretch;
uniform float infl;
uniform float2 tilt;
uniform float4 sty;
uniform float k;
float sd(float2 p, float2 c, float2 hs, float r) {
    float2 q = abs(p - c) - hs + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float2 sdn(float2 p, float2 c, float2 hs, float r) {
    float2 g = float2(sd(p + float2(1.0, 0.0), c, hs, r) - sd(p - float2(1.0, 0.0), c, hs, r),
                      sd(p + float2(0.0, 1.0), c, hs, r) - sd(p - float2(0.0, 1.0), c, hs, r));
    float l = length(g);
    return l > 0.0001 ? g / l : float2(0.0, -1.0);
}
half4 main(float2 p) {
    float f = vis * clamp(intro * 1.6, 0.0, 1.0);
    float2 c = res * 0.5;
    float2 hs = res * 0.5 - pad + dpx * 0.6;
    float r = min(rad + dpx * 0.6, min(hs.x, hs.y));
    float d = sd(p, c, hs, r);
    if (d > dpx * 10.0 || f <= 0.002) return half4(0.0);
    float a = clamp(0.5 - d, 0.0, 1.0);
    float dep = max(-d, 0.0);
    float2 n = sdn(p, c, hs, r);
    float2 lo = float2(0.5);
    float2 hi = res - 0.5;
    // Фон берём из левого поля снимка на той же высоте: родной переключатель под окном закрыт целиком.
    float2 wv = float2(sin(p.y * 0.045 + t * 1.7 + tilt.x * 2.0), cos(p.x * 0.035 - t * 1.3 + tilt.y * 2.0)) * dpx * 1.6 * sty.y;
    wv += tilt * dpx * 5.0;
    float2 wd = -n * dpx * 5.0 * exp(-dep / (dpx * 4.0));
    float2 bq = clamp(float2(2.0, p.y) + wv + wd, lo, hi);
    float bo = dpx * 2.5;
    float3 bg = (content.eval(bq).rgb * 2.0
                 + content.eval(clamp(bq + float2(bo, 0.0), lo, hi)).rgb
                 + content.eval(clamp(bq - float2(bo, 0.0), lo, hi)).rgb
                 + content.eval(clamp(bq + float2(0.0, bo), lo, hi)).rgb
                 + content.eval(clamp(bq - float2(0.0, bo), lo, hi)).rgb) / 6.0;
    float yN = clamp((p.y - (c.y - hs.y)) / (2.0 * hs.y), 0.0, 1.0);
    // Дорожка почти прозрачная: фон страницы плюс лёгкая дымка.
    float3 col = bg * sty.z + float3(0.012, 0.012, 0.018) + 0.012 * (1.0 - yN);
    // матовость: мелкое зерно вместо гладкого стекла
    float nz = fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453) - 0.5;
    col += nz * sty.w;
    // Две диагональные световые полосы медленно скользят по стеклу.
    float u = (p.x * 0.82 + p.y * 0.57) / res.y;
    float ph = fract(u * 0.55 - t * 0.06 + seed * 0.13);
    float z = (ph - 0.5) * 7.0;
    col += float3(0.030, 0.030, 0.042) * exp(-z * z) * k;
    float ang = t * 0.45 + seed;
    float2 L = float2(cos(ang), sin(ang));
    float edge = exp(-dep / (dpx * 1.3));
    float sp = pow(max(dot(n, L), 0.0), 3.0) + 0.45 * pow(max(dot(n, -L), 0.0), 3.0) + 0.12;
    float2 q0 = p - c;
    float th = atan(q0.y, q0.x) / 6.2831853 + 0.5;
    float dth = abs(th - intro);
    dth = min(dth, 1.0 - dth);
    float sweep = exp(-dth * dth * 260.0) * (1.0 - smoothstep(0.88, 1.0, intro)) * step(0.001, intro);
    col += edge * (sp * 0.38 + sweep * 0.8 + pulse * 0.3) * k;
    col += exp(-dep / (dpx * 6.0)) * 0.05;
    float wR = dpx * 1.2;
    float3 rim = float3(exp(-abs(d + dpx * 0.8) / wR), exp(-abs(d) / wR), exp(-abs(d - dpx * 0.8) / wR));
    col += rim * (0.30 * pow(max(dot(n, L), 0.0), 2.0) + 0.06) * 0.40 * k;
    col *= 1.0 - 0.10 * exp(-abs(dep - dpx * 3.4) / (dpx * 1.7));
    float sideK = pow(abs(n.x), 4.0);
    col += float3(0.85, 0.80, 1.0) * sideK * exp(-dep / (dpx * 4.0)) * 0.10 * k * sty.x;
    // Линза: прозрачное стекло, которое увеличивает подписи и преломляет их у кромки.
    float2 lc = float2(lens.x + lens.z * 0.5, lens.y + lens.w * 0.5);
    float wob = sin(t * 2.6 + lc.y * 0.03) * 0.010 * (1.0 + 2.0 * stretch);
    float2 lhs = float2(lens.z * 0.5 * (1.0 + 0.10 * stretch + 0.10 * infl + wob),
                        lens.w * 0.5 * (1.0 + 0.05 * stretch + 0.08 * infl + wob * 0.6)) - dpx * 1.0;
    float lr = lhs.y;
    float dl = sd(p, lc, lhs, lr);
    float la = clamp(0.5 - dl, 0.0, 1.0) * lensA;
    float depl = max(-dl, 0.0);
    float2 nl = sdn(p, lc, lhs, lr);
    col *= 1.0 - 0.20 * exp(max(dl, 0.0) / (-dpx * 3.5)) * lensA * (1.0 - la);
    float yl = clamp((p.y - (lc.y - lhs.y)) / (2.0 * lhs.y), 0.0, 1.0);
    float3 lcol = col * 0.94 + float3(0.020, 0.018, 0.030) + 0.020 * (1.0 - yl) + 0.02 * infl;
    float2 L2 = float2(cos(ang + 1.3), sin(ang + 1.3));
    float s2 = pow(max(dot(nl, L2), 0.0), 3.0) + 0.45 * pow(max(dot(nl, -L2), 0.0), 3.0) + 0.14;
    lcol += exp(-depl / (dpx * 1.3)) * (s2 * 0.40 + pulse * 0.3);
    float3 rl = float3(exp(-abs(dl + dpx * 0.8) / wR), exp(-abs(dl) / wR), exp(-abs(dl - dpx * 0.8) / wR));
    lcol += rl * (0.30 * pow(max(dot(nl, L2), 0.0), 2.0) + 0.06) * 0.45;
    lcol += nz * 0.018;
    lcol *= 1.0 - 0.16 * exp(-abs(depl - dpx * 3.2) / (dpx * 1.6));
    col = mix(col, lcol, la);
    col += (nl.x * tilt.x + nl.y * tilt.y) * 0.04 * la;
    float rr = length(p - c) / (res.x * 0.5);
    col += float3(0.70, 0.62, 1.0) * exp(-pow(rr - intro * 1.2, 2.0) * 60.0) * 0.12 * f * (1.0 - intro);
    // Подписи: вне линзы обычные, внутри увеличены, со складкой у кромки и радужной дисперсией.
    float tt = clamp(depl / (lhs.y * 0.55), 0.0, 1.0);
    float em = lhs.y * 0.32 * pow(1.0 - tt, 2.0);
    float mag = 1.14 + 0.12 * infl;
    float2 bs = lc + (p - lc) / mag;
    float2 off = -nl * em;
    float ar = float4(icons.eval(clamp(bs + off * 0.85, lo, hi))).a;
    float ag = float4(icons.eval(clamp(bs + off, lo, hi))).a;
    float ab = float4(icons.eval(clamp(bs + off * 1.15, lo, hi))).a;
    float a0 = float4(icons.eval(clamp(p, lo, hi))).a;
    float3 cov = mix(float3(a0), float3(ar, ag, ab), la);
    float3 lab = mix(float3(0.66, 0.64, 0.72), float3(0.90, 0.89, 0.93), la);
    col = float3(mix(col.r, lab.r, cov.r), mix(col.g, lab.g, cov.g), mix(col.b, lab.b, cov.b));
    col = clamp(col, 0.0, 1.0);
    float go = exp(-max(d, 0.0) / (dpx * 3.2)) * (0.05 + 0.10 * pulse) * (1.0 - a) * k;
    go += pow(abs(n.x), 3.0) * exp(-max(d, 0.0) / (dpx * 6.0)) * 0.12 * (0.8 + 0.2 * sin(t * 1.5)) * (1.0 - a) * k * sty.x;
    float3 P = col * a + float3(0.95, 0.80, 0.98) * go;
    float A = clamp(a + go, 0.0, 1.0);
    P = min(P, float3(A));
    return half4(float4(P * f, A * f));
}
"""

SCR_PM_REF_W = 905.0
# (ключ, x0, y0, x1, y1, seed, задержка появления, с) — иконки шапки вкладки «Плагины»
SCR_PM = (
    ("pm_add", 649.0, 121.0, 717.0, 189.0, 0.0, 0.00),
    ("pm_store", 726.0, 121.0, 794.0, 189.0, 1.3, 0.08),
    ("pm_gear", 801.0, 121.0, 869.0, 189.0, 2.6, 0.16),
)
ANIM_KEYS = ("light", "opacity", "pulse", "rot")
CMDS = set("MmLlHhVvCcSsZz")
NUM_RE = re.compile(r"[MmLlHhVvCcSsZz]|-?(?:\d+\.?\d*|\.\d+)(?:[eE]-?\d+)?")


def argb(v):
    return v - 0x100000000 if v >= 0x80000000 else v


def make_path(d):
    from java import jclass
    p = jclass("android.graphics.Path")()
    toks = NUM_RE.findall(d)
    n = len(toks)
    i = 0
    cmd = ""
    x = y = sx = sy = 0.0
    px = py = None
    while i < n:
        t = toks[i]
        if t in CMDS:
            cmd = t
            i += 1
            if cmd in "Zz":
                p.close()
                x, y = sx, sy
                px = py = None
            continue
        rel = cmd.islower()
        c = cmd.upper()
        if c == "M":
            a, b = float(toks[i]), float(toks[i + 1])
            i += 2
            x, y = (x + a, y + b) if rel else (a, b)
            p.moveTo(x, y)
            sx, sy = x, y
            cmd = "l" if rel else "L"
            px = py = None
        elif c == "L":
            a, b = float(toks[i]), float(toks[i + 1])
            i += 2
            x, y = (x + a, y + b) if rel else (a, b)
            p.lineTo(x, y)
            px = py = None
        elif c == "H":
            a = float(toks[i])
            i += 1
            x = x + a if rel else a
            p.lineTo(x, y)
            px = py = None
        elif c == "V":
            a = float(toks[i])
            i += 1
            y = y + a if rel else a
            p.lineTo(x, y)
            px = py = None
        elif c == "C":
            v = [float(toks[i + k]) for k in range(6)]
            i += 6
            if rel:
                v = [v[0] + x, v[1] + y, v[2] + x, v[3] + y, v[4] + x, v[5] + y]
            p.cubicTo(v[0], v[1], v[2], v[3], v[4], v[5])
            px, py = v[2], v[3]
            x, y = v[4], v[5]
        elif c == "S":
            v = [float(toks[i + k]) for k in range(4)]
            i += 4
            if rel:
                v = [v[0] + x, v[1] + y, v[2] + x, v[3] + y]
            if px is None:
                c1x, c1y = x, y
            else:
                c1x, c1y = 2 * x - px, 2 * y - py
            p.cubicTo(c1x, c1y, v[0], v[1], v[2], v[3])
            px, py = v[0], v[1]
            x, y = v[2], v[3]
        else:
            i += 1
    return p


def make_proxies():
    from java import dynamic_proxy, jclass
    Runnable = jclass("java.lang.Runnable")
    ClickL = jclass("android.view.View$OnClickListener")
    PcL = jclass("android.view.PixelCopy$OnPixelCopyFinishedListener")
    UpdL = jclass("android.animation.ValueAnimator$AnimatorUpdateListener")

    class Run(dynamic_proxy(Runnable)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def run(self):
            self.fn()

    class Clk(dynamic_proxy(ClickL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onClick(self, v):
            self.fn()

    class Pcl(dynamic_proxy(PcL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onPixelCopyFinished(self, result):
            self.fn(int(result))

    class Upd(dynamic_proxy(UpdL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onAnimationUpdate(self, anim):
            self.fn(float(anim.getAnimatedFraction()))

    TouchL = jclass("android.view.View$OnTouchListener")

    class Tch(dynamic_proxy(TouchL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onTouch(self, v, event):
            return bool(self.fn(event))

    FrameL = jclass("android.view.Choreographer$FrameCallback")

    class Frm(dynamic_proxy(FrameL)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def doFrame(self, t):
            self.fn()

    return Run, Clk, Pcl, Upd, Tch, Frm


# Темы бара: (кромка, свечение, цвет преломления). Тема 0 — прежний вид.
THEMES = (
    ((1.00, 1.00, 1.00), (0.95, 0.80, 0.98), (1.00, 1.00, 1.00)),  # 0 Классика
    ((0.30, 0.80, 1.00), (0.20, 0.62, 1.00), (0.45, 0.80, 1.00)),  # 1 Неон-голубой
    ((1.00, 0.35, 0.90), (0.72, 0.25, 1.00), (1.00, 0.55, 0.95)),  # 2 Фиолетово-розовый
    ((0.95, 0.97, 1.00), (0.85, 0.90, 1.00), (0.95, 0.97, 1.00)),  # 3 Стеклянный белый
)


class GlassBar(BasePlugin):
    # ------------------------------------------------------------------ жизненный цикл
    def on_plugin_load(self):
        self.fx_on = True
        self.pm_wave_pending = False
        self.pm_wave_t0 = None
        self.logs = []
        self.log_dirty = True
        self.logw = None
        self.log_flush_t = 0.0
        self.log_place_t = 0.0
        self.log_err_once = False
        self.pc_err = {}
        self.route = ""
        self.native_ok = False
        self.alive = True
        self.tick_running = False
        self.shown = False
        self.retries = 0
        self.adjusted = 0
        self.dlg = None
        self.root = None
        self.row = None
        self.bub = None
        self.anim = None
        self.bub_target = None
        self.targets = {}
        self.busy = {}
        self.pending = {}
        self.ui_generation = 0
        self.copy_sequence = 0
        self.copy_callbacks = {}
        self.copy_inflight = {}
        self.copy_retired = {}
        self.tab_views = []
        self.rendered = {}
        self.pcls = {}
        self.bufs = None
        self.cap_rect = None
        self.cap_rect_t = 0.0
        self.last_cap = 0.0
        self.cur_idx = -1
        self.pend_idx = 0
        self.ov_route = ""
        self.last_push = None
        self.scale_amt = 50.0
        self.bk = 1.0
        self.bdp = lambda v: int(v * 3 + 0.5)
        self.fps_amt = 30.0
        self.perf_profile = "balanced"
        self.ovs = {}
        self.handler = None
        self.act = None
        self.pressed = False
        self.dragging = False
        self.hover = None
        self.down_x = 0.0
        self.down_y = 0.0
        self.nav_pending = None
        self.touch_x = 0.0
        self.touch_y = 0.0
        self.touch_strength = 0.0
        self.sx = 0.0
        self.sv = 0.0
        self.infl = 0.0
        self.last_t = 0.0
        self.w_bar = 0
        self.sh = False
        self.shader = None
        self.RE = None
        self.glass_iv = None
        self.cur_x = 0.0
        self.cur_sx = 1.0
        self.cur_sy = 1.0
        self.bub_top = 0
        self.bub_h = 0
        self.glow_amt = 30.0
        self.refr_amt = 100.0
        self.tint_amt = 100.0
        self.blur_amt = 100.0
        self.frost_amt = 55.0
        self.grain_amt = 28.0
        self.jelly_amt = 100.0
        self.disp_amt = 100.0
        self.edge_amt = 100.0
        self.sh_failed = False
        self.icons_bmp = None
        self.preview = False
        self.wq = 0.0
        self.wv = 0.0
        self.jelly = 1.0
        self.err = ""
        self.stage = "init"
        self.t0 = time.time()
        self.err_shown = False
        self.scr = {}
        self.scr_dead = False
        self.scr_fx = True
        self.scr_sel = None
        self.scr_cand = -1
        self.scr_cand_n = 0
        self.scr_miss = 0
        self.scr_tl = 0.0
        self.scr_t0 = time.time()
        self.scr_S = 1.0
        self.scr_Sy = 1.0
        self.scr_origin_y = 0.0
        self.scr_lx = 0.0
        self.scr_lv = 0.0
        self.scr_lt = 0.0
        self.scr_la = 0.0
        self.scr_st = 0.0
        self.scr_opt = None
        self.scr_press = False
        self.scr_infl = 0.0
        self.scr_rl_t = 0.0
        self.scr_pause_until = 0.0
        self.tilt_id = None
        self.tilt_x = 0.0
        self.tilt_y = 0.0
        self.tilt_tx = 0.0
        self.tilt_ty = 0.0
        self.tilt_tl = 0.0
        self.tilt_n = 0
        self.watch_on = False
        self.watch_rb_t = 0.0
        self.cap_t = {}
        self.scr_fails = 0
        self.scr_action_sel = None
        self.scr_action_t = 0.0
        self.geom_sig = None
        self.geom_pending = False
        self.geom_last = 0.0
        self.anim_j = None
        self.anim_active = False
        self.anim_t0 = 0.0
        self.anim_cur = {}
        self.hook_surface("bottom_bar", "bar", "replace", 100)
        self.hook_action("bluetooth.section.select", 10)
        self.api.registerSettings("Glass Bar", json.dumps([
            {"type": "header", "title": "Разделы настроек"},
            {"type": "nav", "title": "Панель", "subtitle": "Стиль LSPosed, стекло, трещины, кнопка и заголовок, масштаб",
             "icon": "tune", "screen": "glass_panel"},
            {"type": "nav", "title": "Визуал", "subtitle": "Свечение, преломление, прозрачность, размытие, Frosted Glass",
             "icon": "tune", "screen": "glass_settings"},
            {"type": "nav", "title": "Анимация", "subtitle": "Желейная анимация, верхние накладки, наклон, движение",
             "icon": "tune", "screen": "glass_anim"},
            {"type": "nav", "title": "Bluetooth", "subtitle": "Стекло на экране All/BLE/Advert и калибровка",
             "icon": "tune", "screen": "glass_bt"},
            {"type": "nav", "title": "Бета", "subtitle": "Экспериментальные функции: трещины, наклон, автокалибровка",
             "icon": "tune", "screen": "glass_beta"},
            {"type": "nav", "title": "Система", "subtitle": "Профиль производительности и окно логов",
             "icon": "speed", "screen": "glass_system"},
        ]), 30)
        self._log("Glass Bar " + str(globals().get("__version__", "?")) + " загружен")
        self._anim_load()
        self._log_device()
        self._start()

    def on_plugin_unload(self):
        self._stop()

    def on_plugin_disable(self):
        self._stop()

    def on_activity_create(self, activity):
        self._log("activity create (маршрут=" + (self.route or "-") + ")")
        self.scr_miss = 0
        self._scr_watch_start()
        if self.alive and self.handler is not None:
            self._post(self._setup, 300)

    def on_activity_destroy(self, activity):
        self._log("activity destroy")
        self._teardown_ui()

    def on_navigation(self, route):
        self.route = str(route)
        if self.route.startswith("other/"):
            self.route = self.route[len("other/"):]
        self.nav_pending = None
        self.scr_miss = 0
        self._scr_watch_start()
        lc = getattr(self, "last_nav_call", 0.0)
        late = (" (+" + str(int((time.time() - lc) * 1000)) + " мс после navigate_app)") if lc and time.time() - lc < 10.0 else ""
        self._log("nav → " + self.route + late)
        if not self.route.lower().startswith("plugin/"):
            self.preview = False
        if self.handler is not None:
            self._post(self._sync, 0)
        self.refresh()

    def on_setting_changed(self, payload):
        self._log("setting " + str(payload))
        if self.get_setting("glass_enabled", True):
            if self.handler is not None:
                self.scr_dead = False  # явное включение — разрешаем пересборку
                self.tick_running = True
                self._post(self._setup, 0)
        else:
            self._teardown_ui()
            self.native_ok = False
        self.refresh()

    # ------------------------------------------------------------------ служебное
    def _start(self):
        try:
            from java import jclass
            Handler = jclass("android.os.Handler")
            Looper = jclass("android.os.Looper")
            self.handler = Handler(Looper.getMainLooper())
            self.Run, self.Clk, self.Pcl, self.Upd, self.Tch, self.Frm = make_proxies()
            self.choreo = jclass("android.view.Choreographer")
            self.frame_cb = self.Frm(self._tick)
            self.tick_run = self.Run(self._tick)
            self.watch_run = self.Run(self._scr_watch)
            for key in ("bar", "bub", "glass", "btn", "ttl", "log", "probe", "s_pill", "s_card", "s_dev", "s_go", "s_pm_add", "s_pm_store", "s_pm_gear"):
                self.pcls[key] = self.Pcl(self._make_copy_cb(key))
            self._post(self._setup, 200)
            self.tick_running = True
            self.handler.postDelayed(self.tick_run, 400)
        except Exception as e:
            self._fail(e)

    def _stop(self):
        self.alive = False
        self.watch_on = False
        self._tilt_stop()
        try:
            self.handler.removeCallbacks(self.watch_run)
        except Exception:
            pass
        self._teardown_ui()

    def _post(self, fn, delay=0):
        try:
            r = self.Run(fn)
            if delay:
                self.handler.postDelayed(r, delay)
            else:
                self.handler.post(r)
        except Exception as e:
            self._fail(e)

    def _fail(self, e):
        self.native_ok = False
        try:
            line = ""
            try:
                fr = traceback.extract_tb(e.__traceback__)
                if fr:
                    line = " @L" + str(fr[-1].lineno)
            except Exception:
                pass
            self.err = "[" + str(self.stage) + "] " + type(e).__name__ + line + ": " + str(e)[:200]
        except Exception:
            self.err = "[" + str(self.stage) + "] error"
        self._log("ERR " + str(self.err))
        try:
            tb = "".join(traceback.format_exception(type(e), e, e.__traceback__)).strip().splitlines()
            self._log("TB " + " | ".join(x.strip() for x in tb[-4:]))
        except Exception:
            pass
        try:
            self._teardown_ui()
        except Exception:
            pass
        try:
            self.toast("GlassBar: " + self.err[:140])
        except Exception:
            pass
        try:
            self.refresh()
        except Exception:
            pass
        # Планируем повторную попытку сборки через 1.5 с
        try:
            if self.alive and self.handler is not None:
                self._post(self._setup, 1500)
        except Exception:
            pass

    def _sel_index(self):
        r = self.route.lower()
        if r.startswith("plugin"):
            return 3
        for i, tab in enumerate(TABS):
            if i == 3:
                continue
            if any(r.startswith(p) for p in tab[3]):
                return i
        return 0

    def _route_visible(self):
        return self.route.lower() in VISIBLE_ROUTES or self.preview

    # ------------------------------------------------------------------ сборка окна
    def _glass(self, h, base, filt, tint, stroke_w, stroke_col):
        from java import jclass, jarray, jint
        act = self.act
        FrameLayout = jclass("android.widget.FrameLayout")
        ImageView = jclass("android.widget.ImageView")
        View = jclass("android.view.View")
        GD = jclass("android.graphics.drawable.GradientDrawable")
        GDO = jclass("android.graphics.drawable.GradientDrawable$Orientation")
        FLP = jclass("android.widget.FrameLayout$LayoutParams")
        PDM = jclass("android.graphics.PorterDuff$Mode")
        radius = float(h) / 2.0

        cont = FrameLayout(act)
        bg = GD()
        bg.setColor(argb(base))
        bg.setCornerRadius(radius)
        cont.setBackground(bg)
        cont.setClipToOutline(True)

        iv = ImageView(act)
        iv.setScaleType(ImageView.ScaleType.FIT_XY)
        iv.setColorFilter(argb(filt), PDM.SRC_ATOP)
        cont.addView(iv, FLP(-1, -1))

        tv = View(act)
        tg = GD()
        tg.setOrientation(GDO.TOP_BOTTOM)
        tg.setColors(jarray(jint)([argb(c) for c in tint]))
        tg.setCornerRadius(radius)
        tg.setStroke(stroke_w, argb(stroke_col))
        tv.setBackground(tg)
        cont.addView(tv, FLP(-1, -1))
        return cont, iv

    def _setup(self):
        self.geom_pending = False
        self.geom_sig = None
        if not self.alive or not self.get_setting("glass_enabled", True):
            return
        try:
            from java import jclass
            self.stage = "activity"
            act = self.api.getActivity()
            if act is None:
                self.retries += 1
                if self.retries == 12:
                    self._log("ERR getActivity() вернул None (12 попыток)")
                    self.err = "getActivity() вернул None"
                    self.refresh()
                if self.retries < 200:
                    self._post(self._setup, 600)
                return
            self.retries = 0  # успешно — сбрасываем серию неудач
            self.stage = "teardown"
            self._teardown_ui()
            self.act = act
            dens = act.getResources().getDisplayMetrics().density
            self.dens = dens
            dp = lambda v: int(v * dens + 0.5)
            self.dp = dp
            try:
                bk = float(self.get_setting("glass_bar_scale", 100)) / 100.0
            except Exception:
                bk = 1.0
            bk = max(0.7, min(1.3, bk))
            self.bk = bk
            bdp = lambda v: int(v * dens * bk + 0.5)
            self.bdp = bdp

            Dialog = jclass("android.app.Dialog")
            FrameLayout = jclass("android.widget.FrameLayout")
            LinearLayout = jclass("android.widget.LinearLayout")
            ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
            FLP = jclass("android.widget.FrameLayout$LayoutParams")

            screen_w = int(act.getWindow().getDecorView().getWidth()) or int(act.getResources().getDisplayMetrics().widthPixels)
            w = int(min(screen_w * 0.92, dp(460)) * 0.77 * bk)
            w = max(dp(120), min(w, screen_w - 2 * bdp(14) - dp(8)))
            self.pad = bdp(14)               # запас по бокам, чтобы линза могла «надуваться»
            self.tw = w // len(TABS)
            self.w_bar = w
            self.stage = "shader"
            sh = self._try_shader()
            # Если пользователь выбрал классический стиль — принудительно fallback
            if sh and bool(self.get_setting("glass_style_fallback", False)):
                sh = False
                self.shader = None
            self.stage = "window"
            bar_h = bdp(54)
            bar_top = bdp(19) if sh else bdp(11)
            win_h = bdp(85) if sh else bdp(77)
            win_w = w + 2 * self.pad
            bub_h = (bar_h + bdp(12)) if sh else bdp(45)
            self.bub_w = int(self.tw * 1.18) if sh else (self.tw - bdp(3))
            bub_top = bar_top + (bar_h - bub_h) // 2

            dlg = Dialog(act)
            dlg.requestWindowFeature(1)

            root = FrameLayout(act)

            self.stage = "layers"
            glass_iv = None
            if sh:
                View = jclass("android.view.View")
                ImageView = jclass("android.widget.ImageView")
                glass_iv = ImageView(act)
                glass_iv.setScaleType(ImageView.ScaleType.FIT_XY)
                root.addView(glass_iv, FLP(-1, -1))
                bub = View(act)  # невидимый держатель состояния линзы (в окно не добавляется)
            else:
                bar, bar_iv = self._glass(
                    bar_h, 0xCC1B1720, 0x26000000,
                    [0x26FFFFFF, 0x06FFFFFF, 0x12FFFFFF], max(1, dp(1)), 0x44FFFFFF)
                lpb = FLP(w, bar_h)
                lpb.topMargin = bar_top
                lpb.leftMargin = self.pad
                root.addView(bar, lpb)

                bub, bub_iv = self._glass(
                    bub_h, 0xCC2A2430, 0x08000000,
                    [0x38FFFFFF, 0x10FFFFFF, 0x20FFFFFF], max(2, dp(1)), 0x66FFFFFF)
                lpu = FLP(self.bub_w, bub_h)
                lpu.topMargin = bub_top
                root.addView(bub, lpu)

            self.stage = "row"
            row = LinearLayout(act)
            row.setOrientation(0)
            # Android dispatches OnTouchListener events only when the view is clickable
            # or long-clickable. Without this, the whole tab row can ignore taps/swipes.
            row.setClickable(True)
            row.setFocusable(True)
            row.setContentDescription("Glass Bar: навигация по разделам")
            row.setOnTouchListener(self.Tch(self._on_touch))
            row.setImportantForAccessibility(2)  # вкладки доступны как отдельные кнопки
            lpr = FLP(w, bar_h)
            lpr.topMargin = bar_top
            lpr.leftMargin = self.pad
            root.addView(row, lpr)

            dlg.setContentView(root, FLP(win_w, win_h))

            win = dlg.getWindow()
            win.setBackgroundDrawable(ColorDrawable(0))
            win.clearFlags(2)  # FLAG_DIM_BEHIND
            win.addFlags(8 | 32)  # NOT_FOCUSABLE | NOT_TOUCH_MODAL
            win.setLayout(win_w, win_h)
            win.setGravity(80 | 1)  # BOTTOM | CENTER_HORIZONTAL
            lp = win.getAttributes()
            lp.y = dp(4)
            lp.windowAnimations = 0
            win.setAttributes(lp)

            self.stage = "dialog"
            self.dlg = dlg
            self.root = root
            self.row = row
            self.tab_views = []
            self.bub = bub
            # key -> (контейнер, картинка, отступ по x, отступ по y, конечная ширина блюра)
            self.sh = sh
            self.glass_iv = glass_iv
            self.bub_top = bub_top
            self.bub_h = bub_h
            self._read_settings()
            if sh:
                self.targets = {"glass": (root, glass_iv, 0, 0, 720)}
                self.busy = {"glass": False}
                self.stage = "uniforms"
                self._init_uniforms(win_w, win_h, bar_top, bar_h, w)
            else:
                self.targets = {
                    "bar": (bar, bar_iv, 0, 0, 20),
                    "bub": (bub, bub_iv, dp(3), dp(4), 36),
                }
                self.busy = {"bar": False, "bub": False}
            self.adjusted = 0
            self.bub_target = None
            self.stage = "btn"
            self._setup_ovs(act)
            self.stage = "scr"
            try:
                self._setup_scr(act)
            except Exception as se:
                self._scr_kill()
                self._log("ERR стекло экрана: " + type(se).__name__ + ": " + str(se)[:160])
            self.stage = "log"
            try:
                self._setup_log(act, w, win_h - bar_top)
            except Exception as le:
                self.logw = None
                self._log("ERR панель логов: " + type(le).__name__ + ": " + str(le)[:160])
            self.stage = "tabs"
            self._fill_tabs()
            self.native_ok = True
            self.err = ""
            self.stage = "show"
            self._sync()
            self.stage = "ok"
            # Возобновляем тик после teardown+setup
            if not self.tick_running:
                self.tick_running = True
                try:
                    self.choreo.getInstance().postFrameCallback(self.frame_cb)
                except Exception:
                    pass
            self._log("setup ok: стиль=" + ("шейдер" if sh else "классика") + " окно=" + str(win_w) + "x" + str(win_h)
                      + " bar_w=" + str(w) + " dens=" + str(round(float(dens), 2)))
            self.refresh()
        except Exception as e:
            self._fail(e)

    def _icon(self, path_d, color):
        from java import jclass, jint
        size = self.bdp(22)
        Bitmap = jclass("android.graphics.Bitmap")
        Cfg = jclass("android.graphics.Bitmap$Config")
        bmp = Bitmap.createBitmap(size, size, Cfg.ARGB_8888)
        canvas = jclass("android.graphics.Canvas")(bmp)
        paint = jclass("android.graphics.Paint")(1)
        paint.setColor(jint(color))
        path = make_path(path_d)
        m = jclass("android.graphics.Matrix")()
        s = size / 24.0
        m.setScale(s, s)
        path.transform(m)
        canvas.drawPath(path, paint)
        return bmp

    def _on_tab_touch(self, idx, event):
        from java import jclass
        cp = jclass("android.view.MotionEvent").obtain(event)
        try:
            cp.offsetLocation(float(self.row.getChildAt(idx).getLeft()), 0.0)
            return self._on_touch(cp)
        finally:
            cp.recycle()

    def _fill_tabs(self, idx=None, move=True):
        if self.row is None:
            return
        from java import jclass
        act = self.act
        dp = self.bdp
        LLP = jclass("android.widget.LinearLayout$LayoutParams")
        sel_idx = self._sel_index() if idx is None else idx
        if not self.tab_views:
            self.row.removeAllViews()
            self.tab_click_refs = []
            for i, (route, path_d, label, prefixes) in enumerate(TABS):
                col = jclass("android.widget.LinearLayout")(act)
                col.setOrientation(1)
                col.setGravity(17)
                iv = jclass("android.widget.ImageView")(act)
                iv.setImportantForAccessibility(2)
                col.addView(iv, LLP(dp(22), dp(22)))
                tv = jclass("android.widget.TextView")(act)
                tv.setText(label)
                tv.setTextSize(float(10.5 * self.bk))
                tv.setSingleLine(True)
                tv.setGravity(17)
                tv.setImportantForAccessibility(2)
                tlp = LLP(-2, -2)
                tlp.topMargin = dp(1)
                col.addView(tv, tlp)
                if self.sh:
                    iv.setAlpha(0.0)
                    tv.setAlpha(0.0)
                def click_for(k):
                    def click():
                        self._go(k)
                    return click
                def touch_for(k):
                    return lambda ev: self._on_tab_touch(k, ev)
                cl = self.Clk(click_for(i))
                touch = self.Tch(touch_for(i))
                self.tab_click_refs.extend((cl, touch))
                col.setFocusable(True)
                col.setClickable(True)
                col.setContentDescription(label)
                col.setOnClickListener(cl)
                col.setOnTouchListener(touch)
                self.row.addView(col, LLP(0, -1, 1.0))
                self.tab_views.append((col, iv, tv, None))
        for i, (col, iv, tv, was_selected) in enumerate(self.tab_views):
            selected = i == sel_idx
            col.setSelected(selected)
            if selected != was_selected:
                if not self.sh:
                    iv.setImageBitmap(self._icon(TABS[i][1], argb(0xFFF3CCF7) if selected else argb(0xD9FFFFFF)))
                tv.setTextColor(argb(0xFFFFFFFF) if selected else argb(0xB3FFFFFF))
                self.tab_views[i] = (col, iv, tv, selected)
        if self.sh:
            self._render_icons(sel_idx)
        if move:
            self._spring_to(self._tab_x(sel_idx))

    # --- пружинная физика линзы ------------------------------------------------
    # Линза — это масса на пружине: её тянет к выбранной вкладке, она разгоняется,
    # слегка перелетает и затухает. Размер зависит от скорости и расстояния:
    # в движении надувается и вытягивается вдоль движения, у цели сдувается.
    def _spring_to(self, x1):
        if self.bub is None:
            return
        if bool(self.get_setting("glass_reduce_motion", False)):
            self.bub_target = float(x1)
            self.sx = float(x1)
            self.sv = 0.0
            self.infl = 0.0
            self._set_lens(float(x1), 1.0, 1.0)
            return
        if self.bub_target is not None and abs(self.bub_target - x1) < 1.0:
            return
        first = self.bub_target is None
        self.bub_target = x1
        if first:
            self._set_lens(float(x1), 1.0, 1.0)
            self.sx = float(x1)
            self.sv = 0.0
            self.infl = 0.0
            return
        if self.anim is not None:
            return  # пружина уже работает: у неё просто новая цель
        import time
        from java import jclass, jarray, jfloat
        self.sx = float(self.bub.getTranslationX())
        self.sv = 0.0
        self.infl = 0.0
        self.last_t = time.time()
        VA = jclass("android.animation.ValueAnimator")
        anim = VA.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(1000)
        anim.setRepeatCount(-1)
        anim.setInterpolator(jclass("android.view.animation.LinearInterpolator")())
        anim.addUpdateListener(self.Upd(self._spring_step))
        anim.start()
        self.anim = anim

    def _spring_step(self, p):
        bub = self.bub
        if bub is None or self.bub_target is None:
            return
        import time
        now = time.time()
        dt = min(now - self.last_t, 1.0 / 30.0)
        self.last_t = now
        if dt <= 0:
            return
        jelly_mode = bool(self.get_setting("glass_anim_jelly", True))
        if jelly_mode:
            k = 260.0                              # мягче пружина: дольше плывёт
            c = 2.0 * 0.82 * math.sqrt(k)         # затухание: мягче останавливается
        else:
            k = 300.0                              # упругое, без желейных перелётов
            c = 2.0 * 1.0 * math.sqrt(k)          # критическое затухание
        steps = max(1, int(dt / 0.008))
        h = dt / steps
        for _ in range(steps):
            a = -k * (self.sx - self.bub_target) - c * self.sv
            self.sv += a * h
            self.sx += self.sv * h
        tw = float(self.tw)
        if jelly_mode:
            # Вторая, «желейная» пружина: форма догоняет скорость, перелетает и дрожит
            kq = 420.0
            cq = 2.0 * 0.30 * math.sqrt(kq)
            qt = min(0.34, abs(self.sv) / (tw * 7.0)) * self.jelly
            for _ in range(steps):
                aq = kq * (qt - self.wq) - cq * self.wv
                self.wv += aq * h
                self.wq += self.wv * h
        else:
            # Водяная пластика создаётся шейдером локально под пальцем
            self.wq = 0.0
            self.wv = 0.0
            if not self.pressed and self.touch_strength > 0.0:
                self.touch_strength *= math.exp(-dt * 5.5)
                if self.touch_strength < 0.015:
                    self.touch_strength = 0.0
        speed = abs(self.sv) / (tw * 7.0)
        dist = abs(self.sx - self.bub_target) / tw
        want = min(1.0, speed + dist * 0.7)
        if self.pressed:
            want = 1.0  # пока палец на панели, линза остаётся надутой
        self.infl += (want - self.infl) * min(1.0, dt * 9.0)
        q = self.wq
        if jelly_mode:
            self._set_lens(float(self.sx), float(1.0 + 0.04 * self.infl + q),
                           float(1.0 + 0.03 * self.infl - 0.6 * q))
            stopped = (abs(self.sx - self.bub_target) < 0.4 and abs(self.sv) < 3.0
                       and self.infl < 0.01 and abs(self.wq) < 0.004
                       and abs(self.wv) < 0.08 and not self.pressed)
        else:
            self._set_lens(float(self.sx), 1.0, 1.0)
            stopped = (abs(self.sx - self.bub_target) < 0.4 and abs(self.sv) < 3.0
                       and self.infl < 0.01 and self.touch_strength <= 0.0
                       and not self.pressed)
        if stopped:
            self.infl = 0.0
            self.sv = 0.0
            self.wq = 0.0
            self.wv = 0.0
            self._set_lens(float(self.bub_target), 1.0, 1.0)
            try:
                self.anim.cancel()
            except Exception:
                pass
            self.anim = None

    def _animate_to(self, x1):
        if self.bub is None:
            return
        if self.bub_target is not None and abs(self.bub_target - x1) < 1.0:
            return
        prev = self.bub_target
        self.bub_target = x1
        if prev is None:
            self.bub.setTranslationX(float(x1))
            return
        from java import jclass, jarray, jfloat
        if self.anim is not None:
            try:
                self.anim.cancel()
            except Exception:
                pass
        bub = self.bub
        x0 = float(bub.getTranslationX())
        VA = jclass("android.animation.ValueAnimator")
        anim = VA.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(ANIM_MS)
        anim.setInterpolator(jclass("android.view.animation.LinearInterpolator")())

        def update(p):
            p = min(1.0, max(0.0, p))
            # easeOutBack: мягкий перелёт и возврат
            c1 = 1.25
            c3 = c1 + 1.0
            q = p - 1.0
            e = 1.0 + c3 * q * q * q + c1 * q * q
            bub.setTranslationX(float(x0 + (x1 - x0) * e))
            # линза «надувается» в середине пути и сдувается к концу
            s = math.sin(math.pi * p)
            bub.setScaleX(float(1.0 + 0.30 * s))
            bub.setScaleY(float(1.0 + 0.45 * s))

        anim.addUpdateListener(self.Upd(update))
        anim.start()
        self.anim = anim

    # ------------------------------------------------------------------ шейдер (Android 13+)
    def _try_shader(self):
        try:
            from java import jclass
            if int(jclass("android.os.Build$VERSION").SDK_INT) < 33:
                return False
            self.RE = jclass("android.graphics.RenderEffect")
            self.shader = jclass("android.graphics.RuntimeShader")(AGSL)
            return True
        except Exception as e:
            self.shader = None
            if not self.sh_failed:
                self.sh_failed = True
                try:
                    self.toast("GlassBar: шейдер недоступен, обычный режим (" + str(e)[:100] + ")")
                except Exception:
                    pass
            return False

    def _init_uniforms(self, win_w, win_h, bar_top, bar_h, w):
        sh = self.shader
        sh.setFloatUniform("res", float(win_w), float(win_h))
        sh.setFloatUniform("bar", float(self.pad + w / 2.0), float(bar_top + bar_h / 2.0),
                           float(w / 2.0), float(bar_h / 2.0))
        sh.setFloatUniform("dpx", float(self.dens * self.bk))
        sh.setFloatUniform("glowK", float(self.glow_amt / 30.0))
        sh.setFloatUniform("lsK", float(1.0 if self.get_setting("glass_ls_style", True) else 0.0))
        sh.setFloatUniform("bendK", float(self.get_setting("glass_bend_amt", 44.0)) / 200.0)
        sh.setFloatUniform("sideK", float(self.get_setting("glass_side_glow", 60.0)) / 50.0)
        self._theme_uniforms(sh)
        sh.setFloatUniform("refr", float(self.refr_amt / 100.0))
        sh.setFloatUniform("tintK", float(self.tint_amt / 100.0))
        sh.setFloatUniform("blurK", float(self.blur_amt / 100.0))
        sh.setFloatUniform("frostK", float(self.frost_amt / 100.0))
        sh.setFloatUniform("grainK", float(self.grain_amt / 100.0))
        sh.setFloatUniform("dispK", float(self.disp_amt / 100.0))
        sh.setFloatUniform("edgeK", float(max(self.edge_amt, 10.0) / 100.0))
        sh.setFloatUniform("touch", float(self.touch_x), float(self.touch_y), 0.0)
        self.win_w, self.win_h, self.bar_top, self.bar_h = win_w, win_h, bar_top, bar_h
        self.cur_x = self._tab_x(self._sel_index())
        self._render_icons(self._sel_index())

    def _theme_uniforms(self, sh):
        i = max(0, min(len(THEMES) - 1, int(getattr(self, "theme", 0))))
        rim, glow, refr = THEMES[i]
        sh.setFloatUniform("refrTint", float(refr[0]), float(refr[1]), float(refr[2]))
        sh.setFloatUniform("crackK", 1.0 if bool(self.get_setting("glass_cracks", False)) else 0.0)
        sh.setFloatUniform("rimTint", float(rim[0]), float(rim[1]), float(rim[2]))
        sh.setFloatUniform("glowTint", float(glow[0]), float(glow[1]), float(glow[2]))

    DEFAULTS = {"glass_glow_amt": 30.0, "glass_refr_amt": 100.0,
                "glass_tint_amt": 100.0, "glass_blur_amt": 100.0,
                "glass_frost_amt": 55.0, "glass_grain_amt": 28.0,
                "glass_jelly_amt": 100.0, "glass_disp_amt": 100.0, "glass_edge_amt": 100.0,
                "glass_scale_amt": 50.0, "glass_fps_amt": 30.0, "glass_theme": 0.0}

    def _read_settings(self):
        def val(k):
            try:
                return float(self.get_setting(k, self.DEFAULTS[k]))
            except Exception:
                return self.DEFAULTS[k]
        self.glow_amt = val("glass_glow_amt")
        self.theme = int(round(val("glass_theme")))
        self.refr_amt = val("glass_refr_amt")
        self.tint_amt = val("glass_tint_amt")
        self.blur_amt = val("glass_blur_amt")
        self.frost_amt = val("glass_frost_amt")
        self.grain_amt = val("glass_grain_amt")
        self.jelly_amt = val("glass_jelly_amt")
        self.jelly = self.jelly_amt / 100.0
        self.disp_amt = val("glass_disp_amt")
        self.edge_amt = val("glass_edge_amt")
        self.scale_amt = val("glass_scale_amt")
        self.fps_amt = val("glass_fps_amt")
        profile = str(self.get_setting("glass_perf_profile", "balanced")).lower()
        self.perf_profile = profile if profile in ("quality", "balanced", "battery", "manual") else "balanced"

    def _apply_live(self):
        # применяем настройки сразу, без пересборки окна
        self._read_settings()
        sh = self.shader
        if sh is None or not self.sh:
            self._log("Frosted Glass: настройки прочитаны, но шейдер не активен (sh=" + str(bool(self.sh)) + ", shader=" + str(sh is not None) + ")")
            return
        try:
            sh.setFloatUniform("glowK", float(self.glow_amt / 30.0))
            sh.setFloatUniform("lsK", float(1.0 if self.get_setting("glass_ls_style", True) else 0.0))
            sh.setFloatUniform("bendK", float(self.get_setting("glass_bend_amt", 44.0)) / 200.0)
            sh.setFloatUniform("sideK", float(self.get_setting("glass_side_glow", 60.0)) / 50.0)
            self._theme_uniforms(sh)
            sh.setFloatUniform("refr", float(self.refr_amt / 100.0))
            sh.setFloatUniform("tintK", float(self.tint_amt / 100.0))
            sh.setFloatUniform("blurK", float(self.blur_amt / 100.0))
            sh.setFloatUniform("frostK", float(self.frost_amt / 100.0))
            sh.setFloatUniform("grainK", float(self.grain_amt / 100.0))
            self._log("Frosted Glass применён: матирование=" + str(round(self.frost_amt, 1)) + ", зерно=" + str(round(self.grain_amt, 1)))
            sh.setFloatUniform("dispK", float(self.disp_amt / 100.0))
            sh.setFloatUniform("edgeK", float(max(self.edge_amt, 10.0) / 100.0))
            self._push(True)
        except Exception as e:
            self.stage = "settings"
            self._fail(e)

    def _slider_cb(self, key):
        def cb(v):
            if key in ("glass_scale_amt", "glass_fps_amt", "glass_blur_amt"):
                self.set_setting("glass_perf_profile", "manual")
            self.set_setting(key, float(v))
            if key in ("glass_frost_amt", "glass_grain_amt"):
                self._log("ползунок " + key + " → " + str(round(float(v), 1)))
            self._apply_live()
            self.refresh()
        return cb

    def _enabled_cb(self, v):
        self.set_setting("glass_enabled", bool(v))
        self.on_setting_changed(None)

    def _reset_cb(self):
        self.set_setting("glass_perf_profile", "manual")
        for k, v in self.DEFAULTS.items():
            self.set_setting(k, v)
        self._apply_live()
        self.refresh()

    PERF_PROFILES = {
        "quality": {"title": "Качество", "subtitle": "Максимальная детализация: масштаб 100%, до 60 кадров/с",
                     "scale": 100.0, "fps": 60.0, "blur": 100.0},
        "balanced": {"title": "Баланс", "subtitle": "Оптимальный режим для повседневного использования",
                      "scale": 70.0, "fps": 30.0, "blur": 85.0},
        "battery": {"title": "Экономия батареи", "subtitle": "Меньше захватов экрана и ниже разрешение буферов",
                     "scale": 45.0, "fps": 15.0, "blur": 55.0},
        "manual": {"title": "Свои значения", "subtitle": "Используются значения из ручных слайдеров",
                    "scale": None, "fps": None, "blur": None},
    }

    def _set_perf_profile(self, name):
        profile = self.PERF_PROFILES.get(name)
        if profile is None:
            return
        self.set_setting("glass_perf_profile", name)
        if profile["scale"] is not None:
            self.set_setting("glass_scale_amt", profile["scale"])
            self.set_setting("glass_fps_amt", profile["fps"])
            self.set_setting("glass_blur_amt", profile["blur"])
        self._read_settings()
        self._apply_live()
        self._log("профиль производительности: " + profile["title"])
        self.perf_profile = name  # явно синхронизируем до refresh
        self.refresh()

    def _profile_cb(self, name):
        def click():
            self._set_perf_profile(name)
        return click

    def _key_cb(self, key):
        def cb(v):
            self.set_setting(key, bool(v))
            self.on_setting_changed(None)
        return cb

    def _rows_screen(self, ui, title, rows, extra=None, head=None):
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"
        items = list(head or [])
        for r in rows:
            if r[0] == "sw":
                _, key, t, sub, dflt = r
                items.append(ui.column([
                    ui.text(t, "titleSmall", W),
                    ui.text(sub, "bodySmall", W2),
                    ui.switch(bool(self.get_setting(key, dflt)), self._key_cb(key), "", ""),
                ], 0, 2))
            else:
                _, key, label, lo, hi, steps, dflt = r
                val = float(self.get_setting(key, dflt))
                items.append(ui.column([
                    ui.text(label + ": " + str(int(val)), "titleSmall", W),
                    ui.slider(val, self._slider_cb(key), lo, hi, "", steps),
                ], 0, 2))
        if extra:
            items.extend(extra)
        items.append(ui.spacer(120))
        return ui.scaffold(
            title=title,
            content=ui.lazy_column(items, 16, 12))

    def _apply_mode(self, m):
        self.set_setting("glass_mode", int(m))
        if m == 1:      # бар с LS: линза LSPosed + желе
            ls, jelly = True, True
        elif m == 2:    # обычный: без LS, водяной бугорок 21.6
            ls, jelly = False, False
        else:           # версия 21.5: без LS, желейная линза
            ls, jelly = False, True
        self.set_setting("glass_ls_style", ls)
        self.set_setting("glass_anim_jelly", jelly)
        self.on_setting_changed(None)
        self.refresh()

    def _mode_head(self, ui):
        cur = int(self.get_setting("glass_mode", 1))
        names = {1: "Бар с LS", 2: "Обычный", 3: "Версия 21.5"}
        descr = {
            1: "Линза LSPosed: сильное увеличение, изгиб, свет по бокам, желе",
            2: "Без LS, водяной бугорок (версия 21.6)",
            3: "Без LS, желейная линза как в 21.5",
        }
        def on_mode(v):
            self._apply_mode(max(1, min(3, int(round(v)))))
        return [
            ui.text("Режим", "titleMedium", "#FFFFFF"),
            ui.text("Режим: " + names.get(cur, "Бар с LS"), "titleSmall", "#FFFFFF"),
            ui.text(descr.get(cur, ""), "bodySmall", "#CCFFFFFF"),
            ui.slider(float(cur), on_mode, 1, 3, "", 2),
            ui.text("1 — Бар с LS, 2 — Обычный, 3 — Версия 21.5", "bodySmall", "#CCFFFFFF"),
        ]

    def screen_glass_panel(self, ui, api, state):
        self._read_settings()
        return self._rows_screen(ui, "Панель", head=self._mode_head(ui), rows=[
            ("sw", "glass_enabled", "Эффект стекла", "Выключите, чтобы вернуть обычную плавающую панель", True),
            ("sw", "glass_ls_style", "Стиль LSPosed", "Сильное увеличение иконок под линзой и синяя кромка", True),
            ("sw", "glass_style_fallback", "Стиль бара: стекло без шейдера", "Классическая круглая линза без AGSL-шейдера", False),
            ("sw", "glass_btn", "Стеклянная кнопка «назад»", "Стекло поверх кнопки в левом верхнем углу", True),
            ("sw", "glass_ttl", "Стеклянный заголовок", "Парящая стеклянная капсула над названием экрана", True),
            ("sl", "glass_bar_scale", "Масштаб нижней панели, %", 70, 130, 59, 100),
            ("sl", "glass_bend_amt", "Сила изгиба линзы", 0, 100, 19, 44),
            ("sl", "glass_side_glow", "Сила белого свечения по бокам", 0, 100, 19, 60),
        ])

    def screen_glass_anim(self, ui, api, state):
        self._read_settings()
        return self._rows_screen(ui, "Анимация", [
            ("sw", "glass_anim_jelly", "Желейная анимация (стиль 21.5)", "Линза растягивается и раскачивается. Выключено — водяной бугорок (21.6)", True),
            ("sw", "glass_fx", "Анимация верхних элементов", "Желейный разгон и «шлепок» при остановке верхних накладок", True),
            ("sw", "glass_reduce_motion", "Уменьшить движение", "Отключает перелёты и пружинные анимации для доступности", False),
            ("sw", "haptic_sections", "Вибрация при смене секции", "Короткий отклик, когда переключается All, BLE или Advert", False),
        ])

    def screen_glass_bt(self, ui, api, state):
        self._read_settings()
        return self._rows_screen(ui, "Bluetooth", [
            ("sw", "glass_scr", "Стекло на экране Bluetooth", "Матовый переключатель All/BLE/Advert и кромка-стекло вокруг карточки и кнопок", True),
            ("sw", "glass_scr_fx", "Анимации стекла на экране", "Появление с «пробегом» света, живой блик по кромке, вспышка при смене секции", True),
            ("sw", "glass_scr_top", "Верхняя панель", "Переключатель All / BLE / Advert вверху экрана", True),
            ("sw", "glass_scr_bot", "Нижняя часть", "Карточка и кнопки внизу экрана", True),
            ("sl", "glass_scr_dy_top", "Сдвиг стекла сверху, dp", -30, 30, 59, 0),
            ("sl", "glass_scr_dy_bot", "Сдвиг стекла снизу, dp", -60, 60, 119, 0),
        ])

    def screen_glass_beta(self, ui, api, state):
        self._read_settings()
        return self._rows_screen(ui, "Бета", [
            ("sw", "glass_cracks", "Трещины", "Экспериментально: может влиять на переключение вкладок", False),
            ("sw", "glass_tilt", "Наклон: вода в стекле", "Экспериментально: датчик наклона может выдавать ошибку", False),
            ("sw", "glass_scr_auto_cal", "Автокалибровка экрана Bluetooth", "Экспериментально: может сдвигать нижние элементы", False),
        ])

    def screen_glass_system(self, ui, api, state):
        self._read_settings()
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"
        extra = [ui.text("Профиль производительности", "titleMedium", W)]
        for key in ("quality", "balanced", "battery", "manual"):
            p = self.PERF_PROFILES[key]
            selected = key == self.perf_profile
            title = ("✓ " if selected else "") + p["title"]
            extra.append(ui.card([
                ui.text(title, "titleSmall", W),
                ui.text(p["subtitle"], "bodySmall", W2),
                ui.button("Выбрать", lambda k=key: self._set_perf_profile(k)),
            ]))
        return self._rows_screen(ui, "Система", [
            ("sw", "glass_logs", "Окно логов", "Стеклянная панель с логами плагина и кнопка «Копировать»", True),
        ], extra=extra)

    def screen_glass_performance(self, ui, api, state):
        self._read_settings()
        W = "#FFFFFF"
        W2 = "#CCFFFFFF"
        items = []
        for key in ("quality", "balanced", "battery", "manual"):
            p = self.PERF_PROFILES[key]
            selected = key == self.perf_profile
            title = ("✓ " if selected else "") + p["title"]
            items.append(ui.card([
