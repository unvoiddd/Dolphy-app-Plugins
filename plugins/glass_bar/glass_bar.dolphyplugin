            ui.text("60 кадров/с на любом телефоне. Остаются реалистичная кромка, преломление и блики; "
                    "трещины, размытие, зерно, дисперсия, наклон и бета-шейдер выключены.", "bodyMedium", W2),
            ui.switch(bool(self.get_setting("glass_opt", True)), self._key_cb("glass_opt"), "", ""),
        ]), ui.text("Профиль производительности", "titleMedium", W)]
